  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: rlic\n  version: \"0.5.3\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/rlic-${{ version }}.tar.gz\n  sha256: a5a249df38d3cf9203a6cd5ff4e585db1a2c95ea0e2e5f8365025f348ada96e9\n\nbuild:\n  number: 1\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ true if is_abi3 }}\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then: python\n    - if: build_platform != target_platform\n      then: cross-python_${{ target_platform }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cmake\n    - make\n    - maturin\n  host:\n    - if: is_abi3\n      then: python-abi3\n    - python\n    - maturin >=1.0,<2.0\n    - pip\n  run:\n    - python\n    - numpy >=1.22.0\n    - if: match(python, \"<3.11\")\n      then: exceptiongroup >=1.0.0\n\ntests:\n  - python:\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n      imports:\n        - rlic\n      pip_check: true\n  - files:\n      source:\n        - tests\n    requirements:\n      run:\n        - pip\n        - pytest\n        - if: is_abi3\n          then: abi3audit\n    script:\n      - pytest -ra tests\n      - if: unix and is_abi3\n        then: abi3audit $SP_DIR/rlic/_core.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n      - if: win and is_abi3\n        then: abi3audit %SP_DIR%/rlic/_core.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  summary: A minimal Line Integral Convolution extension for NumPy, written in Rust\n  license: MIT\n  license_file:\n    - LICENSE_rlic\n    - LICENSE_vectorplot\n    - THIRDPARTY.yml\n  homepage: https://github.com/neutrinoceros/rlic\n\nextra:\n  recipe-maintainers:\n    - neutrinoceros\n",
