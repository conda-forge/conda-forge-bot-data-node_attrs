  "raw_meta_yaml": "context:\n  version: \"0.2.0\"\n\npackage:\n  name: fsspec-kafka\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/f/fsspec-kafka/fsspec_kafka-${{ version }}.tar.gz\n  sha256: 7b9b4c6b054c277cdb41d8adff5221bb2c60b9b45efb960126a98b835bae1a06\n\nbuild:\n  number: 0\n  python:\n    version_independent: true\n  script:\n    - if: unix\n      then: export PYO3_PYTHON=\"$PYTHON\"\n      else: set \"PYO3_PYTHON=%PYTHON%\"\n    - if: linux\n      # Bundled krb5 uses legacy function pointers that GCC 15's default C23 rejects.\n      then: export CFLAGS=\"${CFLAGS} -std=gnu17\"\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  skip: is_abi3 and not is_python_min\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python ${{ python_min }}.*\n        - cross-python_${{ target_platform }}\n        - crossenv\n        - hatchling\n        - hatch-rs >=0.6.0\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cmake\n    - ninja\n    - pkgconf\n    - perl\n    - if: unix\n      then:\n        - make\n        - bison\n  host:\n    - python\n    - pip\n    - hatchling\n    - hatch-rs >=0.6.0\n    - fsspec-rs >=0.2.1,<0.3\n    - if: is_abi3\n      then:\n        - python-abi3\n  run:\n    - python\n    - fsspec\n    - fsspec-rs >=0.2.1,<0.3\n\ntests:\n  - python:\n      imports:\n        - fsspec_kafka\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\n  - script:\n      - python -m pytest -v -o addopts=\"\" fsspec_kafka/tests/test_all.py\n      - python -c \"import fsspec, fsspec_kafka; assert fsspec.get_filesystem_class('kafka') is fsspec_kafka.KafkaFileSystem\"\n    files:\n      source:\n        - fsspec_kafka/tests/test_all.py\n    requirements:\n      run:\n        - pytest\n\n  - if: is_abi3\n    then:\n      script:\n        - if: win\n          then: abi3audit %SP_DIR%/fsspec_kafka/fsspec_kafka.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit $SP_DIR/fsspec_kafka/fsspec_kafka.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n      requirements:\n        run:\n          - abi3audit\n\nabout:\n  homepage: https://github.com/1kbgz/fsspec-kafka\n  repository: https://github.com/1kbgz/fsspec-kafka\n  summary: Kafka topics and partitions through fsspec\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - timkpaine\n",
