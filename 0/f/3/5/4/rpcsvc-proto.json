    "about": {
      "description": "rpcsvc-proto provides the rpcsvc protocol files and headers that were formerly\ndistributed with glibc, along with the rpcgen program for generating C code\nfrom RPC protocol definitions. It is the upstream replacement recommended by\ndistributions such as Debian, Fedora, and SUSE for software that needs to\nbuild against Sun RPC.",
      "dev_url": "https://github.com/thkukuk/rpcsvc-proto",
      "home": "https://github.com/thkukuk/rpcsvc-proto",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "COPYING",
      "summary": "rpcsvc protocol files and rpcgen, removed from glibc in favour of libtirpc"
    },
    "build": {
      "number": "0",
      "script": [
        "autoreconf -fi",
        "./configure --prefix=$PREFIX",
        "make",
        "make install"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "anderslindho"
      ]
    },
