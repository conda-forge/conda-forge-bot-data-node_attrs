  "raw_meta_yaml": "context:\n  version: \"1.4.4\"\n\npackage:\n  name: rpcsvc-proto\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/thkukuk/rpcsvc-proto/releases/download/v${{ version }}/rpcsvc-proto-${{ version }}.tar.xz\n  sha256: 81c3aa27edb5d8a18ef027081ebb984234d5b5860c65bd99d4ac8f03145a558b\n  patches:\n    # TODO: drop once upstream includes PR #14 in a release.\n    - 0001-rpcgen-follow-the-CPP-and-RPCGEN_CPP-enviromental-va.patch\n\nbuild:\n  number: 2\n  skip:\n    - win\n  script:\n    - autoreconf -fi\n    - if [[ \"${CONDA_BUILD_CROSS_COMPILATION:-0}\" == \"1\" ]]; then CROSS_ARGS=\"--build=${BUILD} --host=${HOST}\"; fi\n    - ./configure --prefix=$PREFIX ${CROSS_ARGS:-}\n    # The rpcsvc headers are made by running the rpcgen just built\n    # (rpcsvc/Makefile.am: $(top_builddir)/rpcgen/rpcgen -h -o $@ $<).\n    # Cross-compiled, that rpcgen is for the target and cannot run here: make\n    # them first, same command, with the build machine's rpcgen; make then finds\n    # them up to date. The installed rpcgen is still the one built for the target.\n    - |\n      if [[ \"${CONDA_BUILD_CROSS_COMPILATION:-0}\" == \"1\" ]]; then\n        for x in rpcsvc/*.x; do\n          \"${BUILD_PREFIX}/bin/rpcgen\" -h -o \"${x%.x}.h\" \"$x\"\n        done\n      fi\n    - make\n    - make install\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - if: build_platform != target_platform\n      then:\n        - rpcsvc-proto\n    - ${{ stdlib('c') }}\n    - autoconf\n    - automake\n    - libtool\n    - make\n    - gettext\n  host:\n    - if: osx\n      then:\n        - libintl\n\ntests:\n  - script:\n      - rpcgen -h 2>&1 | grep -q rpcgen\n\nabout:\n  homepage: https://github.com/thkukuk/rpcsvc-proto\n  summary: rpcsvc protocol files and rpcgen, removed from glibc in favour of libtirpc\n  description: |\n    rpcsvc-proto provides the rpcsvc protocol files and headers that were formerly\n    distributed with glibc, along with the rpcgen program for generating C code\n    from RPC protocol definitions. It is the upstream replacement recommended by\n    distributions such as Debian, Fedora, and SUSE for software that needs to\n    build against Sun RPC.\n  license: MIT\n  license_file: COPYING\n  repository: https://github.com/thkukuk/rpcsvc-proto\n\nextra:\n  recipe-maintainers:\n    - meiyasan\n    - anderslindho\n",
