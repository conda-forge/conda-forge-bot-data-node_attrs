    "about": {
      "description": "Harmonica is a Python library for processing and modeling gravity and\nmagnetic data. It includes common processing steps, like calculation of\nBouguer and terrain corrections, reduction to the pole, upward\ncontinuation, equivalent layers, and more. There are forward modeling\nfunctions for basic geometric shapes, like spheres, prisms, polygonal\nprisms, and tesseroids. The inversion methods are implemented as classes\nwith an interface inspired by scikit-learn (like Verde).",
      "dev_url": "https://github.com/fatiando/harmonica",
      "doc_url": "https://www.fatiando.org/harmonica",
      "home": "https://pypi.org/project/harmonica/",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE.txt",
      "summary": "Forward modeling, inversion, and processing gravity and magnetic data"
    },
    "build": {
      "noarch": "python",
      "number": "2",
      "script": "${{ PYTHON }} -m pip install . -vv"
    },
    "extra": {
      "recipe-maintainers": [
        "mdtanker",
        "leouieda",
        "santisoler"
      ]
    },
    "outputs": [
