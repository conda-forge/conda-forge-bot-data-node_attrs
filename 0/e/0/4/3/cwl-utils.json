  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: cwl-utils\n  version: \"0.46\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/${{ name[0] }}/${{ name }}/${{ name | replace('-', '_') }}-${{ version }}.tar.gz\n  sha256: 6a0192a30c01c1c9af444b173b29a2d140a7f0c7326c2d6c7c694a9a0b21a46d\n\nbuild:\n  number: 1\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - cwl-cite-extract = cwl_utils.cite_extract:main\n      - cwl-docker-extract = cwl_utils.docker_extract:main\n      - cwl-expression-refactor = cwl_utils.expression_refactor:main\n      - cwl-graph-split = cwl_utils.graph_split:main\n      - cwl-normalizer = cwl_utils.normalizer:main\n      - cwl-inputs-schema-gen = cwl_utils.inputs_schema_gen:main\n\nrequirements:\n  host:\n    - pip\n    - python ${{ python_min }}.*\n    - hatchling >=1.27.0\n  run:\n    - python >=${{ python_min }}\n    - cwl-upgrader >=1.2.3\n    # cwl-upgrader is for cwl-normalizer (cwl_utils/normalizer.py)\n    - cwlformat\n    # cwlformat is from extras[pretty], for cwl-graph-split. An alternative for this would be to build for\n    # multiple outputs, e.g. https://github.com/conda-forge/matplotlib-feedstock/blob/2ca6433797f0a4f77fee890c6fa39617a6a6b0b4/recipe/meta.yaml#L17\n    - packaging\n    - rdflib\n    - requests\n    - schema-salad >=8.10.20260810193251,<9\n    - ruamel.yaml >=0.17.6,<0.20\n    - typing_extensions >=4.10.0\n\ntests:\n  - python:\n      imports:\n        - cwl_utils\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n        - pip\n        - pytest-xdist\n        - pytest-mock >=1.10.0\n        - nodejs\n        - jsonschema >=4.21.1\n        - udocker\n        - cwltool\n    script:\n      - cwl-cite-extract --help\n      - cwl-docker-extract --help\n      - cwl-expression-refactor --help\n      - cwl-graph-split --help\n      - cwl-normalizer --help\n      - cwl-inputs-schema-gen --help\n      - python -m pytest -n auto --pyargs cwl_utils\n\nabout:\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n  summary: Python utilities for CWL\n  homepage: https://github.com/common-workflow-language/cwl-utils\n  repository: https://github.com/common-workflow-language/cwl-utils/\n\nextra:\n  recipe-maintainers:\n    - mr-c\n    - kinow\n",
