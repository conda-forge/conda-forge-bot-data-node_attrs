              ],
              "python_version": [
                "3.12.*",
                "*"
              ]
            }
          },
          {
            "requirements": {
              "run": [
                "abi3audit",
                "python 3.12.*"
              ]
            },
            "script": "abi3audit -s -v --assume-minimum-abi3 ${{ python_min }} $SP_DIR/wesl/_native.abi3.so"
          },
          {
            "files": {
              "source": [
                "tests/",
                "examples/",
                "pyproject.toml",
                "wesl.toml"
              ]
            },
            "requirements": {
              "run": [
                "pytest >=9.1"
              ]
            },
            "script": "python -m pytest tests -q"
          }
        ],
        "version": "0.1.0"
      }
