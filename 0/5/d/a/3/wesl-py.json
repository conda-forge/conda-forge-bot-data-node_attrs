      "dev_url": "https://github.com/claydugo/wesl-py",
      "home": "https://github.com/claydugo/wesl-py",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Python bindings for the Rust WESL compiler"
    },
    "build": {
      "number": "0",
      "python": {
        "version_independent": true
      },
      "script": [
        "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation",
        "cargo-bundle-licenses --format yaml --output THIRDPARTY.yml"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "claydugo"
      ]
    },
    "outputs": [
      {
        "build": {
          "python": {
            "version_independent": true
          }
        },
        "name": "wesl-py",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "c_stdlib_stub",
            "rust_compiler_stub",
            "cargo-bundle-licenses"
          ],
          "host": [
            "python 3.12.*",
            "python-abi3",
            "maturin >=1.15,<2",
            "pip"
          ],
          "run": [
            "python >=3.12"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
