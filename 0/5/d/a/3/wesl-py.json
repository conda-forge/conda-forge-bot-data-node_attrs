  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.1.0\"\n  python_min: \"3.12\"\n\npackage:\n  name: wesl-py\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/w/wesl-py/wesl_py-${{ version }}.tar.gz\n  sha256: 81efaf3386cf5d1dbc22b25d45b35b29bdefc336984956f18cb15b4f517a0778\n\nbuild:\n  number: 0\n  skip:\n    - not is_python_min\n  python:\n    version_independent: true\n  script:\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python ${{ python_min }}.*\n        - cross-python_${{ target_platform }}\n        - maturin >=1.15,<2\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - cargo-bundle-licenses\n  host:\n    - python ${{ python_min }}.*\n    - python-abi3\n    - maturin >=1.15,<2\n    - pip\n  run:\n    - python >=${{ python_min }}\n  run_constraints:\n    - pytest >=9.1\n    - wgpu-py >=0.32,<0.33\n\ntests:\n  - python:\n      imports:\n        - wesl\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - abi3audit\n        - python ${{ python_min }}.*\n    script:\n      - if: unix\n        then: abi3audit -s -v --assume-minimum-abi3 ${{ python_min }} $SP_DIR/wesl/_native.abi3.so\n        else: abi3audit -s -v --assume-minimum-abi3 ${{ python_min }} %SP_DIR%\\wesl\\_native.pyd\n  - files:\n      source:\n        - tests/\n        - examples/\n        - pyproject.toml\n        - wesl.toml\n    requirements:\n      run:\n        - pytest >=9.1\n    script:\n      - python -m pytest tests -q\n\nabout:\n  homepage: https://github.com/claydugo/wesl-py\n  repository: https://github.com/claydugo/wesl-py\n  summary: Python bindings for the Rust WESL compiler\n  description: |\n    wesl-py provides Python bindings for the Rust WESL compiler.\n    WESL adds imports and conditional compilation to WGSL.\n    The package also includes a pytest plugin that runs WESL shader tests.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - claydugo\n",
