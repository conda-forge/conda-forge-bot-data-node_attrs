  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: exorcist\n  version: 0.1.0\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/OpenFreeEnergy/${{ name }}/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 18a4016938dc3e10897a423e38af3789e52f0333946cee1eaa038457b9ba9b17\n  # you can get the sha256 checksum with:  `openssl sha256 <file name>`,\n  # or, in one go without keeping the file with: `curl -L <url> | sha256`\n  # (you may need the packages or openssl and/or curl)\n\nbuild:\n  number: 0\n  noarch: python\n  script: SETUPTOOLS_SCM_PRETEND_VERSION=${{ version }} ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools >=78.1.1  # security-related bugfix https://setuptools.pypa.io/en/stable/history.html#v78-1-1\n    - setuptools_scm\n  run:\n    - __unix\n    - python >=${{ python_min }}\n    - networkx\n    - sqlalchemy\n\ntests:\n  # Some packages might need a `test/commands` key to check CLI.\n  - python:\n      imports:\n      - exorcist\n      pip_check: true  # run `pip check` to verify the integrity\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - pytest\n        - python ${{ python_min }}.*\n    script:\n      - python -c \"import ${{ name }}; print(${{ name }}.__version__)\"\n      - python -c \"import ${{ name }}; assert(${{ name }}.__version__ == '${{ version }}')\"\n      - pytest -v --pyargs ${{ name }}\n\nabout:\n  homepage: https://github.com/openFreeEnergy/exorcist\n  summary: exorcist\n  description: |\n    Daemonless campaign-scale simulation orchestration.\n  license: MIT\n  license_file: LICENSE\n  repository: https://github.com/openFreeEnergy/exorcist\n  documentation: https://exorcist.readthedocs.io/en/latest/\n\nextra:\n  recipe-maintainers:\n    - atravitz\n    - dwhswenson\n",
