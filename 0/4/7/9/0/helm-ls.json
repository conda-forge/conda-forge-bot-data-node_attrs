  "raw_meta_yaml": "context:\n  version: \"0.5.4\"\n\npackage:\n  name: helm-ls\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/mrjosh/helm-ls/archive/v${{ version }}.tar.gz\n  sha256: a8a5490084839af3506c85efcf603fbd71bb9ee37222bbd7817da1da3f054ab3\n  target_directory: src\n\nbuild:\n  number: 0\n  script:\n    - cd src\n    - go-licenses save . --save_path ../library_licenses\n    - if: unix\n      then: go build -v -trimpath -o $PREFIX/bin/helm-ls -ldflags=\"-s -w -X main.Version=v${{ version }} -X main.Branch=v${{ version }}\"\n      else: go build -v -trimpath -o %LIBRARY_BIN%\\helm-ls.exe -ldflags=\"-s -w -X main.Version=v${{ version }} -X main.Branch=v${{ version }}\"\n\nrequirements:\n  build:\n    - if: unix\n      then:\n        - ${{ compiler(\"c\") }}\n        - ${{ stdlib(\"c\") }}\n      else:\n        # cgo on Windows requires a MinGW toolchain, MSVC is not supported\n        - ${{ compiler(\"m2w64_c\") }}\n        - ${{ stdlib(\"m2w64_c\") }}\n    - ${{ compiler(\"go-cgo\") }}\n    - go-licenses\n\ntests:\n  - script:\n      - helm-ls --help\n      - helm-ls version\n  - package_contents:\n      bin:\n        - helm-ls\n      strict: true\n\nabout:\n  license: MIT\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n  summary: Language server for Helm\n  homepage: https://github.com/mrjosh/helm-ls\n  repository: https://github.com/mrjosh/helm-ls\n\nextra:\n  recipe-maintainers:\n    - danielnachun\n    - pavelzw\n",
