  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.10.0\"\n\nrecipe:\n  name: iceoryx2-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/eclipse-iceoryx/iceoryx2/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: ef14e6b8f7cbb003dc0f67f06dd00436fe4ed3ddd97154efde5796bc441d0265\n\nbuild:\n  number: 0\n  skip:\n    - win\n  script: build\n\noutputs:\n  - package:\n      name: libiceoryx2-ffi-c\n    build:\n      files:\n        - if: linux\n          then: lib/libiceoryx2_ffi_c.so\n        - if: osx\n          then: lib/libiceoryx2_ffi_c.dylib\n    requirements:\n      build:\n        - ${{ compiler(\"rust\") }}\n        - ${{ compiler(\"c\") }}\n        - ${{ compiler(\"cxx\") }}\n        - ${{ stdlib(\"c\") }}\n        - cargo-bundle-licenses\n        - cmake\n        - make\n        - libclang\n        - clang_impl_${{ target_platform }}\n      host:\n        - if: linux\n          then: libacl\n        - libiceoryx-hoofs-devel >=2.95.7\n    tests:\n      - script: test -f ${PREFIX}/lib/libiceoryx2_ffi_c${SHLIB_EXT}\n\n  - package:\n      name: libiceoryx2-ffi-c-devel\n    build:\n      files:\n        - lib/cmake/iceoryx2-cmake-modules/\n        - include/iceoryx2/v${{ version }}/iox2/iceoryx2.h\n        - share/doc/iceoryx2-c/\n        - lib/cmake/iceoryx2-c/\n    requirements:\n      build:\n        - ${{ compiler(\"rust\") }}\n        - ${{ compiler(\"c\") }}\n        - ${{ compiler(\"cxx\") }}\n        - ${{ stdlib(\"c\") }}\n        - cargo-bundle-licenses\n        - cmake\n        - make\n        - libclang\n        - clang_impl_${{ target_platform }}\n      host:\n        - if: linux\n          then: libacl\n        - libiceoryx-hoofs-devel >=2.95.7\n        - ${{ pin_subpackage(\"libiceoryx2-ffi-c\", exact=True) }}\n      run:\n        - ${{ pin_subpackage(\"libiceoryx2-ffi-c\", exact=True) }}\n      run_exports:\n        - ${{ pin_subpackage(\"libiceoryx2-ffi-c\", upper_bound=\"x.x.x\") }}\n    tests:\n      - script: test -f ${PREFIX}/include/iceoryx2/v${{ version }}/iox2/iceoryx2.h\n\n  - package:\n      name: libiceoryx2-cxx\n    build:\n      files:\n        - if: linux\n          then: lib/libiceoryx2_cxx.so\n        - if: osx\n          then: lib/libiceoryx2_cxx.dylib\n    requirements:\n      build:\n        - ${{ compiler(\"rust\") }}\n        - ${{ compiler(\"c\") }}\n        - ${{ compiler(\"cxx\") }}\n        - ${{ stdlib(\"c\") }}\n        - cargo-bundle-licenses\n        - cmake\n        - make\n        - libclang\n        - clang_impl_${{ target_platform }}\n      host:\n        - if: linux\n          then: libacl\n        - libiceoryx-hoofs-devel >=2.95.7\n        - ${{ pin_subpackage(\"libiceoryx2-ffi-c-devel\", exact=True) }}\n        - ${{ pin_subpackage(\"libiceoryx2-ffi-c\", exact=True) }}\n      run:\n        - ${{ pin_subpackage(\"libiceoryx2-ffi-c\", exact=True) }}\n    tests:\n      - script: test -f ${PREFIX}/lib/libiceoryx2_cxx${SHLIB_EXT}\n\n  - package:\n      name: libiceoryx2-cxx-devel\n    build:\n      files:\n        include:\n          - lib/cmake/iceoryx2-bb-cxx/\n          - lib/cmake/iceoryx2-cxx/\n          - include/iceoryx2/v${{ version }}/iox2/\n          - include/iceoryx2/v${{ version }}/iox/\n          - share/doc/iceoryx2-cxx/\n          - share/doc/iceoryx2-bb-cxx/\n        exclude:\n          - include/iceoryx2/v${{ version }}/iox2/iceoryx2.h\n    requirements:\n      build:\n        - ${{ compiler(\"rust\") }}\n        - ${{ compiler(\"c\") }}\n        - ${{ compiler(\"cxx\") }}\n        - ${{ stdlib(\"c\") }}\n        - cargo-bundle-licenses\n        - cmake\n        - make\n        - libclang\n        - clang_impl_${{ target_platform }}\n      host:\n        - if: linux\n          then: libacl\n        - libiceoryx-hoofs-devel >=2.95.7\n        - ${{ pin_subpackage(\"libiceoryx2-ffi-c-devel\", exact=True) }}\n        - ${{ pin_subpackage(\"libiceoryx2-ffi-c\", exact=True) }}\n        - ${{ pin_subpackage(\"libiceoryx2-cxx\", exact=True) }}\n      run:\n        - ${{ pin_subpackage(\"libiceoryx2-ffi-c-devel\", exact=True) }}\n        - ${{ pin_subpackage(\"libiceoryx2-cxx\", exact=True) }}\n        - libiceoryx-hoofs-devel\n      run_exports:\n        - ${{ pin_subpackage(\"libiceoryx2-cxx\", upper_bound=\"x.x.x\") }}\n    tests:\n      - script: test -f ${PREFIX}/include/iceoryx2/v${{ version }}/iox2/client.hpp\n\nabout:\n  homepage: https://iceoryx.io/\n  summary: Eclipse iceoryx - true zero-copy inter-process-communication\n  description: |\n    Eclipse iceoryx is an inter-process-communication middleware that enables\n    virtually limitless data transmissions at constant time.\n  license: Apache-2.0 AND MIT AND EPL-2.0\n  license_file:\n    - LICENSE-APACHE\n    - LICENSE-MIT\n    - THIRDPARTY.yml\n  documentation: https://iceoryx.io/latest/\n  repository: https://github.com/eclipse-iceoryx/iceoryx2\n\nextra:\n  feedstock-name: iceoryx2\n  recipe-maintainers:\n    - timkpaine\n",
