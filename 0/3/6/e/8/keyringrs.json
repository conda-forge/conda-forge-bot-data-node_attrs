  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.4.1\"\n\npackage:\n  name: keyringrs\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/k/keyringrs/keyringrs-${{ version }}.tar.gz\n  sha256: 6684e3d0ac70d2c3f0397b1295ae4b1f3bfe2fe889d0d61a0f980122ee0b534d\n\nbuild:\n  number: 0\n  skip: not is_python_min\n  script:\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --config-settings=maturin.build-args=--no-default-features\n  python:\n    version_independent: true\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin >=1.8,<2\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - cargo-bundle-licenses\n    - if: linux\n      then: pkg-config\n  host:\n    - python-abi3\n    - python\n    - pip\n    - maturin >=1.8,<2\n    - if: linux\n      then: dbus\n  run:\n    - python >=${{ python_min }}\n\ntests:\n  - python:\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n      imports:\n        - keyringrs\n      pip_check: true\n  - requirements:\n      run:\n        - abi3audit\n    script:\n      - if: unix\n        then: abi3audit $SP_DIR/keyringrs/keyringrs.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n        else: abi3audit %SP_DIR%\\keyringrs\\keyringrs.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  homepage: https://pypi.org/project/keyringrs/\n  repository: https://github.com/aiidateam/keyringrs\n  summary: Python bindings for keyring-rs\n  description: |\n    keyringrs provides Python bindings for keyring-rs, exposing native\n    platform credential stores such as Linux Secret Service/keyutils,\n    macOS Keychain, and Windows Credential Manager.\n  license: Apache-2.0 OR MIT\n  license_file:\n    - LICENSE-APACHE\n    - LICENSE-MIT\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - agoscinski\n",
