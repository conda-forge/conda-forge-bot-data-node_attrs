  "linux_64_meta_yaml": {
    "about": {
      "description": "caveman is a Claude Code skill that cuts ~65% of tokens by talking like\ncaveman. This package installs the `caveman` CLI, a one-shot bootstrapper\nthat auto-detects supported AI coding agents on the machine (Claude Code,\nCursor, Codex, Gemini CLI, opencode, Continue, Cline, Windsurf, and\n~25 more) and runs each agent's native install path. It also wires\nClaude Code hooks, a statusline badge, and the `caveman-shrink` MCP\nmiddleware when those targets are present. Idempotent and re-runnable.",
      "dev_url": "https://github.com/JuliusBrussee/caveman",
      "doc_url": "https://github.com/JuliusBrussee/caveman/blob/main/INSTALL.md",
      "home": "https://getcaveman.dev/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "One-shot installer that wires the caveman Claude Code skill into ~30 AI coding agents"
    },
    "build": {
      "number": "1",
      "script": [
        "set -ex",
        "NPM_VER=$(node -p \"require('./package.json').version\")",
        "pnpm install --prod --ignore-scripts",
        "pnpm-licenses generate-disclaimer --prod --output-file=ThirdPartyLicenses.txt",
        "npm pack --ignore-scripts --userconfig nonexistentrc",
        "npm install --userconfig nonexistentrc --global \"${SRC_DIR}/caveman-installer-${NPM_VER}.tgz\"",
        "find \"${PREFIX}/lib/node_modules/caveman-installer\" -type d -name .bin -exec rm -rf {} + || true"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "rxm7706"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "caveman-installer",
        "requirements": {
          "build": [
            "nodejs >=18",
            "pnpm",
            "pnpm-licenses"
          ],
          "host": [
            "nodejs 24.*"
          ],
          "run": [
            "nodejs >=18"
          ]
        },
        "tests": [
          {
            "script": "caveman-install --help"
          }
        ],
        "version": "2.7.0"
      }
    ],
    "package": {
      "name": "caveman-installer",
      "version": "2.7.0"
    },
