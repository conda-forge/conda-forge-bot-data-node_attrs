      "description": "proxy-scraper collects public HTTP, SOCKS4 and SOCKS5 proxies from 700+ sources and keeps only the ones\nthat pass every check: a protocol handshake, the same exit IP on two unrelated sites (drops honeypots),\na byte-for-byte content check (drops proxies that inject scripts) and, for HTTPS, a verified TLS\nhandshake. It can serve the result as one rotating local proxy and has a Python API.",
      "dev_url": "https://github.com/maximilianfeix/proxy-scraper",
      "doc_url": "https://github.com/maximilianfeix/proxy-scraper#readme",
      "home": "https://github.com/maximilianfeix/proxy-scraper",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Free HTTP and SOCKS proxies that actually work, verified against honeypots and injected scripts"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "proxy-scraper = proxyscraper.cli:run",
          "proxy-scraper-cli = proxyscraper.cli:run",
          "proxy-scraper-mcp = proxyscraper.mcp_entry:main"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "maximilianfeix"
      ]
    },
