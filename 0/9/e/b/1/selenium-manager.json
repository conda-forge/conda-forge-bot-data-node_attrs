  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"4.52.0\"\n  env_d_json: selenium-manager.json\n\npackage:\n  name: selenium-manager\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/SeleniumHQ/selenium/archive/refs/tags/selenium-${{ version }}.tar.gz\n  sha256: 3282451cad462cd5b7c941fbb71b8db1ace6d6ab160d2c90eed7c984068f4b1a\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      ZSTD_SYS_USE_PKG_CONFIG: \"1\"\n    content:\n      - if: unix\n        then:\n          - mkdir -p \"${PREFIX}/etc/conda/env_vars.d\"\n          - |-\n            cat <<EOF > \"${PREFIX}/etc/conda/env_vars.d/${{ env_d_json }}\"\n            {\"SE_MANAGER_PATH\":\"${PREFIX}/bin/selenium-manager\"}\n            EOF\n        else:\n          - mkdir %PREFIX%\\etc\\conda\\env_vars.d\n          - |-\n            echo {\"SE_MANAGER_PATH\":\"%PREFIX%\\\\Scripts\\\\selenium-manager.exe\"} > \"%PREFIX%\\etc\\conda\\env_vars.d\\${{ env_d_json }}\"\n      - if: osx\n        then:\n          - export RUSTFLAGS=\"-C link-args=-Wl,-rpath,${PREFIX}/lib\"\n      - if: linux\n        then:\n          - export RUSTFLAGS=\"-C link-arg=-Wl,-rpath-link,${PREFIX}/lib -L${PREFIX}/lib\"\n      - cd rust\n      - cargo auditable install --locked --no-track --root=${{ PREFIX }} --path=.\n      - cargo-bundle-licenses --format=yaml --output=THIRDPARTY.yml\n      - cd \"${{ RECIPE_DIR }}\"\n      - if: win\n        then:\n          - md \"%SCRIPTS%\" || echo \"%SCRIPTS% already exists\"\n          - move \"%PREFIX%\\bin\\selenium-manager.exe\" \"%SCRIPTS%\"\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - ${{ stdlib(\"c\") }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - pkg-config\n  host:\n    - zstd\n\ntests:\n  - package_contents:\n      strict: true\n      bin:\n        - selenium-manager\n      files:\n        - etc/conda/env_vars.d/${{ env_d_json }}\n  - script:\n      - selenium-manager --version\n      - selenium-manager --help\n      - if: unix\n        then: ls \"${SE_MANAGER_PATH}\"\n        else: dir \"%SE_MANAGER_PATH%\"\n\nabout:\n  homepage: https://github.com/SeleniumHQ/selenium\n  license: Apache-2.0\n  license_file:\n    - rust/THIRDPARTY.yml\n    - LICENSE\n    - NOTICE\n  summary: |-\n    Selenium Manager is a standalone tool that automatically manages the browser\n    infrastructure required by Selenium (i.e., browsers and drivers).\n\nextra:\n  recipe-maintainers:\n    - conda-forge/selenium\n    - bollwyvl\n",
