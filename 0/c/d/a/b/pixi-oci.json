  "raw_meta_yaml": "context:\n  version: \"0.1.1\"\n  # keep in sync with src/default_glibc.rs and the SHA-1s in build.rs\n  glibc_debian_version: \"2.41-12+deb13u4\"\n\npackage:\n  name: pixi-oci\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/pavelzw/pixi-oci/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: bc499985e52d6c8c824b24f276996d3c16483347f5889aa2ba6279443edb7fb6\n  # Debian libc6 packages embedded with the `bundled-glibc` feature, pinned by SHA-1 in build.rs\n  - url: https://snapshot.debian.org/file/27904cc1b58dd79f0768ba6aa6dd993edc411b97\n    sha256: 967aa62605721081c3eb2a17650611a792aa802d76a6511d1840242623d204c9\n    file_name: libc6_${{ glibc_debian_version }}_amd64.deb\n    target_directory: glibc-debs\n  - url: https://snapshot.debian.org/file/6ee536e6a461ca319776fac983202946f4d3dce8\n    sha256: 8784eda966b189c777a384dac5ce009e8fc9b52d006926c5a013e7fa8aa688cc\n    file_name: libc6_${{ glibc_debian_version }}_arm64.deb\n    target_directory: glibc-debs\n  - url: https://sources.debian.org/data/main/g/glibc/${{ glibc_debian_version | replace(\"+\", \"%2B\") }}/debian/copyright\n    sha256: f5788886720a2605a946e81d571e6c8162b09f58d2e2ceb8d36e5768fccd850d\n    file_name: GLIBC_COPYRIGHT\n\nbuild:\n  number: 0\n  skip: win\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - if: build_platform != target_platform\n        then:\n          # cc-rs >= 1.2 concatenates CFLAGS with CFLAGS_<target>, so the target flags would leak\n          # into the host builds of build-dependencies (ureq -> ring, liblzma).\n          - export TARGET_CFLAGS=\"$CFLAGS\" TARGET_CXXFLAGS=\"$CXXFLAGS\"\n          - unset CFLAGS CXXFLAGS\n          # let openssl-sys find the host-platform openssl via pkg-config\n          - export PKG_CONFIG_ALLOW_CROSS=1\n      - export GLIBC_DEBIAN_FILE=\"$SRC_DIR/glibc-debs/libc6_${{ glibc_debian_version }}_amd64.deb:$SRC_DIR/glibc-debs/libc6_${{ glibc_debian_version }}_arm64.deb\"\n      - cargo auditable install --locked --no-track --features bundled-glibc --bins --root ${{ PREFIX }} --path .\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n      - mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d\n      - $PREFIX/bin/pixi-oci completion zsh > $PREFIX/share/zsh/site-functions/_pixi-oci\n      - $PREFIX/bin/pixi-oci completion bash > $PREFIX/share/bash-completion/completions/pixi-oci\n      - $PREFIX/bin/pixi-oci completion fish > $PREFIX/share/fish/vendor_completions.d/pixi-oci.fish\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - cmake\n    - pkg-config\n  host:\n    - openssl\n\ntests:\n  - script:\n      - pixi-oci --help\n      - pixi-oci --version\n  - package_contents:\n      bin:\n        - pixi-oci\n      files:\n        - share/bash-completion/completions/pixi-oci\n        - share/fish/vendor_completions.d/pixi-oci.fish\n        - share/zsh/site-functions/_pixi-oci\n      strict: true\n\nabout:\n  homepage: https://github.com/pavelzw/pixi-oci\n  summary: Build OCI images from pixi environments\n  description: |\n    pixi-oci builds OCI container images from pixi environments without\n    requiring a container daemon.\n\n    This package embeds the Debian libc6 packages of the default glibc\n    version, so they are not downloaded when building images.\n  license: BSD-3-Clause AND LGPL-2.1-or-later\n  license_file:\n    - LICENSE\n    - GLIBC_COPYRIGHT\n    - THIRDPARTY.yml\n  repository: https://github.com/pavelzw/pixi-oci\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
