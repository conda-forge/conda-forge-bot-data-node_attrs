  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  python_min: \"3.9\"\n  version: \"3.5.2\"\n\npackage:\n  name: charset-normalizer\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/c/charset-normalizer/charset_normalizer-${{ version }}.tar.gz\n  sha256: 39de2a259fc954455c57274dc94c79d5842774e1247a016aff30bc0efed0f4ef\n\nbuild:\n  number: 0\n  script:\n      - if: win\n        then: |\n         set \"CHARSET_NORMALIZER_USE_CYTHON=1\"\n         set \"CHARSET_NORMALIZER_CYTHON_ABI3=1\"\n        else: |\n         export CHARSET_NORMALIZER_USE_CYTHON=\"1\"\n         export CHARSET_NORMALIZER_CYTHON_ABI3=\"1\"\n      - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    version_independent: true\n    entry_points:\n      - normalizer = charset_normalizer.cli:cli_detect\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python ${{ python_min }}.*\n        - cross-python_${{ target_platform }}\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n  host:\n    - python ${{ python_min }}.*\n    - python-abi3\n    - setuptools >=68,<84.1\n    - cython\n    - pip\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - charset_normalizer\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n        - abi3audit\n    script:\n      - normalizer --help\n      - if: unix\n        then:\n          - abi3audit $SP_DIR/charset_normalizer/*.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n      - if: win\n        then:\n          - abi3audit %SP_DIR%\\\\charset_normalizer\\\\md.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n          - abi3audit %SP_DIR%\\\\charset_normalizer\\\\cd.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  summary: The Real First Universal Charset Detector. Open, modern and actively maintained alternative to Chardet.\n  license: MIT\n  license_file:\n    - LICENSE\n    - data/NOTICE.md\n  homepage: https://pypi.org/project/charset-normalizer/\n  documentation: https://charset-normalizer.readthedocs.io/\n\nextra:\n  recipe-maintainers:\n    - ocefpaf\n",
