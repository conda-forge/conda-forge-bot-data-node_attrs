    "about": {
      "description": "isar-tools reads Isabelle theory (.thy) and ROOT files without running\nIsabelle. `isar fmt` formats theories (layout only, idempotent), `isar check`\nreports problems in ROOT files, proofs, syntax, and symbols, `isar stats`\nreports source, proof, and build-log statistics, and `isar project` shows\nsessions, import graphs, class and locale hierarchies, and declarations.",
      "dev_url": "https://github.com/ManuelLerchner/isar-tools",
      "home": "https://github.com/ManuelLerchner/isar-tools",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Formatter, checks, and statistics for Isabelle/Isar projects, without running Isabelle"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "isar = isar_tools.cli:main"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "ManuelLerchner"
      ]
    },
    "outputs": [
      {
        "build": {
          "noarch": "python",
          "python": {
            "entry_points": [
              "isar = isar_tools.cli:main"
            ]
          }
        },
        "name": "isar-tools",
        "requirements": {
          "build": [],
          "host": [
            "python 3.11.*",
