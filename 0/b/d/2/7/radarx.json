  "linux_64_meta_yaml": {
    "about": {
      "description": "radarx is a Python package for processing and visualizing weather radar\ndata with xarray. It builds on xradar and adds fast cone gridding (with a\ncompiled C++ kernel), CAPPI retrieval, interactive plotting and\nunstructured-grid conversion.\n",
      "dev_url": "https://github.com/syedhamidali/radarx",
      "doc_url": "https://radarx.readthedocs.io/",
      "home": "https://github.com/syedhamidali/radarx",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Xarray-based radar toolkit for radar data analysis"
    },
    "build": {
      "number": "1",
      "script": "PYTHON -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "syedhamidali"
      ]
    },
    "package": {
      "name": "radarx",
      "version": "0.4.0"
    },
    "requirements": {
      "build": [
        "cxx_compiler_stub",
        "c_stdlib_stub"
      ],
      "host": [
        "python",
        "pip",
        "setuptools >=64",
        "setuptools-scm >=8",
        "wheel",
        "pybind11 >=2.12"
      ],
      "run": [
        "python",
        "packaging",
        "boto3",
        "cartopy >=0.20.0",
        "cmweather",
        "lat_lon_parser",
        "matplotlib-base",
        "netcdf4",
        "numpy",
        "pooch",
        "pyproj",
        "scipy",
        "xarray >=2024.10.0",
        "xmltodict",
        "xradar >=0.11"
      ]
    },
    "schema_version": 0,
    "source": {
