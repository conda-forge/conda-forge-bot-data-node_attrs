  "linux_64_meta_yaml": {
    "about": {
      "description": "appmap records the execution of a Python application and writes AppMap\nfiles describing what ran: the functions called, the HTTP requests\nserved and the SQL issued. It hooks Django, Flask, FastAPI, SQLAlchemy,\npytest and unittest, and the recordings can be explored in the AppMap\nviewers for VS Code and JetBrains.",
      "dev_url": "https://github.com/getappmap/appmap-python",
      "home": "https://github.com/getappmap/appmap-python",
      "license": "MIT AND BSD-2-Clause",
      "license_family": "MIT AND BSD-2-Clause",
      "license_file": "LICENSE",
      "summary": "Create AppMap files by recording a Python application"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "appmap-agent-init = appmap.command.appmap_agent_init:run",
          "appmap-agent-status = appmap.command.appmap_agent_status:run",
          "appmap-agent-validate = appmap.command.appmap_agent_validate:run",
          "appmap-python = appmap.command.runner:run"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "ickc"
      ]
    },
    "outputs": [
      {
        "build": {
          "noarch": "python",
          "python": {
            "entry_points": [
              "appmap-agent-init = appmap.command.appmap_agent_init:run",
