        "cmake --build build-demo --target demo --parallel ${{ CPU_COUNT }}",
        "mkdir -p \"${PREFIX}/bin\"",
        "install -m 755 build-demo/meshoptdemo \"${PREFIX}/bin/meshoptdemo\""
      ]
    },
