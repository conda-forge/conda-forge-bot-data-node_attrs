  "raw_meta_yaml": "context:\n  version: \"0.46.0\"\n\npackage:\n  name: lux-cli\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/lumen-oss/lux/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 5273d09ad50a810cdae1fd883afd3e9b055c0a21c77c318c29c86e3cd7701399\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      OPENSSL_NO_VENDOR: ${{ \"1\" if unix else \"\" }} # force linking to host's (conda-forge's) OpenSSL libs on Unix\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # instruct Apple's `ld64` linker to drop unused OpenSSL symbols and to add correct `@rpath` for xtask\n      - if: osx\n        then: $env.RUSTFLAGS = $'($env.RUSTFLAGS?) -C link-arg=-Wl,-dead_strip_dylibs -C link-arg=-Wl,-rpath,($prefix)/lib' | str trim\n      # build main app and generate license data\n      - cd lux-cli\n      - if: win\n        then: ^cargo auditable install --path=. --root=($prefix) --no-track --locked --bins --no-default-features --features=vendored\n        else: ^cargo auditable install --path=. --root=($prefix) --no-track --locked --bins\n      - ^cargo-bundle-licenses --format=yaml --output=../THIRDPARTY.yml\n      # generate shell completions and manpage\n      - if: build_platform == host_platform\n        then:\n          - ^lx util completion bash | save --force ($prefix)/share/bash-completion/completions/lx\n          - ^lx util completion fish | save --force ($prefix)/share/fish/vendor_completions.d/lx.fish\n          - ^lx util completion zsh  | save --force ($prefix)/share/zsh/site-functions/_lx\n          - ^lx util man       --target-dir=($prefix)/share/man/man1\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - cmake\n    - make\n    - nushell\n    - perl\n    - pkg-config\n  host:\n    - if: unix\n      then:\n        - gpgme\n        - libgit2\n        - libgpg-error\n        - openssl\n\ntests:\n  - script:\n      - lx --help\n      - lx --version\n  - package_contents:\n      bin:\n        - lx\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/man/man1/lx.1\n            - share/man/man1/lux*.1\n            - share/bash-completion/completions/lx\n            - share/fish/vendor_completions.d/lx.fish\n            - share/zsh/site-functions/_lx\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/man/man1/lx.1\n            - Library/share/man/man1/lux*.1\n            - Library/share/bash-completion/completions/lx\n            - Library/share/fish/vendor_completions.d/lx.fish\n            - Library/share/zsh/site-functions/_lx\n      strict: true\n\nabout:\n  summary: A luxurious package manager for Lua\n  description: |\n    Lux is a modern package manager for Lua. It manages dependencies, build steps,\n    lockfiles, Lua versions, and existing LuaRocks projects through a single CLI.\n  license: LGPL-3.0-or-later\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://lux.lumen-labs.org\n  repository: https://github.com/lumen-oss/lux\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
