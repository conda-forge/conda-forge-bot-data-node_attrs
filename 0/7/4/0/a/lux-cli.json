  "linux_64_meta_yaml": {
    "about": {
      "description": "Lux is a modern package manager for Lua. It manages dependencies, build steps,\nlockfiles, Lua versions, and existing LuaRocks projects through a single CLI.",
      "dev_url": "https://github.com/lumen-oss/lux",
      "home": "https://lux.lumen-labs.org/",
      "license": "LGPL-3.0-or-later",
      "license_family": "LGPL-3.0-or-later",
      "license_file": "LICENSE",
      "summary": "A luxurious package manager for Lua"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "cd lux-cli",
          "^cargo auditable install --path=. --root=($prefix) --no-track --locked --bins",
          "^cargo-bundle-licenses --format=yaml --output=../THIRDPARTY.yml",
          "^lx util completion bash | save --force ($prefix)/share/bash-completion/completions/lx",
          "^lx util completion fish | save --force ($prefix)/share/fish/vendor_completions.d/lx.fish",
          "^lx util completion zsh  | save --force ($prefix)/share/zsh/site-functions/_lx",
          "^lx util man       --target-dir=($prefix)/share/man/man1"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols",
          "OPENSSL_NO_VENDOR": "1"
        },
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "lux-cli",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "cxx_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "cmake",
            "make",
            "nushell",
            "perl",
            "pkg-config"
          ],
          "host": [
            "gpgme",
            "libgit2",
            "libgpg-error",
            "openssl"
          ],
          "run": []
        },
        "tests": [
          {
            "script": [
              "lx --help",
              "lx --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "lx"
              ],
              "files": [
                "share/man/man1/lx.1",
                "share/man/man1/lux*.1",
                "share/bash-completion/completions/lx",
                "share/fish/vendor_completions.d/lx.fish",
                "share/zsh/site-functions/_lx"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.46.0"
      }
    ],
