  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: bleak\n  version: \"3.1.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/bleak-${{ version }}.tar.gz\n  sha256: e37fd30c4691c908d31c8b92ca55b92a22ab924a77c35579822c859042992145\n\nbuild:\n  # Mac Os X is currently not working as - pyobjc-framework-libdispatch is missing on conda-forge\n  number: 0\n  skip: osx\n  script: ${{ PYTHON }} -m pip install . -vv\n\nrequirements:\n  host:\n    - pip\n    - python\n    - uv-build\n  run:\n    - if: win\n      then: bleak-winrt >=1.1.1\n    - if: linux\n      then: dbus-fast\n    - if: osx\n      then:\n        - pyobjc-core\n        - pyobjc-framework-corebluetooth\n        - pyobjc-framework-libdispatch\n    - python\n    - typing-extensions >=4.2.0\n    - async-timeout\n\ntests:\n  - python:\n      imports:\n        - bleak\n      pip_check: false\n  - requirements:\n      run:\n        - pip\n    script:\n      - if: not win\n        then: pip check\n\nabout:\n  summary: Bluetooth Low Energy platform Agnostic Klient\n  license: MIT\n  license_file:\n    - LICENSE\n  homepage: https://github.com/hbldh/bleak\n\nextra:\n  recipe-maintainers:\n    - carlodri\n    - jan-janssen\n",
