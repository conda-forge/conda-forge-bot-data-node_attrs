  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.0.54\"\n\npackage:\n  name: flyteidl2\n  version: ${{ version }}\n\nsource:\n  # PyPI only has a wheel. The package is built from gen/python in the flyte repo.\n  url: https://github.com/flyteorg/flyte/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 5753834b5bd12b7437a8ff344d76ad0651844e890618ab885be8581c16b6fef2\n  patches:\n    # Upstream vendors generated buf/validate code that clashes with the\n    # protovalidate package; depend on protovalidate for it instead.\n    - use-protovalidate-buf.patch\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    env:\n      SETUPTOOLS_SCM_PRETEND_VERSION: ${{ version }}\n    content:\n      # license-files in gen/python/pyproject.toml expects LICENSE next to it;\n      # the file lives at the repo root.\n      - if: unix\n        then: cp LICENSE gen/python/LICENSE\n        else: copy LICENSE gen\\python\\LICENSE\n      - ${{ PYTHON }} -m pip install ./gen/python -vv\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n    - setuptools-scm\n  run:\n    - python >=${{ python_min }}\n    - googleapis-common-protos\n    - protoc-gen-openapiv2\n    - protobuf >=4.21.1\n    # protovalidate 2 moved to the protobuf-py runtime and no longer provides\n    # buf.validate.validate_pb2, which flyteidl2 imports (see the patch).\n    - protovalidate >=1.0.0,<2\n\ntests:\n  - python:\n      imports:\n        - flyteidl2\n        - flyteidl2.common.identifier_pb2\n        - flyteidl2.core.tasks_pb2\n        - flyteidl2.task.task_definition_pb2\n        - flyteidl2.workflow.run_definition_pb2\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - files:\n      recipe:\n        - run_test.py\n    script:\n      - python run_test.py\n\nabout:\n  homepage: https://flyte.org\n  repository: https://github.com/flyteorg/flyte\n  summary: Protobuf IDL for Flyte\n  license: Apache-2.0\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - killua156\n",
