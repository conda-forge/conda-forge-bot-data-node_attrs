  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: tinyxml\n  version: \"2.6.2\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  - url: https://downloads.sourceforge.net/project/tinyxml/tinyxml/2.6.2/tinyxml_2_6_2.tar.gz\n    sha256: 15bdfdcec58a7da30adc87ac2b078e4417dbe5392f3afb719f9ba6d062645593\n    patches:\n      # These two patches are taken from the debian packaging of tinyxml.\n      #   The first patch enforces use of stl strings, rather than a custom string type.\n      #   The second patch is a fix for incorrect encoding of elements with special characters\n      #   originally posted at https://sourceforge.net/p/tinyxml/patches/51/\n      - enforce-use-stl.patch\n      - entity-encoding.patch\n      # Security fixes from Debian's tinyxml 2.6.2-7 patch stack:\n      # https://sources.debian.org/src/tinyxml/2.6.2-7/debian/patches/\n      - CVE-2021-42260.patch\n      - CVE-2023-34194.patch\n  # This adds a CMakeLists.txt file to build a shared library and provide an install target\n  # submitted upstream as https://sourceforge.net/p/tinyxml/patches/66/\n  - path: CMakeLists.txt\n  - path: tinyxml.pc.in\n\nbuild:\n  number: 4\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('cxx') }}\n    - cmake\n    - if: unix\n      then: make\n  run_exports:\n    # tinyxml had ABI changes in the patch releases, but anyhow\n    # no upstream happened in decades\n    - ${{ pin_subpackage('tinyxml', upper_bound='x.x.x') }}\n\n\ntests:\n  - script:\n      - if: unix\n        then: test -f $PREFIX/lib/lib${{ name }}$SHLIB_EXT\n      - if: unix\n        then: test -f $PREFIX/lib/pkgconfig/${{ name }}.pc\n      - if: win\n        then: if exist %PREFIX%\\\\Library\\\\bin\\\\${{ name }}%SHLIB_EXT% (exit 0) else (exit 1)\n      - if: win\n        then: if exist %PREFIX%\\\\Library\\\\lib\\\\pkgconfig\\${{ name }}.pc (exit 0) else (exit 1)\n\nabout:\n  license: Zlib\n  license_file: LICENSE\n  summary: A simple, small, C++ XML parser that can be easily integrated into other programs\n  homepage: http://www.grinninglizard.com/tinyxml\n  repository: https://www.sourceforge.net/projects/tinyxml\n\nextra:\n  recipe-maintainers:\n    - traversaro\n    - jcarpent\n    - wolfv\n",
