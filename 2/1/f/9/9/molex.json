  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.8.1\"\n\nrecipe:\n  name: molex\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/m/molex/molex-${{ version }}.tar.gz\n  sha256: 17a0db3cf9a209a20ac19b5ba0196f103d00eab84d5833b58a535b872f00137d\n\nbuild:\n  number: 0\n\noutputs:\n  # C/C++ library: libmolex.{so,dylib,dll} + static lib + molex.h / molex.hpp\n  - package:\n      name: libmolex\n    build:\n      script:\n        - if: unix\n          then:\n            - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml --features c-api\n            - cargo build --release --locked --features c-api\n            - mkdir -p $PREFIX/lib $PREFIX/include\n            - cp include/molex.h include/molex.hpp $PREFIX/include/\n            - if: osx\n              then:\n                - cp target/${CARGO_BUILD_TARGET:+$CARGO_BUILD_TARGET/}release/libmolex.dylib \"$PREFIX/lib/\"\n                - install_name_tool -id @rpath/libmolex.dylib \"$PREFIX/lib/libmolex.dylib\"\n              else:\n                - cp target/${CARGO_BUILD_TARGET:+$CARGO_BUILD_TARGET/}release/libmolex.so \"$PREFIX/lib/\"\n          else:\n            - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml --features c-api\n            - cargo build --release --locked --features c-api\n            - if not exist %LIBRARY_BIN% mkdir %LIBRARY_BIN%\n            - if not exist %LIBRARY_LIB% mkdir %LIBRARY_LIB%\n            - if not exist %LIBRARY_INC% mkdir %LIBRARY_INC%\n            - copy include\\molex.h %LIBRARY_INC%\\\n            - copy include\\molex.hpp %LIBRARY_INC%\\\n            - copy target\\%CARGO_BUILD_TARGET%\\release\\molex.dll %LIBRARY_BIN%\\\n            - copy target\\%CARGO_BUILD_TARGET%\\release\\molex.dll.lib %LIBRARY_LIB%\\molex.lib\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - ${{ compiler('rust') }}\n        - cargo-bundle-licenses\n      run_exports:\n        # 0.x: the C ABI may change with any minor version, so pin to x.x.\n        - ${{ pin_subpackage('libmolex', upper_bound='x.x') }}\n    tests:\n      - package_contents:\n          include:\n            - molex.h\n            - molex.hpp\n          lib:\n            - molex\n    about:\n      license: MIT\n      license_file:\n        - LICENSE\n        - THIRDPARTY.yml\n\n  # Python bindings, one abi3 build covering every CPython >= python_min\n  - package:\n      name: molex\n    build:\n      skip: is_abi3 and not is_python_min\n      script:\n        - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml --features python,extension-module\n        - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n      python:\n        version_independent: ${{ is_abi3 }}\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - ${{ compiler('rust') }}\n        - cargo-bundle-licenses\n        - if: build_platform != host_platform\n          then:\n            - python\n            - cross-python_${{ host_platform }}\n            - maturin >=1.7,<2\n      host:\n        - if: is_abi3\n          then: python-abi3\n        - python\n        - pip\n        - maturin >=1.7,<2\n      run:\n        - python\n        - numpy\n    tests:\n      - python:\n          imports:\n            - molex\n          python_version:\n            - if: is_abi3\n              then: ${{ python_min }}.*\n            - \"*\"\n      - if: is_abi3\n        then:\n          requirements:\n            run:\n              - abi3audit\n          script:\n            - if: unix\n              then: abi3audit $SP_DIR/molex/molex.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n              else: abi3audit %SP_DIR%\\molex\\molex.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n    about:\n      license: MIT\n      license_file:\n        - LICENSE\n        - THIRDPARTY.yml\n\nabout:\n  homepage: https://github.com/foldit-org/molex\n  repository: https://github.com/foldit-org/molex\n  documentation: https://foldit-org.github.io/molex/\n  summary: Parse, analyze, and transform molecular structure data (PDB, mmCIF, BinaryCIF, MRC)\n  license: MIT\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - petridecus\n",
