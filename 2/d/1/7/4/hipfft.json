  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: hipfft\n  version: \"7.2.4\"\n\nrecipe:\n  name: hipfft-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ROCm/rocm-libraries/releases/download/rocm-${{ version }}/hipfft.tar.gz\n  sha256: 65d08232b0f83dda214c96e869db4b68380a12a7f6526ae008ec5faf19ec30e9\n\nbuild:\n  number: 0\n  skip:\n    - not linux\n    - hip_compiler_version in (None, \"None\")\n\noutputs:\n  - staging:\n      name: hipfft-build\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ compiler('hip') }}\n        - cmake\n        - pkgconf\n        - ninja\n      host:\n        - rocm-core ${{ version }}.*\n        - rocm-cmake\n        - librocfft-devel\n    build:\n      script: build.sh\n\n  - package:\n      name: libhipfft\n    inherit: hipfft-build\n    build:\n      files:\n        include:\n          - \"**/*\"\n        exclude:\n          - include/**\n          - lib/*.a\n          - lib/cmake/**\n          - lib/pkgconfig/**\n          - share/pkgconfig/**\n          - share/doc/**\n    tests:\n      - package_contents:\n          lib:\n            - hipfft\n            - hipfftw\n\n  - package:\n      name: libhipfft-devel\n    inherit: hipfft-build\n    build:\n      files:\n        - include/**\n        - lib/*.a\n        - lib/cmake/**\n        - lib/pkgconfig/**\n        - share/pkgconfig/**\n        - share/doc/**\n    requirements:\n      run:\n        - hip-devel\n        - librocfft-devel\n        - ${{ pin_subpackage('libhipfft', exact=True) }}\n      run_exports:\n        - ${{ pin_subpackage('libhipfft', upper_bound='x.x') }}\n    tests:\n      - requirements:\n          run:\n            - cmake-package-check\n            - ${{ compiler('c') }}\n            - ${{ compiler('cxx') }}\n        script:\n          - cmake-package-check hipfft\n      - package_contents:\n          include:\n            - hipfft/hipfft.h\n\n  - package:\n      name: hipfft\n    requirements:\n      run:\n        - ${{ pin_subpackage('libhipfft-devel', exact=True) }}\n    tests:\n      - script:\n          - test -f $PREFIX/include/hipfft/hipfft.h\n\nabout:\n  homepage: https://rocm.docs.amd.com/projects/hipFFT\n  summary: hipFFT is an FFT marshalling library.\n  description: |\n    hipFFT is an FFT marshalling library that exports a common interface\n    for GPU FFT backends. On AMD GPUs it uses rocFFT as its backend.\n  license: MIT\n  license_file: LICENSE.md\n  documentation: https://rocm.docs.amd.com/projects/hipFFT/en/latest/\n  repository: https://github.com/ROCm/rocm-libraries/tree/develop/projects/hipfft\n\nextra:\n  feedstock-name: hipfft\n  recipe-maintainers:\n    - zklaus\n    - conda-forge/rocm-core\n",
