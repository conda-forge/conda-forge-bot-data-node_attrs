            "requests",
            "setuptools",
            "zc.lockfile >=2.0"
          ]
        },
        "tests": [
          {
            "package_contents": {
              "files": [
                "etc/conda/test-files/pytest-services/**"
              ],
              "site_packages": [
                "pytest_services/**",
                "pytest_services-2.3.0.dist-info/**"
