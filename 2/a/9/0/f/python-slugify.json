  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"9.1.3\"\n  python_check_max: \"3.15\"\n  summary: A Python slugify application that also handles Unicode\n  cov_run: coverage run --source=slugify --branch --append\n\nrecipe:\n  name: python-slugify-split\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/p/python-slugify/python_slugify-${{ version }}.tar.gz\n  sha256: 90e997f2e0987239ce95e12f700086eb18e1d1d3ee22624fbbdbd095afca42b6\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: python-slugify\n    build:\n      number: 0\n      noarch: python\n      script:\n        - ${{ PYTHON }} -m pip install . --no-deps -vv --no-build-isolation --disable-pip-version-check --check-build-dependencies\n      python:\n        entry_points:\n          - slugify = slugify.__main__:main\n    requirements:\n      host:\n        - pip\n        - python ${{ python_min }}.*\n        - setuptools >=77\n      run:\n        - python >=${{ python_min }}\n        - text-unidecode >=1.3\n      run_constraints:\n        # avoid these packages with conflicts in `site-packages/slugify`\n        - awesome-slugify <0\n        - slugify <0\n        # [anyascii]\n        - anyascii >=0.3.2\n        # [unidecode]\n        - unidecode >=1.1.1\n    tests:\n      - package_contents:\n          strict: true\n          site_packages:\n            - slugify/**\n            - python_slugify-${{ version }}.dist-info/**\n      - python:\n          imports: slugify\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n      - script:\n          - slugify --help\n\n  - package:\n      name: python-slugify-with-unidecode\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"python-slugify\", exact=True) }}\n        - unidecode\n    tests:\n      - python:\n          imports: slugify\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n      - files:\n          source:\n            - tests/**\n            - tools/**\n            - README.md\n        requirements:\n          run:\n            - pytest-cov\n            - python ${{ python_min }}.*\n            # anyascii only tested until testing/documentaiton for CEP-44 is resolved\n            - anyascii\n            - pip\n        script:\n          - pip check\n          - slugify --help\n          # check dynamic version\n          - python -c \"import slugify; assert slugify.__version__ == '${{ version }}'\"\n          - ${{ cov_run }} -m slugify.__main__ --help\n          - ${{ cov_run }} -m pytest -vv --tb=long --color=yes\n          - coverage report --show-missing --skip-covered --fail-under=99\n    about:\n      summary: ${{ summary }} (with [unidecode])\n\nabout:\n  license: MIT\n  license_file: LICENSE\n  summary: ${{ summary }}\n  homepage: https://pypi.org/project/python-slugify\n  repository: https://github.com/un33k/python-slugify\n\nextra:\n  feedstock-name: python-slugify\n  recipe-maintainers:\n    - proinsias\n    - sodre\n    - bollwyvl\n",
