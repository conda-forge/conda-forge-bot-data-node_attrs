  "linux_64_meta_yaml": {
    "about": {
      "description": "UniClipboard is a privacy-first clipboard tool. It keeps a searchable, encrypted history of everything you copy, brings it back instantly through the Quick Panel, and syncs text, images, and files across your devices, whether they are on the same Wi-Fi or on different networks. Clipboard content is end-to-end encrypted in transit and stays encrypted at rest; it is decrypted only on your own devices, so relays and the network in between only ever see ciphertext.",
      "dev_url": "https://github.com/UniClipboard/UniClipboard",
      "home": "https://github.com/UniClipboard/UniClipboard",
      "license": "AGPL-3.0-or-later",
      "license_family": "AGPL-3.0-or-later",
      "license_file": "LICENSE",
      "summary": "Real-time clipboard sync across all your devices — local-first, peer-to-peer, and end-to-end encrypted. No account. No cloud dependency. No central server."
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml",
          "mkdir -p \"${PREFIX}/bin\"",
          "go -C apps/cli-go build -trimpath -buildvcs=false -ldflags \"-s -w\" -o \"${PREFIX}/bin/uniclip\" ./cmd/uniclip",
          "cargo auditable install -j ${CPU_COUNT} --root \"${PREFIX}\" --path apps/daemon --locked --no-track"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "XhstormR"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "uniclip",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "rust_compiler_stub",
            "go-nocgo_compiler_stub",
            "cargo-bundle-licenses",
            "cargo-auditable",
            "pkg-config"
          ],
          "host": [
            "dbus"
          ],
          "run": []
        },
        "tests": [
          {
            "script": [
              "uniclip --version",
              "uniclip --help"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "uniclip",
                "uniclipd"
              ],
              "strict": true
            }
          }
        ],
        "version": "1.2.0"
      }
    ],
