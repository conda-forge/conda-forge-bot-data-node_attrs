  "raw_meta_yaml": "context:\n  version: \"1.2.0\"\n\npackage:\n  name: uniclip\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/UniClipboard/UniClipboard/archive/v${{ version }}.tar.gz\n  sha256: ac3890cde2898fb4b12e5b53f7ab3019d52c57a09f212ab71f8228c1b27694dd\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n      - if: unix\n        then:\n          - mkdir -p \"${PREFIX}/bin\"\n          - go -C apps/cli-go build -trimpath -buildvcs=false -ldflags \"-s -w\" -o \"${PREFIX}/bin/uniclip\" ./cmd/uniclip\n          - cargo auditable install -j ${CPU_COUNT} --root \"${PREFIX}\" --path apps/daemon --locked --no-track\n        else:\n          - if not exist \"%PREFIX%\\bin\" mkdir \"%PREFIX%\\bin\"\n          - go -C apps/cli-go build -trimpath -buildvcs=false -ldflags \"-s -w\" -o \"%PREFIX%\\bin\\uniclip.exe\" ./cmd/uniclip\n          - cargo auditable install -j %CPU_COUNT% --root \"%PREFIX%\" --path apps/daemon --locked --no-track\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    - ${{ compiler(\"go-nocgo\") }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - if: linux\n      then: pkg-config\n  host:\n    - if: linux\n      then: dbus\n\ntests:\n  - script:\n      - uniclip --version\n      - uniclip --help\n  - package_contents:\n      strict: true\n      bin:\n        - uniclip\n        - uniclipd\n\nabout:\n  homepage: https://github.com/UniClipboard/UniClipboard\n  summary: \"Real-time clipboard sync across all your devices — local-first, peer-to-peer, and end-to-end encrypted. No account. No cloud dependency. No central server.\"\n  description: |\n    UniClipboard is a privacy-first clipboard tool. It keeps a searchable, encrypted history of everything you copy, brings it back instantly through the Quick Panel, and syncs text, images, and files across your devices, whether they are on the same Wi-Fi or on different networks. Clipboard content is end-to-end encrypted in transit and stays encrypted at rest; it is decrypted only on your own devices, so relays and the network in between only ever see ciphertext.\n  license: AGPL-3.0-or-later\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  repository: https://github.com/UniClipboard/UniClipboard\n\nextra:\n  recipe-maintainers:\n    - XhstormR\n",
