  "raw_meta_yaml": "{% set name = \"conduit\" %}\n{% set version = \"0.9.10\" %}\n{% set sha256 = \"d1cbbdf3c202d6c5a82397fa1d6604bc5a4883e6129004cc9fc62ac33812511a\" %}\n\npackage:\n  name: {{ name }}\n  version: {{ version }}\n\nsource:\n  url: https://github.com/LLNL/conduit/releases/download/v{{ version }}/conduit-v{{ version }}-src-with-blt.tar.gz\n  sha256: {{ sha256 }}\n  patches:\n    # backport of LLNL/conduit#1730: pip install -v, not -V (an error since pip 26.3)\n    - 0001-pip-v-instead-of-V.patch\n    # backport of LLNL/conduit#1732: backslash (Windows) paths and spaces in python\n    # paths broke the install with CMake >= 4 and the installed ConduitConfig.cmake\n    - 0002-python-paths-backslashes-spaces.patch\n    # backport of LLNL/conduit#1733: link HDF5's system libraries by name, not by\n    # absolute paths into the build environment's sysroot\n    - 0003-hdf5-system-libs-by-name.patch\n\nbuild:\n  number: 0\n  skip: true  # [win and vc<14]\n\nrequirements:\n  build:\n    - {{ compiler('c') }}\n    - {{ stdlib(\"c\") }}\n    - {{ compiler('cxx') }}\n    - {{ compiler(\"fortran\") }}\n    - make                       # [linux]\n    - cmake\n  host:\n    - {{ mpi }}  # [mpi != 'nompi']\n    - libpython-static  # [py>=38]\n    - python\n    - pip\n    - setuptools >=68\n    - wheel\n    - numpy\n    - openssl\n    - hdf5\n    - zlib\n  run:\n    - {{ mpi }}  # [mpi != 'nompi']\n    - python\n    - zlib\n\ntest:\n  files:\n    - test/\n  requires:\n    - numpy\n    - cmake\n    - ninja\n    - {{ compiler('c') }}\n    - {{ stdlib(\"c\") }}\n    - {{ compiler('cxx') }}\n  commands:\n    - test -f $PREFIX/lib/libconduit.dylib  # [osx]\n    - test -f $PREFIX/lib/libconduit.so     # [linux]\n    - if not exist %PREFIX%\\\\Library\\\\lib\\\\conduit.lib exit 1  # [win]\n    # smoke test: find_package(Conduit) in a downstream CMake project\n    - cmake -S test -B build-test -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH:PATH=$PREFIX  # [unix]\n    - cmake -S test -B build-test -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH:PATH=%LIBRARY_PREFIX%  # [win]\n    - cmake --build build-test\n    - ./build-test/conduit_smoke  # [unix]\n    - build-test\\conduit_smoke.exe  # [win]\n  imports:\n    - conduit\n    - conduit.relay\n    - conduit.blueprint\nabout:\n  home: https://github.com/LLNL/conduit\n  license: BSD-3-Clause\n  license_family: BSD\n  license_file: LICENSE\n  summary: Simplified Data Exchange for HPC Simulations\n\n  description: |\n    Conduit is an open source project from Lawrence Livermore National\n    Laboratory that provides an intuitive model for describing hierarchical\n    scientific data in C++, C, Fortran, and Python. It is used for data\\\n    coupling between packages in-core, serialization, and I/O tasks.\n  doc_url: https://software.llnl.gov/conduit\n  dev_url: https://github.com/LLNL/conduit\n\nextra:\n  recipe-maintainers:\n    - ax3l\n    - cyrush\n",
