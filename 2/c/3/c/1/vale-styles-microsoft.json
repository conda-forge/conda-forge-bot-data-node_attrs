  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.15.2\"\n  vale_name: Microsoft\n  summary: Microsoft rules for vale grammar and style checker\n  # well-known\n  styles: share/vale/styles\n  # os\n  export: ${{ \"export\" if unix else \"set \"}}\n  mkdir_p: ${{ \"mkdir -p\" if unix else \"md\" }}\n  slash: ${{ \"/\" if unix else \"\\\\\" }}\n  cp_r: ${{ \"cp -r\" if unix else \"copy\" }}\n  os_styles: ${{ slash }}${{ styles | split(\"/\") | join(slash) }}${{ slash }}\n\npackage:\n  name: vale-styles-microsoft\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/errata-ai/${{ vale_name }}/releases/download/v${{ version }}/${{ vale_name }}.zip\n  sha256: c696d462128a4440b66d0ca1e8f2de38660209a3134d1ba7ea55ac1a75b7a2b6\n  target_directory: ${{ vale_name }}\n\nbuild:\n  number: 0\n  noarch: generic\n  script:\n    - ${{ mkdir_p }} \"${{ PREFIX }}${{ os_styles }}}\"\n    - ${{ cp_r }} \"${{ vale_name }}\" \"${{ PREFIX }}${{ os_styles }}${{ slash }}${{ vale_name }}\"\n\nrequirements:\n  run:\n    - vale\n\ntests:\n  - package_contents:\n      strict: true\n      files:\n        - ${{ styles }}/${{ vale_name }}/*.yml\n        - ${{ styles }}/${{ vale_name }}/LICENSE\n        - ${{ styles }}/${{ vale_name }}/meta.json\n  - requirements:\n      run:\n        - pytest\n    script:\n      env:\n        VALE_PKG_NAME: ${{ vale_name }}\n      file: run_test.py\n\nabout:\n  license: MIT\n  license_file: ${{ vale_name }}/LICENSE\n  summary: ${{ summary }}\n  homepage: https://github.com/errata-ai/${{ vale_name }}\n\nextra:\n  recipe-maintainers:\n    - bollwyvl\n",
