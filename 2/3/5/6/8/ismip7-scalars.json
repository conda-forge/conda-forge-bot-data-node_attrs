  "linux_64_meta_yaml": {
    "about": {
      "description": "ismip7-scalars turns gridded ISMIP7 ice sheet model output into the scalar\ntime series the community compares: three sea-level contributions, four\nstate scalars and six integrated mass fluxes, for the whole ice sheet and\noptionally for each IMBIE3 basin.  It covers Antarctica (AIS) and\nGreenland (GrIS), and writes each scalar with the standard name, units and\nlong name fixed by the ISMIP7 data request.",
      "dev_url": "https://github.com/ismip/ismip7-scalar-processing",
      "doc_url": "https://ismip.github.io/ismip7-scalar-processing/",
      "home": "https://github.com/ismip/ismip7-scalar-processing",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Sea-level contributions and other scalar diagnostics from ISMIP7 ice sheet model output"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "ismip7-scalars = ismip7_scalars.scalars:main",
          "ismip7-scalars-ensemble = ismip7_scalars.ensemble:main",
          "ismip7-scalars-set-params = ismip7_scalars.params:main"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "xylar"
      ]
    },
    "outputs": [
      {
        "build": {
          "noarch": "python",
          "python": {
            "entry_points": [
              "ismip7-scalars = ismip7_scalars.scalars:main",
              "ismip7-scalars-ensemble = ismip7_scalars.ensemble:main",
              "ismip7-scalars-set-params = ismip7_scalars.params:main"
            ]
          }
        },
        "name": "ismip7-scalars",
        "requirements": {
          "build": [],
          "host": [
            "python 3.11.*",
            "setuptools >=77",
            "pip"
          ],
          "run": [
            "python >=3.11,<3.15",
            "numpy >=2.1,<3",
            "netcdf4 >=1.7,<2",
            "isschecker >=0.2,<1",
            "__unix"
          ]
        },
        "tests": [
          {
            "python": {
