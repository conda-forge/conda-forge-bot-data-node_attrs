  "linux_64_meta_yaml": {
    "about": {
      "description": "tera-cli (providing the `tera` command) is a command-line utility built on\ntop of the Rust-based [Tera](https://keats.github.io/tera/) templating\nengine inspired by Jinja2 and Django. It merges structured context data\n(from JSON, YAML, or TOML files) and system environment variables into\ntemplate files to generate rendered outputs.",
      "dev_url": "https://github.com/chevdor/tera-cli",
      "home": "https://github.com/chevdor/tera-cli",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "CLI for rendering Tera templates using JSON, YAML, TOML, and environment variables"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "cargo auditable install --path=. --root=($prefix) --no-track --locked --bins --features=full",
          "cargo-bundle-licenses --format=yaml --output=THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        },
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "tera-cli",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "nushell"
          ],
          "host": [],
          "run": []
        },
