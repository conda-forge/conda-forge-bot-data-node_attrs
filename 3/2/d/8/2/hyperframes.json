    "about": {
      "description": "HyperFrames renders motion graphics programmatically: compositions are a\npure function of frame index, so output is frame-deterministic and\nreproducible. It ships a block catalog (code animations, transitions,\ncaption styles, lower thirds, social cards, data-viz, 3D device mockups),\nfootage-facing effects such as colour grading, grain and background\nremoval, and HDR10 / 4K delivery. Rendering runs locally.\n\nThis package provides the ``hyperframes`` command line interface.",
      "dev_url": "https://github.com/heygen-com/hyperframes",
      "home": "https://github.com/heygen-com/hyperframes",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Frame-deterministic motion-graphics engine and CLI for programmatic video"
    },
    "build": {
      "number": "0",
      "script": [
        "export npm_config_prefix=\"${PREFIX}\"",
        "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));delete p.devDependencies;fs.writeFileSync('package.json',JSON.stringify(p,null,2));\"",
        "pnpm install --ignore-scripts --prod",
        "npm pack --ignore-scripts",
        "npm install --no-bin-links -g ./hyperframes-${{ version }}.tgz",
        "pnpm-licenses generate-disclaimer --prod --output-file=third-party-licenses.txt",
        "mkdir -p \"${PREFIX}/bin\"",
        "cat > \"${PREFIX}/bin/hyperframes\" << 'EOF'\n#!/bin/sh\nexec \"${CONDA_PREFIX}/bin/node\" \"${CONDA_PREFIX}/lib/node_modules/hyperframes/bin/hyperframes.mjs\" \"$@\"\nEOF\n",
        "chmod +x \"${PREFIX}/bin/hyperframes\"",
        "cat > \"${PREFIX}/bin/hyperframes.cmd\" << 'EOF'\n@call \"%CONDA_PREFIX%\\bin\\node\" \"%CONDA_PREFIX%\\lib\\node_modules\\hyperframes\\bin\\hyperframes.mjs\" %*\nEOF\n"
      ]
    },
    "extra": {
