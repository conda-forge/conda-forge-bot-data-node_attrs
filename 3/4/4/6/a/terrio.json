  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: terrio\n  version: \"0.5.0\"\n  python_min: \"3.12\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name }}-${{ version }}.tar.gz\n  sha256: 967d87125797031ff62f3acbb60c5c697e0d2cdaca2ed4c9306689b201c81dfd\n\nbuild:\n  number: 0\n  skip: is_abi3 and not is_python_min\n  script:\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - terrio = terrio.__main__:main\n      - terrio-rio = terrio.rio.cli:main\n    version_independent: ${{ true if is_abi3 }}\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python ${{ python_min }}.*\n        - cross-python_${{ target_platform }} ${{ python_min }}.*\n        - crossenv\n        - maturin >=1.9,<2\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n  host:\n    - if: is_abi3\n      then: python-abi3\n    - python ${{ python_min }}.*\n    - maturin >=1.9,<2\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - numpy >=1.21\n    - affine >=2.3\n  run_constraints:\n    - geopandas >=0.14\n    - matplotlib-base >=3.5\n    - xarray >=2024.1\n    - dask-core >=2024.1\n\ntests:\n  - python:\n      imports:\n        - terrio\n        - terrio.rio\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n        - if: is_abi3\n          then: abi3audit\n    script:\n      - python -c \"import terrio; print(terrio.__version__); assert terrio.__version__ == '${{ version }}'\"\n      - terrio --help\n      - terrio-rio --help\n      - if: unix and is_abi3\n        then: abi3audit $SP_DIR/terrio/_terrio.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n      - if: win and is_abi3\n        then: abi3audit %SP_DIR%/terrio/_terrio.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  homepage: https://terrio.opengeos.org\n  repository: https://github.com/opengeos/terrio\n  documentation: https://terrio.opengeos.org\n  summary: Pure-Rust geospatial raster, vector and point cloud data I/O, without GDAL\n  description: |\n    terrio reads, writes, converts and reprojects the geospatial raster, vector and point cloud\n    formats most workflows use, in pure Rust and without GDAL. This package provides its Python\n    bindings, the rasterio-like terrio.rio API, an xarray backend, and the terrio command line.\n  license: MIT\n  license_file:\n    - LICENSE\n    - NOTICE\n    - LICENSE-THIRD-PARTY.md\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - giswqs\n",
