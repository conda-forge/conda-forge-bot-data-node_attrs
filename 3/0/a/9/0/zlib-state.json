  "raw_meta_yaml": "context:\n  version: \"0.1.12\"\n\npackage:\n  name: zlib-state\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/z/zlib-state/zlib_state-${{ version }}.tar.gz\n  sha256: ccbb06321daf165b022aa4d22d62effb7df76f55035d50bbe8b93696db416cf0\n  patches:\n    # Upstream hardcodes an absolute Windows include path (\"C:/Program Files/zlib/include/zlib.h\")\n    # instead of using the system include search path, so zlib.h is never found in a conda env.\n    - patches/0001-fix-windows-zlib-include-path.patch\n    # Upstream falls back to a hardcoded, non-existent \"C:/Program Files/zlib/bin\" for\n    # os.add_dll_directory() on Windows, which raises FileNotFoundError on import in any\n    # environment that doesn't have zlib installed there (i.e. every conda environment).\n    - patches/0002-fix-windows-dll-directory-fallback.patch\n\nbuild:\n  number: 0\n  script:\n    - if: win\n      then:\n        - set \"ZLIB_HOME=%LIBRARY_PREFIX%\"\n        - ${{ PYTHON }} -m pip install . -vv\n      else:\n        - ${{ PYTHON }} -m pip install . -vv\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n  host:\n    - python\n    - pip\n    - setuptools\n    - zlib\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n      - zlib_state\n      pip_check: true\n\nabout:\n  homepage: https://github.com/seanmacavaney/zlib-state\n  summary: Low-level interface to the zlib library that enables capturing the decoding state\n  description: |\n    zlib-state provides a low-level Python interface to the zlib library\n    that allows the decompression state to be captured and later restored.\n    This makes it possible to efficiently seek into gzip-compressed files\n    at arbitrary deflate block boundaries without having to decompress\n    from the start of the file each time.\n  license: MIT\n  license_file: LICENSE\n  repository: https://github.com/seanmacavaney/zlib-state\n\nextra:\n  recipe-maintainers:\n    - pb01ka\n",
