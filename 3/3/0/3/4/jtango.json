  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"10.0.1\"\n\nrecipe:\n  name: jtango-split\n  version: ${{ version }}\n\nsource:\n  url: https://gitlab.com/tango-controls/JTango/-/archive/${{ version }}/JTango-${{ version }}.tar.gz\n  sha256: 47de26e50a9d630c1f2b42026d1dceafa48b64424c888327c05468e91946369b\n\nbuild:\n  number: 0\n\noutputs:\n  - staging:\n      name: jtango-build\n    requirements:\n      build:\n        - openjdk 11.*\n        - maven\n    build:\n      script:\n        env:\n          JTANGO_VERSION: ${{ version }}\n        file: build\n\n  - package:\n      name: jtango-logback\n    inherit:\n      from: jtango-build\n      run_exports: false\n    build:\n      script:\n        file: install-logback\n    tests:\n      - package_contents:\n          files:\n            exists:\n              - share/tango/logback.xml\n              - share/tango/logback-server.xml\n            not_exists:\n              - share/java/JTango.jar\n  - package:\n      name: jtango\n    inherit: jtango-build\n    build:\n      script:\n        env:\n          JTANGO_VERSION: ${{ version }}\n        file: install-jar\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"jtango-logback\", exact=True) }}\n        - openjdk >=11\n    tests:\n      - package_contents:\n          files:\n            - share/java/JTango.jar\n            - if: unix\n              then:\n                - share/java/JTango-${{ version }}.jar\n\nabout:\n  license: LGPL-3.0-or-later\n  license_file:\n    - LICENSE\n    - aggregate-third-party-report.html\n  summary: TANGO kernel Java implementation.\n  description: |\n    TANGO kernel Java implementation.\n    Tango-Controls is a software toolkit for building control systems.\n  homepage: https://www.tango-controls.org\n  repository: https://gitlab.com/tango-controls/JTango\n  documentation: https://jtango.readthedocs.io/\n\nextra:\n  feedstock-name: jtango\n  recipe-maintainers:\n    - beenje\n",
