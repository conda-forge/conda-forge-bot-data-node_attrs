  "raw_meta_yaml": "context:\n  version: \"2.0.28\"\n\npackage:\n  name: autohotkey\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/AutoHotkey/AutoHotkey/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 4520c28768080941342fd75f0ca1f294a6b80840fb9a04243d289ba080696d63\n  patches:\n    # The release tarball has no .git directory, so the version cannot be read via\n    # `git describe`. Allow it to be supplied through /p:RawAhkVersion instead.\n    - ahkversion.patch\n\nbuild:\n  number: 0\n  skip: not win\n  script: build.bat\n\nrequirements:\n  build:\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n\ntests:\n  - files:\n      recipe:\n        - run_test.ahk\n        - run_test.bat\n    script:\n      - run_test.bat\n\nabout:\n  homepage: https://www.autohotkey.com/\n  repository: https://github.com/AutoHotkey/AutoHotkey\n  summary: Macro-creation and automation software utility for Windows\n  description: |\n    AutoHotkey is a free, open source macro-creation and automation software\n    utility that allows users to automate repetitive tasks. It is driven by a\n    custom scripting language that has special provision for defining keyboard\n    shortcuts, otherwise known as hotkeys.\n  license: GPL-2.0-or-later AND BSD-3-Clause\n  license_file:\n    - license.txt\n    - source/lib_pcre/pcre/LICENCE\n\nextra:\n  recipe-maintainers:\n    - ytausch\n",
