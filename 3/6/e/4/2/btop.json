  "raw_meta_yaml": "context:\n  version: \"1.4.8\"\n\npackage:\n  name: btop\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/aristocratos/btop/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 67e07c21b770a6d884c5e50ba1d2cfc90732ea57459367d8732ec7ecbeb3be5f\n  patches:\n    # Remove after a release containing https://github.com/aristocratos/btop/pull/1819.\n    - patches/0001-fix-linux-gpu-build.patch\n\nbuild:\n  number: 0\n  skip: [win]\n  script:\n    - if: osx\n      then:\n        - export CXXFLAGS=\"${CXXFLAGS} -D_LIBCPP_DISABLE_AVAILABILITY -DkIOMainPortDefault=kIOMasterPortDefault\"\n    # Conda exports ARCH=64, which overrides btop's x86_64 auto-detection.\n    - if: linux and x86_64\n      then: make -j$CPU_COUNT CXX=$CXX ARCH=x86_64 STRIP=true\n      else: make -j$CPU_COUNT CXX=$CXX STRIP=true\n    - make -j$CPU_COUNT PREFIX=$PREFIX install\n\nrequirements:\n  build:\n    - make\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n\ntests:\n  - script:\n      - btop --version\n      - if: linux and x86_64\n        then: btop --version | grep \"GPU_SUPPORT=true\"\n\nabout:\n  homepage: https://github.com/aristocratos/btop\n  repository: https://github.com/aristocratos/btop\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n  summary: Resource monitor that shows usage and stats for processor, memory, disks, network and processes.\n\nextra:\n  recipe-maintainers:\n    - wolfv\n",
