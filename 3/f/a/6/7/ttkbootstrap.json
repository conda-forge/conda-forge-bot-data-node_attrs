  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.2.3\"\n\npackage:\n  name: ttkbootstrap\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/t/ttkbootstrap/ttkbootstrap-${{ version }}.tar.gz\n  sha256: 31b71ca273e2cd2fc354f9f736498bb334209703aea22a0abc076b6231dcfc0f\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv\n  python:\n    entry_points:\n      - ttkbootstrap = ttkbootstrap.cli:main\n      - ttkb = ttkbootstrap.cli:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools >=61\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - pillow >=10,<13\n\ntests:\n  # conda-forge's tk links libX11 without depending on xorg-libx11, so it\n  # must be provided explicitly for tkinter to import on Linux.\n  # c.f. https://github.com/conda-forge/tk-feedstock/issues/79\n  # The python test type does not support extra requirements, so use script\n  # tests for the imports.\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n        - pip\n        - if: linux\n          then: xorg-libx11\n    script:\n      - python -c \"import ttkbootstrap, ttkcreator\"\n      - pip check\n      - ttkbootstrap --help\n      - ttkb --help\n\n  - requirements:\n      run:\n        - python\n        - if: linux\n          then: xorg-libx11\n    script:\n      - python -c \"import ttkbootstrap, ttkcreator\"\n\nabout:\n  summary: Modern themes for Tkinter.\n  description: |\n    Sleek, responsive styles inspired by Bootstrap.\n    Includes ready-to-use widgets, 30+ themes, and tools for building\n    beautiful, cross-platform desktop apps with ease.\n  license: MIT\n  license_file:\n    - LICENSE\n    - src/ttkbootstrap/assets/icons/LICENSE\n  homepage: https://github.com/israel-dryer/ttkbootstrap\n  repository: https://github.com/israel-dryer/ttkbootstrap\n  documentation: https://www.ttkbootstrap.org/\n\nextra:\n  recipe-maintainers:\n    - matthewfeickert\n",
