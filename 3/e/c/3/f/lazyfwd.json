  "raw_meta_yaml": "context:\n  version: \"0.1.1\"\n\npackage:\n  name: lazyfwd\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/glattziehen/lazyfwd/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 800226118087c2caa5d21885e0c6d4c9a9507bfecb47e2cd43af7b92e0351756\n    target_directory: src\n  # go-localereader (Windows-only dependency) added its LICENSE after its last tag\n  - if: win\n    then:\n      url: https://raw.githubusercontent.com/mattn/go-localereader/2491eb6c1c75720122ef321ed7acc3a8d9de95b1/LICENSE\n      sha256: dceede03550621e65ec7b79fcba87cf6dbb9d31132a8ae71a8fe8ceec0af7da3\n      file_name: LICENSE\n      target_directory: go-localereader-license\n\nbuild:\n  number: 0\n  script:\n    - cd src\n    - if: unix\n      then:\n        - go-licenses save . --save_path ../library_licenses\n        - go build -v -o $PREFIX/bin/lazyfwd -ldflags=\"-s -w\" .\n      else:\n        - go-licenses save . --save_path ../library_licenses --ignore github.com/mattn/go-localereader\n        - mkdir ..\\library_licenses\\github.com\\mattn\\go-localereader\n        - copy ..\\go-localereader-license\\LICENSE ..\\library_licenses\\github.com\\mattn\\go-localereader\\LICENSE\n        - go build -v -o %LIBRARY_BIN%\\lazyfwd.exe -ldflags=\"-s\" .\n\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n\ntests:\n  - script:\n      - lazyfwd --version\n      - if: unix\n        then: lazyfwd --version | grep ${{ version }}\n  - package_contents:\n      bin:\n        - lazyfwd\n      strict: true\n\nabout:\n  homepage: https://github.com/glattziehen/lazyfwd\n  summary: Keyboard-first TUI for managing SSH port forwards\n  description: |\n    lazyfwd is a terminal UI for starting, stopping, and monitoring SSH port\n    forwards. It drives the system ssh, so your SSH config, agent, and\n    ProxyJump work as usual.\n  license: MIT\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n  repository: https://github.com/glattziehen/lazyfwd\n\nextra:\n  recipe-maintainers:\n    - moritzwilksch\n    - pavelzw\n",
