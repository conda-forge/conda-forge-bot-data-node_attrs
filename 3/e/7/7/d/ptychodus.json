  "raw_meta_yaml": "{% set python_min = \"3.11\" %}\n{% set name = \"ptychodus\" %}\n{% set version = \"1.7.0\" %}\n\npackage:\n  name: ptychodus-split\n  version: {{ version }}\n\nsource:\n  url: https://github.com/AdvancedPhotonSource/ptychodus/archive/refs/tags/v{{ version }}.zip\n  sha256: 15a1a83520442855e56a6451c80a2f17ce85418b3a8327643fa557aaf4c93aa0\n\nbuild:\n  number: 0\n\noutputs:\n  # all optional packages\n  - name: ptychodus-all\n\n    build:\n      noarch: generic\n\n    requirements:\n      run:\n        - {{ pin_subpackage('ptychodus', exact=True) }}\n\n    test:\n      imports:\n        - ptychodus\n      requires:\n        - pip\n      commands:\n        #- pip check\n        - ptychodus --version\n\n  # with QT\n  - name: ptychodus\n\n    build:\n      noarch: generic\n\n    requirements:\n      run:\n        - {{ pin_subpackage('ptychodus-core', exact=True) }}\n        - pyqt\n\n    test:\n      imports:\n        - ptychodus\n      requires:\n        - pip\n      commands:\n        #- pip check\n        - ptychodus --version\n\n  # ptychodus without QT (headless) without optional packages\n  - name: ptychodus-core\n\n    script: build-core.sh\n\n    build:\n      noarch: python\n      entry_points:\n        - convert-to-ptychodus = ptychodus.cli.convert_to_ptychodus:main\n        - ptychodus = ptychodus.__main__:main\n        - ptychodus-bdp = ptychodus.cli.bdp:main\n        - ptychodus-system-check = ptychodus.cli.system_check:main\n\n    requirements:\n      host:\n        - pip\n        - python {{ python_min }}\n        - setuptools >=80\n        - setuptools_scm >=9.2\n      run:\n        - colorcet\n        - h5py >=3\n        - hdf5plugin\n        - httpx\n        - matplotlib-base\n        - mlflow-skinny\n        - numpy\n        # conda-only dep with no counterpart in upstream pyproject.toml:\n        # conda-forge's pydantic-ai is a thin wrapper over pydantic-ai-slim and\n        # mirrors none of PyPI's provider extras, so the OpenAI provider that\n        # ptychodus selects at runtime is otherwise missing. Do not remove.\n        - openai\n        - psutil\n        - pydantic\n        - pydantic-ai >=1.0,<3\n        - python >={{ python_min }}\n        - pyyaml\n        - scikit-image\n        - scikit-learn\n        - scipy\n        - tifffile\n        - watchdog\n      run_constrained:\n        - globus-sdk >=4.5.0\n        - globus-compute-sdk\n        - pyqt =5.*\n\n    test:\n      imports:\n        - ptychodus\n      requires:\n        - pip\n        - python {{ python_min }}\n      commands:\n        #- pip check\n        - ptychodus --version\n        # One line per entry point: conda-build generates these wrappers from the\n        # list above, so an upstream module rename ships broken binaries while a\n        # test that only runs `ptychodus --version` stays green.\n        - convert-to-ptychodus --help\n        - ptychodus-bdp --help\n        - ptychodus-system-check --help\n\nabout:\n  home: https://github.com/AdvancedPhotonSource/ptychodus\n  summary: Ptychodus is a ptychography data pipeline application.\n  license: BSD-3-Clause\n  license_family: BSD\n  license_file: LICENSE\n  dev_url: https://github.com/AdvancedPhotonSource/ptychodus\n\nextra:\n  recipe-maintainers:\n    - AdvancedPhotonSource/ptychodus\n    - carterbox\n    - stevehenke\n",
