  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: FreeFem\n  version: \"4.17\"\n  build_num: 1\n  # nompi gets +100 so the solver prefers it by default\n  # https://conda-forge.org/docs/maintainer/knowledge_base/#preferring-a-provider-usually-nompi\n  build_number: ${{ build_num + 100 if mpi == \"nompi\" else build_num }}\n  # build string prefix so dependents can select a variant:\n  #   `freefem * mpi_mpich_*`, `freefem * mpi_*`, `freefem * nompi_*`\n  mpi_prefix: ${{ \"nompi\" if mpi == \"nompi\" else \"mpi_\" ~ mpi }}\n\npackage:\n  name: ${{ name | lower }}\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/${{ name }}/${{ name }}-sources/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: b1198448c0394d42d8371e398aee209a92a50067082d866cdf5f11f56a636835\n    patches:\n      - Makefile.am_conda.patch\n      - Makefile.am_src_bin-win32_conda.patch\n      # NLopt>=2.9 removed LD_LBFGS_NOCEDAL\n      - ff-NLopt_nlopt-2.9.patch\n      # HDF5>=2 h5cc -showconfig lists libs ';'-separated\n      - ax_lib_hdf5_cmake-lists.patch\n      # detect conda-forge superlu/scotch/mmg/gmm (SuperLu, scotch, mmg, ilut plugins)\n      - configure.ac_conda-layout.patch\n      # 3rdparty/getall: HPDDM v2.4.1 (the version PETSc 3.26 uses) instead of a 2021 commit that\n      # doesn't compile against PETSc >= 3.17 (PetscOptionsBegin is now a statement macro)\n      - getall_hpddm-2.4.1.patch\n      # upstream bacfd971c9 (PETSc-code.hpp part): HPDDM 2.4.1 removed Wrapper<T>::d__1\n      - PETSc-code_petsc-3.26.patch\n      # PCHPDDM calls guarded by defined(PCHPDDM) (always true) instead of PETSC_HAVE_HPDDM;\n      # conda-forge's PETSc has no HPDDM, so PETSc.so failed to load (undefined PCHPDDMSetAuxiliaryMat)\n      - PETSc-code_PCHPDDM-guard.patch\n      # make check: drop hpddm/mf-2d-SLEPc.edp (singular-vector comparison fails with -np 4) and\n      # ffddm tests that need PETSc-complex/bemtool but are only gated on PETSC\n      - examples_skip-unsupported-tests.patch\n      # installed FreeFem++ never found its freefem++.pref (so no plugin could be loaded): GCC folds\n      # the build-time length of FF_PREFIX_DIR, which breaks when conda relocates the prefix\n      - environment_relocatable-prefix.patch\n      # make check: CPU ulimit (60 s) and MPIEXEC_TIMEOUT (50 s) overridable (FF_TEST_*)\n      - test-driver-ff_cpu-limit.patch\n  # HPDDM (header-only, not packaged on conda-forge) is needed by the PETSc/SLEPc/hpddm plugins.\n  # It is placed where 3rdparty/getall expects it. getall's md5 check (patched above) accepts it,\n  # so --enable-download_hpddm uses it without network access.\n  - if: mpi != \"nompi\"\n    then:\n      url: https://codeload.github.com/hpddm/hpddm/zip/refs/tags/v2.4.1\n      sha256: 8c9bbd522900efaa5da25572b2718fc8f8b47a435023d242314adedc9de91727\n      file_name: hpddm.zip\n      target_directory: 3rdparty/pkg\n\nbuild:\n  number: ${{ build_number }}\n  script:\n    file: build.sh\n    env:\n      mpi: ${{ mpi }}\n  string: ${{ mpi_prefix }}_h${{ hash }}_${{ build_number }}\n  skip:\n    - osx\n    - win\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('fortran') }}\n    - autoconf\n    - automake\n    - bison\n    - flex\n    - m4\n    - make\n    # HDF5>=2 h5cc is a pkg-config wrapper\n    - pkg-config\n    - patch\n    - unzip\n  host:\n    - arpack\n    - fftw\n    - gmm\n    - gsl\n    - freeglut\n    - nlopt\n    - metis\n    - if: mpi == \"nompi\"\n      then:\n        - mumps-seq\n        # ipopt needs mumps-seq, which can't coexist with petsc's mumps-mpi (mumps-feedstock#144)\n        - ipopt\n      else:\n        - mumps-mpi\n        - ${{ mpi }}\n        # PETSc/SLEPc plugins only exist in plugin/mpi\n        - petsc\n        - slepc\n        # parmetis/scalapack only exist as MPI builds; FreeFEM only uses them in plugin/mpi\n        - parmetis\n        - scalapack\n    - mmgsuite\n    - scotch\n    - hdf5\n    - libblas\n    - libcblas\n    - liblapack\n    - suitesparse\n    - superlu\n    - tetgen\n    - zlib\n    - zstd\n  run:\n    - if: mpi != \"nompi\"\n      then: ${{ mpi }}\n    - ${{ pin_compatible('hdf5', upper_bound='x.x') }}\n  run_exports:\n    - ${{ pin_subpackage('freefem', upper_bound='x.x', build=mpi_prefix ~ '_*') }}\n\ntests:\n  - package_contents:\n      bin:\n        - FreeFem++\n        - FreeFem++-nw\n        - ff-c++\n        - ff-get-dep\n        - ff-pkg-download\n  - script:\n      - FreeFem++ -nw $PREFIX/share/FreeFEM/${{ version }}/examples/tutorial/beam.edp\n      - FreeFem++ -nw $PREFIX/share/FreeFEM/${{ version }}/examples/3dSurf/buildMeshSfromMesh3.edp\n      # an installed plugin loads (needs the relocated freefem++.pref lookup)\n      - FreeFem++ -nw $PREFIX/share/FreeFEM/${{ version }}/examples/plugin/ilut.edp\n      # MPI variants: the installed PETSc/SLEPc/hpddm plugins load and solve\n      - if: mpi != \"nompi\"\n        then:\n          - ff-mpirun -np 2 $PREFIX/share/FreeFEM/${{ version }}/examples/hpddm/diffusion-2d-PETSc.edp -nw\n          - ff-mpirun -np 2 $PREFIX/share/FreeFEM/${{ version }}/examples/hpddm/laplace-2d-SLEPc.edp -nw\n          - ff-mpirun -np 2 $PREFIX/share/FreeFEM/${{ version }}/examples/hpddm/diffusion-substructuring-2d.edp -nw\n\nabout:\n  homepage: https://freefem.org/\n  # LGPL-3.0-or-later: HPDDM headers compiled into the MPI variants' plugins\n  license: LGPL-3.0-only AND LGPL-3.0-or-later\n  license_file:\n    - LICENSE.txt\n    - if: mpi != \"nompi\"\n      then: 3rdparty/include/hpddm/LICENSE.md\n  summary: 'FreeFem : A high level multiphysics finite element software'\n  description: >\n    FreeFEM is a popular 2D and 3D partial differential equations (PDE) solver used by\n    thousands of researchers across the world. It allows you to easily implement your own\n    physics modules using the provided FreeFEM language. FreeFEM offers a large list of\n    finite elements, like the Lagrange, Taylor-Hood, etc., usable in the continuous and\n    discontinuous Galerkin method framework.\n  documentation: https://doc.freefem.org\n  repository: https://github.com/FreeFem/FreeFem-sources\n\nextra:\n  recipe-maintainers:\n    - ldallolio\n    - cnrdn\n    - fbordeu\n",
