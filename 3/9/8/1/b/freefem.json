  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: FreeFem\n  version: \"4.16\"\n  build_num: 0\n  # nompi gets +100 so the solver prefers it by default\n  # https://conda-forge.org/docs/maintainer/knowledge_base/#preferring-a-provider-usually-nompi\n  build_number: ${{ build_num + 100 if mpi == \"nompi\" else build_num }}\n  # build string prefix so dependents can select a variant:\n  #   `freefem * mpi_mpich_*`, `freefem * mpi_*`, `freefem * nompi_*`\n  mpi_prefix: ${{ \"nompi\" if mpi == \"nompi\" else \"mpi_\" ~ mpi }}\n\npackage:\n  name: ${{ name | lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/${{ name }}/${{ name }}-sources/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 9921af94fb69c85a650b05b0eeb4d56623af35f5d71d635b7ba5e2508c02246a\n  patches:\n    - Makefile.am_conda.patch\n    - Makefile.am_src_bin-win32_conda.patch\n    # NLopt>=2.9 removed LD_LBFGS_NOCEDAL\n    - ff-NLopt_nlopt-2.9.patch\n    # HDF5>=2 h5cc -showconfig lists libs ';'-separated\n    - ax_lib_hdf5_cmake-lists.patch\n    # detect conda-forge superlu/scotch/mmg (SuperLu, scotch, mmg plugins)\n    - configure.ac_conda-layout.patch\n\nbuild:\n  number: ${{ build_number }}\n  script:\n    file: build.sh\n    env:\n      mpi: ${{ mpi }}\n  string: ${{ mpi_prefix }}_h${{ hash }}_${{ build_number }}\n  skip:\n    - osx\n    - win\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('fortran') }}\n    - autoconf\n    - automake\n    - bison\n    - flex\n    - m4\n    - make\n    # HDF5>=2 h5cc is a pkg-config wrapper\n    - pkg-config\n    - patch\n    - unzip\n  host:\n    - arpack\n    - fftw\n    - gmm\n    - gsl\n    - freeglut\n    - nlopt\n    - metis\n    - if: mpi == \"nompi\"\n      then:\n        - mumps-seq\n        # ipopt needs mumps-seq, which can't coexist with petsc's mumps-mpi (mumps-feedstock#144)\n        - ipopt\n      else:\n        - mumps-mpi\n        - ${{ mpi }}\n        # PETSc/SLEPc plugins only exist in plugin/mpi\n        - petsc\n        - slepc\n        # parmetis/scalapack only exist as MPI builds; FreeFEM only uses them in plugin/mpi\n        - parmetis\n        - scalapack\n    - mmgsuite\n    - scotch\n    - hdf5\n    - libblas\n    - libcblas\n    - liblapack\n    - suitesparse\n    - superlu\n    - tetgen\n    - zlib\n    - zstd\n  run:\n    - if: mpi != \"nompi\"\n      then: ${{ mpi }}\n    - ${{ pin_compatible('hdf5', upper_bound='x.x') }}\n  run_exports:\n    - ${{ pin_subpackage('freefem', upper_bound='x.x', build=mpi_prefix ~ '_*') }}\n\ntests:\n  - package_contents:\n      bin:\n        - FreeFem++\n        - FreeFem++-nw\n        - ff-c++\n        - ff-get-dep\n        - ff-pkg-download\n  - script:\n      - FreeFem++ -nw $PREFIX/share/FreeFEM/${{ version }}/examples/tutorial/beam.edp\n      - FreeFem++ -nw $PREFIX/share/FreeFEM/${{ version }}/examples/3dSurf/buildMeshSfromMesh3.edp\n\nabout:\n  homepage: https://freefem.org/\n  license: LGPL-3.0-only\n  license_file: LICENSE.txt\n  summary: 'FreeFem : A high level multiphysics finite element software'\n  description: >\n    FreeFEM is a popular 2D and 3D partial differential equations (PDE) solver used by\n    thousands of researchers across the world. It allows you to easily implement your own\n    physics modules using the provided FreeFEM language. FreeFEM offers a large list of\n    finite elements, like the Lagrange, Taylor-Hood, etc., usable in the continuous and\n    discontinuous Galerkin method framework.\n  documentation: https://doc.freefem.org\n  repository: https://github.com/FreeFem/FreeFem-sources\n\nextra:\n  recipe-maintainers:\n    - ldallolio\n    - cnrdn\n    - fbordeu\n",
