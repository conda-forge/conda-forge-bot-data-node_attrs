  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.1.6\"\n  build_number: 1\n\npackage:\n  name: terragrunt\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/gruntwork-io/terragrunt/archive/v${{ version }}.tar.gz\n  sha256: 13d96feff7d0cbd47d3bb875ff4ca4f27f871dee98bf7ac32acb8d766cd33dc3\n\nbuild:\n  number: ${{ build_number }}\n  script:\n    file: build  # build.sh on Unix, build.bat on Windows\n\nrequirements:\n  build:\n    - ${{ compiler('go') }}\n    - go-licenses\n\ntests:\n  - package_contents:\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/terragrunt\n            - share/zsh/site-functions/_terragrunt\n            - share/fish/vendor_completions.d/terragrunt.fish\n            - etc/conda/activate.d/terragrunt.sh\n            - etc/conda/deactivate.d/terragrunt.sh\n            - etc/conda/activate.d/terragrunt.fish\n            - etc/conda/deactivate.d/terragrunt.fish\n  - requirements:\n      run:\n        - if: unix\n          then:\n            - fish\n            - zsh\n    script:\n      - if: win\n        then: |\n          set \"TERRAGRUNT_VERSION=\"\n          for /f \"delims=\" %%V in ('terragrunt --version') do set \"TERRAGRUNT_VERSION=%%V\"\n          if not \"%TERRAGRUNT_VERSION%\"==\"terragrunt version v${{ version }}\" exit /b 1\n        else: terragrunt --version | grep -Fx \"terragrunt version v${{ version }}\"\n      - terragrunt --help\n      - if: unix\n        then:\n          # Check that completing \"terragrunt ru\" suggests \"run\".\n          - env COMP_LINE=\"terragrunt ru\" terragrunt | grep -qx run\n          - bash -e tests/completions.bash\n          - zsh -f -e tests/completions.zsh\n          - fish --no-config tests/completions.fish\n    files:\n      recipe:\n        - tests/\n  - requirements:\n      run:\n        - opentofu\n    script:\n      - terragrunt run --tf-path tofu -- version\n  - requirements:\n      run:\n        - terraform\n    script:\n      - terragrunt run --tf-path terraform -- version\n\nabout:\n  homepage: https://www.gruntwork.io/\n  license: MIT\n  license_file:\n    - LICENSE.txt\n    - library_licenses\n  summary: Terragrunt is a flexible orchestration tool for OpenTofu and Terraform.\n  description: |\n    Terragrunt is a flexible orchestration tool that allows Infrastructure as Code written in OpenTofu/Terraform to scale.\n    Install either opentofu or terraform separately to run infrastructure commands.\n  repository: https://github.com/gruntwork-io/terragrunt.git\n\nextra:\n  recipe-maintainers:\n    - sodre\n    - mariusvniekerk\n    - hajapy\n    - Hoeze\n",
