  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"7.2.4\"\n  esmi_version: \"4.2\"\n\nrecipe:\n  name: amdsmi-split\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/ROCm/rocm-systems/releases/download/rocm-${{ version }}/amdsmi.tar.gz\n    sha256: e1b7afe0ba9b12dc0ea9f3a49c381ff65363344b33ac435f7bbcc0ab1e4c8ff6\n  - url: https://github.com/amd/esmi_ib_library/archive/refs/tags/esmi_pkg_ver-${{ esmi_version }}.tar.gz\n    sha256: de19d222d09e2171f47f8bbd6608e5648bd547c82543379bb8fb5ed2e379e141\n    target_directory: esmi_ib_library\n\nbuild:\n  number: 0\n  skip:\n    - not linux\n\noutputs:\n  - staging:\n      name: amdsmi-build\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - cmake >=3.20\n        - ninja\n        - pkg-config\n      host:\n        - libdrm\n    build:\n      script: build.sh\n\n  - package:\n      name: libamd-smi\n    inherit: amdsmi-build\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - cmake >=3.20\n        - ninja\n        - pkg-config\n      host:\n        - libdrm\n        - rocm-core ${{ version }}.*\n      run_exports:\n        - ${{ pin_subpackage('libamd-smi', upper_bound='x.x') }}\n    tests:\n      - script:\n          - test -f $PREFIX/lib/libamd_smi.so\n          - test -f $PREFIX/include/amd_smi/amdsmi.h\n\n  - package:\n      name: amdsmi\n    inherit:\n      from: amdsmi-build\n      run_exports: false\n    build:\n      script: install_python.sh\n    requirements:\n      host:\n        - python\n        - pip\n        - setuptools >=59.0\n        - rocm-core ${{ version }}.*\n      run:\n        - python\n        - ${{ pin_subpackage('libamd-smi', exact=True) }}\n    tests:\n      - python:\n          imports:\n            - amdsmi\n          pip_check: true\n\nabout:\n  homepage: https://github.com/ROCm/amdsmi\n  summary: AMD System Management Interface Library\n  description: |\n    AMD SMI provides a C library and Python interface for monitoring and\n    managing AMD hardware (GPUs and CPUs). It exposes telemetry data\n    such as temperature, clock speeds, power usage, and allows device\n    management operations.\n  license: MIT\n  license_file: LICENSE\n  documentation: https://rocm.docs.amd.com/projects/amdsmi/\n  repository: https://github.com/ROCm/amdsmi\n\nextra:\n  recipe-maintainers:\n    - flferretti\n    - conda-forge/rocm-core\n",
