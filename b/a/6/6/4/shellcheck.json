  "raw_meta_yaml": "context:\n  version: \"0.11.0\"\n\npackage:\n  name: shellcheck\n  version: ${{ version }}\n\nsource:\n  - if: not linux\n    then:\n      url: https://github.com/koalaman/shellcheck/archive/v${{ version }}.tar.gz\n      sha256: 8b07554f92e4fbfc33f1539a1f475f21c6503ceae8f806efcc518b1f529f7102\n  - if: linux and x86_64\n    then:\n      url: https://github.com/koalaman/shellcheck/releases/download/v${{ version }}/shellcheck-v${{ version }}.linux.x86_64.tar.xz\n      sha256: 8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198\n  - if: linux and aarch64\n    then:\n      url: https://github.com/koalaman/shellcheck/releases/download/v${{ version }}/shellcheck-v${{ version }}.linux.aarch64.tar.xz\n      sha256: 12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588\n  - if: linux and riscv64\n    then:\n      url: https://github.com/koalaman/shellcheck/releases/download/v${{ version }}/shellcheck-v${{ version }}.linux.riscv64.tar.xz\n      sha256: 693c987777e7b524dd311d9b8c704885a39c889c9804bb1ef1fd29b48567b0b3\n\nbuild:\n  number: 2\n  dynamic_linking:\n    missing_dso_allowlist:\n      - if: osx\n        then: /usr/lib/libiconv.2.dylib\n\nrequirements:\n  build:\n    - if: not linux\n      then: stack\n    - if: linux or win\n      then: ${{ \"m2w64-\" if win else \"\" }}binutils\n    - if: osx\n      then: llvm-tools 13.*\n  host:\n    - if: osx\n      then: gmp\n  run:\n    - if: osx\n      then: gmp\n\ntests:\n  - package_contents:\n      bin:\n        - shellcheck\n      files:\n        not_exists:\n          - share/shellcheck-*/**\n  - script:\n      - shellcheck --version\n      - shellcheck || true\n\nabout:\n  homepage: https://github.com/koalaman/shellcheck\n  license: GPL-3.0-only\n  license_family: GPL\n  license_file:\n    - if: linux\n      then: LICENSE.txt\n      else: LICENSE\n  summary: ShellCheck, a static analysis tool for shell scripts\n\nextra:\n  recipe-maintainers:\n    - dbast\n    - pavelzw\n",
