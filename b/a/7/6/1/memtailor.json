    "about": {
      "description": "Memtailor is a C++ library of special-purpose memory allocators, including\nan arena allocator and a memory pool, designed for better and more\npredictable performance than new/delete. The memory pool is useful for many\nfixed-size allocations, such as linked list nodes, while the arena\nallocator is fast, works like stack allocation, stays within the C++\nstandard, and allows multiple independent arenas.",
      "dev_url": "https://github.com/Macaulay2/memtailor",
      "home": "https://github.com/Macaulay2/memtailor",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "license.txt",
      "summary": "C++ library of special purpose memory allocators"
    },
    "build": {
