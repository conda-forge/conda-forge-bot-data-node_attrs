  "raw_meta_yaml": "context:\n  version: \"0.6.0\"\n\npackage:\n  name: forgejo-cli\n  version: ${{ version }}\n\nsource:\n  url: https://codeberg.org/forgejo-contrib/forgejo-cli/archive/v${{ version }}.tar.gz\n  sha256: 8b91194cb1886f253261a4567ee6f83aa34b05a9637644793f88b40b7110322a\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n      LIBGIT2_NO_VENDOR: \"1\"\n      LIBSSH2_SYS_USE_PKG_CONFIG: \"1\"\n    content:\n      - if: unix\n        then:\n          # ssh2-config's build script links libgit2 dynamically\n          - export DYLD_FALLBACK_LIBRARY_PATH=$PREFIX/lib\n          - export LD_LIBRARY_PATH=$PREFIX/lib\n          - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .\n          - mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d\n          - $PREFIX/bin/fj completion zsh > $PREFIX/share/zsh/site-functions/_fj\n          - $PREFIX/bin/fj completion bash > $PREFIX/share/bash-completion/completions/fj\n          - $PREFIX/bin/fj completion fish > $PREFIX/share/fish/vendor_completions.d/fj.fish\n        else:\n          - set OPENSSL_DIR=%LIBRARY_PREFIX%\n          # libssh2.pc says -lssh2 / -lcrypto but the import libraries are\n          # called libssh2.lib / libcrypto.lib\n          - mkdir %SRC_DIR%\\winlib\n          - copy %LIBRARY_LIB%\\libssh2.lib %SRC_DIR%\\winlib\\ssh2.lib\n          - copy %LIBRARY_LIB%\\libcrypto.lib %SRC_DIR%\\winlib\\crypto.lib\n          - set \"LIB=%SRC_DIR%\\winlib;%LIB%\"\n          - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path .\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - pkg-config\n  host:\n    - libgit2\n    - libssh2\n    - openssl\n    # needed for libssh2's pkg-config file, not linked directly\n    - zlib\n  ignore_run_exports:\n    by_name:\n      - libzlib\n\ntests:\n  - script: fj --help\n  - package_contents:\n      bin:\n        - fj\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/fj\n            - share/fish/vendor_completions.d/fj.fish\n            - share/zsh/site-functions/_fj\n      strict: true\n\nabout:\n  homepage: https://codeberg.org/forgejo-contrib/forgejo-cli\n  summary: CLI tool for Forgejo\n  description: |\n    fj is a command-line tool for interacting with Forgejo instances,\n    allowing you to manage repositories, issues, pull requests and more\n    from your terminal.\n  license: Apache-2.0 OR MIT\n  license_file:\n    - LICENSE-APACHE\n    - LICENSE-MIT\n    - THIRDPARTY.yml\n  repository: https://codeberg.org/forgejo-contrib/forgejo-cli\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
