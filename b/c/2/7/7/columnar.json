  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.4.1\"\n\npackage:\n  name: columnar\n  version: ${{ version }}\n\nsource:\n  - url: https://pypi.org/packages/source/C/Columnar/Columnar-${{ version }}.tar.gz\n    sha256: c3cb57273333b2ff9cfaafc86f09307419330c97faa88dcfe23df05e6fbb9c72\n  # The sdist doesn't include the license, so take it from the v1.4.1 tag.\n  - url: https://raw.githubusercontent.com/MaxTaggart/columnar/548a21daa1907448418a1f26c8a966e7cb6c37ab/LICENSE.txt\n    sha256: ed50ff698e505a4e5c3d3423f64d11f1f9a32cb42ca08fb8a458c88d0e678774\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    # setup.py reads the UTF-8 README without an encoding, which breaks\n    # on Windows' default cp1252 codec.\n    env:\n      PYTHONUTF8: \"1\"\n    content: ${{ PYTHON }} -m pip install . -vv\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n  run:\n    - python >=${{ python_min }}\n    - toolz\n    - wcwidth\n\ntests:\n  - python:\n      imports:\n        - columnar\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      - python -c \"from columnar import columnar; out = columnar([['a', 1], ['b', 2]], ['name', 'n'], no_borders=True); assert 'NAME' in out and 'b' in out\"\n\nabout:\n  homepage: https://github.com/MaxTaggart/columnar\n  repository: https://github.com/MaxTaggart/columnar\n  summary: A tool for printing data in a columnar format.\n  license: MIT\n  license_file: LICENSE.txt\n\nextra:\n  recipe-maintainers:\n    - killua156\n",
