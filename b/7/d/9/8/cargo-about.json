  "raw_meta_yaml": "context:\n  version: \"0.9.2\"\n\npackage:\n  name: cargo-about\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/EmbarkStudios/cargo-about/archive/refs/tags/${{ version }}.tar.gz\n  sha256: bc82b1c4ec112780652f8b8fee043b5826e580a946f8dda68c25eb39bc168a05\n\nbuild:\n  number: 1\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      # The ppc64le CFLAGS contain -fno-plt, so gcc compiles the C dependencies (mimalloc,\n      # ring, zstd) using inline PLT call sequences. rustc links with its bundled rust-lld,\n      # which rejects those relocations (R_PPC64_PLT16_HA/_LO_DS, R_PPC64_PLTSEQ,\n      # R_PPC64_PLTCALL), so link with GNU ld on that platform instead.\n      #\n      # This has to go through RUSTFLAGS: the upstream .cargo/config.toml sets\n      # `[target.'cfg(all())'] rustflags`, which replaces `build.rustflags` and therefore\n      # makes cargo ignore the CARGO_BUILD_RUSTFLAGS set by the rust activation script.\n      # Carry those flags over so the usual rpaths are kept.\n      - if: target_platform == 'linux-ppc64le'\n        then:\n          - export RUSTFLAGS=\"${CARGO_BUILD_RUSTFLAGS} -C link-arg=-fuse-ld=bfd\"\n      - if: unix\n        then:\n          - cargo auditable install --locked --no-track --bins --features cli --root ${{ PREFIX }} --path .\n        else:\n          - cargo auditable install --locked --no-track --bins --features cli --root %LIBRARY_PREFIX% --path .\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n\ntests:\n  - script:\n      - cargo-about --help\n      - cargo-about --version\n  - package_contents:\n      bin:\n        - cargo-about\n      strict: true\n\nabout:\n  homepage: https://github.com/EmbarkStudios/cargo-about\n  summary: Cargo plugin for generating a listing of all of the crates and the terms under which they are licensed\n  description: |\n    cargo-about is a cargo plugin that generates a listing of all crates used by a\n    Rust project along with the licenses under which they are distributed, rendered\n    through user-provided Handlebars templates.\n  license: MIT OR Apache-2.0\n  license_file:\n    - LICENSE-APACHE\n    - LICENSE-MIT\n    - THIRDPARTY.yml\n  documentation: https://embarkstudios.github.io/cargo-about/\n  repository: https://github.com/EmbarkStudios/cargo-about\n\nextra:\n  recipe-maintainers:\n    - ytausch\n",
