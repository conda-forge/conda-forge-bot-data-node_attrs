  "linux_64_meta_yaml": {
    "about": {
      "description": "cargo-about is a cargo plugin that generates a listing of all crates used by a\nRust project along with the licenses under which they are distributed, rendered\nthrough user-provided Handlebars templates.",
      "dev_url": "https://github.com/EmbarkStudios/cargo-about",
      "doc_url": "https://embarkstudios.github.io/cargo-about/",
      "home": "https://github.com/EmbarkStudios/cargo-about",
      "license": "MIT OR Apache-2.0",
      "license_family": "MIT OR Apache-2.0",
      "license_file": "LICENSE-APACHE",
      "summary": "Cargo plugin for generating a listing of all of the crates and the terms under which they are licensed"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --features cli --root ${{ PREFIX }} --path .",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "ytausch"
      ]
    },
    "outputs": [
      {
