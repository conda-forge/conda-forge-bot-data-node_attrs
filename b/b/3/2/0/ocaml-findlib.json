  "raw_meta_yaml": "context:\n  build_number: 0\n  name: ocaml-findlib\n  version: 1.9.8\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: http://download.camlcity.org/download/findlib-${{ version }}.tar.gz\n  sha256: 662c910f774e9fee3a19c4e057f380581ab2fc4ee52da4761304ac9c31b8869d\n\nbuild:\n  number: ${{ build_number }}\n  skip:\n    - win\n  prefix_detection:\n    force_file_type:\n      text:\n        - lib/ocaml/site-lib/findlib/Makefile.config\n        - lib/ocaml/topfind\n        - etc/findlib.conf\n    ignore:\n      # Only ignore bytecode files (binary format, relocation corrupts them)\n      - lib/ocaml/site-lib/**/*.cma\n      - lib/ocaml/site-lib/**/*.cmi\n      - lib/ocaml/site-lib/**/*.cmx\n      - lib/ocaml/site-lib/**/*.cmt\n      - lib/ocaml/site-lib/**/*.cmti\n  script: build.sh\n\nrequirements:\n  build:\n    - ${{ compiler('ocaml') }}\n    - ${{ stdlib(\"c\") }}\n    - bash >=5.2\n    - make\n    - sed\n    - grep\n  run_constraints:\n    - ocaml_${{ target_platform }} >=${{ ocaml_compiler_version }}\n\ntests:\n  - script:\n      - ocamlfind install -help\n    requirements:\n      run:\n        - ocaml-compiler\n\nabout:\n  homepage: http://projects.camlcity.org/projects/findlib.html\n  license: MIT\n  license_family: MIT\n  license_file: LICENSE\n  summary: 'OCaml library manager and package finder'\n  documentation: http://projects.camlcity.org/projects/dl/findlib-${{ version }}/doc/guide-html/index.html\n  repository: https://github.com/ocaml/ocamlfind\n\nextra:\n  recipe-maintainers:\n    - isuruf\n    - slel\n",
