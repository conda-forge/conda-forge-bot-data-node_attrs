  "raw_meta_yaml": "context:\n  version: \"0.7\"\n\npackage:\n  name: hidapitester\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/todbot/hidapitester/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: a20f805e308592f79c9ea4ecf74d9ea36a267e222b3c3c49c18f7b980a67ebbe\n  patches:\n    - 0001-use-conda-provided-dependencies.patch\n\nbuild:\n  number: 0\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - ninja\n  host:\n    - libhidapi\n    - if: win\n      then: getopt-win32\n\ntests:\n  - script:\n      - hidapitester --version\n      - hidapitester -h\n      - if: unix\n        then: hidapitester --list || echo \"no HID devices found (expected on CI runners)\"\n      - if: win\n        then: hidapitester --list || echo no HID devices found\n  - files:\n      source:\n        - tests/test_nohardware.sh\n    script:\n      - if: unix\n        then: sh tests/test_nohardware.sh hidapitester\n  - package_contents:\n      bin:\n        - hidapitester\n\nabout:\n  homepage: https://github.com/todbot/hidapitester\n  summary: Simple command-line program to exercise HIDAPI\n  description: |\n    hidapitester is a command-line tool for testing the API of HIDAPI, a\n    cross-platform library for communicating with USB and Bluetooth HID-class\n    devices. It can list HID devices, open them, and read and write input,\n    output, and feature reports, as well as retrieve report descriptors.\n  license: GPL-3.0-only\n  license_file: LICENSE\n  repository: https://github.com/todbot/hidapitester\n\nextra:\n  recipe-maintainers:\n    - ytausch\n",
