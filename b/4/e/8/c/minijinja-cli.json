  "raw_meta_yaml": "context:\n  version: \"3.0.4\"\n\npackage:\n  name: minijinja-cli\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/mitsuhiko/minijinja/archive/refs/tags/${{ version }}.tar.gz\n  sha256: c200618aee830aeee4581a6fd92232ccd248d7371170339553caa19733bfc1c4\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - if: unix\n        then:\n          # build.rs writes the man page and shell completions here\n          - export ASSET_OUT_DIR=$SRC_DIR/assets\n          - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path minijinja-cli\n          - mkdir -p ${{ PREFIX }}/share/man/man1 ${{ PREFIX }}/share/bash-completion/completions ${{ PREFIX }}/share/zsh/site-functions ${{ PREFIX }}/share/fish/vendor_completions.d\n          - cp assets/man/minijinja-cli.1 ${{ PREFIX }}/share/man/man1/minijinja-cli.1\n          - cp assets/completions/minijinja-cli.bash ${{ PREFIX }}/share/bash-completion/completions/minijinja-cli\n          - cp assets/completions/_minijinja-cli ${{ PREFIX }}/share/zsh/site-functions/_minijinja-cli\n          - cp assets/completions/minijinja-cli.fish ${{ PREFIX }}/share/fish/vendor_completions.d/minijinja-cli.fish\n        else:\n          - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path minijinja-cli\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n\ntests:\n  - script:\n      - minijinja-cli --help\n      - minijinja-cli --version\n      - if: unix\n        then:\n          - test \"$(echo 'Hello {{ name }}!' | minijinja-cli -D name=World -)\" = \"Hello World!\"\n        else:\n          - echo Hello {{ name }}| minijinja-cli -D name=World - | findstr /b /c:\"Hello World\"\n  - package_contents:\n      bin:\n        - minijinja-cli\n      files:\n        - if: unix\n          then:\n            - share/man/man1/minijinja-cli.1\n            - share/bash-completion/completions/minijinja-cli\n            - share/fish/vendor_completions.d/minijinja-cli.fish\n            - share/zsh/site-functions/_minijinja-cli\n      strict: true\n\nabout:\n  homepage: https://github.com/mitsuhiko/minijinja\n  summary: Command Line Utility to render MiniJinja/Jinja2 templates\n  description: |\n    minijinja-cli is a command line executable that uses MiniJinja to render\n    Jinja2 templates directly from the command line to stdout.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  documentation: https://github.com/mitsuhiko/minijinja/tree/main/minijinja-cli\n  repository: https://github.com/mitsuhiko/minijinja\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
