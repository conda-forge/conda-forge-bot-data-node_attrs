    "build": {
      "number": "0",
      "script": {
        "content": [
          "export ASSET_OUT_DIR=$SRC_DIR/assets",
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path minijinja-cli",
          "mkdir -p ${{ PREFIX }}/share/man/man1 ${{ PREFIX }}/share/bash-completion/completions ${{ PREFIX }}/share/zsh/site-functions ${{ PREFIX }}/share/fish/vendor_completions.d",
          "cp assets/man/minijinja-cli.1 ${{ PREFIX }}/share/man/man1/minijinja-cli.1",
          "cp assets/completions/minijinja-cli.bash ${{ PREFIX }}/share/bash-completion/completions/minijinja-cli",
          "cp assets/completions/_minijinja-cli ${{ PREFIX }}/share/zsh/site-functions/_minijinja-cli",
          "cp assets/completions/minijinja-cli.fish ${{ PREFIX }}/share/fish/vendor_completions.d/minijinja-cli.fish",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
