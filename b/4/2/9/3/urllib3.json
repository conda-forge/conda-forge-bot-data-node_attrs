  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.8.0\"\n\nrecipe:\n  name: urllib3\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/u/urllib3/urllib3-${{ version }}.tar.gz\n  sha256: 63bf2ead4c879426ebf22ef2a781eeb4aa3b4ae798a0435506f8687fd5bb9b63\n\nbuild:\n  number: 1\n  noarch: python\n\noutputs:\n  - package:\n      name: urllib3\n    build:\n      noarch: python\n      script: ${{ PYTHON }} -m pip install . -vv\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - hatchling >=1.27.0,<2\n        - hatch-vcs >=0.4.0,<0.6.0\n        - setuptools-scm >=8,<11\n        - pip\n      run:\n        - python >=${{ python_min }}\n    tests:\n      - python:\n          imports:\n            - urllib3\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n\n  - package:\n      name: urllib3-brotli\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"urllib3\", exact=True) }}\n        - brotli-python >=1.2.0\n    tests:\n      - python:\n          pip_check: true\n\n  - package:\n      name: urllib3-zstd\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"urllib3\", exact=True) }}\n        #  Drop when python_min = 3.14\n        - backports.zstd >=1.0.0\n    tests:\n      - python:\n          pip_check: true\n\n  - package:\n      name: urllib3-socks\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"urllib3\", exact=True) }}\n        - pysocks >=1.5.6,<2.0,!=1.5.7\n    tests:\n      - python:\n          pip_check: true\n\n  - package:\n      name: urllib3-h2\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"urllib3\", exact=True) }}\n        - h2 >=4,<5\n    tests:\n      - python:\n          pip_check: true\n\nabout:\n  summary: HTTP library with thread-safe connection pooling, file post, and more.\n  license: MIT\n  license_file: LICENSE.txt\n  homepage: https://pypi.org/project/urllib3/\n  documentation: https://urllib3.readthedocs.io\n  repository: https://github.com/urllib3/urllib3\n\nextra:\n  recipe-maintainers:\n    - shazow\n    - sethmlarson\n    - ocefpaf\n    - pquentin\n    - illia-v\n",
