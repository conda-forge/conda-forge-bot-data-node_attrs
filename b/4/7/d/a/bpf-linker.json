  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.12.0\"\n\npackage:\n  name: bpf-linker\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/aya-rs/bpf-linker/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: b338f41fb9bb690693eaa9021bb1c28e6dfe894ad5ff60385a0343aa269c0c02\n\nbuild:\n  number: 0\n  # this (somewhat surprisingly) works on `osx-64`, but (not unsurprisingly) fails on `win-64`:\n  #\n  #   error[E0433]: failed to resolve: could not find `unix` in `os`\n  #\n  skip: win\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - cargo auditable install --no-track --locked --path=. --profile=release --root=\"${{ PREFIX }}\"\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - ${{ stdlib(\"c\") }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n  host:\n    - llvmdev\n    - if: linux\n      then:\n        - libllvm23\n  run:\n    - llvmdev\n\ntests:\n  - package_contents:\n      strict: true\n      bin:\n        - bpf-linker\n  - script:\n      - bpf-linker --version | grep -iE \"^bpf-linker ${{ version | replace('.', '\\\\.') }}$\"\n      - bpf-linker --help\n\nabout:\n  license: Apache-2.0 OR MIT\n  license_file:\n    - LICENSE-APACHE\n    - LICENSE-MIT\n    - THIRDPARTY.yml\n  homepage: https://github.com/aya-rs/bpf-linker\n  summary: Simple BPF static linker\n\nextra:\n  recipe-maintainers:\n    - bollwyvl\n",
