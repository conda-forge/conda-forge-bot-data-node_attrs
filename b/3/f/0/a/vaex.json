    "about": {
      "description": "Vaex is a high performance Python library for lazy Out-of-Core DataFrames\n(similar to Pandas), to visualize and explore big tabular datasets. It\ncalculates statistics such as mean, sum, count, standard deviation etc, on an\nN-dimensional grid for more than a billion samples/rows per second.\nVisualization is done using histograms, density plots and 3d volume rendering,\nallowing interactive exploration of big data.",
      "dev_url": "https://github.com/vaexio/vaex",
      "doc_url": "https://vaex.readthedocs.io/",
      "home": "https://vaex.io/",
      "license": "MIT",
