  "raw_meta_yaml": "context:\n  version: \"1.29.0\"\n\npackage:\n  name: bazelisk\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/bazelbuild/bazelisk/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 7e4c7b8ade016052e63c1553cb4fbe0c4fe921e1e66913d49eef074ed894e933\n  target_directory: src\n\nbuild:\n  number: 0\n  script:\n    - cd src\n    - go-licenses save . --save_path ../library_licenses\n    - if: unix\n      then: go build -v -trimpath -ldflags=\"-s -w -X github.com/bazelbuild/bazelisk/core.BazeliskVersion=${{ version }}\" -o \"$PREFIX/bin/bazelisk\" .\n      else: go build -v -trimpath -ldflags=\"-s -w -X github.com/bazelbuild/bazelisk/core.BazeliskVersion=${{ version }}\" -o \"%LIBRARY_BIN%\\bazelisk.exe\" .\n\nrequirements:\n  build:\n    - ${{ compiler('go-nocgo') }}\n    - go-licenses\n\ntests:\n  - package_contents:\n      bin:\n        - bazelisk\n  - script:\n      - if: unix\n        then: 'bazelisk bazeliskVersion | grep -F \"Bazelisk version: ${{ version }}\"'\n        else: 'bazelisk bazeliskVersion | findstr /C:\"Bazelisk version: ${{ version }}\"'\n\nabout:\n  homepage: https://github.com/bazelbuild/bazelisk\n  summary: A user-friendly launcher for Bazel\n  description: |\n    Bazelisk automatically downloads and runs the appropriate version of Bazel,\n    using a project's .bazelversion file or the USE_BAZEL_VERSION environment variable.\n  license: Apache-2.0\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n  repository: https://github.com/bazelbuild/bazelisk\n\nextra:\n  recipe-maintainers:\n    - wolfv\n",
