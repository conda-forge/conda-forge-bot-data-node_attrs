    "about": {
      "description": "Bazelisk automatically downloads and runs the appropriate version of Bazel,\nusing a project's .bazelversion file or the USE_BAZEL_VERSION environment variable.",
      "dev_url": "https://github.com/bazelbuild/bazelisk",
      "home": "https://github.com/bazelbuild/bazelisk",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "src/LICENSE",
      "summary": "A user-friendly launcher for Bazel"
    },
    "build": {
      "number": "0",
      "script": [
        "cd src",
        "go-licenses save . --save_path ../library_licenses",
        "go build -v -trimpath -ldflags=\"-s -w -X github.com/bazelbuild/bazelisk/core.BazeliskVersion=${{ version }}\" -o \"$PREFIX/bin/bazelisk\" ."
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "wolfv"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "bazelisk",
        "requirements": {
          "build": [
            "go-nocgo_compiler_stub",
            "go-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "package_contents": {
              "bin": [
                "bazelisk"
              ]
            }
          },
          {
            "script": "bazelisk bazeliskVersion | grep -F \"Bazelisk version: ${{ version }}\""
          }
        ],
        "version": "1.29.0"
      }
    ],
