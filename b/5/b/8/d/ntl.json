  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"11.6.0\"\n  name: ntl\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  # Upstream does not like our builders and times out almost always when downloading.\n  # Therefore, we use the tarball on GitHub which is not identical to the one\n  # upstream, see\n  # https://github.com/conda-forge/ntl-feedstock/pull/26#issuecomment-3801646143\n  # url: https://libntl.org/ntl-{{ version }}.tar.gz\n  url: https://github.com/libntl/ntl/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 30e29eb21c5da6db031fc7dc5b1a6c728f226c7128e922421247157bc89ecd86\n  patches:\n    - if: build_platform != target_platform and target_platform == \"osx-arm64\"\n      then: 0001-Do-not-run-binaries-when-cross-compiling-for-Silicon.patch\n\nbuild:\n  number: 1\n  skip: win\n\nrequirements:\n  build:\n    - libtool\n    - automake\n    - make\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n  host:\n    - gf2x\n    - gmp\n  run:\n    - gf2x\n    - gmp\n  run_exports:\n    - ${{ pin_subpackage('ntl', exact=True) }}\n\ntests:\n  - script:\n      - test -f $PREFIX/include/NTL/ZZ.h\n      - test -f $PREFIX/lib/lib${{ name }}.a\n      - if: linux\n        then: test -f $PREFIX/lib/lib${{ name }}.so\n      - if: osx\n        then: test -f $PREFIX/lib/lib${{ name }}.dylib\n\nabout:\n  license: LGPL-2.1-or-later\n  license_file: doc/copying.txt\n  summary: A Library for doing Number Theory\n  description: |\n    NTL is a high-performance, portable C++ library providing data structures and algorithms for manipulating signed, arbitrary length integers, and for vectors, matrices, and polynomials over the integers and over finite fields.\n  homepage: https://libntl.org/\n  repository: https://github.com/libntl/ntl\n  documentation: https://libntl.org/doc/tour.html\n\nextra:\n  recipe-maintainers:\n    - isuruf\n    - saraedum\n",
