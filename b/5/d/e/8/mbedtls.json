  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: mbedtls\n  version: \"4.3.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-${{ version }}/mbedtls-${{ version }}.tar.bz2\n  sha256: 1c87cba094cb40f097ebe0eba440a74939b71dab4e1d0d566bc90749ff381d18\n  patches:\n    # Mbed TLS does not support DLLs with MSVC: import the data that the\n    # DLLs and their consumers use from another DLL\n    - if: win\n      then: windows-dll-data-imports.patch\n\nbuild:\n  number: 0\n\nrequirements:\n  build:\n    - cmake\n    - if: win\n      then: ninja\n      else: make\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n  host:\n  run_exports:\n    - ${{ pin_subpackage('mbedtls', upper_bound='x.x') }}\n\ntests:\n  # Link a program against the installed libraries and run it. On Windows,\n  # also check that the .lib files are import libraries, i.e. that the\n  # program depends on the DLLs instead of linking Mbed TLS statically.\n  - files:\n      recipe:\n        - test_link.c\n    requirements:\n      build:\n        - ${{ stdlib('c') }}\n        - ${{ compiler('c') }}\n    script:\n      - if: win\n        then:\n          - cl /nologo /I%LIBRARY_INC% test_link.c /link /LIBPATH:%LIBRARY_LIB% mbedtls.lib mbedx509.lib tfpsacrypto.lib\n          - dumpbin /dependents test_link.exe | findstr /i mbedtls.dll\n          - dumpbin /dependents test_link.exe | findstr /i mbedx509.dll\n          - dumpbin /dependents test_link.exe | findstr /i tfpsacrypto.dll\n          - test_link.exe\n        else:\n          - ${CC} ${CFLAGS} -I${PREFIX}/include test_link.c -o test_link ${LDFLAGS} -L${PREFIX}/lib -Wl,-rpath,${PREFIX}/lib -lmbedtls -lmbedx509 -ltfpsacrypto\n          - ./test_link\n  # On Windows, `lib` checks both the DLL in Library/bin and the import\n  # library in Library/lib\n  - package_contents:\n      lib:\n        - tfpsacrypto\n        - libmbedcrypto\n        - mbedx509\n        - mbedtls\n      include:\n        - mbedtls/private/md5.h\n\nabout:\n  license: Apache-2.0\n  license_file: LICENSE\n  summary: An open source, portable, easy to use, readable and flexible SSL library\n  homepage: https://tls.mbed.org/\n  repository: https://github.com/Mbed-TLS/mbedtls\n\nextra:\n  recipe-maintainers:\n    - izahn\n    - carlodri\n    - xhochy\n",
