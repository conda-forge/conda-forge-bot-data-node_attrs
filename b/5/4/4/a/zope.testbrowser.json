  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"8.1\"\n\npackage:\n  name: zope.testbrowser\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/z/zope.testbrowser/zope_testbrowser-${{ version }}.tar.gz\n  sha256: 09440718ef0bf7876357d272dc829b3e5d5502519b79a8294c5b288e5fd151da\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n  run:\n    - python >=${{ python_min }}\n    - setuptools\n    - zope.interface\n    - zope.schema\n    - zope.cachedescriptors\n    - pytz\n    - webtest >=2.0.30\n    - beautifulsoup4\n    - soupsieve >=1.9.0\n    - wsgiproxy2\n    # upstream: python_version > \"3.12\"; legacy-cgi is metadata only below 3.13\n    - legacy-cgi\n\ntests:\n  - python:\n      imports:\n        - zope.testbrowser\n        - zope.testbrowser.browser\n        - zope.testbrowser.wsgi\n        - zope.testbrowser.interfaces\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      # dotted names: the tests use relative imports and mock.patch by module path\n      - python -m unittest -v zope.testbrowser.tests.test_browser zope.testbrowser.tests.test_cookies zope.testbrowser.tests.test_wsgi\n    requirements:\n      run:\n        - zope.testing\n\nabout:\n  homepage: https://github.com/zopefoundation/zope.testbrowser\n  repository: https://github.com/zopefoundation/zope.testbrowser\n  documentation: https://zopetestbrowser.readthedocs.io\n  summary: Programmable browser for functional black-box tests\n  license: ZPL-2.1\n  license_file:\n    - LICENSE.rst\n    - COPYRIGHT.rst\n\nextra:\n  recipe-maintainers:\n    - killua156\n",
