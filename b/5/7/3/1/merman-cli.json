  "raw_meta_yaml": "context:\n  version: \"0.9.0\"\n\npackage:\n  name: merman-cli\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/Latias94/merman/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: b185e0c25e3ac24c6ef0d26846a838a72e1612d3a375aa117c0ab1fdf28182fd\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      # CMake preserves jitterentropy's required -O0 after conda's CFLAGS.\n      AWS_LC_SYS_CMAKE_BUILDER: \"1\"\n      CMAKE_GENERATOR: Ninja\n      # Ninja uses the activated compiler; AWS-LC ARM64 assembly needs clang-cl.\n      CC_aarch64_pc_windows_msvc: clang-cl\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build main app and generate license data\n      - cd crates/merman-cli\n      - ^cargo auditable install --path=. --root=($prefix) --no-track --locked --bins\n      - ^cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml\n      # copy shell completion files and man pages\n      - mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions ($prefix)/share/man/man1\n      - cp assets/completions/merman-cli.bash ($prefix)/share/bash-completion/completions/merman-cli\n      - cp assets/completions/merman-cli.fish ($prefix)/share/fish/vendor_completions.d/merman-cli.fish\n      - cp assets/completions/_merman-cli     ($prefix)/share/zsh/site-functions/_merman-cli\n      - cp assets/man/*.1                     ($prefix)/share/man/man1/\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - nushell\n    - cmake\n    - ninja\n    - if: win and arm64\n      then: clang\n\ntests:\n  - script:\n      - merman-cli --help\n      - merman-cli --version\n  - package_contents:\n      bin:\n        - merman-cli\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/merman-cli\n            - share/fish/vendor_completions.d/merman-cli.fish\n            - share/zsh/site-functions/_merman-cli\n            - share/man/man1/merman-cli*.1\n        - if: win\n          then:\n            - Library/share/bash-completion/completions/merman-cli\n            - Library/share/fish/vendor_completions.d/merman-cli.fish\n            - Library/share/zsh/site-functions/_merman-cli\n            - Library/share/man/man1/merman-cli*.1\n      strict: true\n\nabout:\n  summary: Mermaid.js, but headless, in Rust. Parse, layout and render diagrams to SVG/PNG/JPG/PDF/ASCII/Unicode.\n  description: |\n    `merman-cli` is a performant browserless Mermaid command-line renderer in Rust for SVG, PNG, JPG, PDF, and\n    ASCII/Unicode text output. The top-level command follows common `mmdc` workflows, while developer subcommands\n    expose merman's parse, layout, and render internals.\n  license: MIT OR Apache-2.0\n  license_file:\n    - LICENSE-MIT\n    - LICENSE-APACHE\n    - THIRDPARTY.yml\n  homepage: https://github.com/Latias94/merman\n  repository: https://github.com/Latias94/merman\n\nextra:\n  recipe-maintainers:\n    - Latias94\n    - salim-b\n",
