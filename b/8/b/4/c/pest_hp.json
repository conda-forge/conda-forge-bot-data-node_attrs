    "about": {
      "description": "PEST_HP interacts with a model through the model’s own input and output\nfiles for Highly Parameterized (HP) models. While estimating or adjusting\nits parameters, it runs a model many times. These model runs can be\nconducted either in serial or in parallel. Advanced dimensional-reduction\nmethods can dramatically reduce the number of model runs required for\nattainment of a high level of model-to-measurement fit.",
      "doc_url": "https://s3.amazonaws.com/docs.pesthomepage.org/documents/all_manuals.zip",
      "home": "https://pesthomepage.org/",
      "license": "LicenseRef-DISCLAIMER",
      "license_family": "LicenseRef-DISCLAIMER",
      "license_file": "LICENSE.txt",
      "summary": "PEST_HP automates calibration and calibration-constrained uncertainty analysis of any numerical model."
