  "raw_meta_yaml": "context:\n  version: \"0.1.23\"\n\npackage:\n  name: idt\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/sh-cho/idt/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 79404c0aef153f350d2c2982641f42bc881fc597e58f92024382ee9f8c528cc4\n\nbuild:\n  number: 1\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build main app and generate license data\n      - cargo auditable install --path=. --root=($prefix) --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=THIRDPARTY.yml\n      # generate shell completions\n      - if: build_platform == host_platform\n        then:\n          - mkdir ($prefix)/share/man/man1 ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions\n          - let bin = ($prefix)/bin/idt\n          - ^$bin manpage                 ($prefix)/share/man/man1\n          - ^$bin completions bash | save ($prefix)/share/bash-completion/completions/idt\n          - ^$bin completions fish | save ($prefix)/share/fish/vendor_completions.d/idt.fish\n          - ^$bin completions zsh  | save ($prefix)/share/zsh/site-functions/_idt\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - nushell\n\ntests:\n  - script:\n      - idt --help\n      - idt --version\n  - package_contents:\n      bin:\n        - idt\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/man/man1/idt*.1\n            - share/bash-completion/completions/idt\n            - share/fish/vendor_completions.d/idt.fish\n            - share/zsh/site-functions/_idt\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/man/man1/idt*.1\n            - Library/share/bash-completion/completions/idt\n            - Library/share/fish/vendor_completions.d/idt.fish\n            - Library/share/zsh/site-functions/_idt\n      strict: true\n\nabout:\n  summary: A fast, ergonomic CLI tool for working with various ID formats\n  description: |\n    idt (ID Tool) is a fast, ergonomic CLI tool for working with various\n    identifier formats. Whether you need to generate, inspect, convert, or\n    validate IDs, idt provides a unified interface for all your identifier needs\n    including support for UUID (all versions), ULID, NanoID, Snowflake, assigned\n    IDs (EAN, ISBN, ISIN), and more.\n  license: MIT OR Apache-2.0\n  license_file:\n    - LICENSE-APACHE\n    - LICENSE-MIT\n    - THIRDPARTY.yml\n  homepage: https://sh-cho.github.io/idt\n  repository: https://github.com/sh-cho/idt\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
