  "linux_64_meta_yaml": {
    "about": {
      "description": "idt (ID Tool) is a fast, ergonomic CLI tool for working with various\nidentifier formats. Whether you need to generate, inspect, convert, or\nvalidate IDs, idt provides a unified interface for all your identifier needs\nincluding support for UUID (all versions), ULID, NanoID, Snowflake, assigned\nIDs (EAN, ISBN, ISIN), and more.",
      "dev_url": "https://github.com/sh-cho/idt",
      "home": "https://sh-cho.github.io/idt",
      "license": "MIT OR Apache-2.0",
      "license_family": "MIT OR Apache-2.0",
      "license_file": "LICENSE-APACHE",
      "summary": "A fast, ergonomic CLI tool for working with various ID formats"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "cargo auditable install --path=. --root=($prefix) --no-track --locked --bins",
          "cargo-bundle-licenses --format=yaml --output=THIRDPARTY.yml",
          "mkdir ($prefix)/share/man/man1 ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions",
          "let bin = ($prefix)/bin/idt",
          "^$bin manpage                 ($prefix)/share/man/man1",
          "^$bin completions bash | save ($prefix)/share/bash-completion/completions/idt",
          "^$bin completions fish | save ($prefix)/share/fish/vendor_completions.d/idt.fish",
          "^$bin completions zsh  | save ($prefix)/share/zsh/site-functions/_idt"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        },
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "idt",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "nushell"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "idt --help",
              "idt --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "idt"
              ],
              "files": [
                "share/man/man1/idt*.1",
                "share/bash-completion/completions/idt",
                "share/fish/vendor_completions.d/idt.fish",
                "share/zsh/site-functions/_idt"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.1.23"
      }
    ],
    "package": {
      "name": "idt",
      "version": "0.1.23"
    },
    "requirements": {
