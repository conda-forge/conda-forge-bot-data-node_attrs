    "outputs": [
      {
        "build": null,
        "name": "ocaml-gen",
        "requirements": {
          "build": [
            "ocaml_compiler_stub",
            "c_stdlib_stub",
            "ocaml-dune >=1.1"
          ],
          "host": [
            "ocaml 5.4.0.*",
            "ocaml-seq"
          ],
          "run": [
            "ocaml-seq"
          ]
        },
        "tests": [
          {
            "package_contents": {
              "files": [
                "lib/ocaml/gen/*",
                "doc/gen/*"
              ],
              "strict": true
            }
          },
          {
            "requirements": {
              "build": [
                "file",
                "binutils"
              ]
            },
            "script": {
              "content": [
                "found=0",
                "for a in $(find \"${PREFIX}/lib/ocaml/gen\" -name '*.a'); do\n  found=1\n  d=$(mktemp -d)\n  (cd \"$d\" && ar x \"$a\")\n  out=$(file -L \"$d\"/*.o)\n  echo \"$out\"\n  if echo \"$out\" | grep -v \"${ELF_ARCH}\" | grep -q .; then\n    echo \"wrong architecture in $a\"\n    exit 1\n  fi\ndone\ntest \"$found\" = 1 || { echo \"no static archive found\"; exit 1; }\nfor s in \"${PREFIX}\"/lib/ocaml/stublibs/dll*gen*.so; do\n  [ -e \"$s\" ] || continue\n  out=$(file -L \"$s\")\n  echo \"$out\"\n  echo \"$out\" | grep -q \"${ELF_ARCH}\" || exit 1\ndone\n"
              ],
              "env": {
                "ELF_ARCH": "x86-64"
              }
            }
          }
        ],
        "version": "1.1"
      },
