  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: newton-usd-schemas\n  version: \"0.8.0\"\n  build_number: 0\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name|replace(\"-\", \"_\")|lower }}-${{ version }}.tar.gz\n  sha256: c04fadc30053f699245634518d66b57a7e333ca08161a400b7a35f9fc64a5564\n  patches:\n    # The openusd conda package provides the usd-core Python distribution.\n    - use-conda-openusd-metadata.patch\n\nbuild:\n  noarch: python\n  number: ${{ build_number }}\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - hatchling\n  run:\n    - python >=${{ python_min }}\n    # Conda-forge provides openusd >=25.5 on all supported platforms.\n    # It supplies usd-core directly, so the patched Python metadata can use\n    # a single minimum version without the usd-exchange fallback.\n    - openusd >=25.5\ntests:\n  - python:\n      imports:\n        - newton_usd_schemas\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      - python -m unittest discover -v -s ./tests\n    files:\n      source:\n        - tests/\n        - pyproject.toml\n    requirements:\n      run:\n        - python ${{ python_min }}.*\n\nabout:\n  homepage: https://github.com/newton-physics/newton-usd-schemas\n  license: Apache-2.0\n  license_file: LICENSE.md\n  repository: https://github.com/newton-physics/newton-usd-schemas\n  summary: OpenUSD Schemas for Newton\n\nextra:\n  recipe-maintainers:\n    - adenzler-nvidia\n    - diegoferigo\n    - eric-heiden\n",
