  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: 2.1.0-1\n  name: giac\n\npackage:\n  name: giac\n  version: ${{ version | replace('-', '.') }}\n\nsource:\n  url: https://www-fourier.univ-grenoble-alpes.fr/~parisse/debian/dists/stable/main/source/giac_${{ version }}.tar.gz\n  sha256: cdec29897d6a55f9e53f82285ffd85cd82bcaba0bd90a494f710be002bd73f57\n  patches:\n    - 0001-giac-builds-against-libintl-on-macOS-even-with-GUI-d.patch\n    - 0002-Enable-pari-factorization-in-macOS.patch\n    - 0003-Fix-conda-relocation.patch\n    - 0004-Match-FLTK-build-output-when-building-without-FLTK.patch\n    - 0005-Do-not-confuse-std-bitset-with-pari-2.19-bitset.patch\n\nbuild:\n  number: 0\n  skip: win\n\nrequirements:\n  build:\n    - if: unix\n      then: gnuconfig\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib(\"c\") }}\n    - libtool\n    - automake\n    - gettext-tools\n    - xz-tools\n    - sed\n    - make\n    - flex\n    - bison\n  host:\n    - libblas\n    - libcblas\n    - liblapack\n    - readline\n    - gmp\n    - mpfr\n    - mpfi\n    - ntl\n    - gf2x\n    - gsl\n    - pari\n    - libpng\n    - zlib\n    - if: osx\n      then: gettext\n    - ncurses\n    - ecm\n    - glpk\n    - libcurl\n    - nauty\n  run:\n    - readline\n    - gmp\n    - mpfr\n    - mpfi\n    - ntl\n    - gf2x\n    - ${{ pin_compatible('gsl', upper_bound='x.x') }}\n    - ${{ pin_compatible('pari') }}\n    - libpng\n    - zlib\n    - if: osx\n      then: gettext\n    - ncurses\n    - ${{ pin_compatible('ecm') }}\n    - ${{ pin_compatible('glpk') }}\n    - ${{ pin_compatible('nauty', upper_bound='x') }}\n\ntests:\n  - script:\n      - test -f ${PREFIX}/include/giac/giac.h\n      - if: osx\n        then: test -f ${PREFIX}/lib/libgiac.dylib\n      - if: linux\n        then: test -f ${PREFIX}/lib/libgiac.so\n      - giac 1\n\nabout:\n  license: GPL-3.0-or-later\n  license_file: COPYING\n  summary: Giac/Xcas is a free computer algebra system\n  homepage: http://www-fourier.ujf-grenoble.fr/~