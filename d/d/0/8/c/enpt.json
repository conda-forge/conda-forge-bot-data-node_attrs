  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: enpt\n  version: \"1.4.3\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/enpt-${{ version }}.tar.gz\n  sha256: ff2382858377db89264d03c6d4d863aba627efda0d5705e0e16ec25cd8aa8679\n\nbuild:\n  number: 1\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv\n  python:\n    entry_points:\n      - enpt = enpt.cli:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - hatchling\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - acwater >=0.4.1\n    - arosics >=1.0.0\n    - cerberus\n    - gdal\n    - geoarray >=0.19.2\n    - isofit =3.4.3\n    - joblib\n    - jsmin\n    - lxml\n    - matplotlib-base\n    - mvgavg\n    - natsort\n    - numpy >=2\n    - numpy-indexed\n    - packaging\n    - pandas\n    - py-tools-ds >=0.14.25\n    - pyproj >=3.4.0\n    - scikit-image\n    - scipy\n    - sensormapgeo >=1.0.0\n    - sicor >=0.19.1\n    - tqdm\n    - utm\n  run_constraints:\n    - eccodes !=2.42.0  # classified as suspicous by ESET on Windows\n    - hygeos-core <1.3.0  # should be fixed with polymer>4.17.3\n\ntests:\n  - python:\n      imports:\n        - enpt\n        - enpt.execution\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - enpt --help\n\nabout:\n  summary: EnMAP Processing Tool\n  license: GPL-3.0-or-later\n  license_file: LICENSE\n  homepage: https://git.gfz.de/EnMAP/GFZ_Tools_EnMAP_BOX/EnPT\n\nextra:\n  recipe-maintainers:\n    - danschef\n",
