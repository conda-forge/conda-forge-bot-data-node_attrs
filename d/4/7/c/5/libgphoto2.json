  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.5.34\"\n\npackage:\n  name: libgphoto2\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/gphoto/libgphoto2/releases/download/v${{ version }}/libgphoto2-${{ version }}.tar.xz\n  sha256: 51993f5d9bfb6b4e5925cbbe5883085791bff6f81bcacb8ffe1b783ce76d586a\n\nbuild:\n  number: 2\n  skip: win\n  dynamic_linking:\n    overlinking_behavior: error\n    # The camera/port drivers link against this package's own libraries via\n    # their soname symlinks, which the overlinking check reports on Linux.\n    missing_dso_allowlist:\n      - \"**/libgphoto2*.so*\"\n  script:\n    - ./configure --prefix=$PREFIX --disable-static\n    - make -j${CPU_COUNT}\n    - make install\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - make\n    - libtool\n    - pkgconf\n    - gettext\n  host:\n    - libusb\n    - libexif\n    - libjpeg-turbo\n    - libxml2-devel\n    - gettext\n    - libltdl\n    - libiconv\n  run_exports:\n    - ${{ pin_subpackage('libgphoto2', upper_bound='x.x') }}\n\ntests:\n  - package_contents:\n      lib:\n        - gphoto2\n        - gphoto2_port\n      include:\n        - gphoto2/gphoto2.h\n  # Load the library and its camera/port drivers; needs no camera attached.\n  - script:\n      file: run_test.py\n      interpreter: python\n    requirements:\n      run:\n        - python\n\nabout:\n  homepage: http://www.gphoto.org/\n  repository: https://github.com/gphoto/libgphoto2\n  license: LGPL-2.1-or-later\n  license_file: COPYING\n  summary: Library for accessing hundreds of digital cameras over USB/serial\n  description: |\n    libgphoto2 is a C library that enables applications to access digital\n    cameras and other USB/serial devices. It supports hundreds of camera\n    models and is the foundation for the gphoto2 CLI and various image\n    management applications.\n\nextra:\n  recipe-maintainers:\n    - baradejoo\n",
