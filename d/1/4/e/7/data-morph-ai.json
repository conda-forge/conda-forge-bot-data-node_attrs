      "description": "Data Morph transforms an input dataset of 2D points into select shapes,\nwhile preserving the summary statistics to a given number of decimal\npoints through simulated annealing. It is intended to be used as a\nteaching tool to illustrate the importance of data visualization.\n",
      "dev_url": "https://github.com/stefmolin/data-morph",
      "doc_url": "https://stefaniemolin.com/data-morph",
      "home": "https://stefaniemolin.com/data-morph",
      "license": "MIT",
      "license_file": "LICENSE",
      "summary": "Teaching tool on the importance of data visualization."
    },
