  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"1.0.0\"\n  python_check_max: \"3.14\"\n  cov_fail_under: \"100\"\n\npackage:\n  name: pylsqpack\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/p/pylsqpack/pylsqpack-${{ version }}.tar.gz\n  sha256: 4674adc2c833c1c70a36454f5774e9def94fc3109e4a8464d804af2a2030957a\n\nbuild:\n  number: 0\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n  script:\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check --check-build-dependencies\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - if: build_platform != target_platform\n      then:\n        - cross-python_${{ target_platform }}\n        - python\n  host:\n    - pip\n    - setuptools\n    - if: is_abi3\n      then:\n        - python ${{ python_min }}.*\n        - python-abi3\n      else:\n        - python\n  run:\n    - if: is_abi3\n      then:\n        - python >=${{ python_min }}\n        - python-abi3\n      else:\n        - python\n\ntests:\n  - package_contents:\n      strict: true\n      files:\n        - etc/conda/test-files/pylsqpack/**\n      site_packages:\n        - pylsqpack/**\n        - pylsqpack-${{ version }}.dist-info/**\n  - python:\n      imports: pylsqpack._binding\n      pip_check: true\n      python_version:\n        - if: is_abi3\n          then:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n          else:\n            - \"*\"\n  - files:\n      source:\n        - tests/\n    requirements:\n      run:\n        - coverage\n        - mypy\n        - pytest\n        - if: is_abi3\n          then:\n            - python ${{ python_min }}.*\n            - abi3audit\n    script:\n      - coverage run --source=pylsqpack --branch -m pytest -vv --tb=long --color=yes\n      - if: linux\n        then: coverage report --show-missing --skip-covered --fail-under=${{ cov_fail_under }}\n      - mypy -p pylsqpack\n      - if: is_abi3\n        then:\n          - if: unix\n            then: abi3audit -s -v --assume-minimum-abi3 ${{ python_min }} \"${SP_DIR}/pylsqpack/_binding.abi3.so\"\n            else: abi3audit -s -v --assume-minimum-abi3 ${{ python_min }} \"%SP_DIR%\\pylsqpack\\_binding.pyd\"\n\nabout:\n  summary: Python wrapper for the ls-qpack QPACK library\n  license: MIT AND BSD-3-Clause\n  license_file:\n    - LICENSE\n    - vendor/ls-qpack/LICENSE\n  homepage: https://pypi.org/project/pylsqpack\n  repository: https://github.com/aiortc/pylsqpack\n  documentation: https://pylsqpack.readthedocs.io\n\nextra:\n  recipe-maintainers:\n    - jonashaag\n    - bollwyvl\n",
