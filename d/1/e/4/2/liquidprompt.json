  "raw_meta_yaml": "{% set name = \"liquidprompt\" %}\n{% set version = \"2.1.2\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  fn: {{ name }}-{{ version }}.tar.gz\n  url: https://github.com/{{ name }}/{{ name }}/archive/v{{ version }}.tar.gz\n  sha256: f752f46595519befd1ad83eaa3605cfc05babd485250a0b46916d8eacabf4f26\n\nbuild:\n  number: 1\n  # The c stdlib is only in the build requirements to satisfy the osx CI\n  # build scripts; its run_exports would otherwise pin __osx >=11.0 on a\n  # package of shell scripts that runs on any macOS.\n  ignore_run_exports:\n    - __osx  # [osx]\n\nrequirements:\n  build:\n    # Required by the osx CI build scripts whenever the config sets\n    # MACOSX_DEPLOYMENT_TARGET, even though nothing here is compiled.\n    - {{ stdlib('c') }}  # [osx]\n    - sed  # [osx]\n    - m2-base  # [win]\n  run:\n    - m2-base  # [win]\n\ntest:\n  commands:\n    - grep -q '${CONDA_PREFIX}' $PREFIX/etc/conda/activate.d/liquidprompt.sh  # [not win]\n    - grep -q '${CONDA_PREFIX}' %PREFIX%\\etc\\conda\\activate.d\\liquidprompt.sh  # [win]\n    - grep -q 'LP_MARK_PREFIX' $PREFIX/etc/conda/activate.d/liquidprompt.sh  # [not win]\n    - grep -q 'LP_MARK_PREFIX' %PREFIX%\\etc\\conda\\activate.d\\liquidprompt.sh  # [win]\n    - grep -q 'LP_MARK_PREFIX' $PREFIX/etc/conda/deactivate.d/liquidprompt.sh  # [not win]\n    - grep -q 'LP_MARK_PREFIX' %PREFIX%\\etc\\conda\\deactivate.d\\liquidprompt.sh  # [win]\n    - '! grep -q export $PREFIX/etc/conda/activate.d/liquidprompt.sh'  # [not win]\n\nabout:\n  home: https://github.com/nojhan/liquidprompt\n  license: AGPL-3.0-only\n  license_file: LICENSE\n  summary: A full-featured & carefully designed adaptive prompt for Bash & Zsh\n\n  description: |\n    Liquid Prompt gives you a nicely displayed prompt with useful \n    information when you need it. It shows you what you need when you need\n    it. You will notice what changes when it changes, saving time and \n    frustration. You can even use it with your favorite shell – Bash or zsh.\n  doc_url: https://github.com/nojhan/liquidprompt/blob/master/README.md\n  dev_url: https://github.com/nojhan/liquidprompt\n\nextra:\n  recipe-maintainers:\n    - sodre\n",
