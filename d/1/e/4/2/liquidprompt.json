    },
    "test": {
      "commands": [
        "test -f $PREFIX/etc/liquidprompt/themes/unfold/unfold.theme",
        "test -f $PREFIX/etc/liquidprompt/themes/powerline/powerline.theme",
        "test -f $PREFIX/etc/liquidprompt/themes/alternate_vcs/alternate_vcs.theme",
        "grep -q '${CONDA_PREFIX}' $PREFIX/etc/conda/activate.d/liquidprompt.sh",
        "grep -q 'lp_theme unfold' $PREFIX/etc/conda/activate.d/liquidprompt.sh",
        "grep -q 'themes/\\*/\\*.theme' $PREFIX/etc/conda/activate.d/liquidprompt.sh",
        "! grep -q export $PREFIX/etc/conda/activate.d/liquidprompt.sh"
      ]
    }
