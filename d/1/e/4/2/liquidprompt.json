  "raw_meta_yaml": "{% set name = \"liquidprompt\" %}\n{% set version = \"2.3.0\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  # The release asset, not the git archive: upstream only ships the generated\n  # example config (liquidpromptrc-dist) in the release tarball.\n  url: https://github.com/{{ name }}/{{ name }}/releases/download/v{{ version }}/{{ name }}-v{{ version }}.tar.gz\n  sha256: ff274d36f47f4fb6a34c6eb1eae2d58e51944a863b74031ff29c6c03ab011ec3\n\nbuild:\n  number: 1\n  # The c stdlib is only in the build requirements to satisfy the osx CI\n  # build scripts; its run_exports would otherwise pin __osx >=11.0 on a\n  # package of shell scripts that runs on any macOS.\n  ignore_run_exports:\n    - __osx  # [osx]\n\nrequirements:\n  build:\n    # Required by the osx CI build scripts whenever the config sets\n    # MACOSX_DEPLOYMENT_TARGET, even though nothing here is compiled.\n    - {{ stdlib('c') }}  # [osx]\n    - sed  # [osx]\n    - m2-base  # [win]\n  run:\n    - m2-base  # [win]\n\ntest:\n  commands:\n    - test -f $PREFIX/etc/liquidprompt/themes/unfold/unfold.theme  # [not win]\n    - test -f $PREFIX/etc/liquidprompt/themes/powerline/powerline.theme  # [not win]\n    - test -f $PREFIX/etc/liquidprompt/themes/alternate_vcs/alternate_vcs.theme  # [not win]\n    - if not exist %PREFIX%\\Library\\etc\\liquidprompt\\themes\\unfold\\unfold.theme exit 1  # [win]\n    - grep -q '${CONDA_PREFIX}' $PREFIX/etc/conda/activate.d/liquidprompt.sh  # [not win]\n    - grep -q '${CONDA_PREFIX}' %PREFIX%\\etc\\conda\\activate.d\\liquidprompt.sh  # [win]\n    - grep -q 'lp_theme unfold' $PREFIX/etc/conda/activate.d/liquidprompt.sh  # [not win]\n    - grep -q 'themes/\\*/\\*.theme' $PREFIX/etc/conda/activate.d/liquidprompt.sh  # [not win]\n    - grep -q 'lp_theme unfold' %PREFIX%\\etc\\conda\\activate.d\\liquidprompt.sh  # [win]\n    - '! grep -q export $PREFIX/etc/conda/activate.d/liquidprompt.sh'  # [not win]\n\nabout:\n  home: https://github.com/nojhan/liquidprompt\n  license: AGPL-3.0-only\n  license_file: LICENSE\n  summary: A full-featured & carefully designed adaptive prompt for Bash & Zsh\n\n  description: |\n    Liquid Prompt gives you a nicely displayed prompt with useful \n    information when you need it. It shows you what you need when you need\n    it. You will notice what changes when it changes, saving time and \n    frustration. You can even use it with your favorite shell – Bash or zsh.\n  doc_url: https://github.com/nojhan/liquidprompt/blob/master/README.md\n  dev_url: https://github.com/nojhan/liquidprompt\n\nextra:\n  recipe-maintainers:\n    - sodre\n",
