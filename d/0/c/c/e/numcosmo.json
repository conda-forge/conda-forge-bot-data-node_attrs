  "raw_meta_yaml": "{% set name = \"numcosmo\" %}\n{% set version = \"0.29.0\" %}\n{% set build = 0 %}\n{% set sha256 = \"eed6277d25199c602430b3806352b2bf6fbd0ec4f0374440cbd3a3deb2497079\" %}\n{% set nonmpi_build = build + 100 %}\n\npackage:\n  name: {{ name }}\n  version: {{ version }}\n\nsource:\n  url: https://github.com/NumCosmo/NumCosmo/releases/download/v{{ version }}/numcosmo-{{ version }}.tar.xz\n  sha256: {{ sha256 }}\n\n# ensure mpi is defined (needed for conda-smithy recipe-lint)\n{% set mpi = mpi or 'nompi' %}\n\nbuild:\n  skip: true  # [py<311 or win or (python_impl=='pypy')]\n  number: {{ nonmpi_build }}  # [mpi == \"nompi\"]\n  string: \"nompi_h{{ PKG_HASH }}_{{ nonmpi_build }}\"  # [mpi == \"nompi\"]\n  number: {{ build }}  # [mpi != \"nompi\"]\n  string: \"mpi_{{ mpi }}_h{{ PKG_HASH }}_{{ build }}\"  # [mpi != \"nompi\"]\n  run_exports:   # [mpi != \"nompi\"]\n    - {{ name }} * mpi_{{ mpi }}_*                     # [mpi != \"nompi\"]\n  detect_binary_files_with_prefix: true\n  ignore_run_exports_from:\n    - libfabric-devel\n\nrequirements:\n  build:\n    - python\n    - cross-python_{{ target_platform }}     # [build_platform != target_platform]\n    - meson\n    - ninja\n    - pkg-config\n    - pip\n    - pygobject\n    - {{ compiler('c') }}\n    - {{ compiler('fortran') }}\n    - {{ stdlib('c') }}\n    - gobject-introspection\n    - {{ mpi }}              # [build_platform != target_platform and mpi != 'nompi']\n    - libfabric-devel        # [build_platform != target_platform and mpi != 'nompi']\n    - libblas                # [build_platform != target_platform]\n    - libcblas               # [build_platform != target_platform]\n    - liblapack              # [build_platform != target_platform]\n    - glib                   # [build_platform != target_platform]\n    - gsl                    # [build_platform != target_platform]\n    - gmp                    # [build_platform != target_platform]\n    - mpfr                   # [build_platform != target_platform]\n    - fftw                   # [build_platform != target_platform]\n    - nlopt                  # [build_platform != target_platform]\n    - cfitsio                # [build_platform != target_platform]\n    - arb                    # [build_platform != target_platform]\n    - hdf5                   # [build_platform != target_platform]\n    - zlib                   # [build_platform != target_platform]\n  host:\n    - {{ mpi }}  # [mpi != 'nompi']\n    - libfabric-devel  # [mpi != 'nompi']\n    - libblas\n    - libcblas\n    - liblapack\n    - glib\n    - gsl\n    - gmp\n    - mpfr\n    - fftw\n    - nlopt\n    - cfitsio\n    - arb\n    - hdf5\n    - python\n    - pygobject\n    - pygobject-stubs\n    - zlib\n  run:\n    - {{ mpi }}  # [mpi != 'nompi']\n    - libcurl\n    - fftw\n    - nlopt\n    - cfitsio\n    - pygobject\n    - pygobject-stubs\n    - gobject-introspection\n    - numpy\n    - scipy\n    - matplotlib-base\n    - astropy-base\n    - getdist\n    - networkx\n    - pydantic\n    - tabulate\n    - tqdm\n    - python\n    - rich\n    - typer\n    - zlib\n\ntest:\n  requires:\n    - pip\n    - pygobject\n    - openssh  # [mpi == 'openmpi']\n  commands:\n    - test -f ${PREFIX}/lib/libnumcosmo{{ SHLIB_EXT }}   # [not win]\n    - numcosmo --help\n    - $PYTHON -c \"import numcosmo_py.analysis, numcosmo_py.app, numcosmo_py.catalog, numcosmo_py.ccl, numcosmo_py.certified, numcosmo_py.datasets, numcosmo_py.experiments, numcosmo_py.external, numcosmo_py.interpolation, numcosmo_py.plotting, numcosmo_py.sampling\"\n    - $PYTHON -m pip check\n    - $PYTHON ${PREFIX}/share/numcosmo-{{ version }}/examples/example_simple.py\n\nabout:\n  home: https://numcosmo.github.io/\n  license: GPL-3.0-or-later\n  license_file: COPYING\n  summary: 'NumCosmo is a free software C library whose main purposes are to test cosmological models using observational data and to provide a set of tools to perform cosmological calculations.'\n\nextra:\n  recipe-maintaine