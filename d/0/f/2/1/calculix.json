  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: calculix\n  version: \"2.24\"\n  sha256: 99fb4f9b0ec19b100a914c3a097ea1e7f0c22f715b96338acc4a66b63306a2e2\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: http://www.dhondt.de/ccx_${{ version }}.src.tar.bz2\n  sha256: ${{ sha256 }}\n  patches:\n    - patches/avoid-ifport.patch\n    # 2.24 moved the sources from ccx_2.23/ to ccx_2.24/, so every patch\n    # below was regenerated against the new tree.  The fixes that were taken\n    # upstream are no longer carried: they are in 2.24 itself.\n    #\n    # still submitted upstream, not in 2.24\n    - patches/upstream-mohrcoulomb-degenerate-return.patch\n    - patches/upstream-readfrd-return-value.patch\n    # 2.23 creates and joins threads for every loop of every *CFD iteration,\n    # so small meshes run several times slower threaded than on one core\n    - patches/fix-cfd-small-mesh-threads.patch\n    # a rotational SPC or moment on a plane stress, plane strain or\n    # axisymmetric node reaches the mean rotation code, which sets its loop\n    # bounds only for shells and beams; FreeCAD/FreeCAD#10865\n    - patches/fix-2d-rotational-dofs.patch\n    # found by AddressSanitizer and by poisoning uninitialised memory over\n    # CalculiX's suite and FreeCAD's FEM test models\n    - patches/fix-cd-lab-correction-edges.patch\n    # calls whose arguments do not line up with the routine called, found by\n    # checking every call against its callee\n    - patches/fix-flux-rcavi-physcon.patch\n    # face-to-face contact with PRESSURE-OVERCLOSURE=TABULAR used the old\n    # 82-entry layout of plconloc that materialdata_sp.f no longer fills\n    - patches/fix-f2f-tabular-overclosure.patch\n    # found by AddressSanitizer on FreeCAD's ccx_1D_fluid_network example\n    - patches/fix-preinitialnet-inlet-neighbor.patch\n    # crashes, hangs and silent out-of-bounds accesses on malformed input,\n    # found by fuzzing 518 decks under AddressSanitizer; each such input now\n    # ends in an *ERROR and exit code 201\n    - patches/fix-malformed-input-nodes-elements.patch\n    - patches/fix-malformed-input-sets-sections.patch\n    - patches/fix-malformed-input-fluid.patch\n    - patches/fix-malformed-input-materials.patch\n    - patches/fix-malformed-input-parsing.patch\n    # two fluid network loops that test the wrong element; these change\n    # results for valid models\n    - patches/fix-fluid-network-labels.patch\n    - patches/fix-malformed-input-misc.patch\n    - patches/fix-malformed-input-followups.patch\n    # mingw has no clock_gettime and the timing print was already disabled\n    # on Windows and macOS before 2.24; keep it that way\n    - if: win or osx\n      then: patches/mingw_time.patch\n\nbuild:\n  number: 0\n\nrequirements:\n  build:\n    - make\n    - perl\n    - if: unix\n      then:\n        - ${{ compiler(\"c\") }}\n        - ${{ stdlib(\"c\") }}\n        - ${{ compiler(\"fortran\") }}\n    - if: win\n      then:\n        - ${{ compiler('m2w64_c') }}\n        - ${{ stdlib('m2w64_c') }}\n        - ${{ compiler('m2w64_fortran') }}\n    - if: osx\n      then:\n        - llvm-openmp\n  host:\n    - libblas\n    - liblapack\n    - arpack\n    # spoolesMT.a is linked statically and its data races were only fixed in\n    # build 1006, so an older build bakes silently wrong threaded results into\n    # ccx with nothing at run time to express the constraint; see Makefile_MT\n    - spooles[version ='>=2.2',build_number='>=1006']\n    - if: osx\n      then:\n        - llvm-openmp\n  run:\n    - arpack\n    - if: osx\n      then:\n        - llvm-openmp\n\ntests:\n  - script:\n      - if: unix\n        then: test -f $PREFIX/bin/ccx\n      - if: win\n        then: if not exist %LIBRARY_PREFIX%\\bin\\ccx.exe exit 1\n  # a build that links but miscomputes has shipped from here before, so\n  # actually solve something and check the numbers\n  - script: python run_test.py\n    files:\n      recipe:\n        - run_test.py\n        - smoketest.inp\n        - contact.inp\n        - contact.dat.ref\n        - mohr.inp\n        - restart.inp\n        - cfd.inp\n        - cfd.dat.ref\n        - axirot.inp\n        - axirotload.inp\n        - hcfnoinput.inp\n        - bleedtap.inp\n    requirements:\n      run:\n        - python\n\nabout:\n  license: GPL-2.0-or-later\n  license_file: LICENSE\n  summary: 3D Structural Finite Element Program\n  description: A Free Software Three-Dimensional Structural Finite Element Program\n  homepage: https://www.dhondt.de/\n  repository: https://github.com/Dhondtguido/CalculiX\n  documentation: https://www.dhondt.de/ccx_${{ version }}.pdf\n\nextra:\n  recipe-maintainers:\n    - oursland\n    - looooo\n    - Krande\n",
