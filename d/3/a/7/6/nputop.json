    "about": {
      "description": "Monitor Ascend devices and processes through DCMI or npu-smi.\nLive telemetry requires Linux and an installed Ascend driver.\n",
      "dev_url": "https://github.com/youyve/nputop",
      "doc_url": "https://github.com/youyve/nputop",
      "home": "https://github.com/youyve/nputop",
      "license": "Apache-2.0 AND GPL-3.0-only",
      "license_file": [
        "LICENSE",
        "COPYING",
        "NOTICE"
      ],
      "summary": "An interactive Ascend NPU and process monitor"
    },
    "build": {
      "entry_points": [
        "nputop = nputop.cli:main"
      ],
      "number": "0",
      "script": "PYTHON -m pip install . -vv --no-build-isolation --no-deps"
    },
    "extra": {
      "recipe-maintainers": [
        "youyve"
      ]
    },
    "package": {
      "name": "nputop",
      "version": "0.1.0"
    },
    "requirements": {
      "host": [
        "python",
        "pip",
        "setuptools >=61",
        "wheel"
      ],
      "run": [
        "python",
        "psutil >=5.6.6",
        "cachetools >=1.0.1",
        "termcolor >=1.0.0"
      ]
    },
    "schema_version": 0,
    "source": {
