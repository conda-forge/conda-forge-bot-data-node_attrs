  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"5.0.0\"\n\npackage:\n  name: splink\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/s/splink/splink-${{ version }}.tar.gz\n  sha256: 389dfc2669b08889324571d5ef19a068bc8901e3a6ea1cc5c23af95fbe021177\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - hatchling\n  run:\n    - python >=${{ python_min }}\n    - python-duckdb >=0.9.2\n    - pyarrow >=18.0.0\n    - sqlglot >=17.6.0\n  run_constraints:\n    # optional dependencies (extras) as of splink 5.0\n    - altair >=5.0.1\n    - numpy >=1.19.3\n    - pandas >=1.3.5\n    - python-igraph >=0.11.2\n    - rapidfuzz >=3.10.0\n    - pyspark >=3.5.0\n    - sqlalchemy >=2.0.0\n\ntests:\n  - python:\n      imports:\n        - splink\n      pip_check: true\n      # Test on both the oldest supported and the newest available Python.\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\nabout:\n  homepage: https://github.com/moj-analytical-services/splink\n  license: MIT\n  license_family: MIT\n  license_file: LICENSE\n  summary: Fast, accurate and scalable probabilistic data linkage using your choice of SQL backend.\n  documentation: https://moj-analytical-services.github.io/splink/\n\nextra:\n  recipe-maintainers:\n    - ThomasHepworth\n    - ADBond\n",
