      "description": "pyglenn is a Python package for calculating thermochemical properties (heat capacity, enthalpy, entropy) of chemical species using NASA-7 polynomial coefficients. It converts FORTRAN thermo.inp files into a normalized SQLite3 database and provides both a Python API and a command-line interface.",
      "dev_url": "https://github.com/ProfLeao/pyglenn",
      "doc_url": "https://profleao.github.io/pyglenn",
      "home": "https://github.com/ProfLeao/pyglenn",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Thermochemical properties calculator — computes Cp(T), H°(T), S°(T) from NASA polynomial coefficients stored in SQLite."
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "pyglenn = pyglenn.cli:main"
        ]
      },
      "script": "python -m pip install . --no-deps --no-build-isolation -vv"
    },
