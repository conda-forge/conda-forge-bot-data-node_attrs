  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: 1.0.0b12\n  npm_version: ${{ version | replace(\"b\", \"-beta.\") }}\n\npackage:\n  name: cloudflare-cli\n  version: ${{ version }}\n\nsource:\n  url: https://registry.npmjs.org/cf/-/cf-${{ npm_version }}.tgz\n  sha256: 2c668df92ba9b73c50ab5b8495bc00ef51f3064dde9ff70b3d9c02c8e4cb3076\n\nbuild:\n  number: 0\n  # bundles prebuilt workerd and sharp binaries from npm\n  dynamic_linking:\n    binary_relocation: false\n  prefix_detection:\n    ignore_binary_files: true\n  script:\n    - if: unix\n      then:\n        - npm pack --ignore-scripts\n        - npm install -ddd --global --allow-scripts=workerd ./cf-${{ npm_version }}.tgz\n        - pnpm install --prod --ignore-scripts\n        - pnpm-licenses generate-disclaimer --prod --output-file=third-party-licenses.txt\n      else:\n        - call npm pack --ignore-scripts\n        - if errorlevel 1 exit 1\n        - call npm install -ddd --global --allow-scripts=workerd .\\cf-${{ npm_version }}.tgz\n        - if errorlevel 1 exit 1\n        - call pnpm install --prod --ignore-scripts\n        - if errorlevel 1 exit 1\n        - call pnpm-licenses generate-disclaimer --prod --output-file=third-party-licenses.txt\n        - if errorlevel 1 exit 1\n\nrequirements:\n  build:\n    - nodejs\n    - pnpm\n    - pnpm-licenses\n  host:\n    - nodejs >=22\n  run:\n    - nodejs >=22\n\ntests:\n  - script:\n      - cf --help\n      - cf --version\n      - cloudflare --help\n\nabout:\n  homepage: https://github.com/cloudflare/cf\n  summary: The agentic CLI for the entire Cloudflare API\n  description: |\n    cf is Cloudflare's command-line interface for managing Cloudflare\n    products and the Cloudflare API, including Workers, R2, D1, KV, DNS\n    and Zero Trust.\n  license: MIT OR Apache-2.0\n  license_file:\n    - LICENSE-MIT\n    - LICENSE-APACHE\n    - third-party-licenses.txt\n  repository: https://github.com/cloudflare/cf\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
