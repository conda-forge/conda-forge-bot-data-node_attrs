      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE.md",
      "summary": "Object-Oriented HTTP framework"
    },
    "build": {
      "noarch": "python",
      "number": "3",
      "python": {
        "entry_points": [
          "cherryd = cherrypy.__main__:run"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check --check-build-dependencies"
