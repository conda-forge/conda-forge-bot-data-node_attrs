  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: python-msilib\n  version: \"0.7.2\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name|replace(\"-\", \"_\") }}-${{ version }}.tar.gz\n  sha256: 2e4175bbcaa7238b84077f7aa5fc77370e1d182daecca930e726a098f0d8c07e\n  patches:\n    - py310.patch\n\nbuild:\n  number: 0\n  script: python -m pip install . -vv --no-deps --no-build-isolation\n  skip: not win\n\nrequirements:\n  build:\n    - if: build_platform != host_platform\n      then:\n        - python\n        - cross-python_${{ host_platform }}\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n  host:\n    - python\n    - pip\n    - setuptools >=78.1.1,<84\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - msilib\n  - files:\n      source:\n        - pyproject.toml\n        - tests\n    requirements:\n      run:\n        - coverage >=7.13.0\n        - pytest >=9.0.3\n    script:\n      - coverage run\n\nabout:\n  license: PSF-2.0\n  license_file: LICENSE\n  summary: Read and write Microsoft Installer files.\n  description: |\n    This library is legacy code borrowed from Python 3.12, intended to allow\n    cx_Freeze's bdist_msi command to continue working in Python 3.13+. \n  homepage: https://github.com/marcelotduarte/python-msilib\n  documentation: https://docs.python.org/3.12/library/msilib.html\n\nextra:\n  recipe-maintainers:\n    - marcelotduarte\n",
