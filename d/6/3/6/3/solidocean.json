    "about": {
      "description": "SolidOcean is a free and open-source finite element tool for 3D structures: phonon dispersion and\neigenfrequencies of periodic and finite structures, static and driven solid mechanics, and heat\ntransfer. A desktop interface takes a model from geometry and mesh to physics, study and results;\nevery model is a human-readable TOML file that can also be run headless from the command line.",
      "dev_url": "https://github.com/anufrievroman/solidocean",
      "doc_url": "https://anufrievroman.gitbook.io/solidocean",
      "home": "https://github.com/anufrievroman/solidocean",
      "license": "GPL-3.0-or-later",
      "license_family": "GPL-3.0-or-later",
      "license_file": "LICENSE",
      "summary": "Finite element tool for 3D structures, with phonons, solid mechanics and heat transfer"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "solidocean = solidocean.cli:main"
        ]
      },
      "script": [
        "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation",
        "${{ PYTHON }} ${{ RECIPE_DIR }}/menu/install_menu.py"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "anufrievroman"
      ]
    },
