  "raw_meta_yaml": "context:\n  name: solidocean\n  version: \"0.1.3\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/anufrievroman/solidocean/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 7b2baeb09890a011317a1ca1ca8daa2a5c9c6e865045049eb2888df380f3e8d7\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n    # desktop shortcut (menuinst): the shortcut definition and its icons in $PREFIX/Menu\n    - ${{ PYTHON }} ${{ RECIPE_DIR }}/menu/install_menu.py\n  python:\n    entry_points:\n      - solidocean = solidocean.cli:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools >=77\n    - pillow\n  run:\n    - python >=${{ python_min }}\n    - numpy\n    - scipy\n    - python-gmsh\n    - matplotlib-base\n    - tomli-w\n    - python-mumps\n    - pyside6\n    - pyvista\n    - pyvistaqt\n    - pillow\n\ntests:\n  - python:\n      imports:\n        - solidocean\n        - solidocean.fem\n        - solidocean.physics\n        - solidocean.gui.app\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      - solidocean --help\n      # mesh and solve a small model headless\n      - solidocean --template heat_bar bar.toml\n      - solidocean bar.toml\n\nabout:\n  homepage: https://github.com/anufrievroman/solidocean\n  repository: https://github.com/anufrievroman/solidocean\n  documentation: https://anufrievroman.gitbook.io/solidocean\n  summary: Finite element tool for 3D structures, with phonons, solid mechanics and heat transfer\n  description: |\n    SolidOcean is a free and open-source finite element tool for 3D structures: phonon dispersion and\n    eigenfrequencies of periodic and finite structures, static and driven solid mechanics, and heat\n    transfer. A desktop interface takes a model from geometry and mesh to physics, study and results;\n    every model is a human-readable TOML file that can also be run headless from the command line.\n  license: GPL-3.0-or-later\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - anufrievroman\n",
