  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.1.1\"\n\npackage:\n  name: pythoncdt\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/p/pythoncdt/pythoncdt-${{ version }}.tar.gz\n  sha256: a2377770da802172844e5abff53825ead8a68c5414c535ddbcc492ba7d3e5cd8\n\nbuild:\n  number: 0\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - pybind11\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - make\n  host:\n    - python\n    - pip\n    - scikit-build-core >=0.11\n    - pybind11 >=3.0.4\n    - setuptools-scm >=8\n    - hatch-fancy-pypi-readme >=22.3\n  run:\n    - python\n    - numpy\n\ntests:\n  - python:\n      imports:\n        - pythoncdt\n      pip_check: true\n  - files:\n      source:\n        - tests/\n        - CDT/visualizer/data/\n    requirements:\n      run:\n        - pytest\n    script:\n      - pytest tests -v\n\nabout:\n  homepage: https://github.com/artem-ogre/PythonCDT\n  summary: 'Python bindings for CDT: constrained Delaunay triangulation'\n  license: MPL-2.0 AND BSD-3-Clause AND Apache-2.0 WITH LLVM-exception\n  # CDT is bundled as source; its predicates.h is BSD-3-Clause and\n  # portable_nth_element.hpp comes from LLVM's libc++\n  license_file:\n    - LICENSE\n    - CDT/CDT/LICENSE\n    - CDT/CDT/LICENSE-predicates.txt\n    - CDT/CDT/LICENSE-LLVM.txt\n  repository: https://github.com/artem-ogre/PythonCDT\n\nextra:\n  recipe-maintainers:\n    - artem-ogre\n    - mdealencar\n",
