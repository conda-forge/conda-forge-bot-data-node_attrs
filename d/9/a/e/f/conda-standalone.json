  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"26.9.4\"\n  conda_version: ${{ version | replace(\".post1\", \"\") }}\n  conda_libmamba_solver_version: \"26.7.0\"\n  libmambapy_version: \"2.8.1\"\n  constructor_lower_bound: \"3.15.3\"\n  menuinst_lower_bound: \"2.5.2\"\n  python_version: \"3.13.14\"\n\npackage:\n  name: conda-standalone\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/conda/conda-standalone/archive/${{ version }}.tar.gz\n    sha256: a181934ff65359115f3b695f474cea8ba4c78b517876183cb781d8baa26a95ea\n  - url: https://github.com/conda/conda/archive/${{ conda_version }}.tar.gz\n    sha256: 0b084bdaac353c6b1ce8aa6be860d9348eca2b6ba26a3741d615fd704641a1fd\n    target_directory: conda_src\n    patches:\n      - ${{ SRC_DIR }}/src/conda_patches/0001-Rename-and-replace-entrypoint-stub-exe.patch\n      - ${{ SRC_DIR }}/src/conda_patches/0002-Manipulate-PATH-directly-instead-of-_call_ing-conda.patch\n      - ${{ SRC_DIR }}/src/conda_patches/0003-Restrict-search-paths.patch\n      - ${{ SRC_DIR }}/src/conda_patches/0004-Fix-conda-run.patch\n\nbuild:\n  number: 0\n\nrequirements:\n  build:\n    - if: osx and x86_64\n      then: ${{ stdlib('c') }}\n    # https://github.com/conda/conda-standalone/issues/308\n    - pyinstaller <6.22.1\n    - python =${{ python_version }}\n    - conda =${{ conda_version }}\n    - conda-package-handling >=2.3.0\n    - conda-package-streaming >=0.9.0\n    - menuinst >=${{ menuinst_lower_bound }}\n    - conda-libmamba-solver =${{ conda_libmamba_solver_version }}\n    - libmambapy =${{ libmambapy_version }}\n    - archspec >=0.2.3\n  ignore_run_exports:\n    from_package:\n      - ${{ stdlib('c') }}\n  run_constraints:\n    - constructor >=${{ constructor_lower_bound }}\n\ntests:\n  - files:\n      source:\n        - tests\n    requirements:\n      run:\n        - conda =${{ conda_version }}\n        - conda-build\n        - pytest\n        - menuinst =${{ menuinst_lower_bound }}\n        - ruamel.yaml\n    script:\n      - pytest -vv -k \"not test_uninstallation\"\n  - package_contents:\n      strict: true\n      files:\n        - standalone_conda/conda.exe\n        # These are added in the previous step\n        - etc/conda/test-files/conda-standalone/*\n\nabout:\n  license: LicenseRef-CondaStandalone\n  license_file:\n    - LICENSE\n    - 3rd-party-licenses.json\n  summary: Entry point and dependency collection for PyInstaller-based standalone conda.\n  homepage: https://github.com/conda/conda-standalone\n\nextra:\n  recipe-maintainers:\n    - marcoesters\n    - jaimergp\n    - jakirkham\n    - msarahan\n    - forrestwaters\n    - nehaljwani\n",
