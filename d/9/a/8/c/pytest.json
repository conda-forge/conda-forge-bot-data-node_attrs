  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: 9.2.0\n  python_min: '3.10'\n\npackage:\n  name: pytest\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/pytest/pytest-${{ version }}.tar.gz\n  sha256: 97c4f3b1f3c7414aa36465e09b8220f1d03627993bd51b1282e193753c80557b\n\nbuild:\n  number: 1\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv\n  python:\n    entry_points:\n      - pytest = _pytest.config:_console_main\n      - py.test = _pytest.config:_console_main\n\nrequirements:\n  host:\n    - pip\n    - python ${{ python_min }}.*\n    - setuptools >=77\n    - setuptools_scm >=10.1\n  run:\n    # Do not remove 'colorama': always included, even on non-Windows, to keep package no-arch (#206).\n    - colorama\n    - python >=${{ python_min }}\n    - exceptiongroup >=1\n    - iniconfig >=2\n    - packaging >=24\n    - pluggy >=1.6,<2\n    - pygments >=2.15\n    - tomli >=2\n\n  run_constraints:\n    - pytest-faulthandler >=2\n\ntests:\n  - python:\n      imports:\n        - pytest\n      python_version:\n        - ${{ python_min }}.*\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - pip check\n      - pytest -h\n\nabout:\n  license: MIT\n  license_file: LICENSE\n  summary: Simple and powerful testing with Python.\n  description: |\n    The pytest framework makes it easy to write small tests, yet scales to\n    support complex functional testing for applications and libraries.\n  homepage: https://docs.pytest.org/en/latest/\n  repository: https://github.com/pytest-dev/pytest/\n  documentation: https://docs.pytest.org/en/latest/\n\nextra:\n  recipe-maintainers:\n    - flub\n    - goanpeca\n    - nicoddemus\n    - ocefpaf\n    - mingwandroid\n",
