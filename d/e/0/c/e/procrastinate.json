  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"3.12.0\"\n\npackage:\n  name: procrastinate\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/procrastinate-org/procrastinate/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 9e6f0cf69cb9213ba934adbbb6c0eab8bc3fb65e534f5c300f26e40422989531\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    env:\n      UV_DYNAMIC_VERSIONING_BYPASS: ${{ version }}\n    content:\n      - ${{ PYTHON }} -m pip install . -vv\n  python:\n    entry_points:\n      - procrastinate = procrastinate.cli:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - hatchling\n    - uv-dynamic-versioning\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - psycopg\n    - psycopg-pool\n    - asgiref\n    - attrs\n    - croniter\n    - python-dateutil\n    - typing_extensions\n    - packaging\n\ntests:\n  - python:\n      imports:\n        - procrastinate\n      pip_check: true\n      python_version:\n        - '*'\n        - ${{ python_min }}.*\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      - procrastinate --help\n  - requirements:\n      run:\n        - pytest\n        - pytest-asyncio\n        - pytest-mock\n        - pytest-django\n        - pytest-benchmark\n        - pytest-cov\n        - sphinx\n        - django\n    script:\n      - if: win\n        then: >\n          pytest tests/unit\n          --ignore=tests/unit/contrib\n          --ignore=tests/unit/test_signals.py\n          --deselect \"tests/unit/test_worker.py::test_worker_run_respects_polling\"\n          --deselect \"tests/unit/test_schema.py::test_get_migrations_path\"\n          --deselect \"tests/unit/test_utils.py::test_get_module_name_path3\"\n          --deselect \"tests/unit/test_worker.py::test_worker_run_wait_stop\"\n          --deselect \"tests/unit/test_worker.py::test_worker_run_once_log_messages\"\n          --deselect \"tests/unit/test_worker.py::test_run_no_signal_handlers