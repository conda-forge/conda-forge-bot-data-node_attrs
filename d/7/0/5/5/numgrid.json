    "about": {
      "description": "NumGrid is a library that produces numerical integration grids for\nmolecules based on atom coordinates, atom types, and basis set\ninformation. It provides Rust and Python bindings.",
      "dev_url": "https://github.com/dftlibs/numgrid",
      "doc_url": "https://github.com/dftlibs/numgrid",
      "home": "https://github.com/dftlibs/numgrid",
      "license": "MPL-2.0",
      "license_family": "MPL-2.0",
      "license_file": "LICENSE",
      "summary": "Numerical integration grid for molecules"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo-bundle-licenses --format yaml --output THIRDPARTY.yml",
          "maturin build --release --locked --interpreter ${{ PYTHON }}",
          "${{ PYTHON }} -m pip install --no-deps --no-index --find-links target/wheels numgrid"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "jan-janssen"
      ]
    },
