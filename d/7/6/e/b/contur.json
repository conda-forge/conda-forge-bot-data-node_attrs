  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"3.1.5\"\n  # Need Python 3.10+ to avoid rivet/libfastjet.so.0 ImportError\n  python_min: \"3.10\"\n\npackage:\n  name: contur\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/c/contur/contur-${{ version }}.tar.gz\n  sha256: 74ac5c763819786ec638f1f8c0542013817782a5109e925ba11d681566cbc2cd\n  patches:\n    # ttkbootstrap is not on conda-forge and is only an optional import upstream\n    - make-ttkbootstrap-an-optional-dependency.patch\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    - ${{ PYTHON }} -m pip install . -vv\n\n    # Add the post activate/deactivate scripts\n\n    # The scripts are executed in lexicographical order, so use zzz-/0- to ensure\n    # last/first to manipulate RIVET environment variables\n    # (lowercase letters have highest value)\n\n    - mkdir -p \"${PREFIX}/etc/conda/activate.d\"\n    # Run **after** anything else that might set Rivet environment variables\n    - cp \"${RECIPE_DIR}/activate.sh\" \"${PREFIX}/etc/conda/activate.d/zzz-activate-${PKG_NAME}.sh\"\n    - cp \"${RECIPE_DIR}/activate.csh\" \"${PREFIX}/etc/conda/activate.d/zzz-activate-${PKG_NAME}.csh\"\n    - cp \"${RECIPE_DIR}/activate.fish\" \"${PREFIX}/etc/conda/activate.d/zzz-activate-${PKG_NAME}.fish\"\n\n    - mkdir -p \"${PREFIX}/etc/conda/deactivate.d\"\n    # Run **before** anything else that might unset Rivet environment variables\n    - cp \"${RECIPE_DIR}/deactivate.sh\" \"${PREFIX}/etc/conda/deactivate.d/0-deactivate-${PKG_NAME}.sh\"\n    - cp \"${RECIPE_DIR}/deactivate.csh\" \"${PREFIX}/etc/conda/deactivate.d/0-deactivate-${PKG_NAME}.csh\"\n    - cp \"${RECIPE_DIR}/deactivate.fish\" \"${PREFIX}/etc/conda/deactivate.d/0-deactivate-${PKG_NAME}.fish\"\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - hatchling\n  run:\n    - python >=${{ python_min }}\n    - click >=8.1.7\n    - configobj >=5.0.6\n    - matplotlib-base >=3.8\n    - numpy >=1.71\n    - pandas >=1.4.3\n    - pathos >=0.3.2\n    - pyslha >=3.2.6\n    - pyyaml >=6.0.1\n    - scikit-learn >=1.5.0\n    - scipy >=1.10.0\n    - tqdm >=4.66.4\n    - uncertainties >=3.2.1\n    - autograd >=1.8.0\n    - rivet\n    # Needed to create \"${CONTUR_USER_DIR}/analysis-list\" in activate.sh\n    - cxx-compiler\n    - make\n    # Avoid broken installs on Windows given rivet is unix only\n    - __unix\n\ntests:\n  - package_contents:\n      # FIXME: Relocate python-scripts/ contents to bin/\n      files:\n        - python-scripts/check-contur-deps\n        - python-scripts/contur\n        - python-scripts/contur-batch\n        - python-scripts/contur-export\n        - python-scripts/contur-extract-xs-bf\n        - python-scripts/contur-gridtool\n        - python-scripts/contur-init\n        - python-scripts/contur-mapmerge\n        - python-scripts/contur-mkbib\n        - python-scripts/contur-mkthy\n        - python-scripts/contur-oracle\n        - python-scripts/contur-plot\n        - python-scripts/contur-profile\n        - python-scripts/contur-rivetplots\n        - python-scripts/contur-scan-xs-bf\n        - python-scripts/contur-smtest\n\n  - python:\n      imports:\n        - contur\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\n  - files:\n      recipe:\n        - test_rivet_analysis.cc\n    script:\n      - contur --version\n      - contur --help\n      # Activation-time 'make' must have produced the analysis list\n      - test -f \"${CONTUR_USER_DIR}/analysis-list\"\n      # Verify that runtime compilation of Rivet analyses works with\n      # minimally activated compilers that do not set environmental variables.\n      - cp test_rivet_analysis.cc \"${CONTUR_DATA_PATH}/data/Rivet/SmokeTest.cc\"\n      - rm -rf \"${CONTUR_USER_DIR}\"\n      - >-\n        env -u CC -u CXX -u FC -u CFLAGS -u CXXFLAGS -u CPPFLAGS -u LDFLAGS\n        bash -c '. \"${CONDA_PREFIX}/etc/conda/activate.d/zzz-activate-contur.sh\"\n        && test -f \"${CONTUR_USER_DIR}/Rivet-ConturOverload.so\"\n        && test -f \"${CONTUR_USER_DIR}/analysis-list\"'\n      - rm -f \"${CONTUR_DATA_PATH}/data/Rivet/SmokeTest.cc\"\n\nabout:\n  license: GPL-3.0-or-later\n  license_file: COPYING\n  summary: Package for model interpretation of collider-physics measurements\n  description: |\n    Contur is a procedure and toolkit designed to probe theories Beyond the\n    Standard Model using measurements at particle colliders.\n  homepage: https://hepcedar.gitlab.io/contur-webpage/\n  repository: https://gitlab.com/hepcedar/contur\n  documentation: https://hepcedar.gitlab.io/contur-webpage/\n\nextra:\n  recipe-maintainers:\n    - matthewfeickert\n    - conda-forge/hepmc3\n",
