  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"2.3.4\"\n  python_check_max: \"3.15\"\n  ruff_min: \"0.8.0\"\n  # ruff-feedstock stopped publishing `site-packages/ruff`\n  #   see: https://github.com/conda-forge/ruff-feedstock/pull/361\n  pytest_k: not (test_ruff_config_param or test_ruff_settings)\n\npackage:\n  name: python-lsp-ruff\n  version: ${{ version }}\n\nsource:\n  - target_directory: dist\n    url: https://pypi.org/packages/source/p/python-lsp-ruff/python_lsp_ruff-${{ version }}.tar.gz\n    sha256: 0c101db5ba54390dd0d3401c73b291d909fe5e5295e85ab2cfe9c21d08ef0905\n    patches:\n      - 0000-no-ruff-pyproject.patch\n  # PyPI sdist missing test files, see https://github.com/python-lsp/python-lsp-ruff/issues/117\n  - target_directory: src\n    url: https://github.com/python-lsp/python-lsp-ruff/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 1c4b8a4f1073192cb931a13e1590f4aef5fb7942dd4b371cf15f73facc296870\n\nbuild:\n  number: 1\n  noarch: python\n  script:\n    - cd dist\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check --check-build-dependencies\n\nrequirements:\n  host:\n    - pip\n    - python ${{ python_min }}.*\n    - setuptools\n  run:\n    - lsprotocol >=2023.0.1\n    - cattrs !=23.2.1\n    - python >=${{ python_min }}\n    - python-lsp-server-base\n    - ruff >=${{ ruff_min }}\n    - tomli >=1.1.0\n\ntests:\n  - package_contents:\n      strict: true\n      files:\n        - etc/conda/test-files/python-lsp-ruff/**\n      site_packages:\n        - pylsp_ruff/**\n        - python_lsp_ruff-${{ version }}.dist-info/**\n  - python:\n      imports: pylsp_ruff\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - ${{ python_check_max }}.*\n  - files:\n      source:\n        - src/tests/**\n    requirements:\n      run:\n        - coverage\n        - pytest\n        - python ${{ python_min }}.*\n    script:\n      - cd src\n      - coverage run --source=pylsp_ruff --branch -m pytest -vv --color=yes --tb=long -k \"${{ pytest_k }}\"\n      - coverage report --show-missing --skip-covered --fail-under=82\n\nabout:\n  summary: Ruff linting plugin for pylsp\n  license: MIT\n  license_file: dist/LICENSE\n  homepage: https://pypi.org/project/python-lsp-ruff\n  repository: https://github.com/python-lsp/python-lsp-ruff\n\nextra:\n  recipe-maintainers:\n    - bollwyvl\n    - jhossbach\n    - jonas-w\n",
