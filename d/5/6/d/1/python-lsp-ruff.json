            "script": [
              "cd src",
              "coverage run --source=pylsp_ruff --branch -m pytest -vv --color=yes --tb=long -k \"${{ pytest_k }}\"",
              "coverage report --show-missing --skip-covered --fail-under=82"
            ]
          }
        ],
        "version": "2.3.4"
