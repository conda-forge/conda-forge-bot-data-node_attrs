  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: dune-configurator\n  version: \"3.24.2\"\n  build_number: 1\n\n  library: ${{ \"Library/\" if not unix else \"\" }}\n  m2: ${{ \"m2-\" if not unix else \"\" }}\n  # ocaml_win-64 ships gcc_* and vs2022_* at the same version/build; name the track.\n  c_toolchain: ${{ \"\" if unix else c_compiler ~ \"_*\" }}\n\npackage:\n  name: ocaml-${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ocaml/dune/releases/download/${{ version }}/dune-${{ version }}.tbz\n  sha256: 472798691b0216daf538709f0f4703b3617ef24ad0866c9096068baaba4d762a\n\nbuild:\n  number: ${{ build_number }}\n  string: ${{ c_compiler ~ \"_\" if not unix }}h${{ hash }}_${{ build_number }}\n  script: bash ${{ RECIPE_DIR }}/build.sh dune-configurator\n\nrequirements:\n  build:\n    - ${{ compiler(\"ocaml\") }}\n    - if: not unix and c_compiler == \"gcc\"\n      then:\n        - ${{ stdlib(\"m2w64_c\") }}\n      else:\n        - ${{ stdlib(\"c\") }}\n    # ocaml_win-64 >=14 only run-constrains the C compiler; activate it here, once (vs2022, zig)\n    - if: not unix and c_compiler != \"gcc\"\n      then:\n        - ${{ compiler(\"c\") }}\n    # compiler(\"ocaml\") renders no toolchain track; name it on windows\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n    # the cross compiler does not pull the native one; the build runs OCaml on the build machine\n    - if: build_platform != target_platform and unix\n      then:\n        - ocaml_${{ build_platform }} ${{ ocaml_compiler_version }}.*\n        # the cross compiler activates itself (shims, OCAMLLIB, host OCAMLPATH)\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.*\n    # windows cross: the self-contained gcc track needs no vcvars\n    - if: build_platform != target_platform and not unix\n      then:\n        - ocaml_${{ build_platform }} ${{ ocaml_compiler_version }}.* gcc_*\n    - ocaml-dune >=${{ version }}\n    - ${{ m2 }}make\n    - if: not unix\n      then:\n        - m2-bash\n        - m2-coreutils\n  host:\n    # library: ocaml's run_export pins the compiler patch version\n    - ocaml ${{ ocaml_compiler_version }}.*\n    # the noarch ocaml metapackage does not pin the windows toolchain track\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n    - ocaml-csexp >=1.5\n  run:\n    - ocaml-csexp >=1.5\n  # the ocaml run_export does not encode the windows toolchain track\n  run_constraints:\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n\ntests:\n  - package_contents:\n      files:\n        - ${{ library }}lib/ocaml/${{ name }}/META\n        - ${{ library }}lib/ocaml/${{ name }}/configurator.cma\n        # win-arm64 is bytecode-only upstream: OCaml 5.4 has no arm64 Windows backend\n        - if: target_platform != \"win-arm64\"\n          then:\n            - ${{ library }}lib/ocaml/${{ name }}/configurator.cmxa\n  # the script links with ocamlopt: no native backend on win-arm64\n  - if: target_platform != \"win-arm64\"\n    then:\n      script: bash testing/test_dune_configurator.sh\n      files:\n        recipe:\n          - testing/test_dune_configurator.sh\n      requirements:\n        run:\n          - ocaml ${{ ocaml_compiler_version }}.*\n          - if: not unix\n            then:\n              - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n          - if: not unix and c_compiler != \"gcc\"\n            then:\n              - ${{ compiler(\"c\") }}\n          - if: not unix\n            then:\n              - m2-bash\n              - m2-coreutils\n\nabout:\n  homepage: https://github.com/ocaml/dune\n  repository: https://github.com/ocaml/dune\n  license: MIT\n  license_file: LICENSE.md\n  summary: Helper library for gathering system configuration (dune-configurator)\n\nextra:\n  recipe-maintainers:\n    - MementoRC\n    - ManuelLerchner\n",
