  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: dune-configurator\n  version: \"3.24.2\"\n\n  library: ${{ \"Library/\" if not unix else \"\" }}\n  m2: ${{ \"m2-\" if not unix else \"\" }}\n  c_toolchain: ${{ \"\" if unix else \"gcc_*\" }}\n\npackage:\n  name: ocaml-${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ocaml/dune/releases/download/${{ version }}/dune-${{ version }}.tbz\n  sha256: 472798691b0216daf538709f0f4703b3617ef24ad0866c9096068baaba4d762a\n\nbuild:\n  number: 0\n  script: bash ${{ RECIPE_DIR }}/build.sh dune-configurator\n\nrequirements:\n  build:\n    - if: unix\n      then:\n        - ${{ compiler(\"c\") }}\n        - ${{ stdlib(\"c\") }}\n      else:\n        - ${{ compiler(\"m2w64_c\") }}\n        - ${{ stdlib(\"m2w64_c\") }}\n    # non-unix: conda-forge ocaml has gcc_ and vs2022_ tracks; these recipes use the gcc (MinGW) track only.\n    - ocaml ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n    - ocaml-dune 3.24.*\n    - ${{ m2 }}make\n    - if: not unix\n      then:\n        - m2-bash\n        - m2-coreutils\n  host:\n    - ocaml ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n    - ocaml-csexp >=1.5\n  run:\n    - ocaml-csexp >=1.5\n\ntests:\n  - package_contents:\n      files:\n        - ${{ library }}lib/ocaml/${{ name }}/META\n        - ${{ library }}lib/ocaml/${{ name }}/configurator.cmxa\n        - ${{ library }}lib/ocaml/${{ name }}/configurator.cma\n  - script: bash testing/test_dune_configurator.sh\n    files:\n      recipe:\n        - testing/test_dune_configurator.sh\n    requirements:\n      run:\n        - ocaml ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n        - if: not unix\n          then:\n            - m2-bash\n            - m2-coreutils\n\nabout:\n  homepage: https://github.com/ocaml/dune\n  repository: https://github.com/ocaml/dune\n  license: MIT\n  license_file: LICENSE.md\n  summary: Helper library for gathering system configuration (dune-configurator)\n\nextra:\n  recipe-maintainers:\n    - MementoRC\n    - ManuelLerchner\n",
