  "raw_meta_yaml": "context:\n  version: \"3.13.6\"\n\npackage:\n  name: dart-sdk\n  version: ${{ version }}\n\nsource:\n  - if: linux and x86_64\n    then:\n      url: https://storage.googleapis.com/dart-archive/channels/stable/release/${{ version }}/sdk/dartsdk-linux-x64-release.zip\n      sha256: f80780c01ade17b789cf4dc2425d662f63bdd40eceda53b36c0d46af650de41b\n  - if: linux and aarch64\n    then:\n      url: https://storage.googleapis.com/dart-archive/channels/stable/release/${{ version }}/sdk/dartsdk-linux-arm64-release.zip\n      sha256: 73753a2e009505a2ba0d0c0bd449e248001a01984c805a3fcc19671dbb9616b1\n  - if: win and x86_64\n    then:\n      url: https://storage.googleapis.com/dart-archive/channels/stable/release/${{ version }}/sdk/dartsdk-windows-x64-release.zip\n      sha256: 95e16f71ebb80f41ba9dfcdc0c603bd3d4e2ce6aab586f4c14b229fb49597672\n  - if: osx and x86_64\n    then:\n      url: https://storage.googleapis.com/dart-archive/channels/stable/release/${{ version }}/sdk/dartsdk-macos-x64-release.zip\n      sha256: c978361a06576e3cf9602851da3d7c094b5c11661a880225aa4b64ab73cd5dd4\n  - if: osx and arm64\n    then:\n      url: https://storage.googleapis.com/dart-archive/channels/stable/release/${{ version }}/sdk/dartsdk-macos-arm64-release.zip\n      sha256: 6691d16a048c5bcb6554ad35c0de3fe2e599d35a7538bb9830d3d55d366a6bb8\n\nbuild:\n  number: 0\n  skip:\n    - ppc64le\n  dynamic_linking:\n    binary_relocation: false\n    missing_dso_allowlist:\n      # normal linux stuff that would go away if we had libgcc-ng in the run deps\n      - \"*/ld-linux.so.2\"\n      - \"*/lib64/ld-linux-x86-64.so.2\"\n      - \"*/libpthread.so.0\"\n      - \"*/libdl.so.2\"\n      - \"*/libm.so.6\"\n      - \"*/libc.so.6\"\n\ntests:\n  - package_contents:\n      bin:\n        - if: win\n          then: dart.exe\n  - script:\n      - dart --help\n\nabout:\n  homepage: https://dart.dev/\n  license: BSD-3-Clause\n  license_file: LICENSE\n  summary: a client-optimized language for developing fast apps on any platform\n  repository: https://github.com/dart-lang/sdk\n  documentation: https://dart.dev/\n\nextra:\n  recipe-maintainers:\n    - msarahan\n    - munechika-koyo\n",
