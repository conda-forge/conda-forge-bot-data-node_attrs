  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.9.2\"\n\npackage:\n  name: skia-pathops\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/s/skia-pathops/skia_pathops-${{ version }}.tar.gz\n  sha256: 4b6d8459f6f4a69282cb26fca0c2bb0b321cc58a9bf9cc6579a52a391edc0319\n  patches:\n    # the sdist's vendored skia must not shadow the headers of the skia we link against\n    - dont-use-vendored-skia-headers.patch\n\nbuild:\n  number: 3\n  skip: is_abi3 and not is_python_min\n  script:\n    env:\n      BUILD_SKIA_FROM_SOURCE: \"0\"\n      # already the upstream default, but stated so a change of that default\n      # cannot silently turn this back into a per-Python build\n      USE_PY_LIMITED_API: ${{ is_abi3 }}\n    content:\n      - ${{ PYTHON }} -m pip install . -vv\n  python:\n    version_independent: ${{ is_abi3 }}\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - cython >=3.2.0\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib(\"c\") }}\n    - pkg-config\n  host:\n    - pip\n    - python\n    - python-abi3\n    - setuptools\n    - setuptools-scm\n    - cython >=3.2.0\n    - libskia\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - pathops\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      - python test_pathops.py\n      - if: unix\n        then: abi3audit $SP_DIR/pathops/_pathops.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n        else: abi3audit %SP_DIR%/pathops/_pathops.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n    files:\n      recipe:\n        - test_pathops.py\n    requirements:\n      run:\n        - python\n        - abi3audit\n\nabout:\n  summary: Python access to operations on paths using the Skia library\n  license: BSD-3-Clause\n  license_file:\n    - LICENSE\n  homepage: https://github.com/fonttools/skia-pathops\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n    - naveen521kk\n",
