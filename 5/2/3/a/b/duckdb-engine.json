  "raw_meta_yaml": "context:\n  version: \"0.17.0\"\n\npackage:\n  name: duckdb-engine\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/d/duckdb_engine/duckdb_engine-${{ version }}.tar.gz\n  sha256: 396b23869754e536aa80881a92622b8b488015cf711c5a40032d05d2cf08f3cf\n\nbuild:\n  number: 1\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - poetry-core >=1.0.0\n  run:\n    - python >=${{ python_min }}\n    # duckdb 2 removed DuckDBPyConnection.fetch_arrow_table, which arrow fetches call.\n    - python-duckdb >=0.5.0,<2\n    # Reflection fails for every table from 2.0.45 on (pg_collation lookup):\n    # https://github.com/Mause/duckdb_engine/issues/1379\n    - sqlalchemy >=1.3.22,<2.0.45\n    - packaging >=21.3\n\ntests:\n  - python:\n      imports:\n        - duckdb_engine\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n        - pyarrow\n        - pytest >=8.0.0,<9\n        - pytest-remotedata >=0.4.0,<0.5\n        - pytest-snapshot >=0.9.0,<1\n        - hypothesis >=6.75.2,<7\n        - pandas >=1,<2\n        - fsspec >=2025.2.0,<2026.0.0\n        - mypy >=1.4,<2\n    script:\n      # test_user_agent*: fail with every duckdb/sqlalchemy combination, independent of this package.\n      # The other tests: reflection of some objects broke with duckdb 1.3, which the package\n      # still supports otherwise.\n      - pytest --remote-data --pyargs duckdb_engine -k \"not (test_user_agent or test_get_columns or test_get_foreign_keys or test_get_check_constraints or test_get_unique_constraints or test_all_types_reflection)\"\n\nabout:\n  homepage: https://github.com/Mause/duckdb_engine\n  repository: https://github.com/Mause/duckdb_engine\n  license: MIT\n  license_file: LICENSE.txt\n  summary: SQLAlchemy driver for duckdb\n  description: SQLAlchemy driver for duckdb\n\nextra:\n  recipe-maintainers:\n    - gforsyth\n    - cpcloud\n    - pavelzw\n",
