  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: portable-file-dialogs\n  version: \"0.1.0\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/samhocevar/portable-file-dialogs/archive/refs/tags/${{ version }}.tar.gz\n  sha256: db57f02a45b169613c41d1fb94edab5f03020cc5cdc5033f538c08b4982cd5d4\n\nbuild:\n  number: 0\n  noarch: generic\n  # one variant per OS family: headers go to $PREFIX/include on unix and to\n  # %PREFIX%\\Library\\include on Windows (noarch_platforms in conda-forge.yml)\n  script:\n    # Single header file\n    - if: unix\n      then:\n        - mkdir -p $PREFIX/include\n        - cp portable-file-dialogs.h $PREFIX/include/\n      else:\n        - if not exist %LIBRARY_INC% mkdir %LIBRARY_INC%\n        - copy portable-file-dialogs.h %LIBRARY_INC%\\\n\nrequirements:\n  run:\n    - if: unix\n      then: __unix\n      else: __win\n\ntests:\n  - package_contents:\n      files:\n        - if: unix\n          then: include/portable-file-dialogs.h\n          else: Library/include/portable-file-dialogs.h\n  - script:\n      - if: unix\n        then: ${CXX} -std=c++11 -fsyntax-only -I$PREFIX/include test.cpp\n        else: cl /nologo /std:c++17 /EHsc /Zs /I%LIBRARY_INC% test.cpp\n    requirements:\n      run:\n        - ${{ compiler('cxx') }}\n    files:\n      recipe:\n        - test.cpp\n\nabout:\n  homepage: https://github.com/samhocevar/portable-file-dialogs\n  repository: https://github.com/samhocevar/portable-file-dialogs\n  summary: Portable GUI dialogs library, C++11, single-header\n  description: |\n    Native message boxes, file open/save and folder selection dialogs for\n    Windows, macOS and Linux (via zenity/kdialog), in a single C++11 header.\n  license: WTFPL\n  license_file: COPYING\n\nextra:\n  recipe-maintainers:\n    - Tobias-Fischer\n",
