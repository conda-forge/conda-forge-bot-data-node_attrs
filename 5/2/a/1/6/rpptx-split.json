  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.14.0\"\n\nrecipe:\n  name: rpptx-split\n  version: ${{ version }}\n\nsource:\n  # One tag per family releases the CLI, the crates and the Python distribution.\n  url: https://github.com/tensorbee/rdocx/archive/refs/tags/rpptx-v${{ version }}.tar.gz\n  sha256: edbf4b321e17dc5b7766090e2ac0e36d38062e2f8f419efa5f3aeb17fc6a3b99\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: rpptx\n    build:\n      skip: is_abi3 and not is_python_min\n      python:\n        version_independent: ${{ is_abi3 }}\n      script:\n        - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n        - ${{ PYTHON }} -m pip install ./crates/rpptx-py -vv --no-deps --no-build-isolation --disable-pip-version-check\n    requirements:\n      build:\n        - if: build_platform != host_platform\n          then:\n            - python\n            - cross-python_${{ host_platform }}\n            - maturin >=1.9,<2\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - ${{ compiler('rust') }}\n        - cargo-bundle-licenses\n      host:\n        - if: is_abi3\n          then: python-abi3\n        - python\n        - maturin >=1.9,<2\n        - pip\n      run:\n        - python\n    tests:\n      - python:\n          imports:\n            - rpptx\n          python_version:\n            - if: is_abi3\n              then: ${{ python_min }}.*\n            - \"*\"\n      - files:\n          recipe:\n            - test_rpptx.py\n        script:\n          - python test_rpptx.py\n      - if: is_abi3\n        then:\n          requirements:\n            run:\n              - abi3audit\n          script:\n            - if: unix\n              then: abi3audit $SP_DIR/rpptx/_rpptx.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n              else: abi3audit %SP_DIR%/rpptx/_rpptx.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n    about:\n      summary: Native PPTX creation, editing, comments, notes, and rendering for Python\n\n  - package:\n      name: rpptx-cli\n    build:\n      script:\n        - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n        - if: unix\n          then: cargo install --locked --no-track --root \"$PREFIX\" --path crates/rpptx-cli\n          else: cargo install --locked --no-track --root \"%LIBRARY_PREFIX%\" --path crates/rpptx-cli\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - ${{ compiler('rust') }}\n        - cargo-bundle-licenses\n    tests:\n      - package_contents:\n          bin:\n            - rpptx\n      - files:\n          source:\n            - crates/rpptx/assets/default.pptx\n        script:\n          - rpptx --version\n          - rpptx inspect crates/rpptx/assets/default.pptx\n          - rpptx validate crates/rpptx/assets/default.pptx\n          - rpptx convert crates/rpptx/assets/default.pptx --to pdf --output default.pdf\n    about:\n      summary: CLI tool for inspecting, converting, and manipulating PPTX files\n\nabout:\n  summary: Native PPTX creation, editing, comments, notes, and rendering\n  homepage: https://github.com/tensorbee/rdocx\n  repository: https://github.com/tensorbee/rdocx\n  description: |\n    rpptx creates, opens, edits, and renders PowerPoint (PPTX) presentations\n    natively, without Microsoft PowerPoint or LibreOffice. It ships as a\n    Python binding (rpptx) and a command line tool (rpptx-cli).\n  # The code is dual licensed MIT OR Apache-2.0 upstream but only the MIT text\n  # is shipped. The bundled fonts are Apache-2.0 (Caladea) and OFL-1.1 (Carlito,\n  # Liberation, Noto); the embedded ICC profile has its own permissive license.\n  license: MIT AND Apache-2.0 AND OFL-1.1 AND LicenseRef-sRGB2014\n  license_file:\n    - LICENSE\n    - crates/oxml-layout/fonts/LICENSE-*\n    - crates/oxml-layout/fonts/NOTICE-*\n    - crates/oxml-pdf/assets/LICENSE-sRGB2014\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - hadim\n",
