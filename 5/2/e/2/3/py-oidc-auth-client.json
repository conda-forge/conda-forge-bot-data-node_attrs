    "about": {
      "description": "py-oidc-auth-client is the counterpart of the server-side library **py-oidc-auth**.\n\nWhile **py-oidc-auth** helps you add OpenID Connect login, token, and device endpoints to web frameworks,\n**py-oidc-auth-client** consumes those routes and gives you ready-to-use bearer tokens for calling protected APIs.",
      "doc_url": "https://py-oidc-auth-client.readthedocs.io/",
      "home": "https://github.com/freva-org/py-oidc-auth-client",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE",
      "summary": "Client library for the OIDC Auth server."
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "oidc-auth = py_oidc_auth_client.__main__:main"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . --no-deps -vv"
    },
