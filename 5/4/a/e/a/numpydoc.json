            "requirements": {
              "run": [
                "matplotlib-base",
                "pytest-cov",
                "python 3.11.*"
              ]
            },
            "script": [
              "coverage run --source=numpydoc --branch -m pytest -vv --tb=long --color=yes --pyargs numpydoc -k \"${{ pytest_k }}\"",
              "coverage report --show-missing --skip-covered --fail-under=84"
            ]
          }
