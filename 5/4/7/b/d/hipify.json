  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: hipify\n  version: \"7.2.4\"\n  llvm_major_version: \"22\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ROCm/HIPIFY/archive/refs/tags/rocm-${{ version }}.tar.gz\n  sha256: 3ffe18218c5bd0311e4359064da68f0a1d699bdc3b43472060d346a885bf8229\n  patches:\n    - 0001-use-conda-toolchain-and-resource-headers.patch\n\nbuild:\n  number: 0\n  skip: not linux\n  script: build.sh\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - ninja\n  host:\n    - rocm-core ${{ version }}.*\n    - llvmdev ${{ llvm_major_version }}.*\n    - clangdev ${{ llvm_major_version }}.*\n    - libclang-cpp ${{ llvm_major_version }}.*\n    # llvmdev itself has no run exports; depend on the shared-library package.\n    - libllvm${{ llvm_major_version }} ${{ llvm_major_version }}.*\n  run:\n    - perl\n    # The versioned compiler package owns lib/clang/<major>/include.\n    - clang-${{ llvm_major_version }} ${{ llvm_major_version }}.*\n\ntests:\n  - script:\n      - hipify-perl --help\n      - hipify-clang --help\n  - package_contents:\n      bin:\n        - hipify-clang\n        - hipify-perl\n      files:\n        - libexec/hipify/hipify-perl\n      include:\n        not_exists:\n          - hipify/**\n  - script: run_test.sh\n\nabout:\n  repository: https://github.com/ROCm/HIPIFY\n  homepage: https://rocm.docs.amd.com/projects/HIPIFY/en/latest/\n  license: MIT\n  license_file: LICENSE.txt\n  summary: \"CUDA to HIP source translator (Perl and Clang implementations)\"\n  description: |\n    HIPIFY provides tools to convert CUDA code to HIP code.\n    This package includes both hipify-perl (Perl-based translator) and\n    hipify-clang (LLVM/Clang-based translator) for comprehensive CUDA to HIP conversion.\n    Used by RCCL, JAX, and other ROCm tools for porting CUDA applications.\n\nextra:\n  recipe-maintainers:\n    - flferretti\n    - conda-forge/rocm-core\n",
