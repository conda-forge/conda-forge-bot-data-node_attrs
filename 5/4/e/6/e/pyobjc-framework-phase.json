  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"12.2.2\"\n\npackage:\n  name: pyobjc-framework-phase\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/pyobjc-framework-PHASE/pyobjc_framework_phase-${{ version }}.tar.gz\n  sha256: 6afcfbf754d9959398ccd323e23042afff151c46559af75f7df63a07bf72ca48\n\nbuild:\n  number: 0\n  skip: not osx\n  script:\n    content:\n      # force pyobjc to use conda-forge's chosen SDK\n      - export CFLAGS=\"${CFLAGS} -isysroot ${SDKROOT:-$CONDA_BUILD_SYSROOT}\"\n      - ${{ PYTHON }} -m pip install . -vv\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n  host:\n    - python\n    - pip\n    - setuptools\n  run:\n    # upstream requires the exact same release (>=X.Y.Z); the <13 cap allows\n    # newer 12.x releases while guarding against mixing pyobjc major\n    # versions, which are released and ABI-matched in lockstep\n    - python\n    - pyobjc-core >=${{ version }},<13\n    - pyobjc-framework-avfoundation >=${{ version }},<13\n\ntests:\n  - python:\n      imports:\n        - PHASE\n      pip_check: true\n\nabout:\n  homepage: https://github.com/ronaldoussoren/pyobjc\n  repository: https://github.com/ronaldoussoren/pyobjc\n  documentation: https://pyobjc.readthedocs.io/en/latest/\n  summary: Wrappers for the framework PHASE on macOS\n  description: |\n    PyObjC wrappers for Apple's PHASE (Physical Audio Spatialization Engine)\n    framework, giving Python access to spatial audio rendering, sound\n    sources, and listener modeling on macOS. Part of the PyObjC project,\n    which provides bridges between Python and Objective-C frameworks on\n    macOS.\n  license: MIT\n  license_file: License.txt\n\nextra:\n  recipe-maintainers:\n    - pb01ka\n",
