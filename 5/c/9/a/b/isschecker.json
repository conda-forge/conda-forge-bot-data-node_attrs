  "linux_64_meta_yaml": {
    "about": {
      "description": "isschecker validates NetCDF output from ice sheet models against the\nISMIP7 data request conventions.  Each file is checked for naming,\nnumerical values and units, spatial grid extent and resolution, time\naxis encoding, and required global and coordinate attributes, with\nfindings reported as either errors or warnings.\n\nThe compliance criteria (variable metadata, valid experiment year ranges\nand durations, and grid definitions) are bundled with the package.",
      "dev_url": "https://github.com/ismip/ISM_SimulationChecker",
      "home": "https://github.com/ismip/ISM_SimulationChecker",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "ISMIP7 compliance checker for ice sheet model simulation NetCDF datasets"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "ismip7-compliance-checker = isschecker:main",
          "ismip7-generate-test-files = isschecker.generate:main"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "xylar"
      ]
    },
    "outputs": [
      {
        "build": {
          "noarch": "python",
          "python": {
            "entry_points": [
              "ismip7-compliance-checker = isschecker:main",
              "ismip7-generate-test-files = isschecker.generate:main"
            ]
          }
        },
        "name": "isschecker",
        "requirements": {
          "build": [],
          "host": [
            "python 3.11.*",
            "pip",
            "setuptools >=77"
          ],
          "run": [
            "python >=3.11,<3.15",
            "numpy >=2.1,<3",
            "pandas >=2.2,<4",
            "xarray >=2025.1.2,<2027",
            "cftime >=1.6.4,<2",
            "netcdf4 >=1.7,<2",
            "cf-units >=3.3,<4",
            "tqdm >=4.66"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "isschecker"
              ],
              "python_version": [
                "3.11.*",
                "*"
              ]
            }
          },
          {
            "requirements": {
              "run": [
                "python 3.11.*"
              ]
            },
            "script": [
              "ismip7-compliance-checker --help",
              "ismip7-generate-test-files --help"
            ]
          }
        ],
        "version": "0.5.1"
      }
    ],
