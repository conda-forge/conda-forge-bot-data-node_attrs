  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  src_version: \"3.83\"\n  version: \"${{ src_version }}.0\"\n  date: 2024Nov13\n\npackage:\n  name: chealpix\n  version: ${{ version }}\n\nsource:\n  url: https://sourceforge.net/projects/healpix/files/Healpix_${{ src_version }}/Healpix_${{ src_version }}_${{ date }}.tar.gz\n  sha256: 8876c18efc596fd706b2a004ac15f2fb60b795f2db6fbabea9d8ccf549531dda\n  patches:\n    - if: win\n      then: fix_link_on_windows.patch\n\nbuild:\n  number: 1\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - if: win\n      then:\n        - autotools_clang_conda\n        - m2-pkgconf\n      else:\n        - autoconf\n        - automake\n        - libtool\n        - make\n        - pkgconf\n        - sed\n  host:\n    - cfitsio\n  run_exports:\n    - ${{ pin_subpackage(\"chealpix\", upper_bound=\"x.x\") }}\n\ntests:\n  - package_contents:\n      lib:\n        - if: win\n          then:\n            - chealpix.lib\n            - chealpix-*.dll\n          else:\n            - chealpix\n      include:\n        - chealpix.h\n  - requirements:\n      run:\n        - pkg-config\n    script:\n      - pkg-config --print-errors --exact-version \"${{ version }}\" chealpix\n      - pkg-config --libs chealpix\n\nabout:\n  summary: Software for pixelization, hierarchical indexation, synthesis, analysis, and visualization of data on the sphere.\n  description: |\n    HEALPix is a Hierarchical, Equal Area, and iso-Latitude Pixelation of\n    the sphere designed to support efficiently (1) local operations on the\n    pixel set, (2) a hierarchical tree structure for multi-resolution\n    applications, and (3) the global Fast Spherical Harmonic transform.\n    HEALPix based mathematical software meets the challenges presented\n    by high resolution and large volume data sets, such as the WMAP and\n    Planck CMB mission products.\n  homepage: https://sourceforge.net/projects/healpix/\n  repository: https://sourceforge.net/projects/healpix/\n  documentation: http://healpix.sf.net/documentation.php\n  license: GPL-2.0-or-later\n  license_file: COPYING\n\nextra:\n  recipe-maintainers:\n    - duncanmmacleod\n    - feng1m8\n",
