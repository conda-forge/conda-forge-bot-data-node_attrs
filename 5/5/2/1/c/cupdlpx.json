  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.2.7\"\n  build: 0\n\npackage:\n  name: cupdlpx\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/c/cupdlpx/cupdlpx-${{ version }}.tar.gz\n  sha256: ff47af56867e293e5ffb6b6f231544ed9d0db5bc073478541aa47b4ba65fa4bb\n\nbuild:\n  # Based on learnings from https://github.com/conda-forge/jaxlib-feedstock/blob/1b2b3761e145824a6d7a0bfb638344e1135a583d/recipe/recipe.yaml\n  number: ${{ build if cuda_compiler_version == \"None\" else build + 200 }}\n  string: ${{ \"cpu\" if cuda_compiler_version == \"None\" else \"cuda\" + (cuda_compiler_version | replace('.', '')) }}_py${{ python | version_to_buildstring }}h${{ hash }}_${{ build if cuda_compiler_version == \"None\" else build + 200 }}\n  skip:\n    - osx\n    # CPU-only builds not supported\n    - match(cuda_compiler_version, \"==None\")\n  dynamic_linking:\n    missing_dso_allowlist:\n      - if: win\n        then: \"*/nvcuda.dll\"\n      - if: linux\n        then:\n          - \"*/libcuda.so.1\"\n  script:\n    - if: unix\n      then: |\n        # This is a hotfix for https://github.com/NVIDIA/cccl/issues/4967, backporting\n        # https://github.com/NVIDIA/cccl/pull/4972 on the fly for the installed headers.\n        # Based on learning from https://github.com/conda-forge/llama.cpp-feedstock/pull/76/\n        {%- if match(cuda_compiler_version, \"12.*\") and linux and x86_64 %}\n        CCCL_PREPROCESSOR_H_TO_PATCH=\"$PREFIX/targets/x86_64-linux/include/cuda/std/__cccl/preprocessor.h\"\n        {%- endif %}\n\n        {%- if match(cuda_compiler_version, \"12.*\") and linux and aarch64 %}\n        CCCL_PREPROCESSOR_H_TO_PATCH=\"$PREFIX/targets/sbsa-linux/include/cuda/std/__cccl/preprocessor.h\"\n        {%- endif %}\n\n        {%- if match(cuda_compiler_version, \"12.*\") and linux %}\n        ROOT_DIR=\"$(dirname \"${CCCL_PREPROCESSOR_H_TO_PATCH}\")/../../../..\"\n        patch -p1 -d \"${ROOT_DIR}\" -i \"${RECIPE_DIR}/cuda12_cccl_arch_all.patch\"\n        {%- endif %}\n\n        ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n    - if: win\n      then:\n        ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\n\nrequirements:\n  build:\n    - cmake >=3.20\n    - if: win\n      then: ninja\n      else: make\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"cxx\") }}\n    - if: cuda_compiler_version != \"None\"\n      then:\n        - ${{ compiler(\"cuda\") }}\n        - cuda-version ==${{ cuda_compiler_version }}\n  host:\n    - python\n    - scikit-build-core >=0.9.0\n    - pybind11 >=2.11.0\n    - zlib\n    - pip\n    - if: cuda_compiler_version != \"None\"\n      then:\n        - libcublas-dev\n        - libcusparse-dev\n        - cuda-nvcc-tools\n        - cuda-version ==${{ cuda_compiler_version }}\n  run:\n    - python\n    - numpy >=1.21\n    - scipy >=1.8\n    - if: cuda_compiler_version != \"None\"\n      then:\n        - __cuda\n        - cuda-toolkit\n        - ${{ pin_compatible('cuda-version', upper_bound='x', lower_bound='x') }}\n\n\n  ignore_run_exports:\n    # Ignore run exports from CUDA libraries in the host section\n    from_package:\n      - libcublas-dev\n      - libcusparse-dev\n    # Ignore cuda-version directly. Do not ignore from {{ compiler('cuda') }}\n    # because this package has other exports\n    by_name:\n      - cuda-version\n\ntests:\n  - python:\n      imports:\n        - cupdlpx\n      pip_check: true\n\nabout:\n  summary: Python bindings for cuPDLPx (GPU-accelerated first-order LP solver)\n  license: Apache-2.0\n  license_file: LICENSE\n  homepage: https://pypi.org/project/cupdlpx/\n\nextra:\n  recipe-maintainers:\n    - brynpickering\n    - LucasBoTang\n",
