      "summary": "Python bindings for cuPDLPx (GPU-accelerated first-order LP solver)"
    },
    "build": {
      "number": "200",
      "script": "# This is a hotfix for https://github.com/NVIDIA/cccl/issues/4967, backporting\n# https://github.com/NVIDIA/cccl/pull/4972 on the fly for the installed headers.\n# Based on learning from https://github.com/conda-forge/llama.cpp-feedstock/pull/76/\n{%- if match(cuda_compiler_version, \"12.*\") and linux and x86_64 %}\nCCCL_PREPROCESSOR_H_TO_PATCH=\"$PREFIX/targets/x86_64-linux/include/cuda/std/__cccl/preprocessor.h\"\n{%- endif %}\n\n{%- if match(cuda_compiler_version, \"12.*\") and linux and aarch64 %}\nCCCL_PREPROCESSOR_H_TO_PATCH=\"$PREFIX/targets/sbsa-linux/include/cuda/std/__cccl/preprocessor.h\"\n{%- endif %}\n\n{%- if match(cuda_compiler_version, \"12.*\") and linux %}\nROOT_DIR=\"$(dirname \"${CCCL_PREPROCESSOR_H_TO_PATCH}\")/../../../..\"\npatch -p1 -d \"${ROOT_DIR}\" -i \"${RECIPE_DIR}/cuda12_cccl_arch_all.patch\"\n{%- endif %}\n\n${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n"
    },
    "extra": {
      "recipe-maintainers": [
        "brynpickering",
        "LucasBoTang"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "cupdlpx",
        "requirements": {
          "build": [
            "cmake >=3.20",
            "make",
            "c_compiler_stub",
            "c_stdlib_stub",
            "cxx_compiler_stub",
            "cuda_compiler_stub",
            "cuda-version ==12.9"
          ],
          "host": [
            "python",
            "scikit-build-core >=0.9.0",
            "pybind11 >=2.11.0",
            "zlib",
            "pip",
            "libcublas-dev",
            "libcusparse-dev",
