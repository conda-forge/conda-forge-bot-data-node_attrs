      "description": "HOL Guard reviews supported AI-agent actions before they run, including\nshell commands, file access, package installs, and MCP tool calls. It can\nallow, block, or request approval according to local policy and keeps\nreceipts for later review.",
      "dev_url": "https://github.com/hashgraph-online/hol-guard",
      "doc_url": "https://github.com/hashgraph-online/hol-guard/tree/main/docs/guard",
      "home": "https://hol.org/guard",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Open-source antivirus and runtime protection for AI agents"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "hol-guard = codex_plugin_scanner.cli:main",
          "plugin-guard = codex_plugin_scanner.cli:main"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "kantorcodes"
      ]
    },
