  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.11.1\"\n\npackage:\n  name: conda-ship\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/conda-incubator/conda-ship/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 5533a2a46ca8e55bdda9e9fb59c62874fe45b8462ef2a2118eab72f0d7726f51\n\nbuild:\n  number: 0\n  dynamic_linking:\n    # macOS templates reject LC_RPATH and link only system libraries.\n    binary_relocation: ${{ not osx }}\n  python:\n    version_independent: true\n  script:\n    env:\n      MATURIN_PEP517_ARGS: --locked --compatibility off\n    content:\n      - if: osx\n        then: export CARGO_BUILD_RUSTFLAGS=\"\"\n      - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - maturin >=1,<2\n    - if: build_platform != target_platform\n      then:\n        - python ${{ python_min }}.*\n        - cross-python_${{ target_platform }}\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - maturin >=1,<2\n  run:\n    - python >=${{ python_min }}\n    - conda >=25.1\n    - pyproject_hooks >=1.2\n    - if: match(python_min, \"<3.11\")\n      then: tomli >=1.1\n\ntests:\n  - python:\n      imports:\n        - conda_ship\n        - conda_ship.cli\n        - conda_ship.plugin\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      - cs --help\n      - cs package-update --help\n      - python -m conda_ship.cli --help\n      - python -m conda ship -- --help\n      - python tests/ci/validate_runtime_pair.py installed --scratch-root .\n    files:\n      source:\n        - tests/ci/validate_runtime_pair.py\n        - tests/fixtures/structural-runtime/\n\nabout:\n  homepage: https://conda-incubator.github.io/conda-ship/\n  summary: Build ready-to-run conda runtimes\n  license: BSD-3-Clause\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  documentation: https://conda-incubator.github.io/conda-ship/\n  repository: https://github.com/conda-incubator/conda-ship\n\nextra:\n  recipe-maintainers:\n    - jezdez\n",
