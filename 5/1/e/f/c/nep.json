  "linux_64_meta_yaml": {
    "about": {
      "description": "NEP (NetCDF Expansion Pack) adds read-only format readers to\nNetCDF-C through its User Defined Format API, so nc_open() and\nncdump read PDB, PDBx/mmCIF, FITS and PDS4 files. Register the\nreaders by appending $CONDA_PREFIX/share/.ncrc to ~/.ncrc. LZ4\nand BZIP2 compression is in the separate nep-compress package.",
      "dev_url": "https://github.com/Intelligent-Data-Design-Inc/NEP",
      "home": "https://github.com/Intelligent-Data-Design-Inc/NEP",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE.txt",
      "summary": "Scientific format readers (PDB, mmCIF, FITS, PDS4) for NetCDF-C"
    },
    "build": {
      "number": "0"
    },
    "extra": {
      "recipe-maintainers": [
        "captainkirk99"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "nep",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "c_stdlib_stub",
            "fortran_compiler_stub",
            "cmake",
            "ninja",
            "pkgconf"
          ],
          "host": [
            "libnetcdf >=4.10.1",
            "libnetcdf * nompi_*",
            "hdf5",
            "hdf5 * nompi_*",
            "netcdf-fortran",
            "netcdf-fortran * nompi_*",
            "cfitsio",
            "libxml2",
            "libxml2-devel"
          ],
          "run": []
        },
        "tests": [
          {
            "files": {
              "source": [
                "test/data/PDB/1GAB.pdb",
                "test/data/mmCIF/4HHB.cif",
                "test/data/WFPC2u5780205r_c0fx.fits",
                "test/data/PDS4/general/test_table_binary.xml"
              ]
            },
            "requirements": {
              "run": [
                "libnetcdf"
              ]
            },
            "script": [
              "test -f $PREFIX/include/nep.h",
              "test -f $PREFIX/lib/libnep${SHLIB_EXT}",
              "test -f $PREFIX/lib/libncpdb${SHLIB_EXT}",
              "test -f $PREFIX/lib/libncmmcif${SHLIB_EXT}",
              "test -f $PREFIX/lib/libncfits${SHLIB_EXT}",
              "test -f $PREFIX/lib/libncpds4${SHLIB_EXT}",
              "test -f $PREFIX/lib/cmake/NEP/NEPConfig.cmake",
              "test -f $PREFIX/share/.ncrc",
              "test ! -e $PREFIX/lib/libncgeotiff${SHLIB_EXT}",
              "test ! -e $PREFIX/lib/libncdicom${SHLIB_EXT}",
              "test ! -e $PREFIX/lib/libncnextcdf4${SHLIB_EXT}",
              "test ! -e $PREFIX/lib/libnep.a",
              "NCRCENV_RC=$PREFIX/share/.ncrc ncdump -h test/data/PDB/1GAB.pdb",
              "NCRCENV_RC=$PREFIX/share/.ncrc ncdump -h test/data/mmCIF/4HHB.cif",
              "NCRCENV_RC=$PREFIX/share/.ncrc ncdump -h test/data/WFPC2u5780205r_c0fx.fits",
              "NCRCENV_RC=$PREFIX/share/.ncrc ncdump -h test/data/PDS4/general/test_table_binary.xml"
            ]
          }
        ],
        "version": "4.2.0"
      }
    ],
