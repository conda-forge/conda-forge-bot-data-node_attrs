  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: skillspector\n  version: \"2.13.2\"\n  python_min: \"3.12\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  # not published on PyPI; built from the GitHub release tag\n  url: https://github.com/NVIDIA/SkillSpector/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: ff5427ecee25fa32f1c98cf0179a3ebc585e429cc0602e825885ae10eaf24738\n  patches:\n    # upstream pins pywhatwgurl==0.1.1; conda-forge has 0.1.2 (same 0.1 API)\n    - 0001-relax-pywhatwgurl-pin.patch\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - skillspector = skillspector.cli:app\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - hatchling\n    - pip\n  run:\n    - python >=${{ python_min }},<3.15\n    - typer >=0.23.0,<0.24\n    - rich >=14.3.0\n    - httpx >=0.28.0\n    - pywhatwgurl >=0.1.1,<0.2\n    - regex ==2026.5.9\n    - packaging >=24.0\n    - pyyaml >=6.0.1\n    - pydantic >=2.12.0\n    - openai >=2.25.0\n    - langgraph >=1.0.10\n    - langchain-anthropic >=1.4.5\n    - langchain-aws >=0.2.0\n    - langchain-core >=1.2.17\n    - langchain-openai >=1.1.10\n    - boto3 >=1.34.0\n    - langsmith >=0.7.30\n    - yara-python >=4.5.0\n    # used to resolve remote skill repositories\n    - git\n  run_constraints:\n    # optional `skillspector mcp` server mode (upstream extra `[mcp]`);\n    # install `mcp` alongside once conda-forge has mcp >=1.29,<2\n    - mcp >=1.29.0,<2.0.0\n\ntests:\n  - python:\n      imports:\n        - skillspector\n        - skillspector.cli\n      pip_check: true\n      python_version: ${{ python_min }}.*\n  - script:\n      - skillspector --help\n      - python test_scan.py\n    files:\n      recipe:\n        - test_scan.py\n      source:\n        - tests/fixtures/malicious_skill/\n    requirements:\n      run:\n        - python ${{ python_min }}.*\n\nabout:\n  homepage: https://github.com/NVIDIA/SkillSpector\n  repository: https://github.com/NVIDIA/SkillSpector\n  summary: Security scanner for AI agent skills (Claude Code, Codex, MCP)\n  description: |\n    SkillSpector scans AI agent skills and MCP servers for vulnerabilities, malicious\n    patterns, prompt injection, data exfiltration and supply-chain risks before you\n    install them. It runs static pattern and YARA checks, with optional LLM semantic\n    analysis, and reports risk scores as terminal, JSON or Markdown output.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRD_PARTY_NOTICES.md\n\nextra:\n  recipe-maintainers:\n    - mediocretech\n",
