  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"6.3\"\n\npackage:\n  name: zope\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/z/zope/zope-${{ version }}.tar.gz\n  sha256: c75e5d37ab0f0684e0f1693940f3a1d55ad13bdf281bf5e0abe45b7b5e6cc4e2\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv\n  python:\n    entry_points:\n      - addzopeuser = Zope2.utilities.adduser:main\n      - runwsgi = Zope2.Startup.serve:main\n      - mkwsgiinstance = Zope2.utilities.mkwsgiinstance:main\n      - zconsole = Zope2.utilities.zconsole:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n  run:\n    - python >=${{ python_min }}\n    - accesscontrol\n    - acquisition\n    - btrees\n    - chameleon\n    - datetime\n    - documenttemplate\n    - extensionclass\n    - multimapping\n    - pastedeploy\n    - persistence\n    - restrictedpython\n    - zconfig\n    - zodb >=6.4.dev0\n    - multipart\n    - transaction\n    - waitress\n    - zexceptions\n    - z3c.pt\n    - zope.browser\n    - zope.browsermenu\n    - zope.browserpage\n    - zope.browserresource\n    - zope.component\n    - zope.configuration\n    - zope.container\n    - zope.contentprovider\n    - zope.contenttype\n    - zope.datetime\n    - zope.deferredimport\n    - zope.event\n    - zope.exceptions\n    - zope.globalrequest\n    # zope.i18n[zcml]: the zcml extra pulls in zope.component, zope.configuration\n    # and zope.security, which are all listed here\n    - zope.i18n\n    - zope.i18nmessageid\n    - zope.interface\n    - zope.lifecycleevent\n    - zope.location\n    - zope.pagetemplate\n    - zope.processlifetime\n    - zope.proxy\n    - zope.ptresource\n    - zope.publisher\n    - zope.schema\n    - zope.security\n    - zope.sequencesort\n    - zope.site\n    - zope.size\n    - zope.tal\n    - zope.tales\n    - zope.testbrowser\n    - zope.testing\n    - zope.traversing\n    - zope.viewlet\n\ntests:\n  - python:\n      imports:\n        - Zope2\n        - Zope2.Startup.run\n        - OFS.Application\n        - OFS.Folder\n        - ZPublisher.WSGIPublisher\n        - App.config\n        - Products.Five\n        - Products.PageTemplates.ZopePageTemplate\n        - webdav\n        - ZTUtils\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      env:\n        # the sdist ships the test .po files but not the compiled .mo files,\n        # so let zope.i18n compile them when the tests register translations\n        zope_i18n_compile_mo_files: \"true\"\n      content:\n        # test_no_second_transaction_is_created_if_closed passes on its own but\n        # depends on test order when the whole suite runs in one process\n        - zope-testrunner --auto-path -vc -s App -s OFS -s Products.Five -s Products.PageTemplates -s Products.SiteAccess -s Testing -s webdav -s zmi -s Zope2 -s ZPublisher -s ZTUtils -t \"!test_no_second_transaction_is_created_if_closed\"\n    requirements:\n      run:\n        - zope.testrunner\n  - script:\n      - mkwsgiinstance --help\n      - runwsgi --help\n      - addzopeuser --help\n      - zconsole --help\n      # create a real instance and check its config files are written\n      - mkwsgiinstance -d zinst -u admin:admin\n      - python -c \"import os; assert os.path.isfile('zinst/etc/zope.conf') and os.path.isfile('zinst/etc/zope.ini')\"\n\nabout:\n  homepage: https://github.com/zopefoundation/Zope\n  repository: https://github.com/zopefoundation/Zope\n  documentation: https://zope.readthedocs.io\n  summary: Zope application server / web framework\n  license: ZPL-2.1\n  license_file:\n    - LICENSE.txt\n    - COPYRIGHT.txt\n\nextra:\n  recipe-maintainers:\n    - killua156\n",
