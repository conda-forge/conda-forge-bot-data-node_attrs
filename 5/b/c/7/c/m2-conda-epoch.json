  "meta_yaml": {
    "about": {
      "description": "m2 packages are used as build tools for building packages on windows\nsystems. These packages use the msys2 runtime, a modified Cygwin\nruntime and therefore downstream conda packages should not link to\nthese packages.\n\nDownstream packages should link to the m2w64 packages which used\nmsvcrt runtime and now use ucrt runtime.\n\nWe package m2 x86_64 packages for both win-64 and win-arm64\nplatforms as win-arm64 can run x86_64 binaries and since\nthere are no arm64 msys2 packages.",
      "home": "https://github.com/conda-forge/m2-conda-epoch-feedstock",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE.txt",
      "summary": "epoch for m2 (not m2w64) packages"
    },
    "build": {
      "number": "0",
      "run_exports": {
        "noarch": [
          "m2-conda-epoch ==20261029 *_x86_64"
        ],
