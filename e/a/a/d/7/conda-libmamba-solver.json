  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"26.10.0\"\n\npackage:\n  name: conda-libmamba-solver\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/conda/conda-libmamba-solver/archive/${{ version }}.tar.gz\n  sha256: 21f5f82d3ff2735aed7c1c676222017f85efa186c803abf66e8d38c6e1e5d788\n  target_directory: src/\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    env:\n      SETUPTOOLS_SCM_PRETEND_VERSION: ${{ version }}\n    content: ${{ PYTHON }} -m pip install src/ -vv\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - hatchling\n    - hatch-vcs\n  run:\n    - python >=${{ python_min }}\n    - libmambapy >=2.3.2,!=2.6.2\n    - boltons >=23.0.0\n  run_constraints:\n    # This is technically a `run` dependency (we do import it), but\n    # conda already depends on conda-libmamba-solver, so it creates a\n    # dependency cycle that complicates migrations\n    - conda >=26.7.1\n    - certifi >=2026.10.19\n    - ca-certificates >=2026.10.19\n\ntests:\n  - python:\n      imports:\n        - conda_libmamba_solver\n      pip_check: false\n      python_version: ${{ python_min }}.*\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n        - conda\n    script:\n      - conda create -c conda-forge -n test --dry-run scipy --solver=libmamba\n      - CONDA_SOLVER=libmamba conda create -c conda-forge -n test --dry-run scipy\n\nabout:\n  license: BSD-3-Clause\n  license_file: src/LICENSE\n  summary: The fast mamba solver, now in conda!\n  homepage: https://github.com/conda/conda-libmamba-solver\n  repository: https://github.com/conda/conda-libmamba-solver\n  documentation: https://conda.github.io/conda-libmamba-solver/\n\nextra:\n  recipe-maintainers:\n    - jaimergp\n    - jezdez\n    - wolfv\n",
