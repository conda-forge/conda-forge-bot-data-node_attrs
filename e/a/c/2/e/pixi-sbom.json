  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.9.0\"\n\npackage:\n  name: pixi-sbom\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/millsks/pixi-sbom/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 9d1b2cd3714faa83f452e920e4ed33ef56dd4b84e8f7df148f62135134840efc\n\nbuild:\n  number: 0\n  script:\n    - if: unix\n      then: cargo auditable install --locked --bins --no-track --path . --root \"$PREFIX\"\n      else: cargo auditable install --locked --bins --no-track --path . --root \"%LIBRARY_PREFIX%\"\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n\ntests:\n  - script:\n      # The osx_arm64 package is cross-compiled on an osx_64 runner, which\n      # cannot execute the resulting binary (\"Bad CPU type in executable\").\n      - if: build_platform == target_platform\n        then:\n          - pixi-sbom --version\n          - pixi-sbom --help\n  - package_contents:\n      bin:\n        - pixi-sbom\n      strict: true\n\nabout:\n  homepage: https://millsks.github.io/pixi-sbom/\n  repository: https://github.com/millsks/pixi-sbom\n  documentation: https://millsks.github.io/pixi-sbom/\n  summary: Generate a CycloneDX or SPDX SBOM from a pixi.lock file\n  description: |\n    A pixi extension that writes a CycloneDX 1.6 / 1.7 or SPDX 2.3 / 3.0.1\n    JSON Software Bill of Materials for one or more environments of a\n    pixi.lock file, with licenses, PyPI identities and a license policy gate.\n    Once installed with `pixi global install pixi-sbom`, pixi discovers the\n    `pixi-sbom` executable on PATH and exposes it as `pixi sbom`.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - millsks\n",
