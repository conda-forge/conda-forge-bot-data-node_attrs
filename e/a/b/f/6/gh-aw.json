  "raw_meta_yaml": "context:\n  version: \"1.0.1\"\n\npackage:\n  name: gh-aw\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/github/gh-aw/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: a4cd07e76e14e6a90f337508b0af60e977731d75b2a623c6b995099a4657d5e0\n    target_directory: src\n  - url: https://raw.githubusercontent.com/inconshreveable/mousetrap/v1.1.0/LICENSE\n    sha256: 4819582701f150b28a563a6cd8ed0bf5a754e3c67b90ad38d78ba4131bf77795\n    file_name: LICENSE-mousetrap\n\nbuild:\n  number: 0\n  script:\n    - cd src\n    - go-licenses save ./cmd/gh-aw --save_path ../library_licenses --ignore github.com/inconshreveable/mousetrap\n    - if: unix\n      then: go build -v -trimpath -o $PREFIX/bin/gh-aw -ldflags=\"-s -w -X main.version=v${{ version }} -X main.isRelease=true\" ./cmd/gh-aw\n      else: go build -v -trimpath -o %LIBRARY_BIN%\\gh-aw.exe -ldflags=\"-s -X main.version=v${{ version }} -X main.isRelease=true\" ./cmd/gh-aw\n\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n\ntests:\n  - script:\n      - gh-aw --help\n      - gh-aw version\n  - package_contents:\n      bin:\n        - gh-aw\n      strict: true\n\nabout:\n  homepage: https://github.github.com/gh-aw/\n  summary: GitHub Agentic Workflows\n  description: |\n    gh-aw is a gh CLI extension for GitHub Agentic Workflows: write agentic\n    workflows in natural language markdown and run them in GitHub Actions.\n  license: MIT\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n    - LICENSE-mousetrap\n  documentation: https://github.github.com/gh-aw/\n  repository: https://github.com/github/gh-aw\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
