  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: multivisor\n  version: \"7.1.0\"\n\nrecipe:\n  name: multivisor-suite\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/multivisor-${{ version }}.tar.gz\n  sha256: d33a34b5c6cc0957a0855c2da65f42f29cea3df8154a1dacc4b6ced8403ed649\n\nbuild:\n  number: 0\n  noarch: python\n\noutputs:\n  - package:\n      name: multivisor\n    build:\n      noarch: python\n      python:\n        entry_points:\n          - multivisor=multivisor.server.web:main\n          - multivisor-rpc=multivisor.server.rpc:main\n          - multivisor-cli=multivisor.client.cli:main\n      script: ${{ PYTHON }} -m pip install --no-deps -vv .\n    requirements:\n      host:\n        - pip\n        - python ${{ python_min }}.*\n        - setuptools\n        - setuptools-scm\n      run:\n        - gevent >=1.3\n        - python >=${{ python_min }}\n    tests:\n      - python:\n          imports:\n            - multivisor\n          python_version:\n            - ${{ python_min }}.*\n            - 3.*\n          pip_check: true\n  - package:\n      name: multivisor-web\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - python >=${{ python_min }}\n        - ${{ pin_subpackage('multivisor', exact=True) }}\n        - flask\n        - flask-cors\n        - werkzeug\n        - blinker\n        - pyzmq\n        - msgpack-python\n        - supervisor\n    tests:\n      - python:\n          imports:\n            - multivisor.server.web\n          python_version:\n            - ${{ python_min }}.*\n            - 3.*\n      - script:\n          - multivisor --help\n        requirements:\n          run:\n            - python ${{ python_min }}.*\n  - package:\n      name: multivisor-rpc\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - python >=${{ python_min }}\n        - ${{ pin_subpackage('multivisor', exact=True) }}\n        - pyzmq\n        - msgpack-python\n        - supervisor\n    tests:\n      - python:\n          imports:\n            - multivisor.server.rpc\n          python_version:\n            - ${{ python_min }}.*\n            - 3.*\n      - script:\n          - multivisor-rpc --help\n        requirements:\n          run:\n            - python ${{ python_min }}.*\n  - package:\n      name: multivisor-cli\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - python >=${{ python_min }}\n        - ${{ pin_subpackage('multivisor', exact=True) }}\n        - maya\n        - requests\n        - prompt_toolkit >=2\n        - blinker\n    tests:\n      - python:\n          imports:\n            - multivisor.client.cli\n          python_version:\n            - ${{ python_min }}.*\n            # WARNING: pendulum <=3.1.0 not compatible with python 3.14\n            - 3.13.*\n      - script:\n          - multivisor-cli --help\n        requirements:\n          run:\n            - python ${{ python_min }}.*\n\nabout:\n  summary: A centralized supervisor UI (web & CLI)\n  license: GPL-3.0-or-later AND MIT\n  license_file:\n    - LICENSE\n    - multivisor/zerorpc/LICENSE\n  homepage: https://github.com/tiagocoutinho/multivisor\n\nextra:\n  feedstock-name: multivisor\n  recipe-maintainers:\n    - beenje\n",
