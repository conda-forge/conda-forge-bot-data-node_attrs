  "raw_meta_yaml": "context:\n  version: \"2.3.5\"\n\npackage:\n  name: ls-hpack\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/litespeedtech/ls-hpack/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 430a1a36029e0ae1c81eaa0b2356920f1e65fde1cdd722351c671ebe513b7a96\n  patches:\n    - patches/0001-Use-bundled-queue.h-on-Windows.patch\n    - patches/0002-Add-install-rules.patch\n\nbuild:\n  number: 1\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - ninja\n  run_exports:\n    - ${{ pin_subpackage('ls-hpack', upper_bound='x.x.x') }}\n\ntests:\n  - package_contents:\n      lib:\n        - ls-hpack\n      include:\n        - lshpack.h\n        - lsxpack_header.h\n  - files:\n      recipe:\n        - test.c\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n    script:\n      - if: win\n        then:\n          - cl /nologo test.c /I%LIBRARY_INC% /link /LIBPATH:%LIBRARY_LIB% ls-hpack.lib\n          - test.exe\n        else:\n          - $CC $CFLAGS test.c -I$PREFIX/include $LDFLAGS -L$PREFIX/lib -lls-hpack -Wl,-rpath,$PREFIX/lib -o test\n          - ./test\n\nabout:\n  homepage: https://github.com/litespeedtech/ls-hpack\n  summary: LiteSpeed HPACK (RFC7541) Library\n  description: |\n    LS-HPACK provides functionality to encode and decode HTTP headers using HPACK compression mechanism specified in RFC 7541.\n  license: MIT\n  license_file: LICENSE\n  documentation: https://github.com/litespeedtech/ls-hpack\n  repository: https://github.com/litespeedtech/ls-hpack\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
