  "raw_meta_yaml": "{% set name = \"menpo\" %}\n{% set version = \"0.12.1\" %}\n# upstream supports 3.10, but conda-forge has no 3.10 build of cyvlfeat >=0.8.1 (python_min is 3.11), and\n# the noarch test environment is solved at python_min\n{% set python_min = \"3.11\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/{{ name[0] }}/{{ name }}/{{ name }}-{{ version }}.tar.gz\n  sha256: 78a687c2c9020daaa717eb0df1baa34042fcaff17669a62eb5c2709e6f29173b\n\nbuild:\n  number: 0\n  noarch: python\n  script: {{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python {{ python_min }}.*\n    - pip\n    - setuptools >=77\n    - setuptools-scm >=8\n  run:\n    - python >={{ python_min }}\n    - numpy >=1.14\n    - scipy >=1.0\n    - pillow >=4.0\n    - matplotlib-base >=3.0\n    - ffmpeg\n    - cyvlfeat >=0.8.1\n    - opencv\n\ntest:\n  imports:\n    - menpo\n    - menpo.feature\n    - menpo.image\n    - menpo.io\n    - menpo.landmark\n    - menpo.math\n    - menpo.model\n    - menpo.shape\n    - menpo.transform\n    - menpo.visualize\n  requires:\n    - python {{ python_min }}.*\n    - pip\n  commands:\n    - pip check\n\nabout:\n  home: https://github.com/menpo/menpo\n  dev_url: https://github.com/menpo/menpo\n  doc_url: https://menpo.readthedocs.io/en/stable/\n  license: BSD-3-Clause\n  license_family: BSD\n  license_file: LICENSE.txt\n  summary: 'The Menpo Project Python package for handling annotated data'\n\nextra:\n  recipe-maintainers:\n    - patricksnape\n",
