  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: ixwebsocket\n  version: \"12.1.0\"\n\nrecipe:\n  name: ${{ name }}-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/machinezone/IXWebSocket/archive/v${{ version }}.tar.gz\n  sha256: 55f3a5d3a1a2c5f19d737c24e6aced28d1200f8f5deb45ecd8e5d46f765b5288\n  patches:\n    # Use conda-forge's CLI11 headers for the ws command.\n    - use-system-cli11.patch\n    # Link ws directly with the platform thread library for std::thread.\n    - link-ws-threads.patch\n\nbuild:\n  number: 0\n  skip:\n    - win\n  script: build\n\noutputs:\n  - package:\n      name: libixwebsocket\n    build:\n      files:\n        - if: linux\n          then: lib/libixwebsocket.so.*\n        - if: osx\n          then: lib/libixwebsocket.*.dylib\n    requirements:\n      build:\n        - ${{ compiler(\"c\") }}\n        - ${{ compiler(\"cxx\") }}\n        - ${{ stdlib(\"c\") }}\n        - cmake\n        - make\n      host:\n        - zlib\n        - openssl\n        - cli11 >=2.6.2\n      run_exports:\n        - ${{ pin_subpackage(\"libixwebsocket\", upper_bound=\"x.x.x\") }}\n    tests:\n      - script: test ! -f ${PREFIX}/lib/libixwebsocket${SHLIB_EXT}\n\n  - package:\n      name: ixwebsocket\n    build:\n      files:\n        - if: linux\n          then: lib/libixwebsocket.so\n        - if: osx\n          then: lib/libixwebsocket.dylib\n        - include/ixwebsocket/\n        - lib/cmake/ixwebsocket/\n        - lib/pkgconfig/ixwebsocket.pc\n        - bin/ws\n    requirements:\n      build:\n        - ${{ compiler(\"c\") }}\n        - ${{ compiler(\"cxx\") }}\n        - ${{ stdlib(\"c\") }}\n        - cmake\n        - make\n      host:\n        - zlib\n        - openssl\n        - ${{ pin_subpackage(\"libixwebsocket\", exact=True) }}\n        - cli11 >=2.6.2\n      run:\n        - ${{ pin_subpackage(\"libixwebsocket\", exact=True) }}\n      run_exports:\n        - ${{ pin_subpackage(\"libixwebsocket\", upper_bound=\"x.x.x\") }}\n    tests:\n      - script: ws --help\n    about:\n      license_file:\n        - LICENSE.txt\n        - CLI11-LICENSE.txt\n\nabout:\n  homepage: https://machinezone.github.io/IXWebSocket/\n  summary: IXWebSocket is a C++ library for WebSocket client and server development.\n  description: |\n    IXWebSocket is a C++ library for WebSocket client and server development. It has\n    minimal dependencies (no boost), is very simple to use and support everything you'll\n    likely need for websocket dev (SSL, deflate compression, compiles on most platforms, etc...).\n  license: BSD-3-Clause\n  license_file: LICENSE.txt\n  documentation: https://machinezone.github.io/IXWebSocket\n  repository: https://github.com/machinezone/IXWebSocket\n\nextra:\n  feedstock-name: ixwebsocket-split\n  recipe-maintainers:\n    - zklaus\n    - timkpaine\n",
