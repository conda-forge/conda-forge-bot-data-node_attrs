  "linux_64_meta_yaml": {
    "about": {
      "description": "typst2vast reads a Typst document with typst-syntax, the Typst compiler's\nown parser, and emits the HTML that Vale lints. Nothing is compiled, so\ndocuments that do not build still convert and no package is fetched.\nVale 3.18 and later call it for .typ files when it is on PATH.",
      "dev_url": "https://github.com/jdkato/typst2vast",
      "home": "https://github.com/jdkato/typst2vast",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Convert Typst to HTML for the Vale prose linter, parsing without evaluating"
    },
    "build": {
      "number": "0",
      "script": [
        "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .",
        "cargo-bundle-licenses --format yaml --output THIRDPARTY.yml"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "ManuelLerchner"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "typst2vast",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "c_stdlib_stub",
            "rust_compiler_stub",
            "cargo-bundle-licenses",
            "cargo-auditable"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "typst2vast --version",
              "printf '= Title\\nSome *bold* text.\\n' | typst2vast | grep -q '<strong>bold</strong>'"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "typst2vast"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.1.0"
      }
    ],
