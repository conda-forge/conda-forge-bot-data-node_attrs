  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.1.2\"\n\npackage:\n  name: banal\n  version: ${{ version }}\n\nsource:\n  # PyPI has no sdist from 1.1.0 onward: upstream publishes with\n  # `python -m build --wheel`. Use the tagged GitHub archive, which also\n  # carries LICENSE and the test suite.\n  url: https://github.com/pudo/banal/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 4fa13afa462b7c601163fd5fa970c51ee24ebc8291c3fbc0598bdf2c2ed18a68\n\nbuild:\n  noarch: python\n  number: 0\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - hatchling\n    - pip\n  run:\n    - python >=${{ python_min }}\n\ntests:\n  - python:\n      imports:\n        - banal\n      pip_check: true\n      python_version: [\"${{ python_min }}.*\", \"*\"]\n  - script: pytest tests\n    files:\n      source:\n        - tests/\n    requirements:\n      run:\n        - pytest\n        - python ${{ python_min }}.*\n\nabout:\n  homepage: http://github.com/pudo/banal\n  license: MIT\n  license_file: LICENSE\n  summary: Commons of banal micro-functions for Python.\n  description: |\n    A collection of small, dependency-free helper functions for everyday\n    Python work: coercing values to booleans and lists, flattening and\n    cleaning nested dictionaries, checking mapping and sequence types, and\n    caching keys for arbitrary objects.\n  repository: http://github.com/pudo/banal\n\nextra:\n  recipe-maintainers:\n    - vasudevanv\n    - killua156\n",
