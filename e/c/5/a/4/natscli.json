      "summary": "The NATS command line interface"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "go build -trimpath -ldflags=\"-s -w -X main.version=${{ version }}\" -o ${PREFIX}/bin/nats ./nats",
          "go-licenses save ./nats --save_path=library_licenses --ignore=github.com/nats-io/natscli"
        ],
        "env": {
          "CGO_ENABLED": "0",
          "GOTOOLCHAIN": "local"
        }
      }
    },
    "extra": {
