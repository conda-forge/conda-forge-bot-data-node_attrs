  "raw_meta_yaml": "context:\n  version: \"0.11.5\"\n\npackage:\n  name: rsop\n  version: ${{ version }}\n\nsource:\n  url: https://codeberg.org/heiko/rsop/archive/rsop/v${{ version }}.tar.gz\n  sha256: ec746a90f8db82c893bf75d80c92479363812c82509e3cb9171397d625cbae47\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # fix osx-arm64 compilation by prefetching and patching the `sha1-asm` crate (removing invalid relocation specifiers)\n      - if: target_platform == \"osx-arm64\"\n        then: |\n          ^cargo fetch --locked\n\n          $env.CARGO_HOME? | default ($env.HOME | path join .cargo) | path join '**/aarch64_apple.S' | glob $in | each {|file|\n            cp $file $'($file).bak'\n            open $file | str replace --all '#:lo12:' '' | save --force $file\n          }          \n      # build main app and generate license data\n      - cd rsop\n      - cargo auditable install --path=. --root=($prefix) --no-track --locked --bins --features=cliv\n      - cargo-bundle-licenses --format=yaml --output=../THIRDPARTY.yml\n      # copy shell completion files and man page\n      - mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions ($prefix)/share/man/man1\n      - let out_dir = glob ../target/*/release/build/rsop-*/out | first\n      - cp ($out_dir)/rsop.bash ($prefix)/share/bash-completion/completions/rsop\n      - cp ($out_dir)/rsop.fish ($prefix)/share/fish/vendor_completions.d/rsop.fish\n      - cp ($out_dir)/_rsop     ($prefix)/share/zsh/site-functions/_rsop\n      - cp ($out_dir)/*.1       ($prefix)/share/man/man1/\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - nushell\n\ntests:\n  - script:\n      - rsop --help\n      - rsop version\n      - rsopv --help\n      - rsopv version\n  - package_contents:\n      bin:\n        - rsop\n        - rsopv\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/rsop\n            - share/fish/vendor_completions.d/rsop.fish\n            - share/zsh/site-functions/_rsop\n            - share/man/man1/rsop*.1\n        - if: win\n          then:\n            - Library/share/bash-completion/completions/rsop\n            - Library/share/fish/vendor_completions.d/rsop.fish\n            - Library/share/zsh/site-functions/_rsop\n            - Library/share/man/man1/rsop*.1\n      strict: true\n\nabout:\n  summary: Stateless OpenPGP (SOP) CLI tool\n  description: |\n    rsop is a \"Stateless OpenPGP\" (SOP) CLI tool. It exposes a simple,\n    standardized CLI interface to perform a set of common OpenPGP operations.\n  license: CC0-1.0\n  license_file:\n    - LICENSES/CC0-1.0.txt\n    - THIRDPARTY.yml\n  homepage: https://codeberg.org/heiko/rsop\n  repository: https://codeberg.org/heiko/rsop\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
