  "linux_64_meta_yaml": {
    "about": {
      "description": "rsop is a \"Stateless OpenPGP\" (SOP) CLI tool. It exposes a simple,\nstandardized CLI interface to perform a set of common OpenPGP operations.",
      "dev_url": "https://codeberg.org/heiko/rsop",
      "home": "https://codeberg.org/heiko/rsop",
      "license": "CC0-1.0",
      "license_family": "CC0-1.0",
      "license_file": "LICENSES/CC0-1.0.txt",
      "summary": "Stateless OpenPGP (SOP) CLI tool"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "cd rsop",
          "cargo auditable install --path=. --root=($prefix) --no-track --locked --bins --features=cliv",
          "cargo-bundle-licenses --format=yaml --output=../THIRDPARTY.yml",
          "mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions ($prefix)/share/man/man1",
          "let out_dir = glob ../target/*/release/build/rsop-*/out | first",
          "cp ($out_dir)/rsop.bash ($prefix)/share/bash-completion/completions/rsop",
          "cp ($out_dir)/rsop.fish ($prefix)/share/fish/vendor_completions.d/rsop.fish",
          "cp ($out_dir)/_rsop     ($prefix)/share/zsh/site-functions/_rsop",
          "cp ($out_dir)/*.1       ($prefix)/share/man/man1/"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        },
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "rsop",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "nushell"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "rsop --help",
              "rsop version",
              "rsopv --help",
              "rsopv version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "rsop",
                "rsopv"
              ],
              "files": [
                "share/bash-completion/completions/rsop",
                "share/fish/vendor_completions.d/rsop.fish",
                "share/zsh/site-functions/_rsop",
                "share/man/man1/rsop*.1"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.11.5"
      }
    ],
