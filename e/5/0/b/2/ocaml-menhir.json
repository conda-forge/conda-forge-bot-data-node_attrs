  "raw_meta_yaml": "context:\n  build_number: 2\n  name: ocaml-menhir\n  version: \"20250912\"\n\n  library: ${{ \"Library/\" if not unix else \"\" }}\n  m2: ${{ \"m2-\" if not unix else \"\" }}\n  sh: ${{ \"sh\" if unix else \"bat\" }}\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  - url: https://gitlab.inria.fr/fpottier/menhir/-/archive/${{ version }}/menhir-${{ version }}.tar.gz\n    sha256: 26b1f44d6b4ed634631c50866e5535062591308a01a987f415411a9543965c9b\n\nbuild:\n  number: ${{ build_number }}\n  script: build.sh\n\nrequirements:\n  build:\n    - if: unix\n      then:\n        - ${{ compiler(\"c\") }}\n        - ${{ stdlib(\"c\") }}\n      else:\n        - ${{ compiler(\"m2w64_c\") }}\n        - ${{ stdlib(\"m2w64_c\") }}\n    - ${{ m2 }}bash >=5.2\n    - ${{ m2 }}gawk\n    - ${{ m2 }}grep\n    - ${{ m2 }}make\n    - ${{ m2 }}sed\n    - ocaml-dune\n    - if: unix\n      then:\n        - ${{ compiler(\"ocaml\") }}\n      else:\n        # compiler(\"ocaml\") expands to `ocaml_<target> <version>.*` with no\n        # toolchain track, and ocaml_win-64 publishes gcc_* and vs2022_* at the\n        # same version and build number - so the bare form is settled by upload\n        # order. Replicate what compiler() emits and add the track.\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ ocaml_toolchain }}_*\n    - if: build_platform != target_platform\n      then:\n        # menhir is a build-time tool: it must RUN on the build machine during\n        # a cross build (see recipe/build.sh), so a build-platform ocaml is\n        # needed in addition to the cross compiler above.\n        - ocaml ${{ ocaml_compiler_version }}.*\n        # macOS cross-compilation needs LLVM tools for compatible archives\n    - if: osx\n      then:\n        - llvm-tools\n        - lld\n    - if: unix\n      then:\n        - file\n    - if: not unix\n      then:\n        - ${{ m2 }}coreutils\n        - ${{ m2 }}diffutils\n        - ${{ m2 }}which\n  host:\n    # menhir ships compiled interfaces (menhirLib, menhirCST, menhirSdk,\n    # coq-menhirlib) whose ABI is fixed by the TARGET ocaml, so ocaml belongs\n    # here as well as in build: - under cross these are different packages.\n    #\n    # OCaml interface compatibility is exact-version: a .cmi built against one ocaml\n    # minor will not load under another. Rather than hand-maintaining that pin, host\n    # carries bare `ocaml`, whose weak run_export injects `ocaml >=<ver>,<...>` into\n    # run - so the pin follows whatever we build against. On windows ocaml_<target>\n    # additionally injects a `ocaml_win-64 * <toolchain>_*` constraint, which is what\n    # keeps the gcc_ and vs2022_ flavours from being interchangeable here.\n    - ocaml ${{ ocaml_compiler_version }}.*\n    - if: not unix\n      then:\n        # ocaml_win-64 publishes gcc_* and vs2022_* in the SAME subdir at the\n        # same version and build number, so an unqualified spec is settled by\n        # the solver, not by this recipe. menhir builds with compiler(\"m2w64_c\"),\n        # i.e. mingw, so pin the gcc_ lane. Only windows needs this: the\n        # ocaml-feedstock build string injects the toolchain prefix under a\n        # `not unix` guard, so every unix subdir is single-lane bare-hash.\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ ocaml_toolchain }}_*\n      else:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.*\n\ntests:\n  # Package contents validation\n  - package_contents:\n      strict: true\n      bin:\n        - menhir\n      files:\n        - ${{ library }}doc/*\n        - ${{ library }}lib/coq-menhirlib/*\n        - ${{ library }}lib/menhir/*\n        - ${{ library }}lib/menhirCST/*\n        - ${{ library }}lib/menhirLib/*\n        - ${{ library }}lib/menhirSdk/*\n        - ${{ library }}share/man/man1/menhir.1\n        - etc/conda/test-files/*\n\n  # Python-based functional tests\n  - script: |\n      python testing/test-menhir-arch.py\n      python testing/test-menhir-functional.py\n    files:\n      recipe:\n        - testing/test_utils.py\n        - testing/test-menhir-arch.py\n        - testing/test-menhir-functional.py\n    requirements:\n      run:\n        - ${{ m2 }}file\n        - ocaml ${{ ocaml_compiler_version }}.*\n        - python >=3.9\n\nabout:\n  license: GPL-2.0-only\n  license_file: LICENSE\n  summary: An LR(1) parser generator for OCaml\n  homepage: https://gitlab.inria.fr/fpottier/menhir\n  repository: https://gitlab.inria.fr/fpottier/menhir\n\nextra:\n  recipe-maintainers:\n    - MementoRC\n",
