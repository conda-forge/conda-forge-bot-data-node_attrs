  "raw_meta_yaml": "context:\n  build_number: 2\n  name: ocaml-menhir\n  version: \"20250912\"\n\n  # ocaml_win-64 ships gcc_* and vs2022_* at the same version/build; name the track.\n  c_toolchain: ${{ \"\" if unix else c_compiler ~ \"_*\" }}\n  library: ${{ \"Library/\" if not unix else \"\" }}\n  m2: ${{ \"m2-\" if not unix else \"\" }}\n  sh: ${{ \"sh\" if unix else \"bat\" }}\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  - url: https://gitlab.inria.fr/fpottier/menhir/-/archive/${{ version }}/menhir-${{ version }}.tar.gz\n    sha256: 26b1f44d6b4ed634631c50866e5535062591308a01a987f415411a9543965c9b\n\nbuild:\n  number: ${{ build_number }}\n  string: ${{ c_compiler ~ \"_\" if not unix }}h${{ hash }}_${{ build_number }}\n  script: build.sh\n\nrequirements:\n  build:\n    - if: not unix and c_compiler == \"gcc\"\n      then:\n        - ${{ stdlib(\"m2w64_c\") }}\n      else:\n        - ${{ stdlib(\"c\") }}\n    - ocaml-dune\n    - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n    - if: build_platform != target_platform\n      then:\n        - ocaml ${{ ocaml_compiler_version }}.*\n    - if: osx\n      then:\n        - llvm-tools\n        - lld\n    - if: unix\n      then:\n        - file\n        - sed\n    - if: not unix\n      then:\n        - ${{ m2 }}bash >=5.2\n        - ${{ m2 }}coreutils\n        - ${{ m2 }}gawk\n        - ${{ m2 }}grep\n        - ${{ m2 }}sed\n  host:\n    - ocaml ${{ ocaml_compiler_version }}.*\n    - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n\ntests:\n  # Package contents validation\n  - package_contents:\n      strict: true\n      bin:\n        - menhir\n      files:\n        - ${{ library }}doc/*\n        - ${{ library }}lib/coq-menhirlib/*\n        - ${{ library }}lib/menhir/*\n        - ${{ library }}lib/menhirCST/*\n        - ${{ library }}lib/menhirLib/*\n        - ${{ library }}lib/menhirSdk/*\n        - ${{ library }}share/man/man1/menhir.1\n        - etc/conda/test-files/*\n\n  # Python-based functional tests\n  - script: |\n      python testing/test-menhir-arch.py\n      python testing/test-menhir-functional.py\n    files:\n      recipe:\n        - testing/test_utils.py\n        - testing/test-menhir-arch.py\n        - testing/test-menhir-functional.py\n    requirements:\n      run:\n        - ${{ m2 }}file\n        - ocaml ${{ ocaml_compiler_version }}.*\n        - python >=3.9\n\nabout:\n  license: GPL-2.0-only\n  license_file: LICENSE\n  summary: An LR(1) parser generator for OCaml\n  homepage: https://gitlab.inria.fr/fpottier/menhir\n  repository: https://gitlab.inria.fr/fpottier/menhir\n\nextra:\n  recipe-maintainers:\n    - MementoRC\n",
