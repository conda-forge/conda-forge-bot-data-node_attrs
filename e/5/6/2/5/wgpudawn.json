  "linux_64_meta_yaml": {
    "about": {
      "description": "wgpudawn provides the wgpu-py API for WebGPU in Python, implemented on\ntop of Google's Dawn instead of wgpu-native. It is a cffi extension\nlinked against Dawn's webgpu.h and native C++ API.",
      "dev_url": "https://github.com/hmaarrfk/wgpudawn",
      "home": "https://github.com/hmaarrfk/wgpudawn",
      "license": "BSD-2-Clause",
      "license_family": "BSD-2-Clause",
      "license_file": "LICENSE",
      "summary": "WebGPU for Python, on Dawn. A standalone build of the wgpu-py API with a Dawn backend."
    },
    "build": {
      "number": "0",
      "python": {
        "version_independent": true
      },
      "script": [
        "export DAWN_PREFIX=\"${PREFIX}\"",
        "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "hmaarrfk"
      ]
    },
    "outputs": [
      {
        "build": {
          "python": {
            "version_independent": true
          }
        },
        "name": "wgpudawn",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "c_stdlib_stub",
            "cxx_compiler_stub"
          ],
          "host": [
            "python",
            "python-abi3",
            "pip",
            "setuptools >=77",
            "cffi >=1.17",
            "dawn"
          ],
          "run": [
            "python",
            "cffi >=1.17",
            "dawn"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "wgpudawn",
                "wgpudawn.backends.dawn"
              ],
              "python_version": [
                "3.11.*",
                "*"
              ]
            }
          },
          {
            "requirements": {
              "run": [
                "abi3audit"
              ]
            },
            "script": "abi3audit $SP_DIR/wgpudawn/_lib/_wgpu_dawn.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}"
          },
          {
            "files": {
              "source": [
                "tests/"
              ]
            },
            "requirements": {
              "run": [
                "pip",
                "pytest",
                "numpy",
                "psutil",
                "imageio",
                "anyio",
                "trio",
                "rendercanvas >=2.4.0"
              ]
            },
            "script": [
              "pip check",
              "python -c \"import wgpudawn.backends.dawn as d; print(d.__version__)\"",
              "pytest tests -v"
            ]
          }
        ],
        "version": "0.32.0.4"
      }
    ],
