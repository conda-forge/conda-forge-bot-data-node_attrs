  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.8.0\"\n\npackage:\n  name: innerscope\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/i/innerscope/innerscope-${{ version }}.tar.gz\n  sha256: e5d75cedbe945ed7049ed03ae649167dd90f41081a8bf86279c65efbb08b65e7\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools >=77\n    - setuptools-git-versioning\n    - pip\n  run:\n    - python >=${{ python_min }}\n\ntests:\n  - python:\n      imports:\n        - innerscope\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  # innerscope reads and rewrites bytecode, which changes with every Python,\n  # so run the full suite on both the oldest and the newest Python.\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n        - pytest >=7\n    script:\n      - pytest -v --pyargs innerscope\n  - requirements:\n      run:\n        - python\n        - pytest >=7\n    script:\n      - pytest -v --pyargs innerscope\n\nabout:\n  homepage: https://github.com/eriknw/innerscope\n  repository: https://github.com/eriknw/innerscope\n  summary: Expose the inner scope of functions\n  description: |\n    Innerscope exposes the inner scope of functions and offers primitives suitable for creating pipelines.\n    It explores a design space around functions, dictionaries, and classes.\n  license: BSD-3-Clause\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - eriknw\n",
