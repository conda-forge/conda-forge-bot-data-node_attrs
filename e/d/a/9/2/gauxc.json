  "raw_meta_yaml": "{% set version = \"1.1\" %}\n{% set build = 6 %}\n{% set mpi = mpi or \"nompi\" %}\n\npackage:\n  name: gauxc\n  version: \"{{ version }}\"\n\nsource:\n  - url: https://github.com/wavefunction91/gauxc/archive/refs/tags/v{{ version }}.tar.gz\n    sha256: 17de077fb23e44d03b0ed14dcd8117c01e5b3431fbefa2352d751639ada7f91c\n    patches:\n      - patches/gh-161.patch  # Allow finding highfive library\n  - url: https://github.com/wavefunction91/linalg-cmake-modules/archive/9d2c273a671d6811e9fd432f6a4fa3d915b144b8.tar.gz\n    sha256: 6e49c6c7c7df14b956d1fee77d9b6aad9ded3210cd639133c69a52b2e5ce4eae\n    folder: external/linalg-cmake-modules\n\n{% if mpi == \"nompi\" %}\n{% set build = build + 100 %}\n{% endif %}\nbuild:\n  number: {{ build }}\n  #skip: true  # [win]\n  skip: true  # [not (linux and x86_64)]\n\n  string: cuda{{ cuda_compiler_version | replace('.', '') }}_{{ mpi_prefix }}_h{{ PKG_HASH }}_{{ build }}  # [cuda_compiler_version != \"None\"]\n  string: cpu_{{ mpi_prefix }}_h{{ PKG_HASH }}_{{ build }}  # [cuda_compiler_version == \"None\"]\n\n  run_exports:\n    - {{ pin_subpackage(\"gauxc\", max_pin='x.x') }}\n    - gauxc * *_{{ mpi_prefix }}_*\n    - gauxc * cuda{{ cuda_compiler_version | replace('.', '') }}_*  # [cuda_compiler_version != \"None\"]\n    - gauxc * cpu_*  # [cuda_compiler_version == \"None\"]\n  ignore_run_exports:\n    - catch2\n\nrequirements:\n  build:\n    - {{ compiler('c') }}\n    - {{ compiler('cxx') }}\n    - {{ compiler('cuda') }}  # [cuda_compiler_version != \"None\"]\n    - {{ stdlib('c') }}\n    - cmake >3.20,<4\n    - ninja\n    - llvm-openmp  # [osx]\n    - pkg-config\n  host:\n    - cuda-version {{ cuda_compiler_version }}  # [cuda_compiler_version != \"None\"]\n    - exchcxx >=1.0,<2 cpu_*  # [cuda_compiler_version == \"None\"]\n    - exchcxx >=1.0,<2 cuda{{ cuda_compiler_version | replace('.', '') }}_*  # [cuda_compiler_version != \"None\"]\n    - gau2grid >=2.0.6,<3\n    - hdf5 * {{ mpi_prefix }}_*\n    - highfive >=2.4.1,<3\n    - integratorxx >=1.0,<2\n    - libblas  # [linux]\n    - libgomp  # [linux]\n    - llvm-openmp  # [osx]\n    - libmagma-devel   # [cuda_compiler_version != \"None\"]\n    - libcublas-dev  # [cuda_compiler_version != \"None\"]\n    - libcusparse-dev  # [cuda_compiler_version != \"None\"]\n    - cuda-cudart-dev  # [cuda_compiler_version != \"None\"]\n    - {{ mpi }}  # [mpi != \"nompi\"]\n  run:\n    - llvm-openmp  # [osx]\n    - {{ mpi }}  # [mpi != \"nompi\"]\n    - __cuda  # [cuda_compiler_version != \"None\"]\n\ntest:\n  commands:\n    - test -f $PREFIX/lib/libgauxc$SHLIB_EXT  # [unix]\n\nabout:\n  home: https://github.com/wavefunction91/gauxc\n  summary: >-\n     GauXC is a modern, modular C++ library for the evaluation of quantities related to\n     the exchange-correlation (XC) energy (e.g. potential, etc) in the Gaussian basis set\n     discretization of Kohn-Sham density function theory (KS-DFT) on heterogenous architectures.\n  license: BSD-3-Clause and BSL-1.0\n  license_file:\n    - LICENSE.txt  # BSD-3-Clause\n    - NOTICE.md\n    - external/linalg-cmake-modules/LICENSE.txt  # BSD-3-Clause\n\nextra:\n  recipe-maintainers:\n    - awvwgk\n",
