        "gauxc * *_nompi_*",
        "gauxc * *_mpi_openmpi_*",
        "gauxc * cpu_*",
        "gauxc * cuda134_*"
      ],
      "string": "cuda134_mpi_openmpi_h1234567_6"
    },
    "extra": {
      "recipe-maintainers": [
        "awvwgk"
      ]
    },
    "package": {
      "name": "gauxc",
      "version": "1.1"
    },
    "requirements": {
      "build": [
        "c_compiler_stub",
        "cxx_compiler_stub",
        "cuda_compiler_stub",
        "c_stdlib_stub",
