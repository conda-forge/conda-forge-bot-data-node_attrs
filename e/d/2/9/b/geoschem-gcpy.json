  "raw_meta_yaml": "{% set name = \"geoschem-gcpy\" %}\n{% set version = \"1.8.1\" %}\n\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/{{ name[0] }}/{{ name }}/{{ name | replace('-', '_') }}-{{ version }}.tar.gz\n  sha256: 5692a7865c42e2b9d90819b28d2b75ae9f62ac4890df74f4f836d7555fa96889\n\nbuild:\n  number: 0\n  skip: true  # [win]\n  script_env:\n    - MPLBACKEND=agg\n  script: {{ PYTHON }} -m pip install . --no-deps -vv\n\nrequirements:\n  host:\n    - python\n    - pip\n    - numpy\n    - setuptools\n    - cartopy\n    # Pin to ESMF 8.9.1 and xesmf 0.9.2 to avoid import errors\n    - esmf =8.9.1\n    - esmpy =8.9.1\n    - xesmf =0.9.2\n  run:\n    - python\n    - cartopy\n    - cf_xarray\n    - dask\n    # Pin to ESMF 8.9.1 to avoid import errors\n    - esmf =8.9.1\n    - esmpy =8.9.1\n    - gridspec\n    - joblib\n    - matplotlib-base\n    - netcdf4\n    - netcdf-fortran\n    - {{ pin_compatible('numpy') }}\n    - pandas\n    - pip\n    - pylint\n    - pypdf\n    - pyproj\n    - requests\n    - scipy\n    - sparselt\n    - tabulate\n    - tk\n    - xarray\n    # Pin to xesmf 0.9.2 to avoid import errors\n    - xesmf =0.9.2\n\ntest:\n  imports:\n    - gcpy\n  requires:\n    - esmf =8.9.1\n    - esmpy =8.9.1\n    - xesmf =0.9.2\n\nabout:\n  home: https://github.com/geoschem/gcpy\n  license: MIT\n  license_family: MIT\n  license_file: LICENSE.txt\n  summary: Python toolkit for working with GEOS-Chem output and input\n  doc_url: https://gcpy.readthedocs.io/en/latest/\n  dev_url: https://github.com/geoschem/gcpy\n\nextra:\n  recipe-maintainers:\n    - yantosca\n    - lizziel\n    - msulprizio\n",
