  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"5.18.0\"\n\nrecipe:\n  name: cryptominisat-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/msoos/cryptominisat/archive/refs/tags/release/v${{ version }}.tar.gz\n  sha256: 44b960a43c4eefc7f800ab5f3ec5c43f670c669e6bdec6a87b49138fedb0c34b\n\nbuild:\n  number: 0\n  skip: win\n\noutputs:\n  - staging:\n      name: cryptominisat-build\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - cmake\n        - ninja\n        - pkgconf\n      host:\n        - gmp\n        - zlib\n    build:\n      script: build-lib.sh\n\n  - package:\n      name: libcryptominisat\n    inherit:\n      from: cryptominisat-build\n      run_exports: false\n    build:\n      files:\n        - include/cryptominisat5/\n        - lib/libcryptominisat5.so*\n        - lib/libcryptominisat5*.dylib\n        - lib/cmake/cryptominisat5/\n    requirements:\n      build:\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n      host:\n        # Also needed by consumers: gmpxx.h is included by the public headers.\n        - gmp\n      run_exports:\n        - ${{ pin_subpackage('libcryptominisat', upper_bound='x.x') }}\n      run_constraints:\n        # cryptominisat <5.18 shipped the library, CLI and Python bindings.\n        - cryptominisat >=5.18\n    tests:\n      - package_contents:\n          include:\n            - cryptominisat5/cryptominisat.h\n          lib:\n            - cryptominisat5\n          files:\n            - lib/cmake/cryptominisat5/cryptominisat5Config.cmake\n      - script:\n          - $CXX $CXXFLAGS -std=c++17 test.cpp -o test -I$PREFIX/include $LDFLAGS -lcryptominisat5\n          - ./test\n        files:\n          recipe:\n            - test.cpp\n        requirements:\n          run:\n            - ${{ compiler('cxx') }}\n    about:\n      summary: An advanced SAT solver (C++ library)\n\n  - package:\n      name: cryptominisat\n    inherit:\n      from: cryptominisat-build\n      run_exports: false\n    build:\n      files:\n        - bin/cryptominisat5\n    requirements:\n      build:\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n      host:\n        - ${{ pin_subpackage('libcryptominisat', exact=True) }}\n        - gmp\n        - zlib\n      run:\n        - ${{ pin_subpackage('libcryptominisat', exact=True) }}\n    tests:\n      - package_contents:\n          bin:\n            - cryptominisat5\n      - script:\n          - cryptominisat5 --version\n          - echo -e '1 0\\n-1 0' | cryptominisat5 --verb 0 | grep -x 's UNSATISFIABLE'\n          - echo -e '1 0\\n1 -1 0' | cryptominisat5 --verb 0 | grep -x 's SATISFIABLE'\n    about:\n      summary: An advanced SAT solver (command line executable)\n\n  - package:\n      name: pycryptosat\n    inherit:\n      from: cryptominisat-build\n      run_exports: false\n    build:\n      script: build-python.sh\n      files:\n        - lib/python*/site-packages/\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - cmake\n        - ninja\n        - pkgconf\n        - if: build_platform != target_platform\n          then:\n            - python\n            - cross-python_${{ target_platform }}\n      host:\n        - python\n        - pip\n        - scikit-build-core\n        - ${{ pin_subpackage('libcryptominisat', exact=True) }}\n        - gmp\n        - zlib\n      ignore_run_exports:\n        from_package:\n          # Only their headers are needed; the extension links neither.\n          - gmp\n          - zlib\n      run:\n        - python\n        - ${{ pin_subpackage('libcryptominisat', exact=True) }}\n      run_constraints:\n        # cryptominisat <5.18 shipped the pycryptosat module itself.\n        - cryptominisat >=5.18\n    tests:\n      - python:\n          imports:\n            - pycryptosat\n          pip_check: true\n      - script:\n          - pytest -v python/tests\n        files:\n          source:\n            - python/tests/\n        requirements:\n          run:\n            - pytest\n    about:\n      summary: Python bindings for the CryptoMiniSat SAT solver\n\nabout:\n  homepage: https://www.msoos.org\n  repository: https://github.com/msoos/cryptominisat\n  license: MIT\n  license_file:\n    - LICENSE.txt\n    # cryptominisat vendors a patched version of yals\n    - src/yals/LICENSE\n    # cryptominisat vendors a patched version of mpicosat\n    - src/mpicosat/LICENSE\n  summary: An advanced SAT solver\n  description: |\n    CryptoMiniSat is a modern, multi-threaded, feature-rich, simplifying SAT\n    solver with XOR reasoning. `libcryptominisat` contains the C++ library,\n    `cryptominisat` the cryptominisat5 executable and `pycryptosat` the\n    Python bindings.\n\nextra:\n  recipe-maintainers:\n    - gshiba\n    - msoos\n    - saraedum\n",
