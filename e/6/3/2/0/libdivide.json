  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: libdivide\n  version: \"5.4.0\"\n  build_number: 0\n  os_variant: ${{ \"win\" if win else \"unix\" }}\n\npackage:\n  name: libdivide-devel\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ridiculousfish/libdivide/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 077e8ce6c783d1b4402aa6d77f643f88f37feb80e9896c30e19a62cc0a3f5576\n  patches:\n    # https://github.com/ridiculousfish/libdivide/pull/177\n    - architecture-independent-version.patch\n\nbuild:\n  number: ${{ build_number }}\n  noarch: generic\n  string: ${{ os_variant }}_h${{ hash }}_${{ build_number }}\n  script:\n    env:\n      # Compiler activation must target the build host, not the noarch output.\n      # Workaround for https://github.com/conda-forge/conda-forge.github.io/issues/2691\n      target_platform: ${{ host_platform }}\n    file: build\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('cxx') }}\n    - cmake\n    - ninja\n  ignore_run_exports:\n    from_package:\n      - ${{ compiler('c') }}\n      - ${{ compiler('cxx') }}\n      - ${{ stdlib('c') }}\n  run:\n    - if: unix\n      then: __unix\n    - if: win\n      then: __win\n\ntests:\n  - requirements:\n      run:\n        - cmake-package-check\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n    script:\n      - cmake-package-check libdivide --targets libdivide::libdivide\n  - files:\n      recipe:\n        - test-package/CMakeLists.txt\n        - test-package/test.c\n        - test-package/test.cpp\n    requirements:\n      run:\n        - cmake\n        - ninja\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n    script:\n      - cmake -G Ninja -S test-package -B test-build\n      - cmake --build test-build --config Release\n      - ctest --test-dir test-build -C Release --output-on-failure\n  - package_contents:\n      include:\n        - libdivide.h\n\n\nabout:\n  homepage: https://libdivide.com\n  repository: https://github.com/ridiculousfish/libdivide\n  license: Zlib OR BSL-1.0\n  license_file: LICENSE.txt\n  summary: Header-only C/C++ library for optimized integer division\n\nextra:\n  feedstock-name: libdivide\n  recipe-maintainers:\n    - traversaro\n",
