  "raw_meta_yaml": "context:\n  name: box2d\n  version: \"3.2.0\"\n  build_number: 0\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/erincatto/box2d/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: ffec747b27a2267016f8d0240d658c82d187fb2271fa0f69fcbe53fbc067180d\n\nbuild:\n  number: ${{ build_number }}\n  script:\n    env:\n      BOX2D_AVX2: ${{ \"ON\" if microarch_level|default(1)|int >= 3 and target_platform == \"linux-64\" else \"OFF\" }}\n  variant:\n    use_keys:\n      - microarch_level\n    down_prioritize_variant: ${{ 1 if microarch_level|default(1)|int < 3 and target_platform == \"linux-64\" else 0 }}\n\nrequirements:\n  build:\n    - if: linux and x86_64\n      then: x86_64-microarch-level ==${{ microarch_level }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - ninja\n  run_exports:\n    - ${{ pin_subpackage(name, upper_bound=\"x.x\") }}\n\ntests:\n  - package_contents:\n      lib:\n        - box2d\n      include:\n        - box2d/base.h\n        - box2d/box2d.h\n        - box2d/collision.h\n        - box2d/id.h\n        - box2d/math_functions.h\n        - box2d/types.h\n\nabout:\n  homepage: https://box2d.org/\n  summary: \"Box2D is a 2D physics engine for games.\"\n  description: |\n    An open source C engine for simulating rigid bodies in 2D, uses the C17 standard.\n  license: MIT\n  license_file: LICENSE\n  documentation: https://box2d.org/documentation/\n  repository: https://github.com/erincatto/box2d\n\nextra:\n  recipe-maintainers:\n    - tdejager\n    - baszalmstra\n",
