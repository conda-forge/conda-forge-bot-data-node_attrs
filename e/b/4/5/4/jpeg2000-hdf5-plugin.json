  "linux_64_meta_yaml": {
    "about": {
      "description": "A dynamically loaded HDF5 filter plugin, registered as filter 32031, that\nstores each chunk of a dataset as one JPEG 2000 (including HTJ2K)\ncodestream, encoded and decoded with libojph. It installs to\nlib/hdf5/plugin, the directory HDF5 searches by default on Linux and\nmacOS, and to Library/lib/hdf5/plugin on Windows, which the hdf5\npackage adds to HDF5_PLUGIN_PATH on activation.",
      "dev_url": "https://github.com/hmaarrfk/hdf5_jpeg2000",
      "home": "https://github.com/hmaarrfk/hdf5_jpeg2000",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE.txt",
      "summary": "HDF5 filter plugin 32031 that stores each chunk as a JPEG 2000 codestream"
    },
    "build": {
      "number": "1",
      "script": [
        "cmake -S . -B build -G Ninja ${CMAKE_ARGS} -DHDF5_PLUGIN_INSTALL_DIR=lib/hdf5/plugin",
        "cmake --build build",
        "cmake --install build"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "hmaarrfk"
      ]
    },
    "outputs": [
