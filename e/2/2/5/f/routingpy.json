  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.3.0\"\n\npackage:\n  name: routingpy\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/routingpy/routingpy/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 80126dc6c2d41cbd435380f0abca7a19a91ef5d04bdc3fc07e85f211a2a3fc2d\n\nbuild:\n  number: 1\n  noarch: python\n  script:\n    # GitHub tarballs lack the git metadata setuptools-scm needs\n    - export SETUPTOOLS_SCM_PRETEND_VERSION=${{ version }}\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - pip\n    - python ${{ python_min }}.*\n    - setuptools >=45\n    - setuptools_scm >=6.2\n  run:\n    - python >=${{ python_min }}\n    - requests >=2.2.0,<3.0.0\n  run_constraints:\n    - shapely >=2.0.0,<3\n    - ipykernel >=6.0.0,<7\n    - matplotlib-base >=3.4.1,<4\n    - contextily >=1.1.0,<2\n    - geopandas >=0.8.2,<0.9.0\n    - descartes >=1.0.0,<2\n\ntests:\n  - python:\n      imports:\n        - routingpy\n        - routingpy.routers\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - '*'\n\nabout:\n  summary: Python library to access all public routing, isochrones and matrix APIs in a consistent manner.\n  license: Apache-2.0\n  license_file: LICENSE\n  homepage: https://pypi.org/project/routingpy/\n  repository: https://github.com/routingpy/routingpy\n\nextra:\n  recipe-maintainers:\n    - knaaptime\n    - ickc\n    - synapticarbors\n",
