    "about": {
      "description": "Framework-agnostic Python library providing the core data models, reactive\nstate management, and JSON Schema validation for the A2UI protocol (v0.9\nand later). Implements the protocol's message envelopes (CreateSurface,\nUpdateComponents, UpdateDataModel, DeleteSurface), a reactive state model,\ndata binding, and a catalog system for compiled and JSON Schema-based\ncomponent/function definitions, for use by Python server agents,\nrendering backends, and conformance testing frameworks.",
      "dev_url": "https://github.com/a2ui-project/a2ui/tree/main/python/a2ui_core",
      "home": "https://a2ui.org/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "A2UI Python SDK - Core Library"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "${{ PYTHON }} -m pip install . -vv"
    },
    "extra": {
      "recipe-maintainers": [
        "pb01ka"
      ]
    },
    "outputs": [
      {
        "build": {
          "noarch": "python"
        },
        "name": "a2ui-core",
        "requirements": {
          "build": [],
          "host": [
            "python 3.11.*",
            "pip",
            "hatchling",
            "hatch-vcs"
          ],
          "run": [
            "python >=3.11",
            "babel >=2.14.0",
            "jsonschema >=4.26.0",
            "pydantic >=2.10.0",
            "referencing >=0.37.0",
            "regex >=2024.11.6"
          ]
        },
        "tests": [
          {
