  "linux_64_meta_yaml": {
    "about": {
      "description": "`mise` (mise-en-place) is a unified CLI tool designed to simplify and manage local development environments.\nIt acts as a polyglot tool version manager, installing and seamlessly switching between versions of various\ndevelopment tools (replacing utilities like `asdf`, `nvm`, and `pyenv`). Additionally, it functions as an\nenvironment variable manager that dynamically loads project-specific env vars based on your current directory\n(replacing `direnv`), and serves as a built-in task runner to define and execute project workflows as a modern\nalternative to `make` or `npm` scripts.",
      "dev_url": "https://github.com/jdx/mise",
      "home": "https://mise.jdx.dev/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "mise manages dev tools, env vars, and runs tasks."
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "$env.LIBCLANG_PATH = $env.BUILD_PREFIX | path join lib",
          "cargo auditable install --path=. --root=($prefix) --no-track --locked --bins --no-default-features --features=${{ base_features }}${{ extra_features }}",
          "cargo-bundle-licenses --format=yaml --output=THIRDPARTY.yml",
          "mkdir ($prefix)/lib",
          "echo 'message = \"${{ self_update_msg }}\"' | save ($prefix)/lib/mise-self-update-instructions.toml",
          "mkdir ($prefix)/share/man/man1",
          "cp man/man1/*.1 ($prefix)/share/man/man1/",
          "^mise completion bash | save --force ($prefix)/share/bash-completion/completions/mise",
          "^mise completion fish | save --force ($prefix)/share/fish/vendor_completions.d/mise.fish",
          "^mise completion zsh  | save --force ($prefix)/share/zsh/site-functions/_mise"
        ],
        "env": {
          "AR_x86_64_pc_windows_msvc": "llvm-lib",
          "AWS_LC_SYS_CMAKE_BUILDER": "1",
          "CARGO_PROFILE_RELEASE_LTO": "thin",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols",
          "CC_x86_64_pc_windows_msvc": "clang-cl",
          "CXX_x86_64_pc_windows_msvc": "clang-cl",
          "OPENSSL_NO_VENDOR": "1"
        },
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "mise",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "clang",
            "cmake",
            "libclang",
            "make",
            "ninja",
            "nushell",
            "pkg-config"
          ],
          "host": [
            "openssl"
          ],
          "run": []
        },
        "tests": [
          {
            "script": {
              "content": [
                "mise help",
                "mise version"
              ],
              "env": {
                "MISE_NO_CONFIG": "1",
                "MISE_OFFLINE": "1"
              }
            }
          },
          {
            "package_contents": {
              "bin": [
                "mise"
              ],
              "files": [
                "lib/mise-self-update-instructions.toml",
                "share/man/man1/mise.1",
                "share/bash-completion/completions/mise",
                "share/fish/vendor_completions.d/mise.fish",
                "share/zsh/site-functions/_mise"
              ],
              "strict": true
            }
          }
        ],
        "version": "2026.10.4"
      }
    ],
