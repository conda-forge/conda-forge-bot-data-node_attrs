      "number": "1",
      "script": [
        "cd src",
        "go-licenses save . --ignore github.com/bsm/redislock --save_path ../library_licenses",
        "find $SRC_DIR/gopath/pkg/mod/github.com/bsm -maxdepth 2 -path \"*redislock*/LICENSE\" -exec mkdir -p ../library_licenses/github.com/bsm/redislock \\; -exec cp {} ../library_licenses/github.com/bsm/redislock/LICENSE \\; -quit",
