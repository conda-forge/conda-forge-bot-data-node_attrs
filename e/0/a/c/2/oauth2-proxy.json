  "raw_meta_yaml": "context:\n  version: \"7.15.6\"\n\npackage:\n  name: oauth2-proxy\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/oauth2-proxy/oauth2-proxy/archive/v${{ version }}.tar.gz\n  sha256: 7a24bf731e10d5db9149d7186576bc1286c5d084d3a9536ebece2e53b341b8a9\n  target_directory: src\n\nbuild:\n  number: 1\n  script:\n    - cd src\n    # go-licenses cannot detect the Apache-2.0 license of redislock, so it is\n    # ignored here and copied over manually below\n    - go-licenses save . --ignore github.com/bsm/redislock --save_path ../library_licenses\n    - if: unix\n      then:\n        - find $SRC_DIR/gopath/pkg/mod/github.com/bsm -maxdepth 2 -path \"*redislock*/LICENSE\" -exec mkdir -p ../library_licenses/github.com/bsm/redislock \\; -exec cp {} ../library_licenses/github.com/bsm/redislock/LICENSE \\; -quit\n        - go build -v -o $PREFIX/bin/oauth2-proxy -ldflags=\"-s -w -X github.com/oauth2-proxy/oauth2-proxy/v7/pkg/version.VERSION=v${{ version }}\"\n      else:\n        - for /d %%d in (gopath\\pkg\\mod\\github.com\\bsm\\redislock*) do mkdir ..\\library_licenses\\github.com\\bsm\\redislock & copy \"%%d\\LICENSE\" ..\\library_licenses\\github.com\\bsm\\redislock\\LICENSE\n        - go build -v -o %LIBRARY_BIN%\\oauth2-proxy.exe -ldflags=\"-s -w -X github.com/oauth2-proxy/oauth2-proxy/v7/pkg/version.VERSION=v${{ version }}\"\n\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n\ntests:\n  - script:\n      - oauth2-proxy --version\n  - package_contents:\n      bin:\n        - oauth2-proxy\n      strict: true\n\nabout:\n  homepage: https://github.com/oauth2-proxy/oauth2-proxy\n  summary: A reverse proxy and static file server that provides authentication using Providers (Google, GitHub, and others) to validate accounts by email, domain or group.\n  license: MIT\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n  documentation: https://oauth2-proxy.github.io/oauth2-proxy/\n  repository: https://github.com/oauth2-proxy/oauth2-proxy\n\nextra:\n  recipe-maintainers:\n    - asford\n    - mxr-conda\n    - rluria14\n    - ndmaxar\n    - oblute\n    - RyanHackney\n    - xhochy\n",
