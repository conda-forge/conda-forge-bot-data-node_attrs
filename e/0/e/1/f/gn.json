  "raw_meta_yaml": "# As there are no releases in GN, we build the latest tag from time to time.\n# The version is the time of the latest master commit in YYYYMMDDHHMMSS\n# notation.\n\ncontext:\n  version: \"0.0.20250416202228\"\n\npackage:\n  name: gn\n  version: ${{ version }}\n\nsource:\n  # We have to use git as the source as the provided tarballs are not stable.\n  - git: https://gn.googlesource.com/gn\n    rev: 10a27145cd0770b78745ff536e343bf12c70f6c3\n    patches:\n      # No-op outside of MSVC on ARM64, so it is applied on every platform.\n      - win-arm64.patch\n      # - add-lrt.patch\n\nbuild:\n  number: 2\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('cxx') }}\n    # python is only used to run build/gen.py, so pin it loosely to keep it\n    # out of the variant matrix.\n    - python >=3.9\n    - ninja\n\ntests:\n  - package_contents:\n      bin:\n        - gn\n  # \"gn --version\" does not look at the host architecture, so it kept passing on\n  # win-arm64 while every real invocation aborted. Generate an actual project so\n  # the host CPU detection is exercised, and print host_cpu so a wrong (but\n  # non-fatal) answer is visible in the log too.\n  - script:\n      - gn --version\n      - cd test-project\n      - gn gen out\n      - gn args out --list=host_cpu --short\n    files:\n      recipe:\n        - test-project/.gn\n        - test-project/BUILD.gn\n        - test-project/BUILDCONFIG.gn\n\nabout:\n  homepage: https://gn.googlesource.com/gn/\n  license: BSD-3-Clause\n  license_file: LICENSE\n  summary: GN is a meta-build system that generates build files for Ninja.\n\nextra:\n  recipe-maintainers:\n    - xhochy\n",
  "req": {
    "__set__": true,
    "elements": [
      "c_compiler_stub",
      "c_stdlib_stub",
      "cxx_compiler_stub",
      "ninja",
      "python"
    ]
  },
