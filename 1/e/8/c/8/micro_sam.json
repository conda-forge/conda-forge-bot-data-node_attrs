  "raw_meta_yaml": "{% set version = \"2.0.1\" %}\n{% set python_min = \"3.11\" %}\n{% set python_max = \"3.15\" %}\n\npackage:\n  name: micro_sam\n  version: {{ version }}\n\nsource:\n  url: https://github.com/computational-cell-analytics/micro-sam/archive/v{{ version }}.tar.gz\n  sha256: de56ae91fe413f313af76d28866cc8ea4f3f81978611daf9b3d146f4a8a5d5c3\n\nbuild:\n  entry_points:\n    - micro_sam = micro_sam._cli:cli\n  noarch: python\n  number: 0\n  script: pip install . --no-deps --ignore-installed --no-cache-dir -vvv\n\nrequirements:\n  host:\n    - python {{ python_min }}\n    - pip\n    - setuptools >=42\n  run:\n    - python >={{ python_min }},<{{ python_max }}\n    - bioimage-cpp >=0.7\n    - bioimage-py >=0.2.2\n    - bioimageio.core >=0.11\n    - click\n    - h5py\n    - huggingface_hub\n    - imagecodecs\n    - imageio\n    - joblib\n    - kornia\n    - magicgui\n    - matplotlib-base\n    - napari >=0.7.1,<0.11\n    - natsort\n    - networkx\n    - numpy\n    - pandas\n    - pooch\n    - pydantic <2.14\n    - pyqt6\n    - python-elf >=0.9\n    - python-xxhash\n    - pytorch >=2.5\n    # sam-2 provides the 'sam2' module (Segment Anything 2).\n    - sam-2 >=1.0.0.20241215\n    - scikit-image\n    - scikit-learn\n    - segment-anything >=1.0.1\n    - superqt\n    - tensordict\n    - timm\n    - torch_em >=0.10.8\n    - torchvision\n    - tqdm\n    - trackastra >=0.5.3\n    - transformers >=4.56\n    - xarray\n    - z5py >=3\n    - zarr >=3\n\ntest:\n  requires:\n    - python {{ python_min }}\n    - pytest\n  # conda-build does not expand '**' recursively, so list each test folder.\n  source_files:\n    - test/*.py\n    - test/test_models/*.py\n  imports:\n    - micro_sam\n    - micro_sam.util\n    - micro_sam.v1.util\n    - micro_sam.v2.util\n    - micro_sam.v2.instance_segmentation\n    - micro_sam.v2.automatic_prompt_generation\n    - micro_sam.classical_features\n    - micro_sam.v2.training\n  commands:\n    - micro_sam --help\n    - micro_sam --version\n