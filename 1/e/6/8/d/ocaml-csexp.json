  "raw_meta_yaml": "context:\n  version: \"1.5.2\"\n  build_number: 2\n\n  # ocaml_win-64 ships gcc_* and vs2022_* at the same version/build; name the track.\n  c_toolchain: ${{ \"\" if unix else c_compiler ~ \"_*\" }}\n  library: ${{ \"Library/\" if not unix else \"\" }}\n\npackage:\n  name: ocaml-csexp\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ocaml-dune/csexp/releases/download/${{ version }}/csexp-${{ version }}.tbz\n  sha256: 1a14dd04bb4379a41990248550628c77913a9c07f3c35c1370b6960e697787ff\n\nbuild:\n  number: ${{ build_number }}\n  string: ${{ c_compiler ~ \"_\" if not unix }}h${{ hash }}_${{ build_number }}\n  script:\n    - if: unix\n      then:\n        - dune build --profile=release -p csexp @install\n        - dune install --prefix=\"${PREFIX}\" --libdir=\"${PREFIX}/lib/ocaml\" csexp\n      else:\n        # Plain cmd.exe, not MSYS2 bash: pure OCaml, no stubs, so no wrapper is\n        # needed and the backslashed install prefix reaches dune intact. The\n        # dune cache trips over mixed path separators on windows.\n        - dune build --cache=disabled --profile=release -p csexp @install\n        - if errorlevel 1 exit 1\n        - dune install --prefix=\"%LIBRARY_PREFIX%\" --libdir=\"%LIBRARY_PREFIX%\\lib\\ocaml\" csexp\n        - if errorlevel 1 exit 1\n\nrequirements:\n  build:\n    - if: not unix and c_compiler == \"gcc\"\n      then:\n        - ${{ stdlib(\"m2w64_c\") }}\n      else:\n        - ${{ stdlib(\"c\") }}\n    # MSVC is activated here, once: ocaml_win-64 >=14 only run-constrains it.\n    - if: not unix and c_compiler != \"gcc\"\n      then:\n        - ${{ compiler('c') }}\n    - ${{ compiler(\"ocaml\") }}\n    # compiler(\"ocaml\") renders no toolchain track; name it on windows.\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n    - if: build_platform != target_platform\n      then:\n        - ocaml_${{ build_platform }} ${{ ocaml_compiler_version }}.*\n    - ocaml-dune >=3.4\n  host:\n    - ocaml ${{ ocaml_compiler_version }}.*\n    # The noarch ocaml metapackage does not pin the windows toolchain track.\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n  # The ocaml run_export does not encode the windows toolchain track.\n  run_constraints:\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n\ntests:\n  - package_contents:\n      strict: true\n      files:\n        - ${{ library }}lib/ocaml/csexp/*\n        - ${{ library }}doc/csexp/*\n\nabout:\n  homepage: https://github.com/ocaml-dune/csexp\n  repository: https://github.com/ocaml-dune/csexp\n  summary: Parsing and printing of S-expressions in canonical form\n  license: MIT\n  license_file: LICENSE.md\n\nextra:\n  recipe-maintainers:\n    - ManuelLerchner\n    - MementoRC\n",
