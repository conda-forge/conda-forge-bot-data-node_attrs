      "summary": "Parsing and printing of S-expressions in canonical form"
    },
    "build": {
      "number": "3",
      "script": [
        "dune build --profile=release -p csexp @install",
        "dune install --prefix=\"${PREFIX}\" --libdir=\"${PREFIX}/lib/ocaml\" csexp"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "ManuelLerchner",
        "MementoRC"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "ocaml-csexp",
        "requirements": {
          "build": [
            "ocaml_compiler_stub",
            "c_stdlib_stub",
            "ocaml-dune >=3.4"
          ],
          "host": [
            "ocaml 5.4.0.*"
          ],
          "run": []
        },
        "tests": [
          {
            "package_contents": {
              "files": [
                "lib/ocaml/csexp/*",
                "doc/csexp/*"
              ],
              "strict": true
            }
          },
          {
            "requirements": {
              "build": [
                "file",
                "binutils"
              ]
            },
            "script": {
              "content": [
                "mkdir -p objs",
                "cd objs",
                "ar x \"${PREFIX}/lib/ocaml/csexp/csexp.a\"",
                "file -L ./*.o",
                "test -z \"$(file -L ./*.o | grep -v \"${ELF_ARCH}\")\""
              ],
              "env": {
                "ELF_ARCH": "x86-64"
              }
            }
          }
        ],
        "version": "1.5.2"
      },
