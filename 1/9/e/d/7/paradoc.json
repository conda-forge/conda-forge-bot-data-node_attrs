  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  python_min: \"3.10\"\n  name: paradoc\n  version: \"0.8.0\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/Krande/paradoc/archive/v${{ version }}.tar.gz\n  sha256: 82e8198d8108a2257021eedbce9b36a38cd3eef205038ef90357c934af9bf941\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - paradoc=paradoc.cli_app:app\n      - paradoc-serve=paradoc.serve.cli:app\n      - paradoc-migrate-syntax=paradoc.cli.migrate_syntax:app\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n  run:\n    - python >=${{ python_min }}\n    - pandoc\n    - pandoc-crossref\n    - pypandoc\n    - python-docx\n    - python-kaleido\n    - numpy\n    - pandas\n    - openpyxl\n    - tabulate\n    - pydantic\n    - svgwrite\n    - pytexit\n    - websockets\n    - plotly\n    - pillow\n    - typer\n    - if: unix\n      then: __unix\n    - if: win\n      then:\n        - __win\n        - pywin32\ntests:\n  - files:\n      source:\n        - tests\n        - files\n      recipe:\n        - setup_browser.py\n    requirements:\n      run:\n        - pytest\n        - pytest-cov\n        - pytest-timeout\n        - python ${{ python_min }}.*\n        - playwright\n        - pytest-playwright\n    script:\n      # --timeout with the thread method (works on Windows) fails any test that\n      # hangs instead of stalling CI, and dumps the hung test's stack trace.\n      - if: not win\n        then:\n          - pytest tests --ignore=tests/frontend --timeout=300 --timeout-method=thread\n        else:\n          - python setup_browser.py > browser_path.txt\n          - set /p BROWSER_PATH=<browser_path.txt\n          - pytest tests --ignore=tests/frontend --timeout=300 --timeout-method=thread\nabout:\n  license: GPL-3.0-or-later\n  license_file: LICENSE\n  summary: A Python library for Parametric Documentation\n  homepage: https://github.com/krande/paradoc\n\nextra:\n  recipe-maintainers:\n    - Krande\n",
