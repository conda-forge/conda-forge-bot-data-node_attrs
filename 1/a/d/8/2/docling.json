  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: docling\n  version: \"2.143.1\"\n\nrecipe:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/d/docling-slim/docling_slim-${{ version }}.tar.gz\n  sha256: 4bb1c0b18e47df95f3a1d6e02457fb2bd847be01e1134129e27fed1dda798609\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: ${{ name }}-slim\n    build:\n      number: 0\n      noarch: python\n      script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n      python:\n        entry_points:\n          - docling = docling.cli.main:app\n          - docling-tools = docling.cli.tools:app\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - hatchling\n      run:\n        - python >=${{ python_min }}\n        - pydantic >=2.0.0,<3.0.0\n        - docling-core >=2.103.1,<3.0.0\n        - pydantic-settings >=2.3.0,<3.0.0\n        - filetype >=1.2.0,<2.0.0\n        - requests >=2.32.2,<3.0.0\n        - certifi >=2024.7.4\n        - pluggy >=1.0.0,<2.0.0\n        - tqdm >=4.65.0,<5.0.0\n        - langcodes >=3.5.0,<4.0.0\n    tests:\n      - python:\n          imports:\n            - docling\n          pip_check: false\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n\n  - package:\n      name: ${{ name }}\n    build:\n      number: 0\n      noarch: python\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n      run:\n        - python >=${{ python_min }}\n        - ${{ pin_subpackage(\"docling-slim\", exact=True) }}\n        - docling-ibm-models >=4.0.2,<5\n        - docling-parse >=7.22.2,<8.0.0\n        - pypdfium2 >=4.30.0,!=4.30.1,<6.0.0\n        - huggingface_hub >=0.23,<2\n        - rtree >=1.3.0,<2.0.0\n        - scipy >=1.9.0,<2.0.0\n        - typer >=0.19.0,<0.27.0\n        - python-docx >=1.2.0,<2.0.0\n        - python-pptx >=1.0.2,<2.0.0\n        - beautifulsoup4 >=4.12.3,<5.0.0\n        - marko >=2.1.2,<3.0.0\n        - openpyxl >=3.1.5,<4.0.0\n        - pillow >=10.0.0,<14.0.0\n        - pylatexenc >=2.10,<3.0\n        - polyfactory >=2.22.2\n        - accelerate >=1.0.0,<2\n        - rapidocr >=3.9.1,<4.0.0\n        - defusedxml >=0.7.1,<0.8.0\n        - mail-parser >=4.1.4,<5.0.0\n        - httpx >=0.28,<1.0.0\n        - numpy >=1.24.0,<3.0.0\n        - python-dotenv >=1.0,<2\n        - python-oxmsg >=0.0.2,<0.1.0\n        - rich >=13.0.0\n        - pytorch >=2.2.2,<3.0.0\n        - torchvision <1\n        - websockets >=14.0,<17.0\n      run_constraints:\n        - tesserocr >=2.7.1,<3.0.0\n        - onnxruntime >=1.7.0,<2.0.0\n        - transformers >=4.42.0,<6.0.0,!=5.0.*,!=5.1.*,!=5.2.*,!=5.3.*,!=5.13.0\n    tests:\n      - python:\n          imports:\n            - docling\n          # `pip check` fails because:\n          # - \"scikit-image 0.24.0 has requirement numpy>=1.23, but you have numpy 1.22.4.\"\n          pip_check: false\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n      - script:\n          - docling --help\n          - docling-tools --help\n        requirements:\n          run:\n            - python ${{ python_min }}.*\n\nabout:\n  summary: Docling PDF conversion package\n  license: MIT\n  license_file: LICENSE\n  homepage: https://github.com/DS4SD/docling\n\nextra:\n  recipe-maintainers:\n    - kklein\n",
