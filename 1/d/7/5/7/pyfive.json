  "raw_meta_yaml": "{% set name = \"pyfive\" %}\n{% set version = \"1.2.1\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/{{ name[0] }}/{{ name }}/pyfive-{{ version }}.tar.gz\n  sha256: d44149120bc0d21c1c0dbbc9d84ea2d2fef4be7ae4e15b7fac69eb627c1d11ce\n\nbuild:\n  noarch: python\n  script: {{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  number: 0\n\nrequirements:\n  host:\n    - python {{ python_min }}\n    - pip !=21.3\n    - setuptools >=80\n    - setuptools_scm >=8\n  run:\n    - python >={{ python_min }}\n    - fsspec\n    - numpy >=2\n    - typing_extensions\n\ntest:\n  source_files:\n    - tests\n  requires:\n    - python {{ python_min }}\n    - pip\n    - dask\n    - flask\n    - flask-cors\n    - h5netcdf\n    - h5py\n    - moto\n    - netcdf4 !=1.7.4  # github.com/Unidata/netcdf4-python/issues/1464\n    - pytest\n    - pytest-cov\n    - pytest-html\n    - pytest-xdist\n    - python-neo-lzf\n    - s3fs >=2025.9.0\n  commands:\n    - pip check\n    # either botocore or s3fs sets REQUESTS_CA_BUNDLE='' (empty string)\n    # this tosses an error after botocore=1.45.54 but only inside the conda build environment\n    # so we need to reset env -u REQUESTS_CA_BUNDLE -u AWS_CA_BUNDLE before running pytest\n    - python -c \"import boto3; s=boto3.Session(); print('ca_bundle =', repr(s._session.get_config_variable('ca_bundle')))\"\n    - python -c \"import os; print('AWS_CA_BUNDLE =', repr(os.environ.get('AWS_CA_BUNDLE'))); print('REQUESTS_CA_BUNDLE =', repr(os.environ.get('REQUESTS_CA_BUNDLE')))\"\n    - python -c \"import pyfive\"\n    - env -u REQUESTS_CA_BUNDLE -u AWS_CA_BUNDLE pytest --ignore=tests/test_filter_pipeline_v2.py::test_hdf5_filters\n    - p5dump -h\n  imports:\n    - pyfive\n\nabout:\n  home: https://github.com/NCAS-CMS/pyfive\n  license: BSD-3-Clause\n  license_file: LICENSE.txt\n  summary: 'A pure Python HDF5 file reader'\n\nextra:\n  recipe-maintainers:\n   