      "description": "Wild is a linker with the goal of being very fast for iterative development.\nThe plan is to eventually make it incremental, however that isn't yet\nimplemented. It is however already pretty fast even without incremental\nlinking.",
      "dev_url": "https://github.com/wild-linker/wild",
      "home": "https://github.com/wild-linker/wild",
      "license": "MIT OR Apache-2.0",
      "license_family": "MIT OR Apache-2.0",
      "license_file": "LICENSE-APACHE",
      "summary": "Fast linker optimized for incremental builds"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path wild",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml",
          "ln -rs ${{ PREFIX }}/bin/wild ${{ PREFIX }}/bin/ld.wild"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "benjaminglass1"
      ]
    },
