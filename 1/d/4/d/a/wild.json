  "raw_meta_yaml": "context:\n  version: 0.10.0\n\npackage:\n  name: wild\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/wild-linker/wild/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 99ec83404558d4d0cbde9dd44b8c6fa2a511a2f8bb04a31f54c0929ec4491990\n\nbuild:\n  number: 0\n  skip:\n    # Upstream currently only releases on Linux, so skip untested configs.\n    - osx\n    - win\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path wild\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n      - ln -rs ${{ PREFIX }}/bin/wild ${{ PREFIX }}/bin/ld.wild\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - coreutils\n\ntests:\n  - script:\n      - wild --version\n      - ld.wild --version\n  - package_contents:\n      bin:\n        - wild\n        - ld.wild\n      strict: true\n\nabout:\n  homepage: https://github.com/wild-linker/wild\n  summary: \"Fast linker optimized for incremental builds\"\n  description: |\n    Wild is a linker with the goal of being very fast for iterative development.\n    The plan is to eventually make it incremental, however that isn't yet\n    implemented. It is however already pretty fast even without incremental\n    linking.\n  license: MIT OR Apache-2.0\n  license_file:\n    - LICENSE-APACHE\n    - LICENSE-MIT\n    - THIRDPARTY.yml\n  repository: https://github.com/wild-linker/wild\n\nextra:\n  recipe-maintainers:\n    - benjaminglass1\n",
