  "linux_64_meta_yaml": {
    "about": {
      "description": "The HistFactory p.d.f. template [CERN-OPEN-2012-016] is per-se independent\nof its implementation in ROOT and sometimes, it's useful to be able to run\nstatistical analysis outside of ROOT, RooFit, RooStats framework.\n\nThis repo is a pure-python implementation of that statistical model for\nmulti-bin histogram-based analysis and its interval estimation is based on\nthe asymptotic formulas of \"Asymptotic formulae for likelihood-based tests\nof new physics\" [arXiv:1007.1727]. The aim is also to support modern\ncomputational graph libraries such as PyTorch, JAX, and TensorFlow in order\nto make use of features such as automatic differentiation and GPU\nacceleration.",
      "dev_url": "https://github.com/scikit-hep/pyhf",
      "doc_url": "https://pyhf.readthedocs.io/",
      "home": "https://github.com/scikit-hep/pyhf",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "pure-Python HistFactory implementation"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "pyhf = pyhf.cli:cli"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv"
    },
    "extra": {
      "recipe-maintainers": [
        "matthewfeickert",
        "lukasheinrich",
        "kratsg",
        "conda-forge/scikit-hep"
      ]
    },
