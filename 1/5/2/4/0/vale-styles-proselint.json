  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.4.0\"\n  vale_name: proselint\n  summary: proselint rules for vale grammar and style checker\n  # well-known\n  styles: share/vale/styles\n  # os\n  export: ${{ \"export\" if unix else \"set\" }}\n  mkdir_p: ${{ \"mkdir -p\" if unix else \"md\" }}\n  slash: ${{ \"/\" if unix else \"\\\\\" }}\n  cp_r: ${{ \"cp -r\" if unix else \"copy\" }}\n  os_styles: ${{ slash }}${{ styles | split(\"/\") | join(slash) }}${{ slash }}\n\npackage:\n  name: vale-styles-proselint\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/errata-ai/${{ vale_name }}/releases/download/v${{ version }}/${{ vale_name }}.zip\n    sha256: e09f637e4a7beab802c3fb7c9259ec2b2f383fdd4b24b329e3fe50a715a45e67\n    target_directory: ${{ vale_name }}\n  - url: https://raw.githubusercontent.com/vale-cli/${{ vale_name }}/refs/tags/v${{ version }}/LICENSE\n    sha256: b1f23c552b813bb86d87ed697d895a5e03bf80a3882f9ffd87fcdeb176f103c0\n    target_directory: ${{ vale_name }}\n\nbuild:\n  number: 0\n  noarch: generic\n  script:\n    - ${{ mkdir_p }} \"${{ PREFIX }}${{ os_styles }}\"\n    - ${{ cp_r }} \"${{ vale_name }}\" \"${{ PREFIX }}${{ os_styles }}${{ slash }}${{ vale_name }}\"\n\nrequirements:\n  run:\n    - vale\n\ntests:\n  - package_contents:\n      strict: true\n      files:\n        - ${{ styles }}/${{ vale_name }}/*.yml\n        - ${{ styles }}/${{ vale_name }}/{LICENSE,README.md}\n        - ${{ styles }}/${{ vale_name }}/meta.json\n  - requirements:\n      run:\n        - pytest\n    script:\n      env:\n        VALE_PKG_NAME: ${{ vale_name }}\n      file: run_test.py\n\nabout:\n  license: BSD-3-Clause\n  license_file: ${{ vale_name }}/LICENSE\n  summary: ${{ summary }}\n  homepage: https://github.com/errata-ai/${{ vale_name }}\n\nextra:\n  recipe-maintainers:\n    - bollwyvl\n",
