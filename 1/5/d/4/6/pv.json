  "linux_64_meta_yaml": {
    "about": {
      "description": "pv (Pipe Viewer) is a terminal-based tool for monitoring the progress of\ndata through a pipeline and modifying its flow. It displays how quickly\ndata is being transferred, how long it has taken, how near to completion\nit is, and an estimate of how long it will be until completion.",
      "dev_url": "https://codeberg.org/ivarch/pv",
      "doc_url": "https://www.ivarch.com/programs/quickref/pv.shtml",
      "home": "https://www.ivarch.com/programs/pv.shtml",
      "license": "GPL-3.0-or-later",
      "license_family": "GPL-3.0-or-later",
      "license_file": "docs/COPYING",
      "summary": "Monitor the progress of data through a pipe"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "./configure --prefix=\"${PREFIX}\" --build=\"${BUILD}\" --host=\"${HOST}\" --disable-dependency-tracking",
          "make -j\"${CPU_COUNT}\"",
          "make check TESTS=\"$(ls tests/*.test | grep -v 'numeric_--timer')\" || make recheck || make recheck",
          "make install"
        ]
      }
    },
    "extra": {
      "recipe-maintainers": [
        "shahin",
        "dbast"
      ]
    },
    "outputs": [
      {
        "build": null,
