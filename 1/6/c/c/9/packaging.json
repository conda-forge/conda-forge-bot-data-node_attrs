  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"26.4\"\n  python_min: \"3.10\"\n\npackage:\n  name: packaging\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/p/packaging/packaging-${{ version }}.tar.gz\n  sha256: c4b671c41ddb9bf26e543c37723610d28fb6bf7affc4da17cf048d419d2c062a\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv\n\nrequirements:\n  host:\n    # conda-forge's pip prior to Python 3.13 depends on wheel, which depends on\n    # packaging, so using pip for python_min older than 3.13 would put an older\n    # packaging in host and the new install would clobber it, leaving its files\n    # out of the package. Until packaging has requires-python of >= 3.13\n    # manually force python 3.13 as the host Python.\n    # See https://conda-forge.org/news/2024/08/21/sunsetting-pip-deps/\n    # - python ${{ python_min }}.*\n    - python 3.13.*\n    - flit-core >=3.12\n    - pip\n  run:\n    - python >=${{ python_min }}\n\ntests:\n  - python:\n      imports:\n        - packaging\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\nabout:\n  license: Apache-2.0\n  license_file: LICENSE\n  summary: Core utilities for Python packages\n  homepage: https://github.com/pypa/packaging\n  repository: https://github.com/pypa/packaging\n  documentation: https://packaging.pypa.io/\n\nextra:\n  recipe-maintainers:\n    - henryiii\n    - jakirkham\n    - nicoddemus\n    - matthewfeickert\n    - ofek\n",
