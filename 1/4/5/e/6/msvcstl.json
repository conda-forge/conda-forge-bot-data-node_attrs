  "raw_meta_yaml": "context:\n  version: \"14.44\"\n\nrecipe:\n  name: msvcstl-packages\n  version: \"${{ version }}\"\n\nsource:\n  # Upstream recently changed tagging to match MSVC, but the latest VS 2022 build still uses the old scheme\n  - url: https://github.com/microsoft/STL/archive/refs/tags/vs-2022-17.14.tar.gz\n    sha256: 848542f4d92ea157dec5e66e1f71cde28675b34982390430ad11fcec0cd35bb0\n  - url: https://github.com/boostorg/math/archive/4d0885ae44f7d4ce94568339b2ae5501eb234e8f.tar.gz\n    sha256: 40d66987f3eabe43a2dcd02fdd96ea64dfd9b2b9387131051b7d8ba65436ea49\n    target_directory: boost-math\n\nbuild:\n  number: 0\n  skip: not win\n\noutputs:\n  - staging:\n      name: msvcstl-build\n    build:\n      script:\n        file: build.bat\n    requirements:\n      build:\n        - ${{ stdlib('c') }}\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - cmake\n        - ninja\n        - python >=3.13\n\n  - package:\n      name: msvcstl-headers\n    inherit: msvcstl-build\n    build:\n      noarch: generic\n      files:\n        - Library/include/c++/*\n    requirements:\n      run_constraints:\n        - msvcstl-devel ==${{ version }}\n        # Keep in sync with the __clang_major__ check in stl/inc/yvals_core.h\n        - clangxx >=19\n        - vs >=2022\n    tests:\n      - package_contents:\n          files:\n            - Library/include/c++/*\n          strict: true\n\n  - package:\n      name: msvcstl\n    inherit: msvcstl-build\n    build:\n      string: ${{ \"debug_\" if hardening == \"debug\" }}h${{ hash }}_${{ build_number }}\n      files:\n        - Library/bin/msvcp140_1${{ \"d\" if hardening == \"debug\" }}_conda.dll\n        - Library/bin/msvcp140_2${{ \"d\" if hardening == \"debug\" }}_conda.dll\n        - Library/bin/msvcp140${{ \"d\" if hardening == \"debug\" }}_atomic_wait_conda.dll\n        - Library/bin/msvcp140${{ \"d\" if hardening == \"debug\" }}_codecvt_ids_conda.dll\n        - Library/bin/msvcp140${{ \"d\" if hardening == \"debug\" }}_conda.dll\n    requirements:\n      run_exports:\n        - if: hardening == \"debug\"\n          then: msvcstl * debug*\n    tests:\n      - package_contents:\n          files:\n            - Library/bin/msvcp140_1${{ \"d\" if hardening == \"debug\" }}_conda.dll\n            - Library/bin/msvcp140_2${{ \"d\" if hardening == \"debug\" }}_conda.dll\n            - Library/bin/msvcp140${{ \"d\" if hardening == \"debug\" }}_atomic_wait_conda.dll\n            - Library/bin/msvcp140${{ \"d\" if hardening == \"debug\" }}_codecvt_ids_conda.dll\n            - Library/bin/msvcp140${{ \"d\" if hardening == \"debug\" }}_conda.dll\n          strict: true\n\n  - package:\n      name: msvcstl-devel\n    build:\n      files:\n        - Library/modules/modules.json\n        - Library/modules/std.compat.ixx\n        - Library/modules/std.ixx\n        - Library/lib/stl_asan.lib\n        - Library/lib/msvcprt${{ \"d\" if hardening == \"debug\" }}.lib\n        - Library/lib/libcpmt${{ \"d\" if hardening == \"debug\" }}.lib\n        - Library/lib/libcpmt${{ \"d\" if hardening == \"debug\" }}1.lib\n        - if: hardening == \"debug\"\n          then: Library/lib/libcpmtd0.lib\n      string: ${{ \"debug_\" if hardening == \"debug\" }}h${{ hash }}_${{ build_number }}\n    inherit: msvcstl-build\n    requirements:\n      host:\n        - ${{ pin_subpackage(\"msvcstl\", exact = True) }}\n        - ${{ pin_subpackage(\"msvcstl-headers\", exact = True) }}\n      run:\n        - if: hardening == \"none\"\n          then: msvcstl * h*\n          else: msvcstl * debug*\n        - ${{ pin_subpackage(\"msvcstl\", upper_bound = None) }}\n        - ${{ pin_subpackage(\"msvcstl-headers\", upper_bound = \"x.x.x\") }}\n    tests:\n      - package_contents:\n          files:\n            - Library/modules/modules.json\n            - Library/modules/std.compat.ixx\n            - Library/modules/std.ixx\n            - Library/lib/stl_asan.lib\n            - Library/lib/msvcprt${{ \"d\" if hardening == \"debug\" }}.lib\n            - Library/lib/libcpmt${{ \"d\" if hardening == \"debug\" }}.lib\n            - Library/lib/libcpmt${{ \"d\" if hardening == \"debug\" }}1.lib\n            - etc/conda/test-files/*\n            - if: hardening == \"debug\"\n              then: Library/lib/libcpmtd0.lib\n          strict: true\n      - script: compile_test.bat\n        requirements:\n          run:\n            - ${{ stdlib('c') }}\n            - ${{ compiler('c') }}\n            - ${{ compiler('cxx') }}\n        files:\n          recipe:\n            - test_sources/\n\nabout:\n  license: Apache-2.0\n  license_file: LICENSE.txt\n  summary: MSVC's implementation of the C++ Standard Library.\n  homepage: https://github.com/microsoft/STL\n\nextra:\n  recipe-maintainers:\n    - h-vetinari\n    - isuruf\n    - danielnachun\n  feedstock-name: msvcstl\n",
