  "meta_yaml": {
    "about": {
      "description": "psmux is a native Windows terminal multiplexer built in Rust. It uses\nWindows ConPTY, supports tmux commands and configuration, and provides\npsmux, pmux, and tmux command line executables.",
      "dev_url": "https://github.com/psmux/psmux",
      "home": "https://psmux.pages.dev/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Native Windows terminal multiplexer with tmux compatibility"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path .",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "jsmolic"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "psmux",
