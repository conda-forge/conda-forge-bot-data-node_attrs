    "about": {
      "description": "pyliquibase is a Python module that wraps Liquibase, letting you run\nLiquibase database-migration commands (update, rollback, status,\nvalidate, etc.) from Python code or the command line. It embeds a Java\nVirtual Machine via JPype (JNI) to call Liquibase directly, so a Java\nruntime must be available on the system.",
      "dev_url": "https://github.com/memiiso/pyliquibase",
      "doc_url": "https://memiiso.github.io/pyliquibase/",
      "home": "https://github.com/memiiso/pyliquibase",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "A Python wrapper for Liquibase, the database schema change management tool"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "pyliquibase = pyliquibase:main"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "pb01ka"
      ]
    },
