  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"1.27.0\"\n  summary: Multimodal Access and Interactive Data Representations\n  python_check_max: \"3.14\"\n\nrecipe:\n  name: py-maidr-split\n  version: ${{ version }}\n\nsource:\n  - target_directory: dist\n    url: https://files.pythonhosted.org/packages/source/m/maidr/maidr-${{ version }}.tar.gz\n    sha256: 9c4d58fce96e4989f5b01d06843491c7aa41528423df6414709996ecd460eca7\n  - target_directory: src\n    url: https://github.com/xability/py-maidr/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 0566ef623f490d70db7155315970ff4b8f3b3dc14a7aa45289f95db9c55a3c2d\n\nbuild:\n  number: 0\n  noarch: python\n\noutputs:\n  - package:\n      name: py-maidr\n    build:\n      number: 0\n      noarch: python\n      script:\n        - cd dist\n        - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check --check-build-dependencies\n    requirements:\n      host:\n        - hatchling\n        - pip\n        - python ${{ python_min }}.*\n      run:\n        - htmltools >=0.5\n        - lxml >=5.1.0\n        - mplfinance >=0.12.10b0\n        - numpy >=1.26\n        - python >=${{ python_min }}\n        - wrapt >=1.16.0,<2\n        - seaborn-base >=0.13\n        - matplotlib-base >=3.8\n        - scipy >=1.11\n      run_constraints:\n        - statsmodels >=0.14.4\n    tests:\n      - package_contents:\n          strict: true\n          site_packages:\n            - maidr/**\n            - maidr-${{ version }}.dist-info/**\n      - python:\n          imports: maidr\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n\n  - package:\n      name: py-maidr-with-altair\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"py-maidr\", exact=True) }}\n        - altair >=5.0\n    tests:\n      - python:\n          imports: maidr\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: ${{ summary }} (with [altair])\n\n  - package:\n      name: py-maidr-with-jupyter\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"py-maidr\", exact=True) }}\n        - ipykernel >=6.0.0\n        - jupyter >=1.0.0,<2\n    tests:\n      - python:\n          imports: maidr\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: ${{ summary }} (with [jupyter])\n\n  - package:\n      name: py-maidr-with-plotly\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"py-maidr\", exact=True) }}\n        - plotly >=5.0\n        - contourpy >=1.0.1\n    tests:\n      - python:\n          imports: maidr\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: ${{ summary }} (with [plotly])\n\n  - package:\n      name: py-maidr-with-shiny\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"py-maidr\", exact=True) }}\n        - shiny >=1.0\n    tests:\n      - python:\n          imports: maidr\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: ${{ summary }} (with [shiny])\n\n  - package:\n      name: py-maidr-with-streamlit\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"py-maidr\", exact=True) }}\n        - streamlit >=1.30\n    tests:\n      - python:\n          imports: maidr\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: ${{ summary }} (with [streamlit])\n\n  - package:\n      name: py-maidr-with-visualization\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"py-maidr\", exact=True) }}\n        - flask >=3.0.0\n        - seaborn-base\n        # constraint above\n        - statsmodels\n    tests:\n      - python:\n          imports: maidr\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: ${{ summary }} (with [visualization])\n\n  - package:\n      name: py-maidr-with-all\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"py-maidr-with-altair\", exact=True) }}\n        - ${{ pin_subpackage(\"py-maidr-with-jupyter\", exact=True) }}\n        - ${{ pin_subpackage(\"py-maidr-with-plotly\", exact=True) }}\n        - ${{ pin_subpackage(\"py-maidr-with-shiny\", exact=True) }}\n        - ${{ pin_subpackage(\"py-maidr-with-streamlit\", exact=True) }}\n        - ${{ pin_subpackage(\"py-maidr-with-visualization\", exact=True) }}\n        - ${{ pin_subpackage(\"py-maidr\", exact=True) }}\n    tests:\n      - python:\n          imports: maidr\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n      - files:\n          source:\n            - src/tests/\n            - src/docs/\n            - src/pyproject.toml\n        requirements:\n          run:\n            - cssselect >=1.2\n            - pytest >=7.3.2,<8\n            - pytest-cov\n            - pytest-mock >=3.12.0,<4\n            - pytest-html\n            - python ${{ python_min }}.*\n            # more [extras], not yet captured as sub-packages until extras CEP resolves\n            - networkx >=3.0\n            - tensorboard >=2.12\n            - wandb >=0.16\n            - plotnine >=0.13\n            - gradio >=5.0\n            - mlflow >=2.0\n            - xlsxwriter >=3.0\n            # uses deprecated assumptions in test, using version from `uv.lock`\n            #   AttributeError: module 'plotly.graph_objects' has no attribute 'Scattermapbox'\n            - if: match(version, \"1.25.0.*\") or match(version, \"1.26.0.*\") or match(version, \"1.27.0.*\")\n              then:\n                - plotly 6.7.0.*\n        script:\n          file: run_test.py\n    about:\n      summary: ${{ summary }} (with all [extras])\n\nabout:\n  homepage: https://pypi.org/project/maidr\n  summary: ${{ summary }}\n  license: GPL-3.0-or-later\n  license_file:\n    - dist/LICENSE\n    # TODO: js licenses?\n  repository: https://github.com/xability/py-maidr\n  documentation: https://py.maidr.ai\n\nextra:\n  feedstock-name: py-maidr\n  recipe-maintainers:\n    - bollwyvl\n",
