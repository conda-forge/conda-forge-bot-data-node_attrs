  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: intrinsics-kernel\n  opam_name: ocaml_intrinsics_kernel\n  version: \"0.17.2\"\n  build_number: 0\n\n  library: ${{ \"Library/\" if not unix else \"\" }}\n  m2: ${{ \"m2-\" if not unix else \"\" }}\n  # ocaml_<platform> matchspec tail: version, plus the gcc_ (MinGW) track on non-unix\n  ocaml_spec: ${{ ocaml_compiler_version ~ (\".*\" if unix else \".* gcc_*\") }}\n\npackage:\n  name: ocaml-${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/janestreet/ocaml_intrinsics_kernel/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: a91df2e5038b7d5cc8cccbc2b3fd21fcc5acfffcf4e67792ccb4198c32d18562\n\nbuild:\n  number: ${{ build_number }}\n  string: ${{ \"gcc_\" if not unix }}h${{ hash }}_${{ build_number }}\n  script: bash ${{ RECIPE_DIR }}/build.sh ${{ opam_name }}\n\nrequirements:\n  build:\n    - ${{ compiler(\"ocaml\") }}\n    # compiler(\"ocaml\") renders no toolchain track; name the gcc_ (MinGW) one on non-unix\n    - ocaml_${{ target_platform }} ${{ ocaml_spec }}\n    # C stubs: a C compiler on every lane\n    - if: unix\n      then:\n        - ${{ stdlib(\"c\") }}\n        - ${{ compiler(\"c\") }}\n      else:\n        - ${{ compiler(\"m2w64_c\") }}\n        - ${{ stdlib(\"m2w64_c\") }}\n    - ocaml-dune >=3.11\n    - ${{ m2 }}make\n    - if: not unix\n      then:\n        - m2-bash\n        - m2-coreutils\n        - m2-sed\n        - m2-grep\n        - m2-findutils\n  host:\n    # library: ocaml's run_export pins the compiler patch version\n    - ocaml ${{ ocaml_spec }}\n    - ocaml-dune >=3.11\n  # the ocaml run_export does not encode the non-unix toolchain track\n  run_constraints:\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_spec }}\n    # installed dune-package declares (lang dune X.Y); older dune cannot read it\n    - ${{ pin_compatible('ocaml-dune', lower_bound='x.x', upper_bound=None) }}\n\ntests:\n  - package_contents:\n      files:\n        - ${{ library }}lib/ocaml/${{ opam_name }}/META\n        - ${{ library }}lib/ocaml/${{ opam_name }}/${{ opam_name }}.cma\n        - ${{ library }}lib/ocaml/${{ opam_name }}/${{ opam_name }}.cmxa\n        - ${{ library }}lib/ocaml/${{ opam_name }}/${{ opam_name }}.a\n        - ${{ library }}lib/ocaml/${{ opam_name }}/${{ opam_name }}.cmxs\n  - script:\n      interpreter: bash\n      content:\n        - export DUNE_CACHE=disabled\n        - LIBDIR=$PREFIX/lib/ocaml; SEP=':'\n        - if [[ -d $PREFIX/Library/lib/ocaml ]]; then LIBDIR=$PREFIX/Library/lib/ocaml; SEP=';'; fi\n        - export OCAMLPATH=\"$LIBDIR${OCAMLPATH:+$SEP$OCAMLPATH}\"\n        - echo '(lang dune 3.0)' > dune-project\n        - echo '(executable (name t) (libraries ocaml_intrinsics_kernel) (link_flags (-linkall)))' > dune\n        - echo 'let () = print_string \"intrinsics_kernel ok\"' > t.ml\n        - dune build --root . ./t.exe\n        - ./_build/default/t.exe | grep -q \"intrinsics_kernel ok\"\n    requirements:\n      run:\n        - ocaml ${{ ocaml_spec }}\n        - ocaml-dune >=3.11\n        - if: unix\n          then:\n            - ${{ compiler(\"c\") }}\n        - if: not unix\n          then:\n            - m2-bash\n            - m2-coreutils\n            - m2-grep\n\nabout:\n  homepage: https://github.com/janestreet/ocaml_intrinsics_kernel\n  repository: https://github.com/janestreet/ocaml_intrinsics_kernel\n  license: MIT\n  license_file: LICENSE.md\n  summary: Intrinsics kernel library for OCaml (Jane Street)\n\nextra:\n  recipe-maintainers:\n    - MementoRC\n    - ManuelLerchner\n",
