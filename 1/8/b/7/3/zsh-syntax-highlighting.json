  "linux_64_meta_yaml": {
    "about": {
      "description": "Highlights commands while they are typed at the Zsh prompt, so errors\nsuch as unknown commands or unclosed quotes are visible before the line\nis run.\n\nActivate it by adding this as the last line of your .zshrc:\n\n  source \"${CONDA_PREFIX}/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh\"",
      "dev_url": "https://github.com/zsh-users/zsh-syntax-highlighting",
      "doc_url": "https://github.com/zsh-users/zsh-syntax-highlighting/blob/master/docs/highlighters.md",
      "home": "https://github.com/zsh-users/zsh-syntax-highlighting",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "COPYING.md",
      "summary": "Fish shell like syntax highlighting for Zsh"
    },
    "build": {
      "noarch": "generic",
      "number": "0",
      "script": "make install \\\n  PREFIX=\"${PREFIX}\" \\\n  SHARE_DIR=\"${PREFIX}/${{ plugin_dir }}\" \\\n  DOC_DIR=\"${PREFIX}/share/doc/zsh-syntax-highlighting\"\n"
    },
    "extra": {
      "recipe-maintainers": [
        "ManuelLerchner"
      ]
    },
    "outputs": [
      {
        "build": {
          "noarch": "generic"
        },
        "name": "zsh-syntax-highlighting",
        "requirements": {
          "build": [
            "make"
          ],
          "host": [],
          "run": [
            "__unix",
            "zsh >=4.3.11"
          ]
        },
        "tests": [
          {
            "package_contents": {
              "files": [
                "share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh",
                "share/zsh/plugins/zsh-syntax-highlighting/highlighters/main/main-highlighter.zsh"
              ]
            }
          },
          {
            "script": "zsh -f -c 'source \"${PREFIX}/${{ plugin_dir }}/zsh-syntax-highlighting.zsh\"; (( ${+functions[_zsh_highlight]} ))'\n"
          }
        ],
        "version": "0.8.0"
      }
    ],
    "package": {
      "name": "zsh-syntax-highlighting",
      "version": "0.8.0"
