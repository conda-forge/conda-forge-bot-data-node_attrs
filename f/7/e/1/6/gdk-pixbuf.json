  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: gdk-pixbuf\n  version: 2.44.8\n  maj_min: ${{ (version | split('.'))[:2] | join('.') }}\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: http://ftp.gnome.org/pub/gnome/sources/${{ name }}/${{ maj_min }}/${{ name }}-${{ version }}.tar.xz\n  sha256: 919f529512961a12e81cd4b4b466a48c3933469e7f9a310c6513cd4fb252ba3c\n\nbuild:\n  number: 3\n\nrequirements:\n  build:\n    - pkgconf\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - meson\n    - ninja\n    - gobject-introspection\n    - gettext-tools\n    - if: build_platform != target_platform\n      then:\n        - glib\n        - libjpeg-turbo\n        - libtiff\n        - libpng\n        - zlib\n  host:\n    - glib\n    - if: not linux\n      then:\n        - libintl-devel\n    - libjpeg-turbo\n    - libtiff\n    # This is workaround for \"pkgconf libtiff-4\" failure.\n    # See also: https://github.com/conda-forge/libtiff-feedstock/issues/113\n    - liblzma-devel\n    - libpng\n    - zlib\n  run_exports:\n    # https://abi-laboratory.pro/?view=timeline&l=gdk-pixbuf\n    - ${{ pin_subpackage('gdk-pixbuf', upper_bound='x') }}\n  ignore_run_exports:\n    from_package:\n      # while zlib isn't linked to at build time. it does appear\n      # in the pkgconfig file. Without this build system\n      # tries to include zlib from the build environment\n      # instead of the host environment\n      # https://github.com/conda-forge/gdk-pixbuf-feedstock/pull/40\n      - zlib\n\ntests:\n  - script:\n      - gdk-pixbuf-csource --version\n      - gdk-pixbuf-query-loaders\n      - gdk-pixbuf-pixdata --help\n      # verify that libs can be located through pkg-config\n      - if: unix\n        then:\n          - test -f `pkg-config --variable=libdir --dont-define-prefix gdk-pixbuf-2.0`/libgdk_pixbuf-2.0${SHLIB_EXT}\n          - test -f $PREFIX/lib/girepository-1.0/GdkPixbuf-2.0.typelib\n        else:\n          - for /f \"usebackq tokens=*\" %%a in (`pkg-config --variable=exec_prefix --dont-define-prefix gdk-pixbuf-2.0`) do if not exist \"%%a/bin/gdk_pixbuf-2.0-0.dll\" exit 1\n          - for /f \"usebackq tokens=*\" %%a in (`pkg-config --variable=libdir --dont-define-prefix gdk-pixbuf-2.0`) do if not exist \"%%a/gdk_pixbuf-2.0.lib\" exit 1\n          - if not exist %PREFIX%\\Library\\lib\\girepository-1.0\\GdkPixbuf-2.0.typelib exit 1\n    requirements:\n      run:\n        - pkg-config\n  - package_contents:\n      bin:\n        - gdk-pixbuf-csource\n        - gdk-pixbuf-query-loaders\n        - gdk-pixbuf-pixdata\n      files:\n        exists:\n          # the Windows DLL carries a version suffix (gdk_pixbuf-2.0-0.dll)\n          # which the `lib` matcher doesn't cover, so match it explicitly\n          - if: unix\n            then: lib/libgdk_pixbuf-2.0.*\n            else: Library/bin/gdk_pixbuf-2.0-0.dll\n\nabout:\n  homepage: https://developer.gnome.org/gdk-pixbuf/\n  license: LGPL-2.1-or-later\n  license_file: COPYING\n  summary: GdkPixbuf is a library for image loading and manipulation.\n\nextra:\n  recipe-maintainers:\n    - notestaff\n    - pkgw\n    - tschoonj\n    - xhochy\n    - jschueller\n",
