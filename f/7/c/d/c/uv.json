  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.12.24\"\n\npackage:\n  name: uv\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/astral-sh/uv/releases/download/${{ version }}/source.tar.gz\n  sha256: 094f7b91c4ab1c2553727327e186d62113756dba9dee924c898aec0c8a65164c\n  patches:\n    - 0000-no-link-static-vc-runtime.patch\n    - 0001-no-writeln-space-colon.patch\n    - 0002-zstd-pkg-config.patch\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      # This env var specifies the base 2 log of the allocator page size\n      JEMALLOC_SYS_WITH_LG_PAGE: ${{ \"16\" if target_platform == \"linux-aarch64\" or target_platform == \"linux-ppc64le\" }}\n      # for cross-compiling issues\n      #   fatal error LNK1112: module machine type 'x64' conflicts with target machine type 'ARM64'\n      AWS_LC_SYS_CMAKE_BUILDER: \"1\"\n      # for cross-compiling issues\n      #   error LNK2019: unresolved external symbol ZSTD_compressStream\n      ZSTD_SYS_USE_PKG_CONFIG: \"1\"\n      # for cross-compiling issues\n      #   Can't probe for zstd in pkg-config: pkg-config has not been configured to support cross-compilation.\n      PKG_CONFIG_ALLOW_CROSS: \"1\"\n    content:\n      - if: unix and build_platform != target_platform\n        then:\n          - unset PKG_CONFIG_SYSROOT_DIR\n          - export PKG_CONFIG_LIBDIR=\"${PREFIX}/lib/pkgconfig\"\n          - export PKG_CONFIG_PATH=\"${PREFIX}/lib/pkgconfig\"\n      - if: win\n        then:\n          - set \"PKG_CONFIG_SYSROOT_DIR=%PREFIX%\"\n          - set \"PKG_CONFIG_PATH=%LIBRARY_PREFIX%\\lib\\pkgconfig\"\n      - if: osx\n        then:\n          - export DYLD_LIBRARY_PATH=${PREFIX}/lib:${DYLD_LIBRARY_PATH:-}\n      - cd crates/uv\n      - cargo auditable install --no-track --locked --path=. --profile=release --root=\"${{ '${PREFIX}' if unix else '%LIBRARY_PREFIX%' }}\"\n      - cargo-bundle-licenses --format=yaml --output=THIRDPARTY.yml\n      - if: unix and build_platform == target_platform\n        then:\n          - mkdir -p \"${PREFIX}/share/bash-completion/completions\" \"${PREFIX}/share/fish/vendor_completions.d\" \"${PREFIX}/share/zsh/site-functions\"\n          - |-\n            \"${PREFIX}/bin/uv\" generate-shell-completion bash       > \"${PREFIX}/share/bash-completion/completions/uv\"\n          - |-\n            \"${PREFIX}/bin/uv\" generate-shell-completion fish       > \"${PREFIX}/share/fish/vendor_completions.d/uv.fish\"\n          - |-\n            \"${PREFIX}/bin/uv\" generate-shell-completion zsh        > \"${PREFIX}/share/zsh/site-functions/_uv\"\n      - if: win and build_platform == target_platform\n        then:\n          - md \"%LIBRARY_PREFIX%\\share\\bash-completion\\completions\" \"%LIBRARY_PREFIX%\\share\\fish\\vendor_completions.d\" \"%LIBRARY_PREFIX%\\share\\zsh\\site-functions\"\n          - |-\n            \"%LIBRARY_BIN%\\uv.exe\" generate-shell-completion bash   > \"%LIBRARY_PREFIX%\\share\\bash-completion\\completions\\uv\"\n          - |-\n            \"%LIBRARY_BIN%\\uv.exe\" generate-shell-completion fish   > \"%LIBRARY_PREFIX%\\share\\fish\\vendor_completions.d\\uv.fish\"\n          - |-\n            \"%LIBRARY_BIN%\\uv.exe\" generate-shell-completion zsh    > \"%LIBRARY_PREFIX%\\share\\zsh\\site-functions\\_uv\"\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ compiler(\"cxx\") }}\n    - ${{ compiler(\"rust\") }}\n    - ${{ stdlib(\"c\") }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - cmake\n    - pkg-config\n    # TODO: remove condition after https://github.com/conda-forge/make-feedstock/pull/36\n    - if: target_platform != \"win-arm64\"\n      then:\n        - make\n  host:\n    - zstd\n\ntests:\n  - package_contents:\n      strict: true\n      bin:\n        - uv\n        - uvx\n      files:\n        - if: build_platform == target_platform\n          then:\n            - ${{ \"Library/\" if win }}share/bash-completion/completions/uv\n            - ${{ \"Library/\" if win }}share/fish/vendor_completions.d/uv.fish\n            - ${{ \"Library/\" if win }}share/zsh/site-functions/_uv\n  - script:\n      - uv --help\n      - uv --version\n      - uv --version | ${{ \"grep -iE \" if unix else \"findstr /r /c:\" }}${{ version | replace('.', '\\\\.') }}\n\nabout:\n  homepage: https://github.com/astral-sh/uv\n  license: Apache-2.0 OR MIT\n  license_file:\n    - LICENSE-APACHE\n    - LICENSE-MIT\n    - crates/uv/THIRDPARTY.yml\n  summary: An extremely fast Python package installer and resolver, written in Rust.\n  documentation: https://docs.astral.sh/uv\n\nextra:\n  recipe-maintainers:\n    - charliermarsh\n    - bollwyvl\n",
