  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.0.345\"\n\npackage:\n  name: aws-emulator\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/aws/aws-emulator/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: f79e90cdcb8ecf84e370ce7cdaf2aa0622b57fed6c0c009b6f5ed043f71c901d\n\nbuild:\n  number: 0\n  # Upstream only supports building from source on Linux; the Lambda service uses\n  # Linux-only `RUSAGE_THREAD`.\n  skip: not linux\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      # Stamp the release version, otherwise `--version` reports `0.1.0-dev`.\n      EMULATOR_VERSION: ${{ version }}\n    content:\n      - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path core/router\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n\ntests:\n  - script:\n      - aws-emulator --help\n      - aws-emulator --version | grep \"${{ version }}\"\n  - package_contents:\n      bin:\n        - aws-emulator\n      strict: true\n\nabout:\n  homepage: https://docs.aws.amazon.com/emulator/latest/userguide/what-is-service.html\n  summary: A local emulator of the AWS APIs\n  description: |\n    AWS Emulator is a local emulator of the AWS APIs. Use it to test your\n    software without calling AWS, on your own machine, on a development\n    server, or in continuous integration. It serves an AWS API endpoint that\n    the AWS CLI and AWS SDKs can be pointed at.\n  license: CC0-1.0 AND Apache-2.0\n  license_file:\n    - LICENSE\n    - vendor/LICENSE\n    - vendor/NOTICE\n    - THIRDPARTY.yml\n  documentation: https://docs.aws.amazon.com/emulator/latest/userguide/what-is-service.html\n  repository: https://github.com/aws/aws-emulator\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n    - xhochy\n",
