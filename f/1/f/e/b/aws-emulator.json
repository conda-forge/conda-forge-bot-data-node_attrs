  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.0.492\"\n\npackage:\n  name: aws-emulator\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/aws/aws-emulator/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 47b3d4b552961ce48031702caf5a61dff158813b19a74bb7c5d06c09fd903b93\n\nbuild:\n  number: 0\n  # Upstream only supports building from source on Linux; the Lambda service uses\n  # Linux-only `RUSAGE_THREAD`.\n  skip: not linux\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      # Stamp the release version, otherwise `--version` reports `0.1.0-dev`.\n      EMULATOR_VERSION: ${{ version }}\n    content:\n      - if: build_platform != target_platform\n        then:\n          # cc-rs also applies CFLAGS/CXXFLAGS (the target's flags, e.g.\n          # `-mabi=lp64d`) when compiling C/asm for build scripts on the build\n          # machine. Restrict them to target compiles via TARGET_CFLAGS/CXXFLAGS.\n          - export TARGET_CFLAGS=\"${CFLAGS}\" TARGET_CXXFLAGS=\"${CXXFLAGS}\"\n          - unset CFLAGS CXXFLAGS\n      - if: target_platform == \"linux-aarch64\"\n        then:\n          # The binary's .text exceeds the +-128 MB range of aarch64 branches.\n          # GNU ld fails with `relocation truncated to fit: R_AARCH64_CALL26`\n          # (after hours); lld inserts range-extension thunks.\n          - export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUSTFLAGS=\"-C link-arg=-fuse-ld=lld\"\n      - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path core/router\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    # openh264-sys2 compiles bundled C++ sources\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - if: target_platform == \"linux-aarch64\"\n      then: lld\n\ntests:\n  - script:\n      - aws-emulator --help\n      - aws-emulator --version | grep \"${{ version }}\"\n  - package_contents:\n      bin:\n        - aws-emulator\n      strict: true\n\nabout:\n  homepage: https://docs.aws.amazon.com/emulator/latest/userguide/what-is-service.html\n  summary: A local emulator of the AWS APIs\n  description: |\n    AWS Emulator is a local emulator of the AWS APIs. Use it to test your\n    software without calling AWS, on your own machine, on a development\n    server, or in continuous integration. It serves an AWS API endpoint that\n    the AWS CLI and AWS SDKs can be pointed at.\n  license: CC0-1.0 AND Apache-2.0\n  license_file:\n    - LICENSE\n    - vendor/LICENSE\n    - vendor/NOTICE\n    - THIRDPARTY.yml\n  documentation: https://docs.aws.amazon.com/emulator/latest/userguide/what-is-service.html\n  repository: https://github.com/aws/aws-emulator\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n    - xhochy\n",
