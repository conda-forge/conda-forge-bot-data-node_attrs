    "about": {
      "description": "AWS Emulator is a local emulator of the AWS APIs. Use it to test your\nsoftware without calling AWS, on your own machine, on a development\nserver, or in continuous integration. It serves an AWS API endpoint that\nthe AWS CLI and AWS SDKs can be pointed at.",
      "dev_url": "https://github.com/aws/aws-emulator",
      "doc_url": "https://docs.aws.amazon.com/emulator/latest/userguide/what-is-service.html",
      "home": "https://docs.aws.amazon.com/emulator/latest/userguide/what-is-service.html",
      "license": "CC0-1.0 AND Apache-2.0",
      "license_family": "CC0-1.0 AND Apache-2.0",
      "license_file": "LICENSE",
      "summary": "A local emulator of the AWS APIs"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path core/router",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_STRIP": "symbols",
          "EMULATOR_VERSION": "1.0.345"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw",
        "xhochy"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "aws-emulator",
        "requirements": {
          "build": [
