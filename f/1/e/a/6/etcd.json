  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: etcd\n  version: \"3.7.3\"\n\npackage:\n  name: etcd\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/etcd-io/${{ name }}/archive/v${{ version }}.tar.gz\n  sha256: 38455879fd3744d9aec12f45e890bede61df8b2323279e2c895bbb1bd484681f\n\nbuild:\n  number: 0\n  script:\n    env:\n      GOTOOLCHAIN: local\n      GOFLAGS: -tags=grpcnotrace\n    content:\n      # Materialize example-test symlinks that Windows cannot resolve while Go scans packages.\n      - if: win\n        then:\n          - del client\\v3\\example*_test.go\n          - copy tests\\integration\\clientv3\\examples\\example*_test.go client\\v3\\\n          - del client\\v3\\concurrency\\example*_test.go\n          - copy tests\\integration\\clientv3\\concurrency\\example*_test.go client\\v3\\concurrency\\\n      - cd server\n      - if: win\n        then: go build -v -trimpath -ldflags=\"-s -w\" -o \"%LIBRARY_PREFIX%\\bin\\etcd.exe\" .\n        else: go build -v -trimpath -ldflags=\"-s -w\" -o \"$PREFIX/bin/etcd\" .\n      - go-licenses save . --save_path=../license-files/server\n      - cd ../etcdctl\n      - go install -v -trimpath -ldflags=\"-s -w\" .\n      - go-licenses save . --save_path=../license-files/etcdctl\n      - cd ../etcdutl\n      - go install -v -trimpath -ldflags=\"-s -w\" .\n      - go-licenses save . --save_path=../license-files/etcdutl\n\nrequirements:\n  build:\n    - ${{ compiler('go') }}\n    - go >=1.27.3\n    - go-licenses\n\ntests:\n  - script:\n      - etcd --version\n      - etcdctl version\n      - etcdutl version\n  - requirements:\n      run:\n        - python\n    files:\n      recipe:\n        - run_test.py\n    script: python run_test.py\n\nabout:\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - license-files/\n  summary: A distributed, reliable key-value store for the most critical data of a distributed system.\n  homepage: https://etcd.io\n  repository: https://github.com/etcd-io/etcd\n  documentation: https://etcd.io/docs\n\nextra:\n  recipe-maintainers:\n    - sodre\n    - wolfv\n",
