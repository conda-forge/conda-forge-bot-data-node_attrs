      "dev_url": "https://github.com/BioKT/MasterMSM",
      "doc_url": "https://mastermsm.readthedocs.io/",
      "home": "https://github.com/BioKT/MasterMSM",
      "license": "GPL-2.0-or-later",
      "license_family": "GPL-2.0-or-later",
      "license_file": "LICENSE",
      "summary": "Algorithms to construct master equation / Markov state models"
    },
    "build": {
      "noarch": "python",
      "number": "0",
