  "raw_meta_yaml": "context:\n  version: \"0.24.2\"\n\npackage:\n  name: iwe\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/iwe-org/iwe/archive/refs/tags/iwe-v${{ version }}.tar.gz\n  sha256: ea8fd57950a99a535306528cbbca1ba04e7f74090dba823518f818a7078d9e5c\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build main app and generate license data\n      - cargo auditable install --path=crates/iwe  --root=($prefix) --no-track --locked --bins\n      - cargo auditable install --path=crates/iwec --root=($prefix) --no-track --locked --bins\n      - cargo auditable install --path=crates/iwes --root=($prefix) --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=THIRDPARTY.yml\n      # generate shell completions\n      - if: build_platform == host_platform\n        then:\n          - mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions\n          - let bin = ($prefix)/bin/iwe\n          - ^$bin completions bash | save ($prefix)/share/bash-completion/completions/iwe\n          - ^$bin completions fish | save ($prefix)/share/fish/vendor_completions.d/iwe.fish\n          - ^$bin completions zsh  | save ($prefix)/share/zsh/site-functions/_iwe\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - nushell\n\ntests:\n  - script:\n      - iwe --help\n      - iwe --version\n  - package_contents:\n      bin:\n        - iwe\n        - iwec\n        - iwes\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/bash-completion/completions/iwe\n            - share/fish/vendor_completions.d/iwe.fish\n            - share/zsh/site-functions/_iwe\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/bash-completion/completions/iwe\n            - Library/share/fish/vendor_completions.d/iwe.fish\n            - Library/share/zsh/site-functions/_iwe\n      strict: true\n\nabout:\n  summary: IWE – Markdown memory system for you and your AI Agents\n  description: |\n    IWE is a knowledge graph system that serves as a \"second brain\" for humans\n    and AI agents. It organizes notes hierarchically and makes them accessible\n    through CLI tools and LSP for editor integration (VS Code, Neovim, Zed,\n    Helix etc.).\n  license: Apache-2.0\n  license_file:\n    - LICENSE-APACHE\n    - THIRDPARTY.yml\n  homepage: https://iwe.org\n  documentation: https://iwe.md/docs/\n  repository: https://github.com/iwe-org/iwe\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
