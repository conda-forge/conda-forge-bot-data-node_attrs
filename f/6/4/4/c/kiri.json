      "dev_url": "https://github.com/libracoder/kiri",
      "home": "https://github.com/libracoder/kiri",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "A small, fast container runtime for macOS, Windows and Linux with free Ngrok alternative."
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml",
          "cargo auditable install -j ${CPU_COUNT} --root \"${PREFIX}\" --locked --no-track --path crates/kiri",
          "cargo auditable install -j ${CPU_COUNT} --root \"${PREFIX}\" --locked --no-track --path crates/kiri-init"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "XhstormR"
      ]
    },
