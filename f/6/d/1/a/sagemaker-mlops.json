  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.24.0\"\n\npackage:\n  name: sagemaker-mlops\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/s/sagemaker-mlops/sagemaker_mlops-${{ version }}.tar.gz\n  sha256: 1641c216e65f48519d880ae6cc632d76fb279c502210dcd26b0e1195236a9cac\n\nbuild:\n  number: 0\n  noarch: python\n  script: |\n    ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n    rm -f $SP_DIR/sagemaker/__init__.py\n    rm -rf $SP_DIR/sagemaker/__pycache__\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools >=64\n    - wheel\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - sagemaker-core >=2.24.0\n    - sagemaker-train >=1.24.0\n    - sagemaker-serve >=1.24.0\n    - boto3 >=1.42.2,<2.0\n    - botocore >=1.42.2,<2.0\n    - pyiceberg >=0.8.0\n    - pyarrow >=14.0.0\n    - s3fs\n  # protobuf arrives transitively via sagemaker-train/sagemaker-serve -> mlflow ->\n  # databricks-sdk, which forbids protobuf 5.26-5.28.* and 5.29.0-4. Without this the\n  # solver backtracks to protobuf 5.28.3 and `pip check` fails. Soft-constrain protobuf\n  # to the databricks-sdk-compatible window.\n  run_constraints:\n    - protobuf >=5.29.5,<7\n\ntests:\n  - script:\n      # sagemaker.mlops's import chain reaches AIRHub (via sagemaker-train), which\n      # builds boto3 clients at class-definition (import) time, so a region must be\n      # set or the import raises NoRegionError. Upstream fix tracked in\n      # aws/sagemaker-python-sdk PR #6401; remove this once a release includes it.\n      env:\n        AWS_DEFAULT_REGION: us-east-1\n      content:\n        - python -c \"import sagemaker.mlops\"\n        - pip check\n    requirements:\n      run:\n        - pip\nabout:\n  summary: SageMaker MLOps package for workflow orchestration and model building\n  homepage: https://github.com/aws/sagemaker-python-sdk\n  license: Apache-2.0\n  license_file: LICENSE\n  documentation: https://sagemaker.readthedocs.io/en/stable/\n  repository: https://github.com/aws/sagemaker-python-sdk\n\nextra:\n  recipe-maintainers:\n    - mollyheamazon\n    - mufaddal-rohawala\n    - nargokul\n    - aviruthen\n",
