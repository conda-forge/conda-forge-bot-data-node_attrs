  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: oss-harmony\n  version: \"0.0.12\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/oss_harmony-${{ version }}.tar.gz\n  sha256: 6a2dd2db3ecd5ac771768c0a3091a2e1ee1354cbfcd61efa1283c26f300f0fcd\n\nbuild:\n  number: 0\n  python:\n    version_independent: ${{ is_abi3 }}\n  script:\n    env:\n      # https://github.com/rust-lang/cargo/issues/10583#issuecomment-1129997984\n      CARGO_NET_GIT_FETCH_WITH_CLI: true\n      # Optimize the Cargo build\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - if: win\n        then:\n          - copy \"%RECIPE_DIR%\\cargo-auditable-wrapper.bat\" \"%BUILD_PREFIX%\\Library\\bin\\cargo-auditable-wrapper.bat\"\n          - set CARGO=cargo-auditable-wrapper.bat\n        else:\n          - cp \"${RECIPE_DIR}/cargo-auditable-wrapper.sh\" \"${BUILD_PREFIX}/bin/cargo-auditable-wrapper\"\n          - chmod 755 \"${BUILD_PREFIX}/bin/cargo-auditable-wrapper\"\n          - export CARGO=cargo-auditable-wrapper\n       # Install the Python package using maturin\n      - python -m pip install . -vv --no-deps --no-build-isolation\n       # Generate the THIRDPARTY.yml file\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n  skip: is_abi3 and not is_python_min\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin >=1.7,<2.0\n  host:\n    - python\n    - if: is_abi3\n      then: python-abi3\n    - maturin >=1.8,<2.0\n    - pip\n  run:\n    - python\n    - pydantic >=2.11.7\n  run_constraints:\n    - openai-harmony <0a0\n\ntests:\n  - python:\n      imports:\n        - openai_harmony\n      pip_check: true\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min ~ '.*' }}\n        - '*'\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/openai_harmony/openai_harmony.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%\\openai_harmony\\openai_harmony.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  homepage: https://pypi.org/project/oss-harmony/\n  repository: https://github.com/oss-harmony/harmony\n  summary: Response format library for the gpt-oss open-weight model series (fork of openai-harmony)\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - xhochy\n",
