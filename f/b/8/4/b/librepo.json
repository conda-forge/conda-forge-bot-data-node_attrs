  "raw_meta_yaml": "context:\n  version: \"1.12.1\"\n\nrecipe:\n  name: librepo-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/rpm-software-management/librepo/archive/${{ version }}.tar.gz\n  sha256: b78113f3aeb0d562b034dbeb926609019b7bed27e05c9ab5a584a9938de8da9f\n  patches:\n    - patches/0001-use-sysconfig-instead-of-distutils.patch\n    - patches/0002-find-gpgme-via-pkg-config.patch\n    - patches/0003-drop-ntlm-test-assertion.patch\n\nbuild:\n  number: 8\n  skip: not linux\n\noutputs:\n  - staging:\n      name: librepo-build\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - cmake <4\n        - make\n        - pkgconf\n      host:\n        - libcurl\n        - gpgme\n        - attr\n        - openssl\n        - expat\n        - glib\n        - check\n        - zchunk\n        - libxml2-devel\n        - zlib\n        - zstd\n        - python\n        # gpg binary needed by the C test suite (gpgme shells out to it)\n        - gnupg\n    build:\n      script: build.sh\n\n  - package:\n      name: librepo\n    inherit: librepo-build\n    build:\n      files:\n        - lib/librepo*\n        - lib/pkgconfig/librepo*\n        - include/librepo/\n    requirements:\n      run_exports:\n        - ${{ pin_subpackage('librepo', upper_bound='x.x') }}\n      ignore_run_exports:\n        by_name:\n          - python_abi\n          - gnupg\n          - libattr\n          - libexpat\n          - libzlib\n          - zstd\n    tests:\n      - package_contents:\n          include:\n            - librepo/librepo.h\n            - librepo/checksum.h\n          lib:\n            - librepo\n          files:\n            - lib/pkgconfig/librepo.pc\n\n  - package:\n      name: py-librepo\n    inherit: librepo-build\n    build:\n      files:\n        - lib/python*/site-packages/librepo/\n    requirements:\n      host:\n        - ${{ pin_subpackage('librepo', exact=True) }}\n        - python\n      run:\n        - ${{ pin_subpackage('librepo', exact=True) }}\n        - python\n      ignore_run_exports:\n        by_name:\n          - gnupg\n          - libattr\n          - libexpat\n          - libzlib\n          - zstd\n    tests:\n      - python:\n          imports:\n            - librepo\n          pip_check: false\n\nabout:\n  homepage: https://github.com/rpm-software-management/librepo\n  license: LGPL-2.1-or-later\n  license_file: COPYING\n  summary: A library providing C and Python (libcURL like) API for downloading repository metadata and packages\n  documentation: https://rpm-software-management.github.io/librepo\n\nextra:\n  feedstock-name: librepo\n  recipe-maintainers:\n    - wolfv\n    - JohanMabille\n    - SylvainCorlay\n    - h-vetinari\n",
