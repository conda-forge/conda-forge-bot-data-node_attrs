  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  build_number: 0\n  version: 1.33.0\n\npackage:\n  name: python-cudnn-frontend\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/NVIDIA/cudnn-frontend/archive/v${{ version }}.tar.gz\n  sha256: 135a2c56c91dc6b1eca6a75369a0c8c8a3747da95c099be31b4f2a9788f91ce6\n\nbuild:\n  number: ${{ build_number }}\n  string: cuda${{ cuda_compiler_version | replace('.', '') }}_py${{ python | version_to_buildstring }}_h${{ hash }}_${{ build_number }}\n  skip: (is_abi3 and not is_python_min) or cuda_compiler_version in (undefined, \"None\") or (not linux)\n  script:\n    env:\n      CUDNN_FRONTEND_LOG_INFO: '1'\n      CUDNN_FRONTEND_PYTHON_STABLE_ABI: 'ON'\n    content:\n      - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    version_independent: ${{ is_abi3 }}\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('cuda') }}\n    - ${{ stdlib(\"c\") }}\n    - cmake >=3.26\n    - cuda-nvrtc-dev\n    - make\n    - ninja >=1.11.1.1\n  host:\n    - cudnn\n    - nanobind >=3.0.1,<4\n    - pip\n    - python ${{ python_min }}.*\n    - if: is_abi3\n      then: python-abi3 ${{ python_min }}.*\n    - setuptools >=64\n  run:\n    - apache-tvm-ffi >=0.1.11\n    - python >=${{ python_min }}\n    - nvidia-cutlass-dsl >=4.8.0\ntests:\n  - python:\n      imports:\n        - cudnn\n        - cudnn.block_sparse_attention\n        - cudnn.experimental.ops\n        - cudnn.gemm\n        # - cudnn.gnn\n        # - cudnn.gnn.agg_simple\n        - cudnn.hstu\n        # - cudnn.hstu_attention\n        # - cudnn.jax\n        - cudnn.linear_attention\n        # - cudnn.fla\n        # - cudnn.native_sparse_attention\n        # - cudnn.native_sparse_attention.compression\n        # - cudnn.native_sparse_attention.selection\n        # - cudnn.native_sparse_attention.sliding_window_attention\n        # - cudnn.native_sparse_attention.top_k\n        - cudnn.ops\n        # - cudnn.ops.causal_conv1d\n        # - cudnn.ops.fft_causal_conv1d\n        - cudnn.sdpa\n      pip_check: true\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - if: is_abi3\n          then: abi3audit\n    script:\n      - python -c \"import cudnn; assert cudnn.backend_version() >= 92600, cudnn.backend_version()\"\n      - if: is_abi3\n        then: abi3audit $SP_DIR/cudnn/_compiled_module.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n  - package_contents:\n      strict: false\n      site_packages:\n        - include/cudnn_frontend.h\n        - include/cudnn_frontend_version.h\n\n\nabout:\n  summary: cuDNN FrontEnd API\n  license: MIT\n  license_file:\n    - LICENSE.txt\n    - include/cudnn_frontend/thirdparty/nlohmann/LICENSE.MIT\n  homepage: https://github.com/NVIDIA/cudnn-frontend\n\nextra:\n  recipe-maintainers:\n    - jameslamb\n    - weiji14\n",
