  "raw_meta_yaml": "# Note: make sure that the value of c_stdlib_version (MACOSX_DEPLOYMENT_TARGET)\n# in `conda_build_config.yaml` stays synchronized with `macos-platform.patch`\n# and/or what upstream expects in the scikit-build config in its\n# `pyproject.toml` file.\n#\n# Also note: due to the way the software is packaged, these Python bindings\n# cannot reuse the shared library provided by the `openexr` package, as far as I\n# can tell. So this package is actually independent of that one, but builds a\n# lot of the same C++ code.\n\nschema_version: 1\n\ncontext:\n  name: OpenEXR\n  version: \"3.5.0\"\n\npackage:\n  name: openexr-python  # distinguish from the `openexr` C++ library package\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/${{ name[0] }}/${{ name }}/${{ name|lower }}-${{ version }}.tar.gz\n  sha256: 1c49909e48e57a313de5c23477e3ebda09a14c97bbdf93a2393da2a1aef1eb41\n  patches:\n    - if: osx\n      then: macos-platform.patch\n\nbuild:\n  number: 0\n\nrequirements:\n  build:\n    - ${{ compiler(\"cxx\") }}\n    - ${{ stdlib(\"c\") }}\n    - cmake\n    - make\n    - pkg-config\n  host:\n    - imath\n    - libdeflate\n    - openjph >=0.32.0\n    - pip\n    - pybind11\n    - python\n    - scikit-build-core <1.0  # upstream not compatible as of 3.4.13 (2026 Aug); can probably relax this soon\n    - zlib\n    - zstd\n  run:\n    - numpy\n    - python\n\ntests:\n  - python:\n      imports:\n        - Imath\n        - OpenEXR\n      pip_check: true\n\nabout:\n  summary: Python bindings for ILM's OpenEXR image file format\n  license: BSD-3-Clause\n  license_file: LICENSE\n  homepage: http://www.excamera.com/sphinx/articles-openexr.html\n\nextra:\n  recipe-maintainers:\n    - pkgw\n",
