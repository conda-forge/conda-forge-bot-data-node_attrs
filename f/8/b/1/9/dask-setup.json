  "raw_meta_yaml": "context:\n  name: dask-setup\n  version: \"2.2.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/dask_setup/dask_setup-${{ version }}.tar.gz\n  sha256: 7c64b5e89fc3153a47cd2424899d968ab6385e2132a817f18e9785e505b18fbb\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - dask-setup = dask_setup.cli:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools >=77\n  run:\n    - python >=${{ python_min }}\n    - dask-core >=2024.1.0\n    - distributed >=2024.1.0\n    - psutil >=5.9\n    - pyyaml >=6.0\n  run_constraints:\n    # Optional: only needed for setup_pbs_cluster()/setup_slurm_cluster().\n    - dask-jobqueue >=0.8\n\ntests:\n  - python:\n      imports:\n        - dask_setup\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      - dask-setup --help\n      # Loads the builtin profiles, so it fails if package data went missing.\n      - dask-setup list\n\nabout:\n  homepage: https://github.com/21centuryweather/dask_setup\n  repository: https://github.com/21centuryweather/dask_setup\n  summary: HPC-aware Dask setup for PBS (NCI Gadi) and SLURM clusters.\n  description: |\n    Wraps dask.distributed with HPC-aware defaults: resource detection from\n    PBS/SLURM environment variables, spill routing to node-local storage,\n    workload-shaped worker topology, profile-based configuration, and\n    multi-node clusters via dask-jobqueue.\n  license: Apache-2.0\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - greensh16\n",
