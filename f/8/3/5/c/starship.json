  "raw_meta_yaml": "context:\n  version: \"1.27.0\"\n\npackage:\n  name: starship\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/starship/starship/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: f1887ffa88a7ba437d2932501794047e28d03387996f7d1c364631c053cffc44\n\nbuild:\n  number: 0\n  script:\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n    - if: ppc64le\n      then:\n        - export CFLAGS_powerpc64le_unknown_linux_gnu=\"${CFLAGS}\"\n        - unset CFLAGS\n    - if: unix\n      then:\n        - cargo build --release --locked --target $CARGO_BUILD_TARGET\n        - mkdir -p $PREFIX/bin\n        - mv target/*/release/starship $PREFIX/bin/starship\n      else:\n        - cargo build --release --locked --target %CARGO_BUILD_TARGET%\n        - MKDIR %PREFIX%\\bin\n        - MOVE target\\%CARGO_BUILD_TARGET%\\release\\starship.exe %PREFIX%\\bin\\starship.exe\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }}\n    - ${{ stdlib('c') }}\n    - cargo-bundle-licenses\n    - if: not win\n      then:\n        - make\n        - cmake\n  run:\n  ignore_run_exports:\n    from_package:\n      # we want to ignore libstdcxx, but not libgcc; the latter also comes in through\n      # compiler('c'), and conda keeps that despite ignoring the cxx run-exports\n      - ${{ compiler('cxx') }}\n\ntests:\n  - script:\n      - starship -h\n\nabout:\n  homepage: https://starship.rs/\n  summary: 'The minimal, blazing-fast, and infinitely customizable prompt for any shell!'\n  license: ISC\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  repository: https://github.com/starship/starship\n\nextra:\n  recipe-maintainers:\n    - m-rossi\n",
