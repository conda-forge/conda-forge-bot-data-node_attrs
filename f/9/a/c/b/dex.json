  "raw_meta_yaml": "context:\n  version: \"2.46.0\"\n\npackage:\n  name: dex\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/dexidp/dex/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 3c09c0f2be88719d5bc2a061d3df9310052c8220b651a3b72d774eecd9b50b65\n  target_directory: src\n\nbuild:\n  number: 0\n  script:\n    - cd src/cmd/dex\n    - go-licenses save . --save_path ../../../library_licenses --ignore github.com/dexidp/dex\n    - if: unix\n      then:\n        - go build -v -o $PREFIX/bin/dex -ldflags=\"-s -w -X main.version=${{ version }}\" .\n        - mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d\n        - $PREFIX/bin/dex completion zsh > $PREFIX/share/zsh/site-functions/_dex\n        - $PREFIX/bin/dex completion bash > $PREFIX/share/bash-completion/completions/dex\n        - $PREFIX/bin/dex completion fish > $PREFIX/share/fish/vendor_completions.d/dex.fish\n      else: go build -v -o %LIBRARY_BIN%\\dex.exe -ldflags=\"-s -X main.version=${{ version }}\" .\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n\ntests:\n  - script: dex -h\n  - package_contents:\n      bin:\n        - dex\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/dex\n            - share/fish/vendor_completions.d/dex.fish\n            - share/zsh/site-functions/_dex\n      strict: true\n\nabout:\n  homepage: https://github.com/dexidp/dex\n  summary: OpenID Connect (OIDC) identity and OAuth 2.0 provider with pluggable connectors\n  description: |\n    Dex is an identity service that uses OpenID Connect to drive authentication for other apps.\n  license: Apache-2.0\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n  documentation: https://dexidp.io\n  repository: https://github.com/dexidp/dex\n\nextra:\n  recipe-maintainers:\n    - xhochy\n",
