  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: flatsurf\n  version: \"3.15.2\"\n\nrecipe:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/flatsurf/${{ name }}/releases/download/${{ version }}/${{ name }}-${{ version }}.tar.gz\n  sha256: 3974c53de4dc5e4739659ae7e4c32a313d20ace7bd7b617e2a24575f50b62b29\n  patches:\n    - 0001-Make-compatible-with-fmt-11.patch\n    - 0001-Fixed-compatibility-with-fmt-12.patch\n\nbuild:\n  number: 7\n  # dependency libeantic is not available for Windows on conda-forge yet\n  skip: win\n\noutputs:\n  - package:\n      name: libflatsurf\n    build:\n      script:\n        file: build-libflatsurf.sh\n    requirements:\n      build:\n        - libtool\n        - automake\n        - make\n        - gnuconfig\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib(\"c\") }}\n      host:\n        # We only need the libboost-headers at compile time. However, since we\n        # use bits of boost in our API, code built against libflatsurf must be\n        # built with a compatible version of the headers. Therefore, we add a\n        # liboost pin to our run exports so libboost-headers are going to be\n        # in a compatible version.\n        - libboost-devel\n        - fmt\n        - gmp\n        - libflint\n        - libintervalxt\n        - libexactreal\n        - libeantic\n        - gmpxxll\n      run_exports:\n        - ${{ pin_subpackage(\"libflatsurf\") }}\n    tests:\n      - script:\n          - test -f $PREFIX/include/flatsurf/flatsurf.hpp\n          - test -f $PREFIX/lib/libflatsurf${SHLIB_EXT}\n  - package:\n      name: pyflatsurf\n    build:\n      script:\n        file: build-pyflatsurf.sh\n    requirements:\n      build:\n        - if: build_platform != target_platform\n          then:\n            - python\n            - cross-python_${{ target_platform }}\n        - libtool\n        - automake\n        - make\n        - gnuconfig\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib(\"c\") }}\n      host:\n        # Note that the libboost-devel from libflatsurf forces these headers to be\n        # compatible with ones used when building libflatsurf.\n        - libboost-headers\n        - python\n        - cppyy\n        - cppyythonizations\n        - setuptools\n        - pytest\n        - pyexactreal\n        - pyintervalxt\n        - ${{ pin_subpackage(\"libflatsurf\") }}\n      run:\n        # cppyy dynamically compiles C++ wrappers at runtime, therefore we need C++ headers of boost.\n        # Note that the libboost-devel from libflatsurf forces these headers to be\n        # compatible with ones used when building libflatsurf.\n        - libboost-headers\n        - python\n        - cppyy\n        - cppyythonizations\n        - gmpxxyy\n        - pyexactreal\n        - pyintervalxt\n        # A subpackage does not see the run_exports of another subpackage:\n        # https://github.com/conda/conda-build/issues/3478\n        - ${{ pin_subpackage(\"libflatsurf\") }}\n    tests:\n      - python:\n          imports:\n            - if: build_platform == target_platform\n              then: pyflatsurf\n          pip_check: false\n\nabout:\n  license: GPL-3.0-or-later\n  license_file: COPYING\n  summary: Algorithms on Flat Triangulations\n  homepage: https://github.com/flatsurf/flatsurf\n  repository: https://github.com/flatsurf/flatsurf\n\nextra:\n  recipe-maintainers:\n    - saraedum\n",
