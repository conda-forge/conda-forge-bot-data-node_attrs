  "linux_64_meta_yaml": {
    "about": {
      "description": "ismip7-interpolation regrids ISMIP7 ice sheet model output, for Greenland\n(GrIS) and Antarctica (AIS), onto the standard ISMIP7 grids so that models\non different native grids can be compared.  CDO does the remapping; this\npackage decides what to remap, how, and where to put it.  It works on an\narchive laid out as an ISMIP7 submission, and can process a single file,\nan experiment or a whole archive, as well as take an inventory of what an\narchive holds.",
      "dev_url": "https://github.com/ismip/ismip7-interpolation",
      "doc_url": "https://ismip.github.io/ismip7-interpolation/",
      "home": "https://github.com/ismip/ismip7-interpolation",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Regrid ISMIP7 ice sheet model output onto the standard ISMIP7 grids"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "ismip7-interpolate = ismip7_interp.interpolate:main",
          "ismip7-process-experiment = ismip7_interp.experiment:main",
          "ismip7-run-all = ismip7_interp.run_all:main",
          "ismip7-inventory = ismip7_interp.inventory:main"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "xylar"
      ]
    },
    "outputs": [
      {
        "build": {
          "noarch": "python",
          "python": {
            "entry_points": [
              "ismip7-interpolate = ismip7_interp.interpolate:main",
