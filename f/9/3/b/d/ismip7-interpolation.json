              "ismip7-run-all = ismip7_interp.run_all:main",
              "ismip7-inventory = ismip7_interp.inventory:main"
            ]
          }
        },
        "name": "ismip7-interpolation",
        "requirements": {
          "build": [],
          "host": [
            "python 3.11.*",
            "pip",
            "setuptools >=77"
          ],
          "run": [
            "python >=3.11,<3.15",
            "__unix",
            "netcdf4 >=1.7,<2",
            "isschecker >=0.2,<1",
            "cdo >=2.2"
          ]
        },
        "tests": [
