  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: ismip7-interpolation\n  version: \"0.2.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ismip/ismip7-interpolation/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 7cb83cbc510e62f3f6a96422b8e7218db472ecd1b29ecccd079301b345cd6cfe\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - ismip7-interpolate = ismip7_interp.interpolate:main\n      - ismip7-process-experiment = ismip7_interp.experiment:main\n      - ismip7-run-all = ismip7_interp.run_all:main\n      - ismip7-inventory = ismip7_interp.inventory:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools >=77\n  run:\n    - python >=${{ python_min }},<3.15\n    # Indicate that we don't support Windows\n    - __unix\n    - netcdf4 >=1.7,<2\n    - isschecker >=0.2,<1\n    # CDO does all of the remapping; it is called as an executable\n    - cdo >=2.2\n\ntests:\n  - python:\n      imports:\n        - ismip7_interp\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      - ismip7-interpolate --help\n      - ismip7-process-experiment --help\n      - ismip7-run-all --help\n      - ismip7-inventory --help\n  - files:\n      source:\n        - tests/\n    requirements:\n      run:\n        - python ${{ python_min }}.*\n        - pytest >=8\n    script:\n      - pytest tests\n\nabout:\n  license: MIT\n  license_file: LICENSE\n  summary: Regrid ISMIP7 ice sheet model output onto the standard ISMIP7 grids\n  description: |\n    ismip7-interpolation regrids ISMIP7 ice sheet model output, for Greenland\n    (GrIS) and Antarctica (AIS), onto the standard ISMIP7 grids so that models\n    on different native grids can be compared.  CDO does the remapping; this\n    package decides what to remap, how, and where to put it.  It works on an\n    archive laid out as an ISMIP7 submission, and can process a single file,\n    an experiment or a whole archive, as well as take an inventory of what an\n    archive holds.\n  homepage: https://github.com/ismip/ismip7-interpolation\n  repository: https://github.com/ismip/ismip7-interpolation\n  documentation: https://ismip.github.io/ismip7-interpolation/\n\nextra:\n  recipe-maintainers:\n    - xylar\n",
