  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.7.4\"\n  # Upstream alex-pinkus/tree-sitter-swift ships TWO parallel tag schemes:\n  # `vX.Y.Z` (clean source, no src/parser.c — would require tree-sitter CLI\n  # + nodejs to run `tree-sitter generate`) and `X.Y.Z-with-generated-files`\n  # (same tree with the generated parser.c committed). We use the latter to\n  # avoid a node toolchain in build deps. The tag template tracks `version`\n  # so autotick bumps work without recipe-level edits.\n  tag: ${{ version }}-with-generated-files\n\npackage:\n  name: tree-sitter-swift\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/alex-pinkus/tree-sitter-swift/archive/refs/tags/${{ tag }}.tar.gz\n  sha256: bf4d34383638f41cde398f4678dea72cdcda8442c7cfd13944f4bb63e9a96f70\n\nbuild:\n  number: 0\n  # abi3 packages build once at python_min and ship one artifact per platform.\n  skip: is_abi3 and not is_python_min\n  # Upstream's pyproject.toml carries a placeholder `version = \"0.0.1\"` that\n  # has never been bumped despite tagged releases. Without this rewrite the\n  # produced wheel ships `tree_sitter_swift-0.0.1.dist-info`, which breaks\n  # `pip check` for any downstream with an upper-bounded constraint like\n  # `tree-sitter-swift<0.9,>=0.7` (e.g. graphifyy 0.8.40). The Python helper\n  # (recipe/fix_pyproject_version.py) reads $PKG_VERSION and rewrites the\n  # first `version = \"...\"` line in pyproject.toml — works cross-platform\n  # without sed/powershell quoting hell, and is idempotent (no-op once\n  # upstream resumes proper version bumping).\n  script:\n    - if: unix\n      then: |\n        ${{ PYTHON }} ${RECIPE_DIR}/fix_pyproject_version.py\n        ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n    - if: win\n      then: |\n        \"%PYTHON%\" \"%RECIPE_DIR%\\fix_pyproject_version.py\"\n        if errorlevel 1 exit 1\n        \"%PYTHON%\" -m pip install . -vv --no-deps --no-build-isolation\n        if errorlevel 1 exit 1\n  python:\n    version_independent: ${{ is_abi3 }}\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n  host:\n    - if: is_abi3\n      then: python-abi3\n    - python\n    - pip\n    - setuptools >=42\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - tree_sitter_swift\n      # Verify the abi3 wheel works on the build-time Python AND the latest.\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/tree_sitter_swift/_binding.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%/tree_sitter_swift/_binding.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  homepage: https://github.com/alex-pinkus/tree-sitter-swift\n  summary: Swift grammar for tree-sitter\n  license: MIT\n  license_file: LICENSE\n  repository: https://github.com/alex-pinkus/tree-sitter-swift\n\nextra:\n  recipe-maintainers:\n    - killua156\n    - mgorny\n    - rxm7706\n",
