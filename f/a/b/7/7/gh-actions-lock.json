      "summary": "gh CLI extension that generates and verifies the GitHub Actions dependency lockfile"
    },
    "build": {
      "number": "0",
      "script": [
        "cd src",
        "go-licenses save ./cmd/gh-actions-lock --save_path ../library_licenses --ignore github.com/inconshreveable/mousetrap",
        "go build -v -o $PREFIX/bin/gh-actions-lock -ldflags=\"-s -w -X main.version=v${{ version }}\" ./cmd/gh-actions-lock"
      ]
    },
    "extra": {
      "recipe-maintainers": [
