  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: libmaxminddb\n  version: \"1.14.0\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/maxmind/libmaxminddb/releases/download/${{ version }}/libmaxminddb-${{ version }}.tar.gz\n  sha256: 65ff92382c71ef6634b8c13e278651a2efa68f1de28ef3c31fc32369fa0bb3e3\n  patches:\n    - if: win\n      then: static-test-helper.patch\n\nbuild:\n  number: 1\n  dynamic_linking:\n    overlinking_behavior: error\n  script:\n    - if: win\n      then:\n        - cmake -S . -B build -G Ninja %CMAKE_ARGS% -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=ON -DCMAKE_INSTALL_PREFIX=\"%LIBRARY_PREFIX%\" -DCMAKE_RUNTIME_OUTPUT_DIRECTORY=\"%SRC_DIR%/build/bin\"\n        - cmake --build build\n        - if: build_platform == target_platform\n          then: ctest --test-dir build --output-on-failure\n        - cmake --install build\n      else:\n        - ./configure --disable-debug --disable-dependency-tracking --disable-silent-rules --prefix=\"$PREFIX\" --build=\"$BUILD\" --host=\"$HOST\"\n        - make\n        - if: build_platform == target_platform\n          then: make check\n        - make install\n\nrequirements:\n  build:\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler('c') }}\n    - if: win\n      then:\n        - cmake\n        - ninja\n      else:\n        - make\n        - pkg-config\n  run_exports:\n    - ${{ pin_subpackage('libmaxminddb') }}\n\ntests:\n  - script:\n      - if: win\n        # Upstream does not build mmdblookup with MSVC (getopt is unavailable).\n        then:\n          - if not exist %LIBRARY_BIN%\\maxminddb.dll exit 1\n          - if not exist %LIBRARY_LIB%\\maxminddb.lib exit 1\n          - if not exist %LIBRARY_INC%\\maxminddb.h exit 1\n          - if not exist %LIBRARY_INC%\\maxminddb_config.h exit 1\n        else: mmdblookup -f t/maxmind-db/test-data/GeoIP2-City-Test.mmdb -i 175.16.199.0\n    files:\n      source:\n        - t/maxmind-db/test-data/GeoIP2-City-Test.mmdb\n\nabout:\n  homepage: https://maxmind.github.io/libmaxminddb/\n  license: Apache-2.0\n  license_file: LICENSE\n  summary: \"C library for the MaxMind DB file format\"\n  description: |\n    The libmaxminddb library provides a C library for reading MaxMind DB files, including\n    the GeoIP2 databases from MaxMind. This is a custom binary format designed to facilitate\n    fast lookups of IP addresses while allowing for great flexibility in the type of\n    data associated with an address.\n  repository: https://github.com/maxmind/libmaxminddb\n\nextra:\n  recipe-maintainers:\n    - dbast\n",
