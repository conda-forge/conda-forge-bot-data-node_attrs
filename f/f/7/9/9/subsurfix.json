  "raw_meta_yaml": "context:\n  name: subsurfix\n  version: \"0.2.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name }}-${{ version }}.tar.gz\n  sha256: 889fcdd6eb9784737d42ded22231d22d6a5a962e6fbda2b847bc95b3f625b38a\n\nbuild:\n  number: 0\n  skip:\n    - win\n    - match(python, \"<3.12\")\n  script:\n    content:\n      - export LIBCLANG_PATH=\"$BUILD_PREFIX/lib\"\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n      - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin >=1.14,<1.15\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cmake\n    # bindgen in lightgbm3-sys needs libclang\n    - libclang\n    - clang\n    - make\n  host:\n    - python\n    - pip\n    - maturin >=1.14,<1.15\n    - if: osx\n      then:\n        - llvm-openmp\n    - if: linux\n      then:\n        - _openmp_mutex\n  run:\n    - python\n    - numpy >=1.26.4\n    - pyarrow >=25.0.0\n    - pyproj >=3.8.0\n    - shapely >=2.1.2\n    - pyshp >=3.1.6\n    - openpyxl >=3.1.5\n    - python-calamine >=0.4.0\n    - flopy >=3.9.1\n    - pyvista >=0.44\n    - imageio >=2.31\n    - omf >=1.0.1,<2\n    - if: osx\n      then:\n        - llvm-openmp\n\ntests:\n  - python:\n      imports:\n        - subsurfix\n        - subsurfix._native\n      # omf's deps (properties, vectormath) ship conda metadata that pip check\n      # flags as \"not supported on this platform\"; unrelated to this package\n      pip_check: false\n  - requirements:\n      run:\n        - pip\n    script:\n      - python -c \"import subsurfix, subsurfix._native; print(subsurfix.__version__)\"\n      - pip show subsurfix\n\nabout:\n  summary: A tool for automation in subsurface geological/petrophysical analysis and geomodeling workflows\n  license: AGPL-3.0-or-later\n  license_file:\n    - LICENSE\n    - NOTICE\n    - THIRDPARTY.yml\n  homepage: https://geolarrylai.com/projects/SubsurfiX/\n  repository: https://github.com/GeoLarryLai/SubsurfiX\n\nextra:\n  recipe-maintainers:\n    - GeoLarryLai\n",
