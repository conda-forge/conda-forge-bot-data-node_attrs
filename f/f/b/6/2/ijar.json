  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"9.3.3\"\n  base_url: https://github.com/bazelbuild/bazel/releases/download\n  # these are relative to build_platform, not target_platform\n  # cannot use the more accurate `build_platform is startingwith(\"linux\")`\n  # here due to https://github.com/prefix-dev/rattler-build/issues/2961\n  bz_os: ${{ \"linux\" if linux else \"darwin\" }}\n  bz_arch: ${{ \"x86_64\" if build_platform in (\"linux-64\", \"osx-64\") else \"arm64\" }}\n  bz_hash: ${{ \"9f38a7e60bb03a320d1403d5c344c7cf5f8ab89d3478cb3472a1f8f4a11e8c49\" if build_platform == \"linux-64\" else\n               \"fef3e5657afa77e7c257dd486031802b96e8d0df7b135feaa14d649d27ce22c6\" if build_platform == \"linux-aarch64\" else\n               \"ae392bcc92ff73da614d58bd36e0da0ac32fbeb830c4423184829c3f11de9cc6\" if build_platform == \"osx-64\" else\n               \"a404774c826a5322de4fa621dd03d9d83abf61544238f0cc9149291a03a7464f\" }}\n\npackage:\n  name: ijar\n  version: ${{ version }}\n\nsource:\n  - url: ${{ base_url }}/${{ version }}/bazel-${{ version }}-dist.zip\n    sha256: d78e9aa4edd22076affca23c04d376a031982d63f75cbee16d0233fe3e848149\n\n  - url: ${{ base_url }}/${{ version }}/bazel_nojdk-${{ version }}-${{ bz_os }}-${{ bz_arch }}\n    sha256: ${{ bz_hash }}\n    file_name: bazel\n\nbuild:\n  number: 0\n  skip: win\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('cxx') }}\n    - bazel-toolchain >=0.5.0\n    - openjdk <26\n    - sed\n\ntests:\n  - script:\n      - test -f $PREFIX/bin/ijar\n      - test -f $PREFIX/bin/zipper\n\nabout:\n  homepage: https://github.com/bazelbuild/bazel/tree/master/third_party/ijar\n  license: Apache-2.0\n  license_file: third_party/ijar/LICENSE\n  summary: A tool for generating interface .jars from normal .jars\n\nextra:\n  recipe-maintainers:\n    - xhochy\n    - conda-forge/bazel\n",
