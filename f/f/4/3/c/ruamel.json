  "raw_meta_yaml": "package:\n  name: ruamel\n  version: \"1.0\"\n\nbuild:\n  number: 13\n  script:\n    # conda-build derives SP_DIR from the platform alone, so on Windows it still\n    # says %PREFIX%\\Lib\\site-packages after 3.15 moved site-packages to\n    # %PREFIX%\\lib\\python\\site-packages (conda-forge/python-feedstock#860).\n    # Ask sysconfig for the layout of the python being built against instead.\n    - python -c \"import os,sysconfig;p=os.environ['PREFIX'];d=os.path.join(sysconfig.get_path('purelib',vars={'base':p,'platbase':p,'installed_base':p,'installed_platbase':p}),'ruamel');os.makedirs(d,exist_ok=True);open(os.path.join(d,'__init__.py'),'w').close()\"\n    - {{ PYTHON }} -c \"import ruamel\"   # [build_platform == target_platform]\n\nrequirements:\n  build:\n    - python\n\n  host:\n    - python\n\n  run:\n    - python\n\ntest:\n  imports:\n    - ruamel\n\nabout:\n  home: http://github.com/conda-forge/ruamel-feedstock\n  license: BSD-3-Clause\n  license_family: BSD\n  license_file: LICENSE.txt\n  summary: A package to ensure the `ruamel` namespace is available.\n\nextra:\n  recipe-maintainers:\n    - jakirkham\n",
