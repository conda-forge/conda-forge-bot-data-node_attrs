  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"4.5.8\"\n\npackage:\n  name: libwebsockets\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/warmcat/libwebsockets/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: b6ade658f4af3a823d0dc806ae5ef0623f0f4f5e2aeb895a0f77c4783840c30e\n  patches:\n    - if: win\n      then:\n        - patches/001-msvc-no-warnings-as-errors.patch\n    - if: linux\n      then:\n        - patches/002-use-linux-in6-h-instead-of-linux-ipv6-h.patch\n\nbuild:\n  number: 0\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - ninja\n    - pkg-config\n  host:\n    - libuv\n    - openssl\n  run_exports:\n    - ${{ pin_subpackage('libwebsockets', upper_bound='x.x') }}\n\ntests:\n  - package_contents:\n      include:\n        - libwebsockets.h\n        - libwebsockets/lws-context-vhost.h\n      lib:\n        - websockets\n  # builds a small program against the exported cmake config, which has a history\n  # of pointing at build-time-only locations of openssl\n  - script:\n      - if: unix\n        then:\n          - cmake -GNinja -S consumer_test -B consumer_test/build ${CMAKE_ARGS} -DCMAKE_BUILD_TYPE=Release\n          - cmake --build consumer_test/build\n          - ./consumer_test/build/lws_version\n        else:\n          - cmake -GNinja -S consumer_test -B consumer_test/build %CMAKE_ARGS% -DCMAKE_BUILD_TYPE=Release\n          - cmake --build consumer_test/build\n          - consumer_test\\build\\lws_version.exe\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - cmake\n        - ninja\n    files:\n      recipe:\n        - consumer_test/\n\nabout:\n  homepage: https://libwebsockets.org\n  license: MIT\n  license_file: LICENSE\n  summary: canonical libwebsockets.org websocket library\n  description: |\n    Libwebsockets is a simple-to-use, pure C library providing client and server\n    for **http/1**, **http/2**, **websockets** and other protocols in a security-minded,\n    lightweight, configurable, scalable and flexible way.  It's easy to build and\n    cross-build via cmake and is suitable for tasks from embedded RTOS through mass\n    cloud serving.\n  repository: https://github.com/warmcat/libwebsockets\n  documentation: https://libwebsockets.org/lws-api-doc-master/html/index.html\n\nextra:\n  recipe-maintainers:\n    - sodre\n    - wolfv\n    - pavelzw\n",
