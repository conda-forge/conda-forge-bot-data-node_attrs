  "raw_meta_yaml": "context:\n  name: astromodels\n  version: 2.6.0 \n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/a/astromodels/astromodels-${{ version }}.tar.gz\n  sha256: 8e9e3a277b24eded7a4e7149857df0be4abe70921a219c15a4d55dc1a935e13e\n \nbuild:\n  skip:\n  - win\n  - match(python, \"<3.11\")\n  - match(python, \">=3.14\")\n  script:\n    - rm -rf pfiles\n    - pip install --verbose --no-deps --no-build-isolation --ignore-installed .\n  number: 1\n\nrequirements:\n  build:\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('fortran') }}\n\n  host:\n    - python\n    - pip\n    - setuptools\n    - if: python >=\"3.12\"\n      then: numpy >=2.1\n      else: numpy >=1.26\n    - versioneer\n\n  run:\n    - python\n    - if: python >= \"3.12\"\n      then: numpy >=2.1\n      else: numpy >=1.26\n    - pyyaml\n    - astropy-base >=7.2\n    - scipy\n    - pytables\n    - pandas\n    - dill\n    - numba\n    - h5py >=3.9\n    - omegaconf\n    - rich\n    - versioneer\n    - if: (osx and x86_64)\n      then: llvmlite <0.46\n\n  run_constraints:\n    - if: not (linux and aarch64) and match(python, \">=3.14\")\n      then: xspec >12.15.1\n    - if: not (linux and aarch64) and match(python, \"<3.14\")\n      then: xspec <13.0.0\n\ntests:\n  - python:\n      imports:\n        - astromodels\n  - script:\n      - python -m pytest -vv --pyargs astromodels -c pyproject.toml -n auto --dist worksteal\n\n    files:\n      source:\n        - pyproject.toml\n    requirements:\n      run:\n        - pytest\n        - pytest-xdist\n\nabout:\n  license: BSD-3-Clause\n  license_file: LICENSE\n  summary: Models for astronomy and astrophysics\n  description: |\n    Astromodels contains models to be used in likelihood or\n    Bayesian analysis in astronomy and astrophysics\n\n  homepage: https://github.com/threeml/astromodels\n  repository: https://github.com/threeML/astromodels\n  documentation: https://astromodels.readthedocs.io\n\nextra:\n  recipe-maintainers:\n    - jan-janssen\n",
