  "raw_meta_yaml": "context:\n  version: \"0.2.1\"\n\npackage:\n  name: gh-stack\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/github/gh-stack/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 263af23a0bd8aed815a7db02c088a3606f4f1ae2774ce7806004ff2895945202\n    target_directory: src\n  # go-licenses cannot detect the license of chroma (it ships a COPYING file), so we vendor it manually\n  - url: https://raw.githubusercontent.com/alecthomas/chroma/v2.27.0/COPYING\n    sha256: 13654b052f885cb3fa47d7343e13975d9c8a64c3bcd84993c35d5eb01f22b23f\n    file_name: LICENSE-chroma\n  # go-localereader v0.0.1 (only pulled in on Windows) has no license file in the tagged release;\n  # upstream README states MIT and the LICENSE was added in a later commit, which we vendor here\n  - url: https://raw.githubusercontent.com/mattn/go-localereader/6bae6c923850ab5e0da9f36f69811ffe17064228/LICENSE\n    sha256: dceede03550621e65ec7b79fcba87cf6dbb9d31132a8ae71a8fe8ceec0af7da3\n    file_name: LICENSE-go-localereader\n\nbuild:\n  number: 0\n  script:\n    - cd src\n    - go-licenses save . --save_path ../library_licenses --ignore github.com/alecthomas/chroma/v2 --ignore github.com/mattn/go-localereader\n    - if: unix\n      then: go build -v -o $PREFIX/bin/gh-stack -ldflags=\"-s -w -X github.com/github/gh-stack/cmd.Version=${{ version }}\"\n      else: go build -v -o %LIBRARY_BIN%\\gh-stack.exe -ldflags=\"-s -X github.com/github/gh-stack/cmd.Version=${{ version }}\"\n\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n\ntests:\n  - script:\n      - gh-stack --help\n      - gh-stack --version\n  - package_contents:\n      bin:\n        - gh-stack\n      strict: true\n\nabout:\n  homepage: https://github.com/github/gh-stack\n  summary: GitHub CLI extension for managing stacked branches and pull requests\n  description: |\n    gh-stack is a GitHub CLI (gh) extension for working with stacked pull\n    requests. Stacked PRs break large changes into a chain of small,\n    reviewable pull requests that build on each other. gh-stack automates\n    creating branches, keeping them rebased, setting correct PR base branches,\n    and navigating between layers of the stack.\n  license: MIT\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n    - LICENSE-chroma\n    - LICENSE-go-localereader\n  documentation: https://gh.io/stacks\n  repository: https://github.com/github/gh-stack\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
