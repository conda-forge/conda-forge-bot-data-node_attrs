      "doc_url": "https://gh.io/stacks",
      "home": "https://github.com/github/gh-stack",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "src/LICENSE",
      "summary": "GitHub CLI extension for managing stacked branches and pull requests"
    },
    "build": {
      "number": "0",
      "script": [
        "cd src",
        "go-licenses save . --save_path ../library_licenses --ignore github.com/alecthomas/chroma/v2 --ignore github.com/mattn/go-localereader",
