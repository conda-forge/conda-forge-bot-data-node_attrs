  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: lwt\n  version: \"6.1.2\"\n\n  library: ${{ \"Library/\" if not unix else \"\" }}\n  m2: ${{ \"m2-\" if not unix else \"\" }}\n  c_toolchain: ${{ \"\" if unix else \"gcc_*\" }}\n\nrecipe:\n  name: ocaml-${{ name }}-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ocsigen/lwt/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 8d17156f4a5de94560a7f9edd444bee58f7eb447270b2a2d3e4483d819c6b0ab\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: ocaml-${{ name }}\n      version: ${{ version }}\n    build:\n      script: bash ${{ RECIPE_DIR }}/build.sh lwt\n    requirements:\n      build:\n        - if: unix\n          then:\n            - ${{ compiler(\"c\") }}\n            - ${{ stdlib(\"c\") }}\n          else:\n            - ${{ compiler(\"m2w64_c\") }}\n            - ${{ stdlib(\"m2w64_c\") }}\n        # non-unix: conda-forge ocaml has gcc_ and vs2022_ tracks; these recipes use the gcc (MinGW) track only.\n        - ocaml ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n        - ocaml-dune 3.24.*\n        - ocaml-cppo >=1.1\n        - ${{ m2 }}make\n        - if: not unix\n          then:\n            - m2-bash\n      host:\n        - ocaml ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n        - ocaml-dune-configurator\n        - ocaml-ocplib-endian\n      run:\n        - ocaml ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n        - ocaml-ocplib-endian\n    tests:\n      - package_contents:\n          files:\n            - ${{ library }}lib/ocaml/lwt/META\n            - ${{ library }}lib/ocaml/lwt/lwt.cmxa\n            - ${{ library }}lib/ocaml/lwt/unix/lwt_unix.cmxa\n      - script: bash testing/test_lwt.sh\n        files:\n          recipe:\n            - testing/test_lwt.sh\n        requirements:\n          run:\n            - ocaml ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n            - ocaml-dune 3.24.*\n            - if: unix\n              then:\