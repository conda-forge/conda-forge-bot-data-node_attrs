  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"1.10.0\"\n  # key dependency floors to `pip check`\n  pydantic_min: \"2.7.0\"\n  numpy_min: \"2.0.0\"\n  # check solve/import/check with a specific version of python instead of `*` (read: some python)\n  python_check_max: \"3.15\"\n  # tests that rely on specific type checker version outputs\n  unlink_tests: test_pyright.py test_mypy.py\n\npackage:\n  name: numpydantic\n  version: ${{ version }}\n\nsource:\n  - url: https://files.pythonhosted.org/packages/source/n/numpydantic/numpydantic-${{ version }}.tar.gz\n    sha256: a17d5ccc3b893c4a2e539c81c2f18960d70884ad7fcaa09c9eb56a95e8daf4a3\n  - target_directory: src/numpydantic/vendor/nptyping\n    url: https://raw.githubusercontent.com/ramonhagenaars/nptyping/refs/tags/v2.5.0/LICENSE\n    sha256: c9592e4cc7ac9023931008a31cf278ba39a4619b82ec5d045ba069fc3ac81a7b\n\nbuild:\n  number: 1\n  noarch: python\n  script:\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check --check-build-dependencies\n    - ${{ PYTHON }} -c \"import os; [os.unlink(f'tests/{p}') for p in '''${{ unlink_tests }}'''.split()]\"\n\nrequirements:\n  host:\n    - pdm-backend\n    - pip\n    - python ${{ python_min }}.*\n  run:\n    - numpy >=${{ numpy_min }}\n    - pydantic >=${{ pydantic_min }}\n    - python >=${{ python_min }}\n    - typing-extensions >=4.11.0\n\ntests:\n  - package_contents:\n      strict: true\n      files:\n        - etc/conda/test-files/numpydantic/**\n      site_packages:\n        - numpydantic/**\n        - numpydantic-${{ version }}.dist-info/**\n  - python:\n      imports: numpydantic\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - ${{ python_check_max }}.*\n  - files:\n      source:\n        - pyproject.toml\n        - tests/**\n    requirements:\n      run:\n        - pytest >=7.4.0\n        - pytest-cov >=4.1.0\n        # all the runtime [extras]; add to `requirements/extras` when CEP-44 is ready\n        - dask >=2024.4.0\n        - h5py >=3.10.0\n        - opencv >=4.9.0.80\n        - zarr >=2.17.2,<3.0.0\n        # for extra floor pip check\n        - pip\n        - python ${{ python_min }}.*\n        - numpy ${{ numpy_min }}.*\n        - pydantic ${{ pydantic_min }}.*\n    script:\n      env:\n        NUMCODECS_ALLOW_UNSAFE_PICKLE_DECODE: \"1\"\n      content:\n        - pip check\n        - pytest -vv --tb=long --color=yes\n\nabout:\n  summary: |-\n    Type and shape validation and serialization for arbitrary array types in pydantic models\n  license: MIT\n  license_file:\n    - LICENSE\n    - src/numpydantic/vendor/nptyping/LICENSE\n  homepage: https://pypi.org/project/numpydantic\n  repository: https://github.com/p2p-ld/numpydantic\n  documentation: https://numpydantic.readthedocs.io\n\nextra:\n  recipe-maintainers:\n    - sneakers-the-rat\n    - apcamargo\n    - bollwyvl\n",
