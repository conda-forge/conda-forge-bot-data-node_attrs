    "about": {
      "dev_url": "https://github.com/firelab/FIAstemmap",
      "home": "https://firelab.github.io/FIAstemmap/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Maps individual tree stem locations on field plots of the Forest Inventory and Analysis Program of USDA Forest Service (<https://research.fs.usda.gov/programs/nfi>). Stem locations are mapped in cartesian coordinate space based on field-measured distance and azimuth from subplot and microplot centers. Per-tree crown widths are estimated using a curated set of allometric equations with coverage for the conterminous US. Spatial descriptors of tree point pattern are computed at the whole plot level. Several stand height metrics are also computed and provided in the output. The spatial representation of modeled tree crowns is used to generate estimates of fractional tree canopy cover at the microplot, subplot and whole plot levels. Convenience functions are provided for efficient data processing. Exploratory data analysis is also facilitated via integration with the 'spatstat' packages."
    },
    "build": {
      "number": "0",
      "script": [
        "Rscript -e \"stopifnot(file.copy(file.path(R.home('share'), 'licenses', 'MIT'), 'LICENSE-MIT'))\"",
        "R CMD INSTALL --build ."
      ]
    },
