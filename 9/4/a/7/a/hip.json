  "raw_meta_yaml": "{% set name = \"hip\" %}\n{% set version = \"7.2.4\" %}\n{% set major_version = version.split('.')[0] %}\n{% set minor_version = version.split('.')[1] %}\n{% set major_minor_version = \".\".join(version.split(\".\")[:2]) %}\n{% set patch_version = version.split('.')[2] %}\n{% set llvm_major_version = \"22\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  - url: https://github.com/ROCm/rocm-systems/releases/download/rocm-{{ version }}/hip.tar.gz\n    sha256: 76c3d6909e531f30b84c908984891559d221d8c427d44abc88be5dbb123f9ad6\n    folder: hip\n\n  - url: https://github.com/ROCm/rocm-systems/releases/download/rocm-{{ version }}/clr.tar.gz\n    sha256: c9670697ee47b2d33dde84e4c815a62f594061da9ff184b133b87a227a1a1f02\n    folder: clr\n    patches:\n      - 0001-Mark-raw-strings.patch\n      - 0004-hip-config-optional-tools.patch\n\n  - url: https://github.com/ROCm/llvm-project/archive/refs/tags/rocm-{{ version }}.tar.gz\n    sha256: 526b5fe23417c41acbeb2273e470887b4593f48a297a8d9c1a1aa730d556f9fb\n    folder: hipcc\n    patches:\n      - 0002-Fix-cmake-backward-compatibility.patch\n      - 0003-hipcc-path.diff\n\nbuild:\n  number: 0\n  skip: true  # [not linux]\n\nrequirements:\n  build:\n    - {{ compiler('c') }}\n    - {{ stdlib(\"c\") }}\n    - {{ compiler('cxx') }}\n    - cmake\n    - make\n    - cppheaderparser\n    - wget\n    - python *\n  host:\n    - clangdev {{ llvm_major_version }}.*\n    - numactl\n    - llvmdev {{ llvm_major_version }}.*\n    - ocl-icd\n    - rocm-core {{ version }}.*\n    - rocm-comgr {{ major_minor_version }}.*\n    - rocr-runtime {{ major_minor_version }}.*\n    - rocm-cmake {{ major_minor_version }}.*\n    - zlib\n    - rocminfo {{ major_minor_version }}.*\n    - libgl-devel\n    - libopengl-devel\n    - libglx-devel\n    - libegl-devel\n\noutputs:\n  - name: hip-runtime-amd\n    requirements:\n      build:\n        - {{ compiler('c') }}\n        - {{ stdlib(\"c\") }}\n        - {{ compiler('cxx') }}\n      host:\n        - numactl\n        - rocm-core {{ version }}.*\n        - rocm-comgr {{ major_minor_version }}.*\n        - rocr-runtime {{ major_minor_version }}.*\n      run:\n        - rocm-comgr {{ major_minor_version }}.*\n        - rocr-runtime {{ major_minor_version }}.*\n        - rocm-device-libs {{ major_minor_version }}.*\n    files:\n      - lib/.hipInfo\n      - lib/cmake/hip/hip-targets*.cmake\n      - lib/cmake/hip-lang/*.cmake\n      - lib/cmake/hiprtc/*.cmake\n      - lib/libamdhip64.so*\n      - lib/libhiprtc.so*\n      - lib/libhiprtc-builtins.so*\n      - share/doc/hip/LICENSE.md\n    test:\n      commands:\n        - test -f $PREFIX/lib/.hipInfo\n        - test -f $PREFIX/lib/libamdhip64.so\n        - test -f $PREFIX/lib/libamdhip64.so.{{ major_version }}\n\n  - name: hip-devel\n    requirements:\n      run:\n        - {{ pin_subpackage(\"hip-runtime-amd\") }}\n    run_exports:\n      - {{ pin_subpackage(\"hip-runtime-amd\") }}\n    files:\n      - bin/hipcc_cmake_linker_helper\n      - bin/hipdemangleatp\n      - bin/roc-obj\n      - bin/roc-obj-extract\n      - bin/roc-obj-ls\n      - include/hip/amd_detail/*\n      - include/hip/*.h\n      - lib/cmake/hip/FindHIP.cmake\n      - lib/cmake/hip/FindHIP/*.cmake\n      - lib/cmake/hip/hip-config*.cmake\n      - share/hip/version\n    test:\n      commands:\n        - test -f $PREFIX/share/hip/version\n        - test -f $PREFIX/lib/cmake/hip/FindHIP.cmake\n        - test -f $PREFIX/include/hip/hip_common.h\n        - cmake-package-check hip --targets hip::host hip::device\n      requires:\n        - cmake-package-check\n        - {{ compiler('c') }}\n        - {{ compiler('cxx') }}\n\n  - name: hipcc\n    requirements:\n      build:\n        - {{ compiler('c') }}\n        - {{ stdlib(\"c\") }}\n        - {{ compiler('cxx') }}\n      host:\n        - {{ pin_subpackage(\"hip-devel\", exact=True) }}\n      run:\n        - {{ pin_subpackage(\"hip-devel\", exact=True) }}\n        - clang {{ llvm_major_version }}.*\n        - clangxx {{ llvm_major_version }}.*\n        - llvm-tools {{ llvm_major_version }}.*\n        - perl\n        - python *\n        - rocm-core {{ version }}.*\n        - rocminfo {{ major_minor_version }}.*\n        # rocm-device-libs, lld and clang-tools are required for HIP compilation\n        - rocm-device-libs {{ major_minor_version }}.*\n        - lld {{ llvm_major_version }}.*\n        - clang-tools {{ llvm_major_version }}.*\n        - compiler-rt {{ llvm_major_version }}.*\n    files:\n      - bin/hipcc\n      - bin/hipcc.bin\n      - bin/hipcc.pl\n      - bin/hipconfig*\n      - bin/hipvars.pm\n      - share/doc/hipcc/*\n      - etc/conda/activate.d/hip_activate.sh\n      - etc/conda/deactivate.d/hip_deactivate.sh\n    test:\n      commands:\n        - export HIP_PLATFORM=amd\n        - $PREFIX/bin/hipcc --offload-arch=gfx803 --version\n        - $PREFIX/bin/hipconfig\n        - hipcc --offload-arch=gfx942 ./test/test_cmake_enable_hip/main_hip_smoke_test.hip\n      files:\n        - test\n\n  # This package provides the files and activation scripts needed to compile HIP code\n  # inside conda-build and rattler-build using {{ compiler('hip') }} and targeting the\n  # amd/rocm HIP platform\n  - name: hip-rocm-clang_linux-64\n    requirements:\n      run:\n        - {{ pin_subpackage(\"hipcc\", exact=True) }}\n    run_exports:\n      strong:\n        - rocm-core {{ major_minor_version }}.*\n        - {{ pin_subpackage(\"hip-runtime-amd\") }}\n    files:\n      - etc/conda/activate.d/hip-rocm-clang_activate.sh\n      - etc/conda/deactivate.d/hip-rocm-clang_deactivate.sh\n    test:\n      commands:\n        - cmake-package-check hip --targets hip::host hip::device\n        - cmake -B./test/test_cmake_enable_hip_build -S./test/test_cmake_enable_hip -GNinja\n        - hipcc --offload-arch=gfx942 ./test/test_cmake_enable_hip/main_hip_smoke_test.hip\n        - $HIPCXX --version\n      requires:\n        - cmake-package-check\n        - {{ compiler('c') }}\n        - {{ compiler('cxx') }}\n        - cmake\n        - ninja\n      files:\n        - test\n\n  # This metapackage provides the compiler outside conda-build and rattler-build.\n  - name: hip-compiler\n    requirements:\n      run:\n        - {{ pin_subpackage(\"hip-rocm-clang_linux-64\", exact=True) }}\n    test:\n      commands:\n        - cmake-package-check hip --targets hip::host hip::device\n        - cmake -B./test/test_cmake_enable_hip_build -S./test/test_cmake_enable_hip -GNinja\n        - hipcc --offload-arch=gfx942 ./test/test_cmake_enable_hip/main_hip_smoke_test.hip\n      requires:\n        - cmake-package-check\n        - {{ compiler('c') }}\n        - {{ compiler('cxx') }}\n        - cmake\n        - ninja\n      files:\n        - test\n\n  - name: rocm-opencl\n    requirements:\n      build:\n        - {{ compiler('c') }}\n        - {{ stdlib(\"c\") }}\n        - {{ compiler('cxx') }}\n      host:\n        - numactl\n        - rocm-core {{ version }}.*\n        - rocm-comgr {{ major_minor_version }}.*\n        - rocr-runtime {{ major_minor_version }}.*\n      run:\n        - rocm-comgr {{ major_minor_version }}.*\n        - rocr-runtime {{ major_minor_version }}.*\n    files:\n      - lib/libamdocl64.so*\n      - share/doc/opencl/LICENSE.md\n    test:\n      commands:\n        - test -f $PREFIX/lib/libamdocl64.so\n\n  - name: rocm-opencl-runtime\n    requirements:\n      run:\n        - {{ pin_subpackage(\"rocm-opencl\", exact=True) }}\n        - ocl-icd                 # [linux]\n        - khronos-ocl-icd-loader  # [not linux]\n    files:\n      - etc/OpenCL/vendors/amdocl64.icd\n    test:\n      commands:\n        - test -f $PREFIX/etc/OpenCL/vendors/amdocl64.icd\n\nabout:\n  home: https://github.com/ROCm/HIP\n  license: NCSA\n  license_family: MIT\n  license_file:\n    - clr/LICENSE.md\n    - hip/LICENSE.md\n    - hipcc/amd/hipcc/LICENSE.txt\n  summary: 'HIP: C++ Heterogeneous-Compute Interface for Portability '\n\nextra:\n  recipe-maintainers:\n    - isuruf\n    - zklaus\n    - conda-forge/rocm-core\n",
