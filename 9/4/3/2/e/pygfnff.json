  "raw_meta_yaml": "context:\n  version: \"0.0.3\"\n\npackage:\n  name: pygfnff\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/LiuGaoyong/PyGFNFF/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 8692491a34477a46d700ad117fc5515a4730e93c02b832e9781967651f017646\n\nbuild:\n  number: 0\n  # The CMake build only supports GNU or Intel Fortran compilers; conda-forge\n  # ships flang on Windows.\n  skip: win\n  script:\n    - ${{ PYTHON }} -m pip install . -vv -Ccmake.define.BLA_VENDOR=Generic\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('fortran') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - ninja\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - numpy\n  host:\n    - python\n    - pip\n    - scikit-build-core >=0.11\n    - f2py-cmake\n    - numpy\n    - libblas\n    - liblapack\n  run:\n    - python\n    - ase\n    - typing-extensions\n\ntests:\n  - python:\n      imports:\n        - pygfnff\n        - pygfnff._pygfnfflib\n      pip_check: true\n  - files:\n      source:\n        - tests/\n    requirements:\n      run:\n        - pytest\n    script:\n      - pytest -v tests\n\nabout:\n  homepage: https://github.com/LiuGaoyong/PyGFNFF\n  summary: A Python library for GFN-FF, wrapping the Fortran implementation via F2PY.\n  description: |\n    PyGFNFF provides Python bindings (built with NumPy F2PY) to the GFN-FF\n    general force field, including an ASE calculator interface.\n  license: GPL-3.0-or-later\n  license_file: LICENSE\n  repository: https://github.com/LiuGaoyong/PyGFNFF\n\nextra:\n  recipe-maintainers:\n    - LiuGaoyong\n",
