  "raw_meta_yaml": "context:\n  version: \"2.20.0\"\n\nrecipe:\n  name: pagmo-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/esa/pagmo2/archive/v${{ version }}.tar.gz\n  sha256: 8d684e9a3667dcccc844489083906c35aba7610594c5fce0f4eccce9c2264f4d\n\nbuild:\n  number: 0\n\noutputs:\n  - staging:\n      name: pagmo-staging\n    requirements:\n      build:\n        - ${{ compiler('cxx') }}\n        - ${{ compiler('c') }}\n        - ${{ stdlib(\"c\") }}\n        - cmake\n        - ninja\n      host:\n        - eigen\n        - nlopt\n        - libboost-devel\n        - tbb-devel\n        - ipopt\n    build:\n      script:\n        - if: unix\n          then: build.sh\n          else: build.bat\n\n  - package:\n      name: pagmo\n    inherit: pagmo-staging\n    build:\n      files:\n        - if: unix\n          then:\n            - lib/libpagmo*\n          else:\n            - Library/bin/pagmo.dll\n    tests:\n      - script:\n          - if: unix\n            then:\n              - test -f $PREFIX/lib/libpagmo${SHLIB_EXT}\n            else:\n              - if not exist %PREFIX%\\\\Library\\\\bin\\\\pagmo.dll exit 1\n\n  - package:\n      name: pagmo-devel\n    inherit: pagmo-staging\n    requirements:\n      host:\n        - pagmo\n      run:\n        - ${{ pin_subpackage(\"pagmo\", exact=True) }}\n        - eigen\n        - tbb-devel\n        - libboost-devel\n      run_exports:\n        # NOTE: don't need to list tbb, as\n        # the pagmo public headers do not\n        # use tbb (thus, a dependee of pagmo\n        # does not need to link to tbb).\n        # pagmo's API and ABI change at minor rev bumps.\n        - ${{ pin_subpackage('pagmo', upper_bound='x.x') }}\n        - ${{ pin_compatible('libboost', upper_bound='x.x') }}\n        - ${{ pin_compatible('nlopt', upper_bound='x.x') }}\n        # NOTE: ipopt might change the ABI at minor version bumps:\n        # https://github.com/conda-forge/ipopt-feedstock/issues/85#issuecomment-1168571776\n        - ${{ pin_compatible('ipopt', upper_bound='x.x.x') }}\n    build:\n      files:\n        - if: unix\n          then:\n            - include/pagmo\n            - lib/cmake/pagmo\n          else:\n            - Library/include/pagmo\n            - Library/lib/pagmo.lib\n            - Library/lib/cmake/pagmo\n\n    tests:\n      - script:\n          - if: unix\n            then:\n              - test -f $PREFIX/include/pagmo/config.hpp\n            else:\n              - if not exist %PREFIX%\\\\Library\\\\include\\\\pagmo\\\\config.hpp exit 1\n              - if not exist %PREFIX%\\\\Library\\\\lib\\\\pagmo.lib exit 1\n\nabout:\n  homepage: https://esa.github.io/pagmo2/\n  license: GPL-3.0-or-later OR LGPL-3.0-or-later\n  license_file: COPYING.lgpl3\n  summary: A C++ platform to perform parallel computations of optimisation tasks (global and local) via the asynchronous generalized island model\n\nextra:\n  recipe-maintainers:\n    - bluescarni\n    - darioizzo\n    - jschueller\n",
