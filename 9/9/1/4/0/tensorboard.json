  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: tensorboard\n  version: \"2.21.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  # source distribution not available on PyPI; git luse wheel instead:\n  url: https://pypi.org/packages/py3/t/tensorboard/tensorboard-${{ version }}-py3-none-any.whl\n  sha256: 7279316dcb6bd5bc391d623dea841531299cde1887310e8133bc34a996d32255\n\nbuild:\n  number: 0\n  noarch: python\n  python:\n    entry_points:\n      - tensorboard = tensorboard.main:run_main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n    - sed\n  run:\n    - python >=${{ python_min }}\n    - absl-py >=0.4\n    - grpcio >=1.74.0,<2\n    - markdown >=2.6.8\n    - numpy >=1.12.0\n    - packaging\n    - pillow\n    - protobuf >=6.31.1,<8.0.0\n    - werkzeug >=1.0.1\n    - setuptools >=41.0.0\n    - tensorboard-data-server >=0.7.0,<0.8.0\n\ntests:\n  - python:\n      python_version:\n        - ${{ python_min }}.*\n        - '*'\n      imports:\n        - tensorboard\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - tensorboard -h\n      # Guard against version-mismatch regressions: the package must report ${{ version }}\n      - tensorboard --version_tb\n      - python -c \"import tensorboard.version as v; print('tensorboard.version.VERSION =', v.VERSION); assert v.VERSION == '${{ version }}', v.VERSION\"\n      - python -c \"from importlib.metadata import version; print('importlib.metadata version =', version('tensorboard')); assert version('tensorboard') == '${{ version }}', version('tensorboard')\"\n      # Guard that the package advertises a conda install, not pip/pypi\n      - python -c \"from importlib.metadata import distribution as d; t = (d('tensorboard').read_text('INSTALLER') or '').strip(); print('INSTALLER =', repr(t)); assert t == 'conda', t\"\n\nabout:\n  license: Apache-2.0\n  license_file: LICENSE\n  summary: Tensor