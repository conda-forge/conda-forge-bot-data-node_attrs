    "about": {
      "description": "Particula is a Python-based aerosol particle simulator. Its goal is to\nprovide a robust aerosol simulation (including both gas and particle phases)\nthat can be used to answer scientific questions arising from experiments and research endeavors.\n",
      "dev_url": "https://github.com/uncscode/particula",
      "doc_url": "https://uncscode.github.io/particula/",
      "home": "https://uncscode.github.io/particula",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "license",
      "summary": "a simple, fast, and powerful particle simulator"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "PYTHON -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "gorkowski",
        "ngam",
        "mahf708"
      ]
    },
    "package": {
      "name": "particula",
      "version": "0.3.5"
    },
    "requirements": {
      "host": [
        "python 3.12",
        "pip",
        "flit-core >=3.12,<4"
      ],
      "run": [
        "python >=3.12",
        "numpy >=2.0.0",
        "scipy >=1.14.0",
        "typing_extensions >=4.0.0",
        "warp-lang",
        "pyyaml"
      ]
    },
    "schema_version": 0,
    "source": {
      "sha256": "969d7b7979fcb1b38986dd00ed60ba6dedbac25b9bc8971e76dd7d841042d6b2",
