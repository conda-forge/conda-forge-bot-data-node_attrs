  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: 2.6.15\n  # dependency versions\n  ldas_tools_cmake_version: 1.5.0\n  swig_version: 3.0.7\n\nrecipe:\n  name: ldas-tools-al-swig\n  version: ${{ version }}\n\nsource:\n  url: https://software.igwn.org/sources/source/ldas-tools-al-swig-${{ version }}.tar.gz\n  sha256: 3fa9f11504e0d4a413423fca733515f35e28ffcd6ae8782f5fe13934c961ae5f\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: ldas-tools-al-swig\n    build:\n      noarch: generic\n      script: build\n    requirements:\n      build:\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - cmake >=3.6\n        - pkg-config\n        - make\n        - swig >=${{ swig_version }}\n      host:\n        - ldas-tools-cmake >=${{ ldas_tools_cmake_version }}\n    tests:\n      - package_contents:\n          include:\n            - ldastoolsal/gpstime.i\n\n  - package:\n      name: python-ldas-tools-al\n    build:\n      noarch: python\n      script: build-python\n      files:\n        - lib/python*/site-packages/\n    requirements:\n      build:\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - cmake >=3.6\n        - make\n        - pkg-config\n        - swig >=${{ swig_version }}\n      host:\n        - ${{ pin_subpackage('ldas-tools-al-swig', exact=True) }}\n        - ldas-tools-cmake >=${{ ldas_tools_cmake_version }}\n        - python ${{ python_min }}.*\n      run:\n        - python >=${{ python_min }}\n    tests:\n      - python:\n          imports:\n            - LDAStools\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n    about:\n      summary: Python bindings for the LDAS Tools abstraction toolkit\n\nabout:\n  summary: SWIG bindings for the LDAS Tools abstraction toolkit\n  homepage: https://wiki.ligo.org/Computing/LDASTools\n  repository: https://git.ligo.org/ldastools/LDAS_Tools\n  license: GPL-3.0-or-later\n  license_file: COPYING\n\nextra:\n  recipe-maintainer