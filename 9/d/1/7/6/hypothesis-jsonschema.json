  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.23.2\"\n  hypothesis_min: \"6.170.10\"\n  python_check_max: \"3.15\"\n  # test_from_schema.py:  expects many MB of JSON schema\n  # test_version.py:      only tests repo files\n  unlink_tests: test_from_schema.py test_version.py\n  # upstream doesn't tag, this file not in sdist\n  test_commit: fa38b03d8bb6f917ba749ef84ce1e4465d1e27cc\n  cov_fail_under: \"91\"\n\npackage:\n  name: hypothesis-jsonschema\n  version: ${{ version }}\n\nsource:\n  - url: https://files.pythonhosted.org/packages/source/h/hypothesis-jsonschema/hypothesis_jsonschema-${{ version }}.tar.gz\n    sha256: 43a5f21c67f7cdccd6e3e0d1300cb5261bede6c046e3eff8a73c094b4afdf761\n  - url: https://raw.githubusercontent.com/Zac-HD/hypothesis-jsonschema/${{ test_commit }}/tests/gen_schemas.py\n    sha256: 69d0e8d530a807968d90de0a900d9d301ef1a60d89ce0e5602bac30c8362fb2d\n    target_directory: tests\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check --check-build-dependencies\n    - ${{ PYTHON }} -c \"import os; [os.unlink(f'tests/{p}') for p in '''${{ unlink_tests }}'''.split()]\"\n\nrequirements:\n  host:\n    - pip\n    - python ${{ python_min }}.*\n    - setuptools\n  run:\n    - hypothesis >=${{ hypothesis_min }}\n    - jsonschema >=4.18.0\n    - python >=${{ python_min }}\n\ntests:\n  - package_contents:\n      strict: true\n      files:\n        - etc/conda/test-files/hypothesis-jsonschema/**\n      site_packages:\n        - hypothesis_jsonschema/**\n        - hypothesis_jsonschema-${{ version }}.dist-info/**\n  - python:\n      imports: hypothesis_jsonschema\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - ${{ python_check_max }}.*\n  - files:\n      source:\n        - tests/**\n      recipe:\n        - run_test.py\n    requirements:\n      run:\n        - hypothesis ${{ hypothesis_min }}.*\n        - jsonschema-with-format\n        - pip\n        - pytest-cov\n        - python ${{ python_min }}.*\n    script:\n      - pip check\n      - coverage run --source=hypothesis_jsonschema --branch -m pytest -vv --tb=long --color=yes\n      - coverage report --show-missing --skip-covered --fail-under=${{ cov_fail_under }}\n\nabout:\n  license: MPL-2.0\n  license_file: LICENSE\n  summary: Tools to generate test data from JSON schemata with Hypothesis\n  homepage: https://pypi.org/project/hypothesis-jsonschema\n  repository: https://github.com/python-jsonschema/hypothesis-jsonschema\n\nextra:\n  recipe-maintainers:\n    - bollwyvl\n",
