  "linux_64_meta_yaml": {
    "about": {
      "description": "MOSFiT fits semi-analytical model predictions to observed astrophysical\ntransients. MOSFiT 2 reads event data from local catalog-format JSON or\nASCII files; it no longer downloads events from the Open Astronomy\ncatalogs or uploads fits. The default sampler is dynesty. PyTorch (for the\nSESN SEDONA model) and mpi4py are optional extras rather than required run\ndependencies.\n",
      "dev_url": "https://github.com/guillochon/mosfit",
      "doc_url": "https://mosfit.readthedocs.io/",
      "home": "https://github.com/guillochon/mosfit",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Modular fitter for astrophysical transients"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "PYTHON -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "gmzsebastian",
        "guillochon",
        "mnicholl",
        "pkgw"
      ]
    },
    "package": {
      "name": "mosfit",
      "version": "2.1.0"
    },
    "requirements": {
      "host": [
        "python 3.11",
        "pip",
        "hatchling"
      ],
      "run": [
        "python >=3.11",
        "astrocats >=0.5.0",
        "astropy-base >=7.1",
        "dynesty >=3.1",
        "emcee >=3.0.2",
        "extinction >=0.2.2",
        "git",
        "h5py >=3.8.0",
        "inflect >=1.0.0",
        "matplotlib-base >=3.0.0",
