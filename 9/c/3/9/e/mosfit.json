        "numexpr >=2.6.1",
        "numpy >=2.3",
        "palettable >=2.1.1",
        "pandas >=2.2",
        "schwimmbad >=0.4.2",
        "scipy >=1.2",
        "seaborn >=0.7.1",
        "six >=1.0.0"
      ]
    },
    "schema_version": 0,
