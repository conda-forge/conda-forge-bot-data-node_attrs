  "linux_64_meta_yaml": {
    "about": {
      "description": "ini-file is a command-line tool that allows manipulating INI files.\nIt supports setting, getting, and deleting values in INI files.",
      "dev_url": "https://github.com/bitnami/ini-file",
      "home": "https://github.com/bitnami/ini-file",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE.md",
      "summary": "A CLI tool for manipulating INI files"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "let build_time = date now | format date \"%Y-%m-%dT%H:%M:%SZ\"",
          "let short_commit_hash = (http get https://api.github.com/repos/bitnami/ini-file/commits/v${{ version }}).sha | str substring 0..6",
          "go build -o ($prefix)/bin/ -v -ldflags=$'-s -w -X main.buildDate=($build_time) -X main.commit=($short_commit_hash) -X main.version=${{ version }}' -trimpath .",
          "go-licenses save . --save_path=library_licenses"
        ],
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "ini-file",
        "requirements": {
          "build": [
            "go-nocgo_compiler_stub",
            "go-licenses",
            "nushell"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": "ini-file --help 2>&1 | grep -q \"Usage:\""
          },
          {
            "package_contents": {
              "bin": [
                "ini-file"
              ],
              "strict": true
            }
          }
        ],
        "version": "1.4.10"
      }
    ],
