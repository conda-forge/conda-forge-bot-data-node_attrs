    "about": {
      "description": "get-gecko-driver fetches GeckoDriver, the WebDriver proxy that Selenium\nand similar tools use to automate Firefox. It can report the latest\nrelease, print the download URL for a given version and platform, and\ndownload and extract the binary. Works as a command line tool or as an\nimportable Python library.",
      "dev_url": "https://github.com/zaironjacobs/get-gecko-driver",
      "home": "https://github.com/zaironjacobs/get-gecko-driver",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "A tool to download and install GeckoDriver"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "get-gecko-driver = get_gecko_driver.app:app"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "killua156"
      ]
    },
    "outputs": [
      {
        "build": {
          "noarch": "python",
          "python": {
            "entry_points": [
              "get-gecko-driver = get_gecko_driver.app:app"
            ]
          }
        },
        "name": "get-gecko-driver",
        "requirements": {
          "build": [],
          "host": [
            "python 3.11.*",
            "pip",
            "setuptools >=84.0.0"
          ],
          "run": [
            "python >=3.11",
            "beautifulsoup4 >=4.13.5",
            "requests >=2.33.0",
            "urllib3 >=2.7.0",
            "typer >=0.17.4"
          ]
        },
        "tests": [
