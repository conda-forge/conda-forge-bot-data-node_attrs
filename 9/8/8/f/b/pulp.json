  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"3.3.2\"\n\npackage:\n  name: pulp\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/p/pulp/pulp-${{ version }}.tar.gz\n  sha256: d0904700c207ac11e25e3b1213b70eae1d6fb25faa719d75f3f15054901258c0\n  patches:\n    - patches/system-cbc.patch\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    - ${{ PYTHON }} -m pip install . -vv\n    # Remove bundled cbc binaries, using coin-or-cbc provided cbc instead:\n    - if: not win\n      then: rm -rf \"${SP_DIR}/pulp/solverdir/cbc\"\n      else: rd /s /q %SP_DIR%/pulp/solverdir/cbc\n  python:\n    entry_points:\n      - pulptest = pulp.tests.run_tests:pulpTestAll\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n  host:\n    - pip\n    - python ${{ python_min }}.*\n    - setuptools >=77\n  run:\n    - amply >=0.1.2\n    - coin-or-cbc\n    - python >=${{ python_min }}\n\ntests:\n  - python:\n      imports:\n        - pulp\n        - pulp.solverdir\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      - python -c \"import pulp; assert pulp.LpSolverDefault, 'default solver not available'\"\n      - pulptest\n\nabout:\n  summary: |\n    PuLP is an LP modeler written in python. PuLP can generate MPS or LP files\n    and call GLPK, COIN CLP/CBC, CPLEX, and GUROBI to solve linear problems.\n  license: MIT\n  license_file: LICENSE\n  homepage: https://github.com/coin-or/pulp\n  repository: https://github.com/coin-or/pulp\n\nextra:\n  recipe-maintainers:\n    - johanneskoester\n    - christopher-schroeder\n    - mgorny\n",
