  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: yara-python\n  version: \"4.5.4\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  - url: https://pypi.org/packages/source/y/yara-python/yara_python-${{ version }}.tar.gz\n    sha256: 4c682170f3d5cb3a73aa1bd0dc9ab1c0957437b937b7a83ff6d7ffd366415b9c\n  # the sdist bundles libyara's sources but not YARA's license file\n  - url: https://raw.githubusercontent.com/VirusTotal/yara/v${{ version }}/COPYING\n    sha256: efdabc1c1f655528b8c3a59b03668d446746d87273fab76f8af800b6e8891bd2\n    file_name: COPYING.yara\n\nbuild:\n  number: 0\n  script:\n    # yara-python compiles its bundled libyara; enable the OpenSSL-backed features\n    # (hash module, PE signatures) against conda-forge's openssl\n    - ${{ PYTHON }} ${{ RECIPE_DIR }}/enable_openssl.py\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n  host:\n    - python\n    - pip\n    - setuptools\n    - openssl\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - yara\n      pip_check: true\n  - script:\n      - python test_yara.py\n    files:\n      recipe:\n        - test_yara.py\n    requirements:\n      run:\n        - python\n\nabout:\n  homepage: https://virustotal.github.io/yara/\n  repository: https://github.com/VirusTotal/yara-python\n  documentation: https://yara.readthedocs.io/en/stable/yarapython.html\n  summary: Python interface for YARA, the pattern matching swiss knife for malware researchers\n  description: |\n    yara-python lets Python programs compile and run YARA rules. This package\n    builds the libyara sources bundled in the yara-python sdist, with OpenSSL\n    support enabled.\n  license: Apache-2.0 AND BSD-3-Clause\n  license_file:\n    - LICENSE\n    - COPYING.yara\n\nextra:\n  recipe-maintainers:\n    - mediocretech\n",
