  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.1.2\"\n\npackage:\n  name: napi-rs-keyring\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/Brooooooklyn/keyring-node/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: b461a450df324a73219c6352186b95e4501b3f9099b876b023c9cdcf1d8cbf9d\n  patches:\n    # Link the Linux credential store to conda's D-Bus instead of vendoring it.\n    - system-dbus.patch\n\nbuild:\n  number: 1\n  script:\n    - cargo generate-lockfile\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n    - cargo build --release --locked\n    - if: win\n      then: node \"%RECIPE_DIR%\\install.cjs\"\n      else: node \"$RECIPE_DIR/install.cjs\"\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - ${{ stdlib('c') }}\n    - cargo-bundle-licenses\n    - if: linux\n      then: pkgconf\n  host:\n    - nodejs >=24\n    - if: linux\n      then: dbus\n  run:\n    - nodejs >=24\n\ntests:\n  - files:\n      recipe:\n        - test.cjs\n    script:\n      - node test.cjs\n\nabout:\n  homepage: https://github.com/Brooooooklyn/keyring-node\n  repository: https://github.com/Brooooooklyn/keyring-node\n  summary: Node.js bindings for native operating system credential stores\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - timkpaine\n",
