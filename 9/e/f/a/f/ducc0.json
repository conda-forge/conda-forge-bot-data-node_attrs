  "raw_meta_yaml": "{% set name = \"ducc0\" %}\n{% set version = \"0.41.0\" %}\n{% set build = 1 %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/{{ name[0] }}/{{ name }}/ducc0-{{ version }}.tar.gz\n  sha256: bac084745bbdb243482a4aec3ecc857bdd46faec298c67e48bc0bb90350dbabd\n\nbuild:\n  # ducc0 picks its SIMD width at compile time (std::experimental::simd's\n  # native_simd) and has no runtime dispatch, so a portable build is limited to\n  # SSE2 on x86_64. The microarch_level variants build x86-64-v3 (AVX2) and\n  # x86-64-v4 (AVX-512) as well; the higher level gets the higher build number\n  # so the solver prefers it wherever the CPU supports it.\n  number: {{ build + 100 * (microarch_level|default(1)|int - 1) }}\n  skip: true  # [py<=36]\n  script_env:\n    - DUCC0_OPTIMIZATION=portable\n    # CI runners are not guaranteed to support AVX-512, so level 4 cannot use\n    # x86_64-microarch-level (its run_exports would make the test environment\n    # unsolvable there). Pass the flag through ducc0's own hook instead, which\n    # CMake appends after CXXFLAGS, and require the level at runtime below.\n    - DUCC0_CFLAGS=-march=x86-64-v4  # [linux and x86_64 and microarch_level == 4]\n  script: {{ PYTHON }} -m pip install . -vv\n\nrequirements:\n  build:\n    - x86_64-microarch-level =={{ microarch_level }}  # [unix and x86_64 and microarch_level < 4]\n    - python                                 # [build_platform != target_platform]\n    - cross-python_{{ target_platform }}     # [build_platform != target_platform]\n    - pybind11                               # [build_platform != target_platform]\n    - nanobind\n    - make\n    - cmake\n    - {{ compiler('c') }}\n    - {{ stdlib(\"c\") }}\n    - {{ compiler('cxx') }}\n  host:\n    - pip\n    - pybind11\n    - nanobind\n    - python\n    - make\n    - cmake\n    - scikit-build\n    - scikit-build-core\n  run:\n    - numpy >=1.17.0\n    - python\n    - _x86_64-microarch-level >=4  # [linux and x86_64 and microarch_level == 4]\n\n{% if microarch_level|default(1)|int < 4 %}\n# Not for level 4: its __archspec requirement cannot be met on a CI runner that\n# lacks AVX-512, and importing an AVX-512 build there could fault anyway.\ntest:\n  imports:\n    - ducc0\n  commands:\n    - pip check\n  requires:\n    - pip\n{% endif %}\n\nabout:\n  home: https://gitlab.mpcdf.mpg.de/mtr/ducc\n  summary: Distinctly useful code collection\n  license: GPL-2.0-or-later\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - ickc\n    - MarkWieczorek\n    - mreineck\n",
