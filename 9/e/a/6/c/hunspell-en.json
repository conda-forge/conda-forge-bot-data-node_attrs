  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: 2026.09.01\n  summary: \"English Dictionaries Project (AOO+Mozilla+others)\"\n  # see https://github.com/conda-forge/hunspell-feedstock/issues/12\n  # hunspell <1.7.5 used the legacy `PREFIX/share/hunspell_dictionaries`\n  hunspell_min: hunspell >=1.7.5\n  # localization paths and summary suffix\n  en_au: \"en_AU (-ise) (alt)\"\n  en_ca: \"en_CA (mixed) (alt)\"\n  en_gb: \"en_GB (-ise)\"\n  en_gb_oxendict: \"en_GB (-ize) (Oxford)\"\n  en_us: \"en_US (-ize) (alt)\"\n  en_za: \"en_ZA (-ise)\"\n  # legacy compatibility\n  gb_locales: en_GB en-GB\n  # utilities\n  slash: ${{ \"/\" if unix else \"\\\\\" }}\n  share_stem: share/hunspell\n  share: ${{ \"$PREFIX\" if unix else \"%PREFIX%\" }}${{ slash }}${{ share_stem | replace(\"/\", slash) }}\n  mkdirp: ${{ \"mkdir -p\" if unix else \"md\" }}\n  cp: ${{ \"cp\" if unix else \"copy\" }}\n  cp_all: ${{ mkdirp }} \"${{ share }}\" && ${{ cp }} *.aff *.dic \"${{ share }}\"\n\nrecipe:\n  name: aoo-mozilla-en-dict\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/marcoagpinto/aoo-mozilla-en-dict/archive/${{ version }}.tar.gz\n  sha256: 68349bfc36a17bddb16f8fde63fa10f5cf82f1e6c7b21393d3389e303cf2d97d\n\nbuild:\n  number: 0\n  noarch: generic\n\noutputs:\n  # metapackage\n  - package:\n      name: hunspell-en\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - hunspell\n        - ${{ pin_subpackage(\"aoo-mozilla-en-dict-au\", exact=True) }}\n        - ${{ pin_subpackage(\"aoo-mozilla-en-dict-ca\", exact=True) }}\n        - ${{ pin_subpackage(\"aoo-mozilla-en-dict-gb\", exact=True) }}\n        - ${{ pin_subpackage(\"aoo-mozilla-en-dict-gb-oxendict\", exact=True) }}\n        - ${{ pin_subpackage(\"aoo-mozilla-en-dict-us\", exact=True) }}\n        - ${{ pin_subpackage(\"aoo-mozilla-en-dict-za\", exact=True) }}\n    tests:\n      - requirements: { run: [hunspell, pytest] }\n        script:\n          env:\n            CF_EN_LOCALES: en_AU en_CA ${{ gb_locales }} en_GB-oxendict en_US en_ZA\n          file: test_hunspell.py\n    about:\n      summary: \"${{ summary }}: metapackage for all locales and hunspell\"\n\n  # locales\n  - package:\n      name: aoo-mozilla-en-dict-au\n    build:\n      noarch: generic\n      script: cd \"${{ en_au }}\" && ${{ cp_all }}\n    requirements: {run_constraints: [\"${{ hunspell_min }}\"]}\n    tests:\n      - package_contents: {strict: true, files: [\"${{ share_stem }}/en_AU.{dic,aff}\"]}\n      - requirements: { run: [hunspell, pytest] }\n        script: { file: test_hunspell.py }\n    about:\n      summary: \"${{ summary }}: ${{ en_au }}\"\n\n  - package:\n      name: aoo-mozilla-en-dict-ca\n    build:\n      noarch: generic\n      script: cd \"${{ en_ca }}\" && ${{ cp_all }}\n    requirements: {run_constraints: [\"${{ hunspell_min }}\"]}\n    tests:\n      - package_contents: {strict: true, files: [\"${{ share_stem }}/en_CA.{dic,aff}\"]}\n      - requirements: { run: [hunspell, pytest] }\n        script: { file: test_hunspell.py }\n    about:\n      summary: \"${{ summary }}: ${{ en_ca }}\"\n\n  - package:\n      name: aoo-mozilla-en-dict-gb\n    build:\n      noarch: generic\n      script:\n        - cd \"${{ en_gb }}\" && ${{ cp_all }}\n        # add legacy en-GB\n        - ${{ cp }} en_GB.dic ${{ share }}/en-GB.dic\n        - ${{ cp }} en_GB.aff ${{ share }}/en-GB.aff\n    requirements: {run_constraints: [\"${{ hunspell_min }}\"]}\n    tests:\n      - package_contents: {strict: true, files: [\"${{ share_stem }}/en?GB.{dic,aff}\"]}\n      - requirements: { run: [hunspell, pytest] }\n        script:\n          env:\n            CF_EN_LOCALES: ${{ gb_locales }}\n          file: test_hunspell.py\n    about:\n      summary: \"${{ summary }}: ${{ en_gb }}\"\n\n  - package:\n      name: aoo-mozilla-en-dict-gb-oxendict\n    build:\n      noarch: generic\n      script: cd \"${{ en_gb_oxendict }}\" && ${{ cp_all }}\n    requirements: {run_constraints: [\"${{ hunspell_min }}\"]}\n    tests:\n      - package_contents: {strict: true, files: [\"${{ share_stem }}/en_GB-oxendict.{dic,aff}\"]}\n      - requirements: { run: [hunspell, pytest] }\n        script: { file: test_hunspell.py }\n    about:\n      summary: \"${{ summary }}: ${{ en_gb_oxendict }}\"\n\n  - package:\n      name: aoo-mozilla-en-dict-us\n    build:\n      noarch: generic\n      script: cd \"${{ en_us }}\" && ${{ cp_all }}\n    requirements: {run_constraints: [\"${{ hunspell_min }}\"]}\n    tests:\n      - package_contents: {strict: true, files: [\"${{ share_stem }}/en_US.{dic,aff}\"]}\n      - requirements: { run: [hunspell, pytest] }\n        script: { file: test_hunspell.py }\n    about:\n      summary: \"${{ summary }}: ${{ en_us }}\"\n\n  - package:\n      name: aoo-mozilla-en-dict-za\n    build:\n      noarch: generic\n      script: cd \"${{ en_za }}\" && ${{ cp_all }}\n    requirements: {run_constraints: [\"${{ hunspell_min }}\"]}\n    tests:\n      - package_contents: {strict: true, files: [\"${{ share_stem }}/en_ZA.{dic,aff}\"]}\n      - requirements: { run: [hunspell, pytest] }\n        script: { file: test_hunspell.py }\n    about:\n      summary: \"${{ summary }}: ${{ en_za }}\"\n\nabout:\n  homepage: https://marcoagpinto.com/#dictionaries_project\n  repository: https://github.com/marcoagpinto/aoo-mozilla-en-dict\n  summary: ${{ summary }}\n  license: LGPL-3.0-or-later\n  license_file: LICENSE\n\nextra:\n  feedstock-name: hunspell-en\n  recipe-maintainers:\n    - scopatz\n    - bollwyvl\n",
