  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.14.0\"\n\npackage:\n  name: light-curve-python\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/l/light-curve/light_curve-${{ version }}.tar.gz\n  sha256: cb2103b4a873ae798a8ed9408bd7e9ce45340c36598c3b169545d5ca701aff26\n\nbuild:\n  number: 2\n  skip:\n    - is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n  script:\n    env:\n      # Package cargo flags\n      MATURIN_PEP517_ARGS: --locked --no-default-features --features=${{ \"abi3,\" if is_abi3 else \"\" }}${{ \"ceres-system\" if win else \"ceres-system,gsl\" }}\n    content:\n      - if: win\n        then:\n          # eigen3 discovery, a transitive dependency of ceres-solver\n          - set \"INCLUDE=%LIBRARY_INC%;%LIBRARY_INC%\\eigen3;%INCLUDE%\"\n          # ceres-solver-sys on Windows reads these env vars (no vcpkg in conda builds)\n          - set \"CERES_INCLUDE_DIR=%LIBRARY_INC%\"\n          - set \"EIGEN3_INCLUDE_DIR=%LIBRARY_INC%\\eigen3\"\n          - set \"CERES_LIB_DIR=%LIBRARY_LIB%\"\n        else:\n          # eigen3 discovery, a transitive dependency of ceres-solver\n          - export CPLUS_INCLUDE_PATH=\"${PREFIX}/include:${PREFIX}/include/eigen3\"\n      - if: osx and arm64\n        then:\n          # gsl discovery\n          - export LIBRARY_PATH=\"${PREFIX}/lib\"\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n      - python -m pip install .[full] -vv --no-deps --ignore-installed\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }}\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - crossenv\n        - maturin >=1,<2\n    - cmake\n    - pkgconf\n    - cargo-bundle-licenses\n  host:\n    - python\n    - pip\n    - maturin >=1,<2\n    - ceres-solver >=2.2,<2.3\n    - if: not win\n      then: gsl >=2.1,<3.0\n    - if: linux\n      then: libblas\n    - if: is_abi3\n      then:\n        - python-abi3\n        - python ${{ python_min }}.*\n  run:\n    - python\n    - numpy <3\n    - iminuit >=2.21,<3\n    - scipy >=1,<2\n\ntests:\n  - python:\n      imports:\n        - light_curve\n      pip_check: true\n      python_version:\n        - \"*\"\n        - if: is_abi3\n          then:\n            - ${{ python_min }}.*\n  - if: is_abi3\n    then:\n      - requirements:\n          run:\n            - abi3audit\n            - python ${{ python_min }}.*\n        script:\n          - abi3audit -s -v --assume-minimum-abi3 ${{ python_min }} ${{ \"$SP_DIR/light_curve/light_curve.abi3.so\" if unix else \"%SP_DIR%\\\\light_curve\\\\light_curve.pyd\" }}\n\nabout:\n  summary: Feature extractor from noisy time series\n  license: GPL-3.0-or-later\n  license_file:\n    - THIRDPARTY.yml\n    - LICENSE\n  homepage: https://github.com/light-curve/light-curve-python\n\nextra:\n  recipe-maintainers:\n    - anlava\n    - hombit\n",
