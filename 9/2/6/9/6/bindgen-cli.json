  "raw_meta_yaml": "context:\n  version: \"0.73.2\"\n\npackage:\n  name: bindgen-cli\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/rust-lang/rust-bindgen/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 5fc3277dd334e4bbbd7bdb8cad5d4fb87a667b2e95a2bae350a8d5424c280629\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      # Without the default `runtime` feature, clang-sys links libclang at\n      # build time instead of searching for it with dlopen when bindgen runs.\n      # The binary then finds libclang through its rpath / Library/bin and\n      # users do not have to set LIBCLANG_PATH.\n      - if: unix\n        then:\n          - export LIBCLANG_PATH=$PREFIX/lib\n          - cd bindgen-cli\n          - cargo-bundle-licenses --format yaml --output ../THIRDPARTY.yml\n          - cargo auditable install --locked --no-track --no-default-features --features logging --root ${{ PREFIX }} --path .\n        else:\n          - set LIBCLANG_PATH=%LIBRARY_BIN%\n          - cd bindgen-cli\n          - cargo-bundle-licenses --format yaml --output ..\\THIRDPARTY.yml\n          - cargo auditable install --locked --no-track --no-default-features --features logging --root %LIBRARY_PREFIX% --path .\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n  host:\n    - libclang\n\ntests:\n  - script:\n      - bindgen --version\n  # Generate bindings for a small header to check that libclang is found.\n  - script:\n      - if: unix\n        then:\n          - echo \"int add(int a, int b);\" > test.h\n          - bindgen test.h | grep \"pub fn add\"\n        else:\n          - echo int add(int a, int b); > test.h\n          - bindgen test.h | findstr \"pub fn add\"\n  - package_contents:\n      bin:\n        - bindgen\n      strict: true\n\nabout:\n  homepage: https://rust-lang.github.io/rust-bindgen/\n  summary: Command line tool that generates Rust FFI bindings to C and C++ libraries\n  description: |\n    bindgen automatically generates Rust FFI bindings to C (and some C++)\n    libraries. This package provides the `bindgen` command line tool; the\n    library of the same name is available on crates.io.\n  license: BSD-3-Clause\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  documentation: https://rust-lang.github.io/rust-bindgen/command-line-usage.html\n  repository: https://github.com/rust-lang/rust-bindgen\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
