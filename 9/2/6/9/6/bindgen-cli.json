  "linux_64_meta_yaml": {
    "about": {
      "description": "bindgen automatically generates Rust FFI bindings to C (and some C++)\nlibraries. This package provides the `bindgen` command line tool; the\nlibrary of the same name is available on crates.io.",
      "dev_url": "https://github.com/rust-lang/rust-bindgen",
      "doc_url": "https://rust-lang.github.io/rust-bindgen/command-line-usage.html",
      "home": "https://rust-lang.github.io/rust-bindgen/",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE",
      "summary": "Command line tool that generates Rust FFI bindings to C and C++ libraries"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "export LIBCLANG_PATH=$PREFIX/lib",
          "cd bindgen-cli",
          "cargo-bundle-licenses --format yaml --output ../THIRDPARTY.yml",
          "cargo auditable install --locked --no-track --no-default-features --features logging --root ${{ PREFIX }} --path ."
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "bindgen-cli",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "c_stdlib_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses"
          ],
          "host": [
            "libclang"
          ],
          "run": []
        },
        "tests": [
          {
            "script": "bindgen --version"
          },
          {
            "script": [
              "echo \"int add(int a, int b);\" > test.h",
              "bindgen test.h | grep \"pub fn add\""
            ]
          },
          {
            "package_contents": {
              "bin": [
                "bindgen"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.73.2"
      },
