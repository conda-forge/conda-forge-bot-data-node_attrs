  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: glaze\n  version: 9.1.0\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version | replace('-','.') }}\n\nsource:\n  url: https://github.com/stephenberry/${{ name }}/archive/v${{ version }}.tar.gz\n  sha256: 55f8a675397c505f9bee6c160e1c26b0085868f185d04d7a7727531fdbff4bd4\n\nbuild:\n  number: 0\n\nrequirements:\n  build:\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib(\"c\") }}\n    - cmake\n    - ninja\n\ntests:\n  - package_contents:\n      include:\n        - glaze/glaze.hpp\n  - script:\n      - if: unix\n        then:\n          - $CXX -std=c++23 -I${PREFIX}/include src/main.cpp -o main\n          - ./main\n      - if: win\n        then:\n          - \"%CXX% /std:c++latest /EHsc /I%LIBRARY_INC% src/main.cpp /Fe:main.exe\"\n          - if %errorlevel% neq 0 exit /b %errorlevel%\n          - main.exe\n    files:\n      source:\n        - src/main.cpp\n    requirements:\n      run:\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib(\"c\") }}\n\nabout:\n  homepage: https://github.com/stephenberry/glaze\n  license: MIT\n  license_file: LICENSE\n  summary: Extremely fast, in memory, JSON and reflection library for modern C++\n  description: |\n    One of the fastest JSON libraries in the world. Glaze reads and writes from object memory,\n    simplifying interfaces and offering incredible performance.\n\n    - Pure, compile time reflection for structs (with optional C++26 P2996 backend)\n    - JSON RFC 8259 compliance with UTF-8 validation\n    - Standard C++ library support\n    - Header only\n    - Direct to memory serialization/deserialization\n    - Compile time maps with constant time lookups and perfect hashing\n    - No exceptions (compiles with -fno-exceptions)\n    - No runtime type information necessary (compiles with -fno-rtti)\n    - MessagePack serialization with binary ext + partial read/write support\n  repository: https://github.com/stephenberry/glaze\n\nextra:\n  recipe-maintainers:\n    - nodtem66\n",
