    "about": {
      "description": "Simple library to make working with STL files (and 3D objects in general) fast and easy.\n\nDue to all operations heavily relying on numpy this is one of the fastest STL editing libraries for Python available.\n",
      "dev_url": "https://github.com/WoLpH/numpy-stl",
      "doc_url": "https://numpy-stl.readthedocs.io",
      "home": "https://github.com/WoLpH/numpy-stl",
      "license": "BSD-3-Clause",
      "license_family": "BSD",
      "license_file": "LICENSE",
      "summary": "Library to make reading, writing and modifying both binary and ascii STL files easy."
    },
    "build": {
      "entry_points": [
        "stl = stl.main:main",
        "stl2ascii = stl.main:to_ascii",
        "stl2bin = stl.main:to_binary"
      ],
      "noarch": "python",
      "number": "0",
      "script": "PYTHON -m pip install . --no-deps --no-build-isolation -vv"
    },
    "extra": {
      "recipe-maintainers": [
        "csachs",
        "WoLpH",
        "gouarin"
      ]
    },
    "package": {
      "name": "numpy-stl",
      "version": "4.1.0"
    },
    "requirements": {
      "host": [
        "pip",
        "python 3.11",
        "uv-build >=0.11,<0.12"
      ],
      "run": [
        "python >=3.11",
        "numpy >=1.24",
        "python-utils >=3.4.5",
        "typing_extensions >=4.1"
      ]
