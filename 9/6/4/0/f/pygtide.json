  "raw_meta_yaml": "context:\n  version: \"0.9.3\"\n\npackage:\n  name: pygtide\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/pygtide/pygtide-${{ version }}.tar.gz\n  sha256: cd22ce6a7055c189ea02eedd205e102aad34db44fa912047057305333f456e5d\n\nbuild:\n  skip: match(python, \"<3.10\")\n  number: 0\n  script:\n    - if: win\n      then:\n        - set \"AR=llvm-ar\"\n        - set \"LIB=%PREFIX%\\Library\\lib;%BUILD_PREFIX%\\Library\\lib;%LIB%\"\n        - \"%PYTHON% -m pip install . -vv --no-build-isolation --no-deps\"\n      else:\n        - unset MESON_BUILD_ROOT\n        - unset MESON_SOURCE_ROOT\n        - unset NINJA_STATUS\n        - unset NINJA_LOG_PATH\n        - unset MESONINTROSPECT\n        - \"$PYTHON -m pip install . -vv --no-build-isolation --no-deps\"\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('fortran') }}\n    - ${{ stdlib('c') }}\n    - if: win\n      then:\n        - llvm-tools\n\n  host:\n    - python\n    - pip\n    - setuptools >=61\n    - wheel\n    - meson >=1.1.0\n    - ninja\n    - numpy >=1.21\n    - if: win\n      then:\n        - libpgmath\n\n  run:\n    - python\n    - numpy >=1.21\n    - pandas\n\ntests:\n  - python:\n      imports:\n        - pygtide\n      pip_check: true\n\nabout:\n  homepage: https://github.com/hydrogeoscience/pygtide\n  summary: A Python module and wrapper for ETERNA PREDICT to compute gravitational tides on Earth\n  documentation: https://hydrogeo.science\n  license: MPL-2.0\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - craigmillernz\n    - hydrogeoscience\n",
