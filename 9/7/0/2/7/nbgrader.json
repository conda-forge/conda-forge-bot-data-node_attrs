  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.9.6\"\n  python_check_max: \"3.14\"\n  # upstream claims `4.2`, but this fails `jupyter labextension list`\n  jupyterlab_min: \"4.5\"\n  jupyterlab_max: \"5.0\"\n\npackage:\n  name: nbgrader\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/n/nbgrader/nbgrader-${{ version }}.tar.gz\n  sha256: d01c3a1033c0ef1535936fc53b8e152b46e1e06c02422dca5ef7d5ae62076d4f\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check --check-build-dependencies\n  python:\n    entry_points:\n      - nbgrader = nbgrader.apps.nbgraderapp:main\n\nrequirements:\n  host:\n    - hatch-jupyter-builder >=0.7\n    - hatchling >=1.10.0\n    - jupyter-builder >=1.2.3\n    - pip\n    - python ${{ python_min }}.*\n  run:\n    - alembic >=1.7\n    - ipython >=8.10.0\n    - ipywidgets >=7.6\n    - jinja2 >=3\n    - jsonschema >=3\n    - jupyter_client <9\n    - jupyter_server >=2\n    - jupyterlab >=${{ jupyterlab_min }},<${{ jupyterlab_max }}\n    - jupyterlab_server\n    - nbclient >=0.6.1\n    - nbconvert >=6\n    - notebook >=7.2.0,<8\n    - python >=${{ python_min }}\n    - python-dateutil >=2.8\n    - pyyaml >=6.0\n    - rapidfuzz >=1.8\n    - requests >=2.26\n    - setuptools\n    - sqlalchemy >=1.4,<3\n\ntests:\n  - package_contents:\n      strict: true\n      files:\n        - etc/jupyter/jupyter_server_config.d/nbgrader.json\n        - share/jupyter/labextensions/@jupyter/nbgrader/**\n      site_packages:\n        - nbgrader/**\n        - nbgrader-${{ version }}.dist-info/**\n  - python:\n      imports: nbgrader\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - ${{ python_check_max }}.*\n  - requirements:\n      run:\n        - jupyterlab ${{ jupyterlab_min }}.*\n        - if: win\n          then: m2-grep\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - nbgrader -h\n      - jupyter lab --version\n      - jupyter labextension list\n      - jupyter server extension list\n      - jupyter labextension list 1>labextensions 2>&1\n      - jupyter server extension list 1>server_extensions 2>&1\n      - grep -iE \"nbgrader.server_extensions.${{ ext }}.*OK\" server_extensions\n      - grep -iE \"nbgrader.server_extensions.${{ ext }}.*enabled\" server_extensions\n      - grep -iE \"@jupyter/nbgrader.*OK\" labextensions\n\nabout:\n  license: BSD-3-Clause\n  license_file:\n    - LICENSE\n    - nbgrader/labextension/static/third-party-licenses.json\n  summary: A system for assigning and grading Jupyter notebooks\n  homepage: https://pypi.org/project/nbgrader\n  repository: https://github.com/jupyter/nbgrader\n  documentation: https://nbgrader.readthedocs.io\n\nextra:\n  recipe-maintainers:\n    - blink1073\n    - jhamrick\n    - lgpage\n    - ocefpaf\n    - BertR\n    - SylvainCorlay\n    - bollwyvl\n",
