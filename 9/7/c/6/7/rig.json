  "linux_64_meta_yaml": {
    "about": {
      "description": "rig is a CLI to install, remove, configure, and switch between multiple\nversions of R. It works on macOS, Windows and Linux, supports symbolic\nversion names (e.g. `release`, `devel`, `oldrel`), lets you run multiple\nR versions in parallel via quick links, and integrates with the\nRStudio and Positron IDEs.",
      "dev_url": "https://github.com/r-lib/rig",
      "home": "https://rig.r-lib.org/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "The R Installation Manager"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "cargo auditable install --path=. --root=($prefix) --no-track --locked --bins",
          "cargo-bundle-licenses --format=yaml --output=THIRDPARTY.yml",
          "mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions",
          "let out_dir = glob target/*/release/build/rig-*/out | first",
          "cp ($out_dir)/rig.bash ($prefix)/share/bash-completion/completions/rig",
          "cp ($out_dir)/rig.fish ($prefix)/share/fish/vendor_completions.d/rig.fish",
          "cp ($out_dir)/_rig     ($prefix)/share/zsh/site-functions/_rig"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        },
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "rig",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "nushell"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "rig --help",
              "rig --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "rig",
                "rig-shim"
              ],
              "files": [
                "share/bash-completion/completions/rig",
                "share/fish/vendor_completions.d/rig.fish",
                "share/zsh/site-functions/_rig"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.10.0"
      }
    ],
    "package": {
      "name": "rig",
