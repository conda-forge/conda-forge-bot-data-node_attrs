  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.3.2\"\n\npackage:\n  name: certbot-dns-desec\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/c/certbot-dns-desec/certbot_dns_desec-${{ version }}.tar.gz\n  sha256: 7dec89001609abbc9fe9bf67b9ccb893c6de9fe061c3530fa176b4cc00ac52bb\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n  run:\n    - python >=${{ python_min }}\n    - certbot\n    - dnspython\n    - requests\n    - setuptools\n\ntests:\n  - python:\n      imports:\n        - certbot_dns_desec\n        - certbot_dns_desec.dns_desec\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n        - pytest\n        - mock\n        - requests-mock\n    script:\n      - pytest --pyargs certbot_dns_desec -v\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      # check that certbot discovers the plugin through its entry point\n      - if: unix\n        then: certbot plugins --config-dir cfg --work-dir work --logs-dir logs | grep dns-desec\n        else: certbot plugins --config-dir cfg --work-dir work --logs-dir logs | findstr dns-desec\n\nabout:\n  homepage: https://github.com/desec-io/certbot-dns-desec\n  summary: deSEC DNS Authenticator plugin for Certbot\n  description: |\n    This certbot plugin automates the DNS-01 challenge of the ACME protocol\n    for domains managed by the deSEC DNS hosting service. It creates and\n    removes the required TXT records through the deSEC API. This lets you\n    obtain certificates from Let's Encrypt, including wildcard certificates.\n  license: Apache-2.0\n  license_file: LICENSE.txt\n  repository: https://github.com/desec-io/certbot-dns-desec\n\nextra:\n  recipe-maintainers:\n    - Hoeze\n",
