  "linux_64_meta_yaml": {
    "about": {
      "description": "MBIRTorch performs Model-Based Iterative Reconstruction (MBIR) for\ntomographic reconstruction using PyTorch.\n\nFeatures include:\n\n* Multiple geometries: parallel beam, cone beam (including curved\n  detector and helical), translation mode, and multi-axis parallel.\n* 4D reconstruction: a time sequence of volumes from a single\n  continuous scan, using multi-agent consensus equilibrium (MACE).\n* Preprocessing routines for NSI and Zeiss scanners, plus geometry\n  calibration.\n* Utilities for metal artifact reduction and stripe removal.\n* Interactive slice and geometry viewers.\n* Demos and documentation.\n* Operation on one or more GPUs, Mac MPS, or CPU.\n* Compiled torch and Triton kernels for efficiency.",
      "dev_url": "https://github.com/cabouman/mbirtorch",
      "doc_url": "https://mbirtorch.readthedocs.io/",
      "home": "https://github.com/cabouman/mbirtorch",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE",
      "summary": "High-performance tomographic reconstruction using PyTorch"
    },
    "build": {
      "noarch": "python",
      "number": "1",
      "python": {
        "entry_points": [
          "mbirtorch-hsnt = mbirtorch.hsnt.cli:main"
        ]
      },
      "script": "python -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "cabouman",
        "gbuzzard"
      ]
    },
