  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: spherogram\n  version: \"2.4.1\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name }}-${{ version }}.tar.gz\n  sha256: 9351a77308fee452421b914ae55f3cdaff805692b834777aa6a034a9a85bf970\n\nbuild:\n  number: 0\n  script:\n    # Remove pre-generated Cython output so it is regenerated with conda-forge's Cython\n    - if: win\n      then: del /f planarity_src\\planarity.c planarmap_src\\planarmap.c\n      else: rm -f planarity_src/planarity.c planarmap_src/planarmap.c\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n  host:\n    - python\n    - pip\n    - setuptools\n    - wheel\n    - cython\n  run:\n    - python\n    - decorator\n    - networkx\n    - packaging\n    - snappy-manifolds >=1.4\n    - knot-floer-homology >=1.2.2\n\ntests:\n  - python:\n      imports:\n        - spherogram\n        - spherogram.planarity\n        - spherogram.planarmap\n        - spherogram.links\n      pip_check: true\n  - script:\n      - python -m spherogram.test\n\nabout:\n  homepage: https://github.com/3-manifolds/Spherogram\n  repository: https://github.com/3-manifolds/Spherogram\n  documentation: https://snappy.computop.org/spherogram.html\n  summary: Spherical diagrams for 3-manifold topology\n  description: |\n    Spherogram is a Python module for dealing with diagrams drawn on the\n    2-sphere: links, planar graphs, and related objects. It is used by\n    SnapPy, and includes a vendored copy of the Edge Addition Planarity\n    Suite and Gilles Schaeffer's PlanarMap random map generator.\n  # Spherogram is GPL-2.0-or-later; the vendored Edge Addition Planarity Suite is BSD-3-Clause.\n  license: GPL-2.0-or-later AND BSD-3-Clause\n  license_file:\n    - LICENSE-GPL-2.0.txt\n    - LICENSE-planarity.txt\n\nextra:\n  recipe-maintainers:\n    - soapy1\n",
