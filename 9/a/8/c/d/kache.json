  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.2.2\"\n\npackage:\n  name: kache\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/kunobi-ninja/kache/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 86204a35abc665eaf2c59cb764a3fbab6ce6762a4c450e209dcbfdadc80b4ef2\n\nbuild:\n  number: 1\n  dynamic_linking:\n    # Relocation would turn the absolute rpath added below into @loader_path.\n    binary_relocation: ${{ not osx }}\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n      # Bypass libsqlite3-sys's bundled SQLite and link against conda-forge's SQLite.\n      LIBSQLITE3_SYS_USE_PKG_CONFIG: \"1\"\n    interpreter: brush\n    content:\n      # kache's build.rs links its build-script launcher with the link-args from\n      # the rustflags and embeds the signed binary in kache. An absolute $PREFIX\n      # rpath would end up inside it, and prefix replacement at install time\n      # would invalidate its signature, so macOS kills every cached build script.\n      - if: osx\n        then: export CARGO_BUILD_RUSTFLAGS=\"${CARGO_BUILD_RUSTFLAGS//\"$PREFIX/lib\"/@loader_path/../lib}\"\n      - cargo auditable install --locked --no-track --bins --root \"${LIBRARY_PREFIX:-$PREFIX}\" --path .\n      # kache hardlinks itself into each target directory to run cached build\n      # scripts, where @loader_path/../lib doesn't reach libsqlite3. Give the\n      # outer binary an absolute rpath too; prefix replacement keeps it valid.\n      - if: osx\n        then:\n          - $INSTALL_NAME_TOOL -add_rpath \"$PREFIX/lib\" \"$PREFIX/bin/kache\"\n          - codesign --force --sign - \"$PREFIX/bin/kache\"\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ compiler('rust') }}\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - brush\n    - pkg-config\n  host:\n    - sqlite\n\ntests:\n  - package_contents:\n      bin:\n        - kache\n  - script:\n      - kache --help\n  # kache runs a hardlinked copy of itself from each target directory.\n  - if: osx\n    then:\n      script:\n        - mkdir relocated\n        - cp \"$PREFIX/bin/kache\" relocated/kache\n        - relocated/kache --version\n\nabout:\n  homepage: https://kunobi.ninja/docs/kache\n  repository: https://github.com/kunobi-ninja/kache\n  summary: Zero-copy, content-addressed build cache for Rust and C/C++.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - baszalmstra\n    - haecker-felix\n",
