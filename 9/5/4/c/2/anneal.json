  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: anneal\n  version: \"0.11.1\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  - url: https://pypi.org/packages/source/a/anneal/anneal-${{ version }}.tar.gz\n    sha256: d3b34913c23cb6c68e1376096063fc705328360ba5ebaef698e0d6919e671bab\n  # 0.11.1's sdist declares path deps on the patched nng crates but does not\n  # ship them. Take those trees from the matching tag. nng path-depends on\n  # ../nng-sys, so both directories are required before cargo metadata runs.\n  - url: https://github.com/HaoZeke/anneal/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 9fbd4440d1eecdb8c225aa0e97e93d72d172d6f79a49735eaf243059157b5ebd\n    target_directory: _upstream\n    filter:\n      - vendor/nng/**\n      - vendor/nng-sys/**\n\nbuild:\n  number: 0\n  script:\n    - ${{ PYTHON }} -c \"import shutil; from pathlib import Path; src=Path('_upstream/vendor'); dst=Path('vendor'); dst.mkdir(exist_ok=True); shutil.copytree(src/'nng', dst/'nng', dirs_exist_ok=True); shutil.copytree(src/'nng-sys', dst/'nng-sys', dirs_exist_ok=True)\"\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - ${{ stdlib('c') }}\n    - cargo-bundle-licenses\n  host:\n    - python\n    - pip\n    - maturin\n    - array-api-compat\n    - numpy\n  run:\n    - python\n    - numpy\n    - array-api-compat\n\ntests:\n  - python:\n      imports:\n        - anneal\n      pip_check: true\n\nabout:\n  homepage: https://github.com/HaoZeke/anneal\n  summary: Simulated annealing and quenching for Python\n  license: MIT\n  license_file:\n    - LICENSE.txt\n    - THIRDPARTY.yml\n  repository: https://github.com/HaoZeke/anneal\n\nextra:\n  recipe-maintainers:\n    - HaoZeke\n",
