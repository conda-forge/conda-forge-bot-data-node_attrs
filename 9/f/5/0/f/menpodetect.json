  "raw_meta_yaml": "{% set name = \"menpodetect\" %}\n{% set version = \"0.7.1\" %}\n# conda-forge builds Python 3.11-3.14, and menpo (>=0.12) needs 3.11; the noarch test\n# environment is solved at python_min\n{% set python_min = \"3.11\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/{{ name[0] }}/{{ name }}/{{ name }}-{{ version }}.tar.gz\n  sha256: 5fe2f30e0a79821611b4d5d614c7b72bbe743ee322afda76469cb8a521559bd9\n\nbuild:\n  number: 0\n  noarch: python\n  script: {{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python {{ python_min }}.*\n    - pip\n    - setuptools >=77\n    - setuptools-scm >=8\n  run:\n    - python >={{ python_min }}\n    - menpo >=0.12\n    - dlib\n    # the conda-forge opencv package is built with opencv_contrib, which the Haar cascade\n    # detectors need from OpenCV 5 on (cv2.CascadeClassifier)\n    - opencv >=4.5\n\ntest:\n  imports:\n    - menpodetect\n    - menpodetect.dlib\n    - menpodetect.opencv\n  requires:\n    - python {{ python_min }}.*\n    - pip\n    - pytest >=8\n    - pytest-mock\n    - libopencv *=headless*  # [linux]\n  commands:\n    - pip check\n    # runs the real dlib and OpenCV detectors on the bundled takeo image\n    - pytest --pyargs menpodetect -v\n\nabout:\n  home: https://github.com/menpo/menpodetect\n  dev_url: https://github.com/menpo/menpodetect\n  doc_url: https://menpodetect.readthedocs.io/en/stable/\n  license: BSD-3-Clause\n  license_family: BSD\n  license_file: LICENSE.txt\n  summary: The Menpo Project Python package for detecting faces\n  description: |\n    MenpoDetect is a Menpo Project package for detecting faces in images.\n\nextra:\n  recipe-maintainers:\n    - patricksnape\n",
