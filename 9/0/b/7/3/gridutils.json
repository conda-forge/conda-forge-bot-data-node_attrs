  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.0\"\n\npackage:\n  name: gridutils\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/sakov/gridutils-c/archive/v${{ version }}.tar.gz\n  sha256: 358e93d2e3431d9e2d4c0574d25d97dd26585204e1e8407e817429f40ebf406e\n  patches:\n    # Upstream links libgu.so without $(LDFLAGS) or -lm, leaving it with\n    # undefined libm symbols (acos, hypot, sqrt) but no NEEDED entry for libm.\n    - patches/link-libgu-so-against-libm.patch\n\nbuild:\n  number: 1005\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - if: unix\n      then: make\n  host:\n    - nn\n    - csa\n  run:\n    - nn\n    - csa\n  run_exports:\n    # libgu.so has no SONAME and upstream makes no ABI guarantees, so pin\n    # consumers to the patch release they were built against.\n    - ${{ pin_subpackage('gridutils', upper_bound='x.x.x') }}\n\ntests:\n  - script:\n      - gridbathy -h\n  - package_contents:\n      bin:\n        - getbound\n        - getnodes\n        - gridbathy\n        - insertgrid\n        - setbathy\n        - subgrid\n        - xy2ij\n      include:\n        - gridmap.h\n        - gridnodes.h\n        - gucommon.h\n        - guquit.h\n      lib:\n        - if: unix\n          then: libgu.a\n          else: gu.lib\n      # Upstream names the shared library libgu.so on all Unix platforms, so\n      # it does not match the lib glob, which expects libgu.dylib on macOS.\n      files:\n        - if: unix\n          then: lib/libgu.so\n\nabout:\n  homepage: https://github.com/sakov/gridutils-c\n  license: LicenseRef-Sakov\n  license_file: gridutils/LICENSE\n  summary: C library functions and command line utilities for working with curvilinear grids.\n\nextra:\n  recipe-maintainers:\n    - ocefpaf\n",
