      "license_file": "LICENSE",
      "summary": "A package for Adaptive Spatio-Temporal Model (AdaSTEM) in python"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "PYTHON -m pip install . -vv --no-deps --no-build-isolation"
