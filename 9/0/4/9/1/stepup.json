    "about": {
      "description": "StepUp is a dynamic build tool and a modern alternative to Make.\nIts defining feature is that workflow generation and execution are unified:\na plan.py script defines the initial build steps.\nWhile the workflow is being executed, any step can add more steps and\ndependencies, based on the outputs built so far.\nThis makes StepUp ideal for builds where the full set of dependencies\ncannot be determined in advance.\n\nStepUp Core provides the basic framework for StepUp,\nwithout any domain-specific features.",
      "dev_url": "https://github.com/reproducible-reporting/stepup-core/",
      "doc_url": "https://reproducible-reporting.github.io/stepup-core/",
      "home": "https://reproducible-reporting.github.io/stepup-core/",
      "license": "LGPL-3.0-or-later",
      "license_family": "LGPL-3.0-or-later",
      "license_file": "LICENSE",
      "summary": "A dynamic Python build tool for reproducible workflows"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "stepup = stepup.core.__main__:main",
          "sb = stepup.core.__main__:sb_main",
          "sc-render-jinja = stepup.core.render_jinja:main"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "tovrstra"
      ]
    },
