  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.2.0\"\n\npackage:\n  name: flower\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/f/flower/flower-${{ version }}.tar.gz\n  sha256: c4f4751942ff8b5069e6604a136e073b860971b7658859bdc61da1dc17a4bb32\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    # Upstream only registers a celery subcommand (`celery flower`); keep the\n    # standalone `flower` command earlier builds of this package shipped.\n    entry_points:\n      - flower = flower.__main__:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n  run:\n    - python >=${{ python_min }}\n    - celery >=5.0.5\n    - humanize\n    - prometheus_client >=0.8.0\n    - pytz\n    - tornado >=6.5.7,<7.0.0\n\ntests:\n  - python:\n      imports:\n        - flower\n        - flower.api\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      - flower --help\n\nabout:\n  homepage: https://github.com/mher/flower\n  repository: https://github.com/mher/flower\n  documentation: https://flower.readthedocs.io\n  summary: Celery Flower\n  description: |\n    Flower is a web based tool for monitoring and administrating Celery\n    clusters.\n  license: BSD-3-Clause\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - kwilcox\n    - thebestnom\n    - killua156\n",
