  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.2.5\"\n\npackage:\n  name: dumb-init\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/Yelp/dumb-init/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 3eda470d8a4a89123f4516d26877a727c0945006c8830b7e3bad717a5f6efc4e\n\nbuild:\n  number: 0\n  # Upstream only supports Linux: it's a PID 1 init for containers and\n  # only Linux wheels are published on PyPI.\n  skip:\n    - not linux\n  script:\n    # Same as upstream's Makefile, minus -static and -Werror.\n    - mkdir -p $PREFIX/bin\n    - $CC $CFLAGS -std=gnu99 -Wall -O3 -o $PREFIX/bin/dumb-init dumb-init.c $LDFLAGS\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n\ntests:\n  - package_contents:\n      bin:\n        - dumb-init\n  - script:\n      - dumb-init --version 2>&1 | grep \"v${{ version }}\"\n      - dumb-init true\n      # The child's exit code must be passed through.\n      - sh -c 'dumb-init sh -c \"exit 3\"; test $? -eq 3'\n\nabout:\n  homepage: https://github.com/Yelp/dumb-init\n  repository: https://github.com/Yelp/dumb-init\n  summary: A minimal init system for Linux containers\n  description: |\n    dumb-init is a simple process supervisor and init system designed to run as\n    PID 1 inside minimal container environments. It forwards signals to its\n    child and reaps zombie processes.\n  license: MIT\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - killua156\n",
