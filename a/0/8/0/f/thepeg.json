  "linux_64_meta_yaml": {
    "about": {
      "description": "ThePEG is a general toolkit for implementing physics models of event generation in high energy\nparticle collisions. It defines a general structure of event generation in terms of abstract base\nclasses like hard partonic matrix elements, parton showers and the decay of unstable particles.",
      "dev_url": "https://repo.hepforge.org/source/thepeghg/",
      "doc_url": "https://thepeg.hepforge.org/doxygen/",
      "home": "https://thepeg.hepforge.org/",
      "license": "GPL-3.0-or-later",
      "license_family": "GPL-3.0-or-later",
      "license_file": "COPYING",
      "summary": "Toolkit for High Energy Physics Event Generation - ThePEG"
    },
    "build": {
      "number": "3",
      "run_exports": {
        "weak": [
          "thepeg"
        ]
      },
      "script": [
        "cp $BUILD_PREFIX/share/gnuconfig/config.* ./Config",
        "./configure --prefix=${PREFIX} --with-fastjet=${PREFIX} --with-gsl=${PREFIX} --with-hepmc=${PREFIX} --with-hepmcversion=3 --with-lhapdf=${PREFIX} --with-rivet=${PREFIX} --with-boost=${PREFIX}",
        "make -j${CPU_COUNT} CXX=$CXX",
        "make check",
        "make install",
        "rm -rf \"${PREFIX}/lib/ThePEG/Makefile\" \"${PREFIX}/lib/ThePEG/Makefile.common\" \"${PREFIX}/share/ThePEG/Doc\"",
        "rm -f \"${PREFIX}/lib/ThePEG/runThePEG-${{ version }}\" \"${PREFIX}/lib/ThePEG/setupThePEG-${{ version }}\""
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "utk4r-sh",
        "GiacomoXT",
        "vvsagar",
        "AlexanderHeidelbach",
        "conda-forge/hepmc3"
      ]
    },
    "outputs": [
      {
        "build": {
          "run_exports": {
            "weak": [
              "thepeg"
            ]
          }
        },
        "name": "thepeg",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "cxx_compiler_stub",
            "gnuconfig",
            "make",
            "time"
          ],
          "host": [
            "fastjet-cxx",
            "fastjet-cxx-devel",
            "gsl",
            "hepmc3",
            "lhapdf",
            "libboost-devel",
            "rivet",
            "zlib"
          ],
          "run": [
            "fastjet-cxx-devel",
            "grep"
          ]
        },
        "tests": [
          {
            "package_contents": {
              "bin": [
                "runThePEG",
                "setupThePEG",
                "thepeg-config"
              ],
              "files": [
                "lib/ThePEG/FastJetFinder.so",
                "lib/ThePEG/RivetAnalysis.so",
                "lib/ThePEG/*.so",
                "lib/ThePEG/*.so.*",
                "lib/ThePEG/ThePEGDefaults-2.3.0.rpo",
                "lib/ThePEG/ThePEGDefaults.rpo",
                "share/*",
                "etc/conda/test-files/thepeg/*"
              ],
              "include": [
                "ThePEG/*/*"
              ],
              "strict": true
            }
          },
          {
            "files": {
              "recipe": [
                "test_rivet.in"
              ]
            },
            "requirements": {
              "run": [
                "sed"
              ]
            },
            "script": [
              "thepeg-config --help",
              "thepeg-config --prefix",
              "thepeg-config --datadir",
              "thepeg-config --libdir",
              "thepeg-config --includedir",
              "thepeg-config --cppflags",
              "thepeg-config --ldflags",
              "thepeg-config --ldlibs",
              "thepeg-config --rivet-include",
              "thepeg-config --fastjet-include",
              "thepeg-config --rivet-libs",
              "thepeg-config --fastjet-libs",
              "runThePEG --version",
              "test -f \"$(thepeg-config --fastjet-include | sed 's/^-I//')/fastjet/ClusterSequence.hh\"",
              "setupThePEG --exitonerror test_rivet.in",
              "runThePEG RivetTest.run",
              "grep \"/MC_XS/\" RivetTest.yoda"
            ]
          }
        ],
        "version": "2.3.0"
      }
    ],
