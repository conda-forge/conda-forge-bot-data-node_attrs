  "raw_meta_yaml": "context:\n  version: \"2.3.0\"\n\npackage:\n  name: thepeg\n  version: ${{ version }}\n\nsource:\n  url: https://thepeg.hepforge.org/downloads/ThePEG-${{ version }}.tar.bz2\n  sha256: ac35979ae89c29608ca92c156a49ff68aace7a5a12a0c92f0a01a833d2d34572\n  patches:\n    - fix-libtool-darwin-allow-undefined-flag-for-macOS-11.patch\n    - fix-C-17-compatibility-of-Config-std.h-with-libc.patch\n    - remove-whitespace-in-literal-operator-declarations.patch\n    - fix-hardcoded-install-paths-for-relocated-prefixes.patch\n    - fix-thepeg-config-exit-status-and-use-grep-E.patch\n    # TODO: Drop after move to a release with Rivet 4 support (patch is a backport)\n    - add-support-for-Rivet-4.patch\n\nbuild:\n  number: 3\n  skip:\n    - win\n  script:\n    # Get an updated config.sub and config.guess\n    # c.f. https://conda-forge.org/docs/how-to/advanced/cross-compilation/#autotools\n    # ThePEG sets AC_CONFIG_AUX_DIR([Config]) in configure.ac, so configure looks for them in Config/\n    - cp $BUILD_PREFIX/share/gnuconfig/config.* ./Config\n    # Rivet is built against HepMC3, and ThePEG passes its HepMC events directly to Rivet,\n    # so ThePEG has to use HepMC3 as well (configure defaults to HepMC2)\n    - ./configure --prefix=${PREFIX} --with-fastjet=${PREFIX} --with-gsl=${PREFIX} --with-hepmc=${PREFIX} --with-hepmcversion=3 --with-lhapdf=${PREFIX} --with-rivet=${PREFIX} --with-boost=${PREFIX}\n    - make -j${CPU_COUNT} CXX=$CXX\n    - make check\n    - make install\n    - rm -rf \"${PREFIX}/lib/ThePEG/Makefile\" \"${PREFIX}/lib/ThePEG/Makefile.common\" \"${PREFIX}/share/ThePEG/Doc\"\n    - rm -f \"${PREFIX}/lib/ThePEG/runThePEG-${{ version }}\" \"${PREFIX}/lib/ThePEG/setupThePEG-${{ version }}\"\n\nrequirements:\n  build:\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"cxx\") }}\n    - gnuconfig\n    - make\n    - time\n  host:\n    - fastjet-cxx  # pick up global pinning\n    - fastjet-cxx-devel\n    - gsl\n    - hepmc3\n    - lhapdf\n    - libboost-devel\n    - rivet\n    - zlib\n  run:\n    # thepeg-config --fastjet-include/--fastjet-libs point at FastJet headers and link libraries\n    - fastjet-cxx-devel\n    # thepeg-config parses its options with grep\n    - grep\n  run_exports:\n    - ${{ pin_subpackage(\"thepeg\", upper_bound=\"x.x\") }}\n\ntests:\n  - package_contents:\n      bin:\n        - runThePEG\n        - setupThePEG\n        - thepeg-config\n      include:\n        - ThePEG/*/*\n      # Use files over lib as lib globs get the platform shared library extension\n      # appended, but the libtool '-module' plugins are named .so on macOS as well\n      files:\n        # Guard against FastJet support being silently disabled at configure time\n        - lib/ThePEG/FastJetFinder.so\n        # Guard against Rivet support being silently disabled at configure time\n        - lib/ThePEG/RivetAnalysis.so\n        - lib/ThePEG/*.so\n        - if: linux\n          then: lib/ThePEG/*.so.*\n        - if: osx\n          then: lib/ThePEG/*.dylib\n        - lib/ThePEG/ThePEGDefaults-${{ version }}.rpo\n        - lib/ThePEG/ThePEGDefaults.rpo\n        - share/*\n        - etc/conda/test-files/thepeg/*\n      strict: true\n\n  - script:\n      - thepeg-config --help\n      - thepeg-config --prefix\n      - thepeg-config --datadir\n      - thepeg-config --libdir\n      - thepeg-config --includedir\n      - thepeg-config --cppflags\n      - thepeg-config --ldflags\n      - thepeg-config --ldlibs\n      - thepeg-config --rivet-include\n      - thepeg-config --fastjet-include\n      - thepeg-config --rivet-libs\n      - thepeg-config --fastjet-libs\n\n      - runThePEG --version\n      - test -f \"$(thepeg-config --fastjet-include | sed 's/^-I//')/fastjet/ClusterSequence.hh\"\n      # Load RivetAnalysis.so and run a Rivet analysis in-process end to end\n      - setupThePEG --exitonerror test_rivet.in\n      - runThePEG RivetTest.run\n      - grep \"/MC_XS/\" RivetTest.yoda\n    requirements:\n      run:\n        - sed\n    files:\n      recipe:\n        - test_rivet.in\n\nabout:\n  homepage: https://thepeg.hepforge.org/\n  summary: 'Toolkit for High Energy Physics Event Generation - ThePEG'\n  description: |\n    ThePEG is a general toolkit for implementing physics models of event generation in high energy\n    particle collisions. It defines a general structure of event generation in terms of abstract base\n    classes like hard partonic matrix elements, parton showers and the decay of unstable particles.\n  license: GPL-3.0-or-later\n  license_file: COPYING\n  documentation: https://thepeg.hepforge.org/doxygen/\n  repository: https://repo.hepforge.org/source/thepeghg/\n\nextra:\n  recipe-maintainers:\n    - utk4r-sh\n    - GiacomoXT\n    - vvsagar\n    - AlexanderHeidelbach\n    - conda-forge/hepmc3\n",
