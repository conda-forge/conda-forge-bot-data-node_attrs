  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.26.0\"\n\npackage:\n  name: cartopy_offlinedata\n  version: ${{ version }}\n\nsource:\n  # used for the download tool\n  url: https://pypi.org/packages/source/c/cartopy/cartopy-${{ version }}.tar.gz\n  sha256: b87a35835f30333760cc46194bd90b6a4958d12f488f50131d4c4c0962ad9c3c\n\nbuild:\n  number: 0\n  noarch: python\n  script: build.sh\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - cartopy ${{ version }}.*\n  run:\n    - python >=${{ python_min }}\n    - cartopy >=${{ version }}\n\n\ntests:\n  - python:\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n    script:\n      # pick a few random things to check for\n      - test -f $PREFIX/share/cartopy/shapefiles/natural_earth/physical/ne_10m_antarctic_ice_shelves_polys.shp\n      - test -f $PREFIX/share/cartopy/shapefiles/natural_earth/physical/ne_10m_coastline.shp\n      - test -f $PREFIX/share/cartopy/shapefiles/natural_earth/cultural/ne_50m_urban_areas.shp\n\nabout:\n  homepage: https://scitools.org.uk/cartopy\n  summary: Offline data for using cartopy without an internet connection\n  license: GPL-3.0-only\n  license_file:\n    - licenses/LICENSE_NACISCDN_NaturalEarth\n    - licenses/LICENSE_NOAA_NGDC_GSHHS\n  repository: https://github.com/SciTools/cartopy\n  documentation: https://scitools.org.uk/cartopy/docs/latest/\n\nextra:\n  recipe-maintainers:\n    - ocefpaf\n    - willirath\n    - xylar\n",
