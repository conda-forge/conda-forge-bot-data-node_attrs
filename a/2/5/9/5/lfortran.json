          ],
          "run": [
            "clang 21.1.7.*"
          ]
        },
        "tests": [
          {
            "requirements": {
              "run": [
                "jupyter"
              ]
            },
            "script": [
              "test -f ${PREFIX}/bin/lfortran",
              "lfortran --help",
              "lfortran --version",
              "echo \"print *, 'Hello'; end\" > hello.f90 && lfortran hello.f90 && ./hello.out",
              "jupyter kernelspec list --json",
              "jupyter kernelspec remove -f fortran"
            ]
          }
        ],
        "version": "0.66.0"
      }
