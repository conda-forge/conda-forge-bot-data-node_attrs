        "certik",
        "Shaikh-Ubaid"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "lfortran",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "cxx_compiler_stub",
            "c_stdlib_stub",
            "cmake 3.29.6.*",
            "make 4.4.1.*",
            "nodejs",
            "python >=3.10"
          ],
          "host": [
            "xeus 6.0.1.*",
            "xeus-zmq 4.0.0.*",
            "llvmdev 21.1.7.*",
            "libunwind 1.7.2.*",
            "nlohmann_json 3.12.0.*",
            "zlib",
