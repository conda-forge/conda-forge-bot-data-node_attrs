  "raw_meta_yaml": "# This is revision 3095. (git rev-list HEAD | wc -l)\nschema_version: 1\n\ncontext:\n  so_number: 164\n  epoch: 1\n  revision: 3095\n  version: ${{ epoch }}!${{ so_number }}.${{ revision }}\n  commit: baee400fa9ced6f5481a728138fed6e867b0ff7f\n\npackage:\n  name: x264\n  version: ${{ version }}\n\nsource:\n  # need to use the git source to make version.sh in source work\n  - url: https://code.videolan.org/videolan/x264/-/archive/${{ commit }}/x264-${{ commit }}.tar.gz\n    sha256: 436a2be54d8bc0cb05dd33ecbbcb7df9c3b57362714fcdaa3a5991189a33319b\n    patches:\n      # ppc: Fix incompatible pointer type errors (upstream de1bea53), needed\n      # for GCC >=14 which promotes -Wincompatible-pointer-types to an error\n      - patches/0001-ppc-Fix-incompatible-pointer-type-errors.patch\n      # The Windows ARM64 recipe supplies clang-cpp, while the default cpp\n      # executable is absent.\n      - if: target_platform == \"win-arm64\"\n        then: 0001-use-clang-preprocessor-for-armasm.patch\n  # 2022/07 hmaarrfk\n  # x264 attempts to detect the version from the git information.\n  # however, installing (and using) git on windows is tricky\n  # with m2- tools installed in parallel.\n  # Since the version file is easy to recreate, we use\n  # a thin stub of a file, along with exporting a few variables\n  # from this recipe as environment variables in the build process\n  # to recreate it\n  - path: version.sh\n\nbuild:\n  number: 3\n  script:\n    env:\n      X264_REV: ${{ revision }}\n      X264_VERSION: r${{ revision }} ${{ commit[:7] }}\n      X264_POINTVER: 0.${{ so_number }}.${{ revision }} ${{ commit[:7] }}\n\nrequirements:\n  build:\n    - if: unix\n      then: gnuconfig\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    # The Windows ARM64 build needs clang-cpp (from clang) for assembly\n    # preprocessing, and m2-unix tools since perl/make are not available for\n    # win-arm64.\n    - if: target_platform == \"win-arm64\"\n      then: clang\n    - if: target_platform != \"win-arm64\"\n      then: perl\n    - if: target_platform != \"win-arm64\"\n      then: nasm\n    - if: target_platform != \"win-arm64\"\n      then: make\n    - if: target_platform == \"win-arm64\"\n      then: m2-perl\n    - if: target_platform == \"win-arm64\"\n      then: m2-make\n    - if: win\n      then: m2-bash\n    - if: win\n      then: m2-coreutils\n    - if: win\n      then: m2-grep\n    - if: win\n      then: m2-sed\n  run_exports:\n    - x264 >=${{ version }},<${{ epoch }}!${{ so_number + 1 }}\n\ntests:\n  - script:\n      - if: unix\n        then: test -f ${PREFIX}/include/x264.h\n      - if: unix\n        then: test ! -f ${PREFIX}/lib/libx264.a\n      - if: unix\n        then: test -f ${PREFIX}/lib/libx264${SHLIB_EXT}\n      - if: osx\n        then: test -f ${PREFIX}/lib/libx264.${{ so_number }}.dylib\n      - if: linux\n        then: test -f ${PREFIX}/lib/libx264.so.${{ so_number }}\n      - if: win\n        then: if not exist %LIBRARY_INC%\\\\x264.h exit 1\n      - if: win\n        then: if not exist %LIBRARY_BIN%\\\\libx264-${{ so_number }}.dll exit 1\n      - if: win\n        then: if not exist %LIBRARY_LIB%\\\\libx264.lib exit 1\n      - x264 --help\n  # Windows only: compile upstream example.c against the installed import\n  # library, verify the PE architecture of the built binaries and consumer,\n  # and encode eight frames through both the API and CLI, checking for\n  # SPS/PPS/IDR and slice NAL units. The MSVC toolchain (cl) is needed to\n  # build example.c and test_windows.c with the Windows SDK.\n  - if: win\n    then:\n      - script: run_test.bat\n        requirements:\n          build:\n            - ${{ compiler(\"c\") }}\n            - ${{ stdlib(\"c\") }}\n        files:\n          source:\n            - example.c\n          recipe:\n            - test_windows.c\n\nabout:\n  license: GPL-2.0-or-later\n  license_file: COPYING\n  summary: A free software library for encoding video streams into the H.264/MPEG-4 AVC format.\n  homepage: http://www.videolan.org/developers/x264.html\n  repository: https://code.videolan.org/videolan/x264\n\nextra:\n  recipe-maintainers:\n    - jakirkham\n    - 183amir\n    - carlodri\n    - sdvillal\n",
