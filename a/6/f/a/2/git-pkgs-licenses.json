    "about": {
      "description": "licenses detects the license of a file or a whole repository by matching\nits text against the ScanCode rule corpus, which ships embedded so no\nnetwork access or external data directory is needed. It reports SPDX\nidentifiers with the matched text and evidence, and is usable as a Go\nlibrary or from the command line.",
      "dev_url": "https://github.com/git-pkgs/licenses",
      "home": "https://github.com/git-pkgs/licenses",
      "license": "MIT AND CC-BY-4.0 AND Apache-2.0",
      "license_family": "MIT AND CC-BY-4.0 AND Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Fast license detection and repository scanning against ScanCode's rule corpus"
    },
    "build": {
      "number": "0",
      "script": [
        "go-licenses save ./cmd/licenses --save_path library_licenses",
        "go build -v -o ${{ PREFIX }}/bin/licenses -ldflags=\"-s -w -X main.version=${{ version }}\" ./cmd/licenses"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "killua156"
      ]
    },
