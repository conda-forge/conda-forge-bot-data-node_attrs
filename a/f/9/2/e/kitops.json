      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "let build_time = date now | format date '%Y-%m-%dT%H:%M:%SZ'",
          "let short_commit_hash = (http get https://api.github.com/repos/kitops-ml/kitops/commits/v${{ version }}).sha | str substring 0..6",
          "let exe_name = 'kit.exe'",
          "^go build -o ($prefix)/bin/($exe_name) -v -ldflags=$'-s -w -X github.com/kitops-ml/kitops/pkg/lib/constants.Version=${{ version }} -X github.com/kitops-ml/kitops/pkg/lib/constants.BuildTime=($build_time) -X github.com/kitops-ml/kitops/pkg/lib/constants.GitCommit=($short_commit_hash)' -trimpath .",
          "^go-licenses save . --save_path=library_licenses"
        ],
        "interpreter": "nu"
      }
    },
