  "linux_64_meta_yaml": {
    "about": {
      "description": "KitOps is an open source tool that allows to package, version, share, and\ndeploy AI/ML models and their associated artifacts using familiar DevOps\npractices and OCI standards. It facilitates collaborative work on\nself-hosted AI/ML models and makes sharing, automating, and deploying those\nmodels as simple as managing containerized apps.",
      "dev_url": "https://github.com/kitops-ml/kitops",
      "doc_url": "https://kitops.org/docs",
      "home": "https://kitops.org/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "An open source MLOps tool for packaging, versioning, and sharing AI/ML projects"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "let build_time = date now | format date '%Y-%m-%dT%H:%M:%SZ'",
          "let short_commit_hash = (http get https://api.github.com/repos/kitops-ml/kitops/commits/v${{ version }}).sha | str substring 0..6",
          "let exe_name = 'kit'",
          "^go build -o ($prefix)/bin/($exe_name) -v -ldflags=$'-s -w -X github.com/kitops-ml/kitops/pkg/lib/constants.Version=${{ version }} -X github.com/kitops-ml/kitops/pkg/lib/constants.BuildTime=($build_time) -X github.com/kitops-ml/kitops/pkg/lib/constants.GitCommit=($short_commit_hash)' -trimpath .",
          "^go-licenses save . --save_path=library_licenses",
          "mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions",
          "^kit completion bash | save ($prefix)/share/bash-completion/completions/kit",
          "^kit completion fish | save ($prefix)/share/fish/vendor_completions.d/kit.fish",
          "^kit completion zsh  | save ($prefix)/share/zsh/site-functions/_kit"
        ],
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "kitops",
        "requirements": {
          "build": [
            "go-nocgo_compiler_stub",
            "go-licenses",
            "nushell"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "kit --help",
              "kit version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "kit"
              ],
              "files": [
                "share/bash-completion/completions/kit",
                "share/fish/vendor_completions.d/kit.fish",
                "share/zsh/site-functions/_kit"
              ],
              "strict": true
            }
          }
        ],
        "version": "1.15.0"
      }
    ],
    "package": {
      "name": "kitops",
      "version": "1.15.0"
    },
    "requirements": {
      "build": [
