  "raw_meta_yaml": "context:\n  version: \"1.15.0\"\n\npackage:\n  name: kitops\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/kitops-ml/kitops/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 956a3d526eb45848e66a49089fcc7867c7df4c2e019a3126219e8f1d7163f7e5\n\nbuild:\n  number: 0\n  script:\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build main app and generate license data\n      - let build_time = date now | format date '%Y-%m-%dT%H:%M:%SZ'\n      - let short_commit_hash = (http get https://api.github.com/repos/kitops-ml/kitops/commits/v${{ version }}).sha | str substring 0..6\n      - if: win\n        then: let exe_name = 'kit.exe'\n        else: let exe_name = 'kit'\n      - ^go build\n        -o ($prefix)/bin/($exe_name)\n        -v\n        -ldflags=$'-s -w -X github.com/kitops-ml/kitops/pkg/lib/constants.Version=${{ version }} -X github.com/kitops-ml/kitops/pkg/lib/constants.BuildTime=($build_time) -X github.com/kitops-ml/kitops/pkg/lib/constants.GitCommit=($short_commit_hash)'\n        -trimpath\n        .\n      - ^go-licenses save . --save_path=library_licenses\n      # generate shell completions\n      - if: build_platform == host_platform\n        then:\n          - mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions\n          - ^kit completion bash | save ($prefix)/share/bash-completion/completions/kit\n          - ^kit completion fish | save ($prefix)/share/fish/vendor_completions.d/kit.fish\n          - ^kit completion zsh  | save ($prefix)/share/zsh/site-functions/_kit\n\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n    - nushell\n\ntests:\n  - script:\n      - kit --help\n      - kit version\n  - package_contents:\n      bin:\n        - kit\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/bash-completion/completions/kit\n            - share/fish/vendor_completions.d/kit.fish\n            - share/zsh/site-functions/_kit\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/bash-completion/completions/kit\n            - Library/share/fish/vendor_completions.d/kit.fish\n            - Library/share/zsh/site-functions/_kit\n      strict: true\n\nabout:\n  summary: An open source MLOps tool for packaging, versioning, and sharing AI/ML projects\n  description: |\n    KitOps is an open source tool that allows to package, version, share, and\n    deploy AI/ML models and their associated artifacts using familiar DevOps\n    practices and OCI standards. It facilitates collaborative work on\n    self-hosted AI/ML models and makes sharing, automating, and deploying those\n    models as simple as managing containerized apps.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - library_licenses/\n  homepage: https://kitops.org\n  documentation: https://kitops.org/docs\n  repository: https://github.com/kitops-ml/kitops\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
