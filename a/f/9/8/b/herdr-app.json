  "raw_meta_yaml": "context:\n  version: \"0.1.15\"\n  ghostty_version: \"1.4.0\"\n\npackage:\n  name: herdr-app\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/herdrdev/herdr-app/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: ae39a59c45ef7acdab613841fceaeee5fe72eb551d551173069e9960a6311d58\n    patches:\n      # link conda-forge's libghostty-vt instead of building vendor/ghostty with zig\n      - patches/0001-ghostty-sys-link-a-system-libghostty-vt.patch\n      # find the herdr-core installed into the same prefix when opened from a menu shortcut\n      - patches/0002-core_bin-look-for-herdr-core-beside-the-app.patch\n  # src/vt.rs include_str!s the Kitty placeholder diacritics table from the\n  # vendor/ghostty submodule (absent from the tarball); take it from the Ghostty\n  # release conda-forge's libghostty-vt is built from\n  - url: https://raw.githubusercontent.com/ghostty-org/ghostty/v${{ ghostty_version }}/src/terminal/kitty/graphics_unicode.zig\n    sha256: 360b03cdd44dda018f2869b3cfbfe61567b258a3e604d04823ff7ad7e0770149\n    file_name: graphics_unicode.zig\n    target_directory: vendor/ghostty/src/terminal/kitty\n\nbuild:\n  number: 0\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - pkgconf\n    # bindgen for the libghostty-vt bindings\n    - clang\n    - libclang\n  host:\n    # herdr's vendored ghostty (and src/vt.rs) predate the libghostty-vt 1.0 C API;\n    # 0.1.0.dev is the VT library built from Ghostty ${{ ghostty_version }}\n    - libghostty-vt <1.0\n    - zstd\n    - if: linux\n      then:\n        - expat\n        - fontconfig\n        - freetype\n        - libxcb\n        - libxkbcommon\n        - wayland\n  run:\n    # herdr-app is the window; herdr-core (`hc`) runs the terminals\n    # (distribution/core-version is the oldest core this app works with)\n    - herdr-core >=0.1.11\n    - if: linux\n      then:\n        # loaded at runtime by wgpu and the Wayland backend\n        - libvulkan-loader\n        - wayland\n\ntests:\n  - script:\n      - herdr-app --version\n      - herdr-app --help\n      - herdr-app --skill\n  - package_contents:\n      bin:\n        - herdr-app\n      files:\n        - Menu/herdr-app.json\n        - if: linux\n          then:\n            - Menu/herdr-app.png\n            - share/icons/hicolor/scalable/apps/herdr-app.svg\n        - if: osx\n          then:\n            - Menu/herdr-app.icns\n            - Applications/Herdr.app/Contents/Info.plist\n            - Applications/Herdr.app/Contents/MacOS/Herdr\n            - Applications/Herdr.app/Contents/Resources/Herdr.icns\n        - if: win\n          then:\n            - Menu/herdr-app.ico\n\nabout:\n  homepage: https://herdr.dev\n  summary: Desktop app for terminals and coding agents\n  description: |\n    Herdr is a desktop app for terminals and coding agents. Keep work in\n    spaces, see which agents need you, and leave terminals running when you\n    close the window. The terminals run in herdr-core, which this app connects\n    to locally or over SSH.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRD-PARTY-NOTICES\n    - THIRDPARTY.yml\n  documentation: https://github.com/herdrdev/herdr-app/tree/master/docs\n  repository: https://github.com/herdrdev/herdr-app\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
