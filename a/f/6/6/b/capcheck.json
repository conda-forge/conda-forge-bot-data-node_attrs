  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.1.4\"\n\npackage:\n  name: capcheck\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/git-pkgs/capcheck/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: d861b681b9abf3200dbd450bada80dffef72a887bee1cff630e6ee9b1250a134\n  target_directory: src\n\nbuild:\n  number: 0\n  script:\n    - cd src\n    - go-licenses save ./cmd/capcheck --save_path ../library_licenses\n    - if: unix\n      then: go build -v -o $PREFIX/bin/capcheck -ldflags=\"-s -w -X github.com/git-pkgs/capcheck/cmd/capcheck/app.Version=${{ version }}\" ./cmd/capcheck\n      else: go build -v -o %LIBRARY_BIN%\\capcheck.exe -ldflags=\"-s -X github.com/git-pkgs/capcheck/cmd/capcheck/app.Version=${{ version }}\" ./cmd/capcheck\n    - if: unix\n      then:\n        - mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d\n        - $PREFIX/bin/capcheck completion zsh > $PREFIX/share/zsh/site-functions/_capcheck\n        - $PREFIX/bin/capcheck completion bash > $PREFIX/share/bash-completion/completions/capcheck\n        - $PREFIX/bin/capcheck completion fish > $PREFIX/share/fish/vendor_completions.d/capcheck.fish\n\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n  run:\n    # capcheck loads Go packages via golang.org/x/tools/go/packages, which shells out to `go list`\n    - go\n\ntests:\n  - script:\n      - capcheck --help\n  - package_contents:\n      bin:\n        - capcheck\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/capcheck\n            - share/fish/vendor_completions.d/capcheck.fish\n            - share/zsh/site-functions/_capcheck\n      strict: true\n\nabout:\n  homepage: https://github.com/git-pkgs/capcheck\n  summary: Fail CI when Go code or dependencies gain new privileged operations, using google/capslock\n  description: |\n    capcheck tells you when a Go module or one of its dependencies gains the\n    ability to do something it couldn't before: spawn a process, open a socket,\n    write a file, call cgo. A capability baseline is checked into the repository\n    and CI fails when the capability set drifts. Built on google/capslock.\n  license: MIT\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n  documentation: https://pkg.go.dev/github.com/git-pkgs/capcheck\n  repository: https://github.com/git-pkgs/capcheck\n\nextra:\n  recipe-maintainers:\n    - soapy1\n",
