  "linux_64_meta_yaml": {
    "about": {
      "description": "capcheck tells you when a Go module or one of its dependencies gains the\nability to do something it couldn't before: spawn a process, open a socket,\nwrite a file, call cgo. A capability baseline is checked into the repository\nand CI fails when the capability set drifts. Built on google/capslock.",
      "dev_url": "https://github.com/git-pkgs/capcheck",
      "doc_url": "https://pkg.go.dev/github.com/git-pkgs/capcheck",
      "home": "https://github.com/git-pkgs/capcheck",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "src/LICENSE",
      "summary": "Fail CI when Go code or dependencies gain new privileged operations, using google/capslock"
    },
    "build": {
      "number": "0",
      "script": [
        "cd src",
        "go-licenses save ./cmd/capcheck --save_path ../library_licenses",
        "go build -v -o $PREFIX/bin/capcheck -ldflags=\"-s -w -X github.com/git-pkgs/capcheck/cmd/capcheck/app.Version=${{ version }}\" ./cmd/capcheck",
        "mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d",
        "$PREFIX/bin/capcheck completion zsh > $PREFIX/share/zsh/site-functions/_capcheck",
        "$PREFIX/bin/capcheck completion bash > $PREFIX/share/bash-completion/completions/capcheck",
        "$PREFIX/bin/capcheck completion fish > $PREFIX/share/fish/vendor_completions.d/capcheck.fish"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "soapy1"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "capcheck",
        "requirements": {
          "build": [
            "go-nocgo_compiler_stub",
            "go-licenses"
          ],
          "host": [],
          "run": [
            "go"
          ]
        },
        "tests": [
          {
            "script": "capcheck --help"
          },
          {
            "package_contents": {
              "bin": [
                "capcheck"
              ],
              "files": [
                "share/bash-completion/completions/capcheck",
                "share/fish/vendor_completions.d/capcheck.fish",
                "share/zsh/site-functions/_capcheck"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.1.4"
      }
    ],
    "package": {
      "name": "capcheck",
      "version": "0.1.4"
    },
