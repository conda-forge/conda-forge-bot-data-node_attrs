  "linux_64_meta_yaml": {
    "about": {
      "description": "A pixi extension that checks pixi.toml and pixi.lock against pixi-policy.toml: where packages come from, banned\npackages and versions, SPDX license allow, review and deny lists, manifest and lockfile hygiene, and waivers that\nexpire. It reports each finding with a fix hint, as text, JSON or SARIF, and exits non-zero so CI can stop a merge.\nEvery check runs offline. Once installed with `pixi global install pixi-policy`, pixi discovers the `pixi-policy`\nexecutable on PATH and exposes it as `pixi policy`.",
      "dev_url": "https://github.com/aesir-oss/pixi-policy",
      "doc_url": "https://aesir-oss.github.io/pixi-policy/latest/",
      "home": "https://aesir-oss.github.io/pixi-policy/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Check what a pixi workspace's environments may contain against a written policy"
    },
    "build": {
      "number": "0",
      "script": [
        "cargo auditable install --locked --bins --no-track --path . --root \"$PREFIX\"",
        "cargo-bundle-licenses --format yaml --output THIRDPARTY.yml"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "millsks"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "pixi-policy",
        "requirements": {
          "build": [
