  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.1.1\"\n\npackage:\n  name: pixi-policy\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/aesir-oss/pixi-policy/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 7c0a628f3c0dd6e1ea8043565508938ca2eac73e65a372d3778de04b22be9cea\n\nbuild:\n  number: 0\n  script:\n    - if: unix\n      then: cargo auditable install --locked --bins --no-track --path . --root \"$PREFIX\"\n      else: cargo auditable install --locked --bins --no-track --path . --root \"%LIBRARY_PREFIX%\"\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n\ntests:\n  - script:\n      - pixi-policy --version\n      - pixi-policy --help\n      # Needs no workspace and no network: lists every rule.\n      - pixi-policy explain\n  - package_contents:\n      bin:\n        - pixi-policy\n      strict: true\n\nabout:\n  homepage: https://aesir-oss.github.io/pixi-policy/\n  repository: https://github.com/aesir-oss/pixi-policy\n  documentation: https://aesir-oss.github.io/pixi-policy/latest/\n  summary: Check what a pixi workspace's environments may contain against a written policy\n  description: |\n    A pixi extension that checks pixi.toml and pixi.lock against pixi-policy.toml: where packages come from, banned\n    packages and versions, SPDX license allow, review and deny lists, manifest and lockfile hygiene, and waivers that\n    expire. It reports each finding with a fix hint, as text, JSON or SARIF, and exits non-zero so CI can stop a merge.\n    Every check runs offline. Once installed with `pixi global install pixi-policy`, pixi discovers the `pixi-policy`\n    executable on PATH and exposes it as `pixi policy`.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - millsks\n",
