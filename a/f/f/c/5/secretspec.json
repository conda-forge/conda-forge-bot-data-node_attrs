  "linux_64_meta_yaml": {
    "about": {
      "description": "SecretSpec separates the declaration of which secrets an application needs\nfrom where those secrets are stored. Applications declare their required\nsecrets in a secretspec.toml manifest, and users choose the provider that\nsupplies them: the system keyring, .env files, LastPass, OnePassword,\nHashiCorp Vault, AWS Secrets Manager, Azure Key Vault, Google Secret\nManager, Kubernetes secrets, and more.",
      "dev_url": "https://github.com/cachix/secretspec",
      "doc_url": "https://secretspec.dev/",
      "home": "https://secretspec.dev/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "A declarative interface for every secret provider"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path secretspec",
          "mkdir -p $PREFIX/share/bash-completion/completions $PREFIX/share/zsh/site-functions $PREFIX/share/fish/vendor_completions.d",
          "$PREFIX/bin/secretspec completions bash > $PREFIX/share/bash-completion/completions/secretspec",
          "$PREFIX/bin/secretspec completions zsh > $PREFIX/share/zsh/site-functions/_secretspec",
          "$PREFIX/bin/secretspec completions fish > $PREFIX/share/fish/vendor_completions.d/secretspec.fish",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "thin",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "secretspec",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-bundle-licenses",
            "cargo-auditable",
            "cmake"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "secretspec --help",
              "secretspec --version",
              "docker-credential-secretspec --help",
              "git-credential-secretspec --help"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "secretspec",
                "docker-credential-secretspec",
                "git-credential-secretspec"
              ],
              "files": [
                "share/bash-completion/completions/secretspec",
                "share/zsh/site-functions/_secretspec",
                "share/fish/vendor_completions.d/secretspec.fish"
              ],
              "strict": true
            }
          }
        ],
