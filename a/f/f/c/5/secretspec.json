  "raw_meta_yaml": "context:\n  version: \"0.20.0\"\n\npackage:\n  name: secretspec\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/cachix/secretspec/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 007ae4422ad59c2d2e12046db84311f098a53dc4327a51165ed26cb4db61be70\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: thin\n    content:\n      # aws-lc-sys only auto-selects clang-cl for aarch64-pc-windows-msvc when CC is unset, but\n      # conda-forge sets CC=cl.exe, and cl.exe cannot assemble the aarch64 .S sources\n      - if: target_platform == 'win-arm64'\n        then:\n          - set \"AWS_LC_SYS_CC=clang-cl\"\n      - if: unix\n        then:\n          - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path secretspec\n        else:\n          - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path secretspec\n      - if: unix\n        then:\n          - mkdir -p $PREFIX/share/bash-completion/completions $PREFIX/share/zsh/site-functions $PREFIX/share/fish/vendor_completions.d\n          - $PREFIX/bin/secretspec completions bash > $PREFIX/share/bash-completion/completions/secretspec\n          - $PREFIX/bin/secretspec completions zsh > $PREFIX/share/zsh/site-functions/_secretspec\n          - $PREFIX/bin/secretspec completions fish > $PREFIX/share/fish/vendor_completions.d/secretspec.fish\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - cmake\n    - if: win\n      then:\n        - nasm\n    # provides clang-cl, which aws-lc-sys needs to assemble the aarch64 .S sources\n    - if: target_platform == 'win-arm64'\n      then:\n        - clang\n\ntests:\n  - script:\n      - secretspec --help\n      - secretspec --version\n      - docker-credential-secretspec --help\n      - git-credential-secretspec --help\n  - package_contents:\n      bin:\n        - secretspec\n        - docker-credential-secretspec\n        - git-credential-secretspec\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/secretspec\n            - share/zsh/site-functions/_secretspec\n            - share/fish/vendor_completions.d/secretspec.fish\n      strict: true\n\nabout:\n  homepage: https://secretspec.dev\n  summary: A declarative interface for every secret provider\n  description: |\n    SecretSpec separates the declaration of which secrets an application needs\n    from where those secrets are stored. Applications declare their required\n    secrets in a secretspec.toml manifest, and users choose the provider that\n    supplies them: the system keyring, .env files, LastPass, OnePassword,\n    HashiCorp Vault, AWS Secrets Manager, Azure Key Vault, Google Secret\n    Manager, Kubernetes secrets, and more.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  documentation: https://secretspec.dev\n  repository: https://github.com/cachix/secretspec\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
