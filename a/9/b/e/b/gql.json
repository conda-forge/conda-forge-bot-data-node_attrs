  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"4.4.0\"\n  python_check_max: \"3.14\"\n  summary: GraphQL client for Python\n\nrecipe:\n  name: gql\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/g/gql/gql-${{ version }}.tar.gz\n  sha256: e54fe470d51347ceb46a04fc88c5553695d2d8c86b05bef13aeee8b8f2d5f61a\n\nbuild:\n  number: 0\n  noarch: python\n\noutputs:\n  - package:\n      name: gql\n    build:\n      noarch: python\n      script:\n        - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check --check-build-dependencies\n      python:\n        entry_points:\n          - gql-cli = gql.cli:gql_cli\n    requirements:\n      host:\n        - pip\n        - python ${{ python_min }}.*\n        - setuptools\n      run:\n        - anyio >=3.0,<5\n        - graphql-core >=3.3.0a3,<3.4\n        - python >=${{ python_min }}\n        - tenacity >=9.1.2,<10.0\n        - yarl >=1.6,<2.0\n    tests:\n      - package_contents:\n          strict: true\n          site_packages:\n            - gql/**\n            - gql-${{ version }}.dist-info/**\n      - python:\n          imports:\n            - gql\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n      - requirements:\n          run:\n            - pip\n            - python ${{ python_min }}.*\n        script:\n          - gql-cli --help\n          - gql-cli --version\n\n  - package:\n      name: gql-with-aiohttp\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"gql\", exact=True) }}\n        - aiohttp >=3.11.2,<4\n    tests:\n      - python:\n          imports:\n            - gql\n            - gql.transport.aiohttp\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: ${{ summary }} - aiohttp transport\n\n  - package:\n      name: gql-with-botocore\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"gql\", exact=True) }}\n        - botocore >=1.21,<2\n    tests:\n      - python:\n          imports:\n            - gql\n            - gql.transport.appsync_auth\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: ${{ summary }} - boto transport\n\n  - package:\n      name: gql-with-httpx\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"gql\", exact=True) }}\n        - httpx >=0.27,<1\n    tests:\n      - python:\n          imports:\n            - gql\n            - gql.transport.httpx\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: ${{ summary }} - httpx transport (deprecated)\n\n  - package:\n      name: gql-with-httpx2\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"gql\", exact=True) }}\n        - httpx2 >=2.0.0,<3\n    tests:\n      - python:\n          imports:\n            - gql\n            - gql.transport.httpx\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: ${{ summary }} - httpx2 transport\n\n  - package:\n      name: gql-with-requests\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"gql\", exact=True) }}\n        - requests >=2.26,<3\n        - requests-toolbelt >=1.0.0,<2\n    tests:\n      - python:\n          imports:\n            - gql\n            - gql.transport.requests\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: ${{ summary }} - requests transport\n\n  - package:\n      name: gql-with-websockets\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"gql\", exact=True) }}\n        - websockets >=14.2,<18\n    tests:\n      - python:\n          imports:\n            - gql\n            - gql.transport.websockets\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: ${{ summary }} - websocket transport\n\n  - package:\n      name: gql-with-all\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"gql-with-aiohttp\", exact=True) }}\n        - ${{ pin_subpackage(\"gql-with-httpx2\", exact=True) }}\n        - ${{ pin_subpackage(\"gql-with-botocore\", exact=True) }}\n        - ${{ pin_subpackage(\"gql-with-requests\", exact=True) }}\n        - ${{ pin_subpackage(\"gql-with-websockets\", exact=True) }}\n        - ${{ pin_subpackage(\"gql\", exact=True) }}\n    tests:\n      - python:\n          pip_check: true\n          imports:\n            - gql\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n      - files:\n          source:\n            - pyproject.toml\n            - tests/**\n        requirements:\n          run:\n            - aiofiles\n            - parse\n            - pytest\n            - pytest-asyncio\n            - pytest-console-scripts\n            - pytest-cov\n            - python ${{ python_min }}.*\n            - vcrpy\n        script:\n          file: run_gql_with_all.py\n\nabout:\n  license: MIT\n  license_file: LICENSE\n  summary: ${{ summary }}\n  description: |-\n    This is a GraphQL client for Python. Plays nicely with graphene,\n    graphql-core, graphql-js and any other GraphQL implementation compatible\n    with the spec.\n  homepage: https://pypi.org/project/gql\n  repository: https://github.com/graphql-python/gql\n  documentation: https://gql.readthedocs.io\n\nextra:\n  feedstock-name: gql\n  recipe-maintainers:\n    - leszekhanusz\n    - ozagordi\n    - KingDarBoja\n    - bollwyvl\n",
