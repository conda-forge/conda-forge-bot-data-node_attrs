  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.18.0\"\n\npackage:\n  name: matrix-sdk-python\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/m/matrix-sdk-python/matrix_sdk_python-${{ version }}.tar.gz\n  sha256: 92eebb8d6aa46e2c9458fe126c77262cb53f77cf5fc5444d54f4a3c4d00d0edd\n  patches:\n    # Respect conda's Rust target, build the binding generator for the host, and keep Cargo.lock unchanged.\n    - conda-toolchain.patch\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_NET_GIT_FETCH_WITH_CLI: \"true\"\n      CMAKE_GENERATOR: Ninja\n      LIBSQLITE3_SYS_USE_PKG_CONFIG: \"1\"\n      ZSTD_SYS_USE_PKG_CONFIG: \"1\"\n    content:\n      - cd matrix-rust-sdk/bindings/matrix-sdk-ffi\n      - cargo-bundle-licenses --format yaml --output ../../../THIRDPARTY.yml --features sentry\n      - cd ../../..\n      - python -m pip install . -vv --no-deps --no-build-isolation\n      - if: osx\n        then: install_name_tool -id \"$SP_DIR/matrix_sdk_python/_generated/libmatrix_sdk_ffi.dylib\" \"$SP_DIR/matrix_sdk_python/_generated/libmatrix_sdk_ffi.dylib\"\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }}\n    - ${{ stdlib('c') }}\n    - cargo-bundle-licenses\n    - cmake\n    - ninja\n    - pkgconf\n    - perl\n    - git\n    - if: win\n      then: nasm\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n  host:\n    - python\n    - pip\n    - setuptools >=80\n    - wheel\n    - libsqlite\n    - zstd\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - matrix_sdk_python\n        - matrix_sdk_python._generated.matrix_sdk_ffi\n      pip_check: true\n  - files:\n      source:\n        - tests/test_smoke.py\n    requirements:\n      run:\n        - pytest\n    script: python -m pytest tests/test_smoke.py -v\n\nabout:\n  homepage: https://elysia-best.github.io/matrix-sdk-python/\n  repository: https://github.com/elysia-best/matrix-sdk-python\n  summary: Python bindings for the Matrix Rust SDK via UniFFI\n  license: Apache-2.0\n  license_file:\n    - matrix-rust-sdk/LICENSE\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - timkpaine\n",
