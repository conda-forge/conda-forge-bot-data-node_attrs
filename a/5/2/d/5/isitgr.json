  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: isitgr\n  version: \"1.6.5\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/i/isitgr/isitgr-${{ version }}.tar.gz\n  sha256: 87890cd59c7befa5d244dee6598ef6ceccd099210dd86547951cf87b682fe366\n  patches:\n    - 0000-no-static-linkage.patch\n\nbuild:\n  number: 2\n  skip: match(python, \"<3.10\") or win\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('fortran') }}\n    - ${{ stdlib(\"c\") }}\n    - git\n    - make\n  host:\n    - python\n    - pip\n    - setuptools >=77\n    - packaging >=24.2\n    - wheel\n    - if: osx\n      then: llvm-openmp\n    - if: linux\n      then: libgomp\n  run:\n    - python\n    - numpy\n    - six  # TODO: remove for next update\n    - mock\n    - setuptools  # for an import of pkg_resources\n    - sympy >=1.0\n    - scipy >=1.0\n    - if: not win\n      then: ${{ compiler('fortran') }}\n\ntests:\n  - python:\n      imports:\n        - isitgr\n      pip_check: false\n  - script:\n      - python -c \"import isitgr; print(isitgr.__version__)\"\n\nabout:\n  license: MIT AND GPL-3.0-or-later\n  license_file: LICENCE.txt\n  summary: Integrated Software in Testing General Relativity (ISiTGR). A patch of CAMB to add MG predictions.\n  homepage: https://github.com/mishakb/ISiTGR\n  repository: https://github.com/mishakb/ISiTGR\n\nextra:\n  recipe-maintainers:\n    - gqcristhian\n    - mishakb\n    - Lhior\n",
