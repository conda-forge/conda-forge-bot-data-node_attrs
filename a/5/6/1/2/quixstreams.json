  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: quixstreams\n  version: \"3.26.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/quixio/quix-streams/archive/v${{ version }}.tar.gz\n  sha256: be7890366997e26cd06be9bbdd16f75c779f6617691c5ded2e28555be9c236ee\n\nbuild:\n  number: 1\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - python-confluent-kafka >=2.8.2,<2.12\n    - rocksdict >=0.3,<0.4\n    - typing_extensions >=4.8\n    - orjson >=3.9,<4\n    - pydantic >=2.7,<2.13\n    - pydantic-settings >=2.3,<2.12\n    # Superceded below\n    # - jsonschema >=4.3.0\n    - jsonlines >=4,<5\n    - rich >=13,<15\n    - jsonpath-ng >=1.7.0,<2\n    - httpx >=0.28.1\n    # From confluent-kafka-avro\n    - fastavro >=1.5.4,<2\n    - requests\n    - avro >=1.11.1,<2\n    # From conflient-kafka-json\n    - jsonschema >=4.18.0\n    # From conflient-kafka-protobuf\n    - googleapis-common-protos\n    - protobuf\n    # From conflient-kafka-schemaregistry\n    - attrs >=21.2.0\n    - cachetools >=5.5.0\n    - certifi\n    - httpx2 >=2.0\n    - authlib >=1.8.0\n\ntests:\n  - python:\n      imports:\n        - quixstreams\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\nabout:\n  summary: Python library for building stream processing applications with Apache Kafka\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n  homepage: https://github.com/quixio/quix-streams\n  documentation: https://docs.quix.io/\n\nextra:\n  recipe-maintainers:\n    - thewchan\n",
