  "raw_meta_yaml": "context:\n  name: rocm-core\n  version: \"7.2.4\"\n\nrecipe:\n  name: rocm-core-split\n  version: ${{ version }}\n\nsource:\n  - url: \"https://github.com/ROCm/rocm-systems/releases/download/rocm-${{ version }}/rocm-core.tar.gz\"\n    sha256: 6213466e5d791a492ddc4fe91f2078295468a9d5da11731b0428ce2edc080622\n\nbuild:\n  number: 3\n  skip: not linux\n\noutputs:\n  - package:\n      name: librocm-core\n    build:\n      script: build.sh\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - ${{ compiler('cxx') }}\n        - cmake\n        - ninja\n\n      run_exports:\n        - ${{ pin_subpackage('librocm-core', upper_bound='x.x') }}\n    tests:\n      - package_contents:\n          lib:\n            - rocm-core\n          include:\n            - rocm-core/rocm_version.h\n          files:\n            exists:\n              - .info/version\n              - lib/cmake/rocm-core/rocm-core-config.cmake\n\n  - package:\n      name: rocm-core\n    build:\n      script: []\n    requirements:\n      run:\n        - ${{ pin_subpackage('librocm-core', exact=True) }}\n      run_exports:\n        - ${{ pin_subpackage('rocm-core', upper_bound='x.x') }}\n    tests:\n      - requirements:\n          run:\n            - cmake-package-check\n            - ${{ compiler('c') }}\n            - ${{ compiler('cxx') }}\n        script:\n          - cmake-package-check rocm-core\n      - package_contents:\n          files:\n            not_exists:\n              - \"**/*\"\n\nabout:\n  homepage: https://github.com/ROCm/rocm-systems\n  license: MIT\n  license_family: MIT\n  license_file: LICENSE.md\n  summary: \"ROCm core package\"\n\nextra:\n  feedstock-name: rocm-core\n  recipe-maintainers:\n    - traversaro\n    - isuruf\n    - zklaus\n",
