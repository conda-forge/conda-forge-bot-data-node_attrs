    "about": {
      "description": "p4 is a package for creating and analyzing models of particles and their\ninteractions, based on HOOMD-blue and Plotly. Users can measure energy,\nforce, and torque fields created by rigid bodies of particles interacting\nvia pairwise potentials, and then interactively plot those bodies and\nfields in 3D, 2D, or 1D.",
      "dev_url": "https://github.com/glotzerlab/p4",
      "doc_url": "https://p4-hoomd.readthedocs.io/en/latest",
      "home": "https://github.com/glotzerlab/p4",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE",
      "summary": "Evaluate particle interaction models with HOOMD-blue and Plotly"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "${{ PYTHON }} -m pip install . -vv"
    },
    "extra": {
      "recipe-maintainers": [
        "josephburkhart",
        "joaander"
      ]
    },
