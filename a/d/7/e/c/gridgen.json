  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.51.5\"\n  commit: f6b28d632545cc4806c2619627c6350cd8a10f7a\n\npackage:\n  name: gridgen\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/sakov/gridgen-c/archive/${{ commit }}.tar.gz\n  sha256: d683776613e1f3d614438699f269581ee34f4ed636c2bf612f85c99ee0a2f65b\n\nbuild:\n  number: 1001\n  skip: win\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - make\n  host:\n    - gridutils\n  run:\n    # gridutils has no run_exports, so it must be listed explicitly\n    - gridutils\n  run_exports:\n    - ${{ pin_subpackage('gridgen', upper_bound='x.x') }}\n\ntests:\n  - package_contents:\n      bin:\n        - gridgen\n      include:\n        - gridgen.h\n      # upstream's makefile installs libgridgen.so on all platforms (not\n      # .dylib on macOS), so use literal paths instead of `lib: [gridgen]`\n      files:\n        - lib/libgridgen.a\n        - lib/libgridgen.so\n  - script:\n      - gridgen -h\n\nabout:\n  homepage: https://github.com/sakov/gridgen-c\n  license: LicenseRef-gridgen AND LicenseRef-Triangle\n  license_file: gridgen/LICENSE\n  summary: Non-interactive generation of multi-corner quasi-orthogonal grids inside simply connected polygonal regions.\n\nextra:\n  recipe-maintainers:\n    - ocefpaf\n",
