  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.1.69\"\n\npackage:\n  name: rsloop\n  version: ${{ version }}\n\nsource:\n  - url: https://pypi.org/packages/source/r/rsloop/rsloop-${{ version }}.tar.gz\n    sha256: 49c2976635eecf7e502bf270d23575936c0d5026bf0bf6210e9d5b6d8dfc16c0\n\nbuild:\n  number: 1\n  script:\n    env:\n      # The CMake builder keeps jitterentropy's -O0 after conda's CFLAGS.\n      AWS_LC_SYS_CMAKE_BUILDER: \"1\"\n      CMAKE_GENERATOR: Ninja\n    content:\n      - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\nrequirements:\n  build:\n    - python\n    - if: build_platform != target_platform\n      then:\n        - cross-python_${{ target_platform }}\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    # allocator_api was stabilized in Rust 1.100.\n    - rust >=1.100\n    - cmake\n    - ninja\n    - if: win\n      then: nasm\n    - cargo-bundle-licenses\n    - maturin\n  host:\n    - maturin >=1.9.4,<2\n    - pip\n    - python\n  run:\n    - python\n\ntests:\n  - python:\n      imports: rsloop\n      pip_check: true\n\nabout:\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://rustedbytes.github.io/rsloop\n  repository: https://github.com/RustedBytes/rsloop\n  summary: An event loop for asyncio written in Rust.\n\nextra:\n  recipe-maintainers:\n    - davidbrochart\n",
