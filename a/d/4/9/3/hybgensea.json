  "raw_meta_yaml": "context:\n  name: hybgensea\n  version: \"0.3.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  - url: https://files.pythonhosted.org/packages/source/${{ name[0] }}/${{ name }}/hybgensea-${{ version }}.tar.gz\n    sha256: 7e114d5890e42967078e936c45869fd9dd9d4d0dcf52c012b3258680537d2b85\n  - url: https://github.com/mdealencar/HGS-CVRP/archive/f60dd6108fcaf9e4516ecb288edaf41bdf6bd809.tar.gz\n    sha256: 0aff5a49b6281d71292b243238c5b80bbe82934566f41ccc3b262413e1225f5c\n    target_directory: HGS-CVRP\n\nbuild:\n  number: 0\n  skip:\n    - match(python, \"<3.10\")\n  script:\n    - if: unix\n      then:\n        - python -m pip install . -vv --no-deps --no-build-isolation -C cmake.define.FETCHCONTENT_SOURCE_DIR_HGSCVRP=\"${SRC_DIR}/HGS-CVRP\"\n    - if: win\n      then:\n        - python -m pip install . -vv --no-deps --no-build-isolation -C cmake.define.FETCHCONTENT_SOURCE_DIR_HGSCVRP=\"%SRC_DIR%\\HGS-CVRP\"\n\nrequirements:\n  build:\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - if: unix\n      then: make\n  host:\n    - python\n    - scikit-build-core\n    - nanobind\n    - pip\n  run:\n    - python\n    - numpy\n\ntests:\n  - python:\n      imports:\n        - hybgensea\n      pip_check: true\n  - requirements:\n      run:\n        - pytest\n    script:\n      - pytest --pyargs hybgensea.tests\n\nabout:\n  homepage: https://github.com/mdealencar/HybGenSea\n  repository: https://github.com/mdealencar/HybGenSea\n  summary: Wrapper for the Hybrid Genetic Search algorithm for Capacitated Vehicle Routing Problems (HGS-CVRP)\n  license: MIT\n  license_file:\n    - LICENSE\n    - HGS-CVRP/LICENSE\n\nextra:\n  recipe-maintainers:\n    - mdealencar\n    - simutisernestas\n",
