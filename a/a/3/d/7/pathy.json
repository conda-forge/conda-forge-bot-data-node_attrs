    "about": {
      "description": "Pathy is a python package (with type annotations) for working with Bucket\nstorage providers. It provides a CLI app for basic file operations between\nlocal files and remote buckets. It enables a smooth developer experience by\nsupporting local file-system backed buckets during development and testing.\nIt makes converting bucket blobs into local files a snap with optional\nlocal file caching of blobs.",
      "dev_url": "https://github.com/justindujardin/pathy",
      "doc_url": "https://github.com/justindujardin/pathy",
      "home": "https://github.com/justindujardin/pathy",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "A Path interface for local and cloud bucket storage"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "pathy = pathy.cli:app"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . --no-deps -vv --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "conda-forge/spacy",
        "justindujardin"
      ]
    },
    "outputs": [
      {
        "build": {
          "noarch": "python",
          "python": {
            "entry_points": [
              "pathy = pathy.cli:app"
            ]
          }
        },
        "name": "pathy",
        "requirements": {
          "build": [],
          "host": [
            "python 3.11.*",
            "pip",
            "hatchling"
          ],
          "run": [
            "python >=3.11",
            "pathlib-abc <0.6,>=0.5.2",
            "smart-open >=5.2.1",
            "typer >=0.3.0"
          ]
        },
        "tests": [
