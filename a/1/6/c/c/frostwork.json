  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.2.2\"\n\npackage:\n  name: frostwork\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/f/frostwork/frostwork-${{ version }}.tar.gz\n  sha256: da4ac35a703b68a6fd1ad92dba53abeed4d38bcfaa5125b6f7f50b4405de7066\n\nbuild:\n  number: 0\n  script:\n    - ${{ PYTHON }} -m pip install . -vv\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n  skip:\n    - is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n    entry_points:\n      - frostwork-audit = frostwork.audit:main\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n    - ${{ compiler('rust') }}\n    - ${{ stdlib(\"c\") }}\n    - cargo-bundle-licenses\n  host:\n    - python\n    - maturin >=1.9,<2\n    - pip\n  run:\n    - python\n    - typing_extensions >=4.13\n\ntests:\n  - python:\n      imports:\n        - frostwork\n      pip_check: true\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python\n        - if: is_abi3\n          then: abi3audit\n        - pytest\n        - lxml\n        # tests are fragile to cssselect version\n        - cssselect ==1.5.0\n        - parsel\n    files:\n      source:\n        - tests/\n        - tools/\n    script:\n      - frostwork-audit --help\n      # skip all tests requiring web-poet, too many dependencies\n      - if: unix\n        then: echo \"import pytest; pytest.skip('requires web-poet', allow_module_level=True)\" > ${SP_DIR}/web_poet.py\n        else: echo import pytest; pytest.skip('requires web-poet', allow_module_level=True) > %SP_DIR%\\\\web_poet.py\n      # gate tests are partially broken, and require more dependencies\n      # make_gates and release tests are irrelevant to us\n      # tests/test_python.py::test_every_shipped_base_is_injectable requires andi\n      # tests/test_python.py::test_extract_releases_gil_for_parallel_scans fragile to timing\n      - python -m pytest -vv\n          --ignore=tests/test_gates.py\n          --ignore=tests/test_make_gates.py\n          --ignore=tests/test_release.py\n          --deselect=tests/test_python.py::test_every_shipped_base_is_injectable\n          --deselect=tests/test_python.py::test_extract_releases_gil_for_parallel_scans\n      - if: is_abi3\n        then:\n          - if: unix\n            then: abi3audit $SP_DIR/frostwork/_frostwork.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n            else: abi3audit %SP_DIR%/frostwork/_frostwork.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  summary: Treeless, one-pass HTML extraction — CSS/XPath selectors matched on a streaming scan, no DOM.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/scrapy/frostwork\n  documentation: https://github.com/scrapy/frostwork/blob/main/docs/PYTHON.md\n\nextra:\n  recipe-maintainers:\n    - mgorny\n    - AdrianAtZyte\n    - wRAR\n",
