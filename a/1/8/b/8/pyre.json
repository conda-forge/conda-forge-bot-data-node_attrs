  "raw_meta_yaml": "{% set version = \"1.13.1\" %}\n\npackage:\n  name: pyre\n  version: {{ version }}\n\nsource:\n  - url: https://github.com/pyre/pyre/archive/v{{ version }}.tar.gz\n    sha256: 1da16a27c8055ee724b8c2e6057f97f93f55325931ea27da217689a3e445bfda\n    patches:\n\nbuild:\n  number: 0\n  # the python floor is 3.11 as of v1.13.0\n  skip: true  # [win or py<311 or python_impl == 'pypy']\n\nrequirements:\n  build:\n    - python                                 # [build_platform != target_platform]\n    - cross-python_{{ target_platform }}     # [build_platform != target_platform]\n    - pybind11                               # [build_platform != target_platform]\n    - {{ compiler('c') }}\n    - {{ stdlib(\"c\") }}\n    - {{ compiler('cxx') }}\n    - cmake\n    - make  # [unix]\n  host:\n    - hdf5\n    - numpy\n    - pybind11\n    - python\n    - zip\n  run:\n    - python\n    # the yaml configuration codec; a declared dependency of the python package\n    - pyyaml\n    # the round trip editor of yaml configuration files and the persistence of component\n    # state ride on it; optional for pip, where it is the {editing} extra, included here\n    - ruamel.yaml\n\ntest:\n  requires:\n    # the yaml codec rides on pyyaml, and the round trip editor of yaml configuration files\n    # on ruamel.yaml; the tests of the latter skip themselves when it is absent\n    - pyyaml\n    - ruamel.yaml\n  commands:\n    # the extension modules must be loaded, not merely present: {import pyre} succeeds even\n    # when the core extension cannot be loaded, since the package swallows that failure and\n    # sets {pyre.libpyre} to {None}, which is how v1.12.6 shipped on osx-arm64 with grid and\n    # memory bindings that could not be used\n    - python -c \"import pyre, journal, pyre.h5; assert pyre.libpyre is not None, 'the pyre bindings did not load'; assert journal.libjournal is not None, 'the journal bindings did not load'; assert pyre.h5.libh5 is not None, 'the h5 bindings did not load'\"\n    # a component of each kind of binding does something\n    - python -c \"import pyre; import pyre.memory, pyre.grid; b = pyre.memory.heap(type=pyre.memory.cells.double(), cells=16); assert b.cells == 16\"\n    - python -c \"import journal; c = journal.info('pyre.conda'); c.device = journal.trash(); c.log('the conda package works')\"\n    # the project generator finds its templates in the installation\n    - python -c \"import pyre; assert (pyre.prefix / 'share' / 'pyre' / 'templates' / 'basic').isDirectory(), str(pyre.prefix)\"\n  imports:\n    - pyre\n    - journal\n\nabout:\n  home: http://pyre.orthologue.com\n  license: BSD-3-Clause\n  license_family: BSD\n  license_file: LICENSE\n  summary: A Python framework for scientific applications\n\n  description: |\n    An open source application framework for building\n    scalable, user-friendly scientific applications.\n\n  dev_url: https://github.com/pyre/pyre\n  doc_url: http://pyre.orthologue.com/docs\n\nextra:\n  recipe-maintainers:\n    - aivazis\n    - rtburns-jpl\n",
