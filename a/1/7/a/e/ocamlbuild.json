  "raw_meta_yaml": "context:\n  build_number: 2\n  name: ocamlbuild\n  version: 0.16.1\n\n  # ocaml_win-64 ships gcc_* and vs2022_* at the same version/build; name the track.\n  c_toolchain: ${{ \"\" if unix else c_compiler ~ \"_*\" }}\n  library: ${{ \"Library/\" if not unix else \"\" }}\n  dot: ${{ \"./\" if unix else \"\" }}\n  m2: ${{ \"m2-\" if not unix else \"\" }}\n\npackage:\n  name: ocamlbuild\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ocaml/ocamlbuild/archive/${{ version }}.tar.gz\n  sha256: 2ba6857f2991b7f69368e8db818b163d31cf5a367f15f5953bf8f01a77b3d4fc\n\nbuild:\n  number: ${{ build_number }}\n  script: build.sh\n\nrequirements:\n  build:\n    - ${{ compiler('ocaml') }}\n    - if: not unix and c_compiler == \"gcc\"\n      then:\n        - ${{ stdlib(\"m2w64_c\") }}\n      else:\n        - ${{ stdlib(\"c\") }}\n    - ${{ m2 }}make\n    - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n    # Every sed/cp/tr/mv call site in build.sh is windows-only.\n    - if: not unix\n      then:\n        - ${{ m2 }}coreutils\n        - ${{ m2 }}sed\n  run_constraints:\n    - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n\ntests:\n  - package_contents:\n      strict: true\n      bin:\n        - ocamlbuild\n        - ocamlbuild.native\n      files:\n        - ${{ library }}lib/ocaml/ocamlbuild/META\n        - ${{ library }}lib/ocaml/ocamlbuild/ocamlbuild.cmo\n        - ${{ library }}lib/ocaml/ocamlbuild/ocamlbuild.cmx\n        # Object and library extensions follow the windows toolchain: the gcc lane\n        # emits .o and .a, the vs2022 lane .obj and .lib, with identical basenames.\n        # Glob over the extension rather than branching the block per lane.\n        - ${{ library }}lib/ocaml/ocamlbuild/ocamlbuild.o*\n        - ${{ library }}lib/ocaml/ocamlbuild/ocamlbuild_*.cmi\n        - ${{ library }}lib/ocaml/ocamlbuild/ocamlbuild_*.cmx\n        - ${{ library }}lib/ocaml/ocamlbuild/ocamlbuild_*.o*\n        - ${{ library }}lib/ocaml/ocamlbuild/ocamlbuildlib*\n        - ${{ library }}lib/ocaml/ocamlbuild/ocamlbuildlib.cma\n        - ${{ library }}lib/ocaml/ocamlbuild/ocamlbuildlib.cmxa\n        - ${{ library }}lib/ocaml/ocamlbuild/signatures.cmi\n        - ${{ library }}lib/ocaml/ocamlbuild/signatures.cmti\n        - ${{ library }}lib/ocaml/ocamlbuild/signatures.mli\n        - ${{ library }}share/man/man1/ocamlbuild.1\n\n  # Cross-compiled platforms: verify binary architecture\n  - if: build_platform != target_platform\n    then:\n      script:\n        - if: osx\n          then:\n            - otool -hv ${CONDA_PREFIX}/bin/ocamlbuild\n            - otool -hv ${CONDA_PREFIX}/bin/ocamlbuild.native\n        - if: linux\n          then:\n            - readelf -h ${CONDA_PREFIX}/bin/ocamlbuild\n            - readelf -h ${CONDA_PREFIX}/bin/ocamlbuild.native\n\n  # Native platforms: version check\n  - if: build_platform == target_platform\n    then:\n      script:\n        - ocamlbuild -version | grep ${{ version }}\n        - ocamlbuild.native -version | grep ${{ version }}\n      requirements:\n        run:\n          - ${{ m2 }}grep\n\n  # Native platforms: full functional test\n  - if: build_platform == target_platform\n    then:\n      script:\n        - if: unix\n          then:\n            - echo 'let () = print_endline \"Hello from ocamlbuild\"' > hello.ml\n          else:\n            - echo let () = print_endline \"Hello from ocamlbuild\" > hello.ml\n        - ocamlbuild hello.native && ${{ dot }}hello.native\n        - ocamlbuild -clean\n        - ocamlbuild hello.byte && ${{ dot }}hello.byte\n      requirements:\n        run:\n          # MSVC ships no _impl_ package; vs2022_win-64 is the activation package.\n          - if: not unix and c_compiler == \"vs2022\"\n            then: vs2022_${{ target_platform }}\n            else: ${{ c_compiler }}_impl_${{ target_platform }}\n          - ocaml-compiler\n\n  # Cross-compiled platforms: limited tests (QEMU constraints)\n  - if: linux and (build_platform != target_platform)\n    then:\n      script:\n        - ocamlbuild -documentation\n        - echo 'let () = print_endline \"Hello from ocamlbuild\"' > hello.ml\n        - ocamlbuild hello.cmo\n      requirements:\n        run:\n          - file\n          - ocaml-compiler\n\nabout:\n  homepage: https://ocaml.org/\n  license: LGPL-2.0-only\n  license_family: LGPL\n  license_file: LICENSE\n  summary: OCamlbuild is a generic build tool, that has built-in rules for building OCaml library and programs.\n\n  # The remaining entries in this section are optional, but recommended\n  description: |\n    OCaml is an implementation of the ML language, based on the Caml Light\n    dialect extended with a complete class-based object system and a powerful\n    module system in the style of Standard ML.\n\n    OCamlbuild was distributed as part of the OCaml distribution for OCaml\n    versions between 3.10.0 and 4.02.3. Starting from OCaml 4.03, it is now\n    released separately (with its own version numbering).\n\n    You should refer to the OCambuild manual for more informations on how to\n    use ocamlbuild.\n  documentation: https://github.com/ocaml/ocamlbuild/blob/master/manual/manual.adoc\n  repository: https://github.com/ocaml/ocamlbuild\n\nextra:\n  recipe-maintainers:\n    - dslarm\n    - peterjc\n    - MementoRC\n",
