  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.8\"\n  name: libntlm\n  sha256: ce6569a47a21173ba69c990965f73eb82d9a093eb871f935ab64ee13df47fda1\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url:\n    - https://download.savannah.nongnu.org/releases/libntlm/libntlm-${{ version }}.tar.gz\n    - https://download-mirror.savannah.nongnu.org/releases/libntlm/libntlm-${{ version }}.tar.gz\n  sha256: ${{ sha256 }}\n\nbuild:\n  # This package is a dependency of libhdfs3, which is primarily used with HDFS on Linux.\n  number: 2\n  skip: win\n\nrequirements:\n  build:\n    - if: unix\n      then: gnuconfig\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - make\n  run_exports:\n    - ${{ pin_subpackage(\"libntlm\", upper_bound=\"x\") }}\n\ntests:\n  - script:\n      - test -f $PREFIX/include/ntlm.h\n      - test -f $PREFIX/lib/libntlm.a\n      - test -f $PREFIX/lib/libntlm${{ SHLIB_EXT }}\n      - test -f $PREFIX/lib/pkgconfig/libntlm.pc\n\nabout:\n  license: LGPL-2.1-or-later\n  license_file: COPYING\n  summary: Improved implementation of Microsoft's NTLM authentication\n  homepage: http://www.nongnu.org/libntlm/\n\nextra:\n  recipe-maintainers:\n    - traversaro\n    - mariusvniekerk\n    - martindurant\n",
