  "raw_meta_yaml": "context:\n  # IlmBase ended at 2.5.x; OpenEXR 3.x is packaged by openexr and imath.\n  version: \"2.5.10\"\n\npackage:\n  name: ilmbase\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/AcademySoftwareFoundation/openexr/archive/v${{ version }}.tar.gz\n  sha256: c081fd982a1ba960f0faf41f152ffa035e1fbb071283ce10424116874fc8ce48\n  patches:\n    - patches/0001-find-threads-dependency.patch\n\nbuild:\n  number: 0\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - ninja\n  run_exports:\n    - ${{ pin_subpackage('ilmbase', upper_bound='x.x') }}\n\ntests:\n  - package_contents:\n      include:\n        - OpenEXR/half.h\n        - OpenEXR/IlmThread.h\n        - OpenEXR/ImathMath.h\n        - OpenEXR/Iex.h\n        - OpenEXR/IexMathExc.h\n      lib:\n        - Half\n        - IlmThread\n        - Imath\n        - Iex\n        - IexMath\n      files:\n        - \"**/lib/cmake/IlmBase/IlmBaseConfig.cmake\"\n        - \"**/lib/pkgconfig/IlmBase.pc\"\n  - script:\n      - if: unix\n        then: cmake -S test -B build-test -G Ninja ${CMAKE_ARGS}\n        else: cmake -S test -B build-test -G Ninja %CMAKE_ARGS%\n      - cmake --build build-test\n      - ctest --test-dir build-test --output-on-failure\n    requirements:\n      build:\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - cmake\n        - ninja\n    files:\n      recipe:\n        - test/\n\nabout:\n  homepage: https://openexr.com/\n  license: BSD-3-Clause\n  license_file: LICENSE.md\n  summary: Legacy IlmBase libraries for OpenEXR 2.x.\n  documentation: https://openexr.com/en/latest/PortingGuide.html\n  repository: https://github.com/AcademySoftwareFoundation/openexr\n\nextra:\n  recipe-maintainers:\n    - npavlovikj\n    - SylvainCorlay\n    - wolfv\n    - JohanMabille\n",
