  "raw_meta_yaml": "context:\n  version: \"0.6.0\"\n\npackage:\n  name: jarl\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/etiennebacher/jarl/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 86620fcdb654d18be5f9fc62257ff577eade56cb1a6d9a3bc7d6e6857006a8a7\n\nbuild:\n  number: 1\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # work around Windows `MAX_PATH` (260 char) limitation\n      - if: win\n        then: $env.CARGO_HOME = 'C:\\.cargo'\n      # build main app and generate license data\n      - cd crates/jarl\n      - cargo auditable install --path=. --root=($prefix) --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml\n      # generate shell completions\n      - if: build_platform == host_platform\n        then:\n          - mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions\n          - let bin = ($prefix)/bin/jarl\n          - COMPLETE=bash ^$bin | save ($prefix)/share/bash-completion/completions/jarl\n          - COMPLETE=fish ^$bin | save ($prefix)/share/fish/vendor_completions.d/jarl.fish\n          - COMPLETE=zsh  ^$bin | save ($prefix)/share/zsh/site-functions/_jarl\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - nushell\n\ntests:\n  - script:\n      - jarl --help\n      - jarl --version\n  - package_contents:\n      bin:\n        - jarl\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/bash-completion/completions/jarl\n            - share/fish/vendor_completions.d/jarl.fish\n            - share/zsh/site-functions/_jarl\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/bash-completion/completions/jarl\n            - Library/share/fish/vendor_completions.d/jarl.fish\n            - Library/share/zsh/site-functions/_jarl\n      strict: true\n\nabout:\n  summary: Just Another R Linter\n  description: |\n    Jarl is a fast linter for R: it does static code analysis to search for\n    programming errors, bugs, and suspicious patterns of code. It supports\n    automatic fixes, 55+ rules, multiple output formats, and integration in\n    popular IDEs and editors as well as CI workflows.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://jarl.etiennebacher.com/\n  repository: https://github.com/etiennebacher/jarl/\n\nextra:\n  recipe-maintainers:\n    - etiennebacher\n    - salim-b\n",
