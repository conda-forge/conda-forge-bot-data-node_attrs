  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.6.0\"\n\npackage:\n  name: streamlit-extras\n  version: ${{ version }}\n\nsource:\n  # The GitHub tag rather than the PyPI sdist: the sdist leaves out the\n  # frontends' package-lock.json files.\n  url: https://github.com/arnaudmiribel/streamlit-extras/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 509fbc4def6265eade467bf8d932892d66aad8dc8ca4516a98dc17f4032a0094\n  patches:\n    # https://github.com/arnaudmiribel/streamlit-extras/pull/422\n    - 0001-find-npm-on-windows.patch\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    # The hatch build hook runs npm to build the React frontends.\n    - ${{ PYTHON }} -m pip install . -vv\n    - ${{ PYTHON }} ${{ RECIPE_DIR }}/collect_licenses.py\n\nrequirements:\n  build:\n    - nodejs\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - hatchling\n  run:\n    - python >=${{ python_min }}\n    - plotly >=5.23.0\n    - streamlit >=1.54.0\n\ntests:\n  - python:\n      imports:\n        - streamlit_extras\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      # Every React frontend must ship its compiled bundle.\n      - python -c \"import pathlib, streamlit_extras as s; b = list(pathlib.Path(s.__file__).parent.glob('*/frontend/build/index-*.js')); assert len(b) == 9, b\"\n\nabout:\n  homepage: https://github.com/arnaudmiribel/streamlit-extras\n  repository: https://github.com/arnaudmiribel/streamlit-extras\n  documentation: https://arnaudmiribel.github.io/streamlit-extras/\n  summary: A community-driven collection of useful Streamlit components and utilities\n  # MIT and ISC cover the npm packages bundled into the frontend JS.\n  license: Apache-2.0 AND MIT AND ISC\n  license_file:\n    - LICENSE\n    - ThirdPartyLicenses.txt\n\nextra:\n  recipe-maintainers:\n    - killua156\n",
