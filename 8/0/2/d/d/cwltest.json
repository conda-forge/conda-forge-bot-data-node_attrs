  "linux_64_meta_yaml": {
    "about": {
      "description": "This is a testing tool for checking the output of Tools and Workflows described\nwith the Common Workflow Language.  Among other uses, it is used to run the CWL\nconformance tests.",
      "dev_url": "https://github.com/common-workflow-language/cwltest",
      "doc_url": "http://cwltest.readthedocs.org/",
      "home": "https://github.com/common-workflow-language/cwltest",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Common workflow language testing framework"
    },
    "build": {
      "number": "2",
      "python": {
        "entry_points": [
          "cwltest = cwltest.main:main"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv"
    },
    "extra": {
      "recipe-maintainers": [
        "mr-c"
      ]
    },
    "outputs": [
      {
        "build": {
          "python": {
            "entry_points": [
              "cwltest = cwltest.main:main"
            ]
          }
        },
        "name": "cwltest",
        "requirements": {
          "build": [],
          "host": [
            "pip",
            "python",
            "setuptools >=45",
            "setuptools_scm >=8.0.4,<9"
          ],
          "run": [
            "python",
            "schema-salad >=5.0.20200220195218,<9",
            "junit-xml >=1.8",
            "pytest",
            "defusedxml"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "cwltest",
                "cwltest.tests"
              ],
              "pip_check": false
            }
          },
          {
            "files": {
              "source": [
                "tests/test-data"
              ]
            },
            "requirements": {
              "run": [
                "cwltool",
                "pytest"
              ]
            },
            "script": [
              "cwltest --help",
              "mkdir -p bin",
              "ln -s $(command -v cwltool) bin/cwl-runner",
              "chmod a+x bin/cwl-runner",
              "PATH=$PATH:$PWD/bin CWLTOOL_OPTIONS=--no-container python -m pytest --pyargs cwltest -p pytester -o pytester_example_dir=tests/test-data -k 'not test_plugin'"
            ]
          }
        ],
        "version": "2.7.20260814150058"
      },
