  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: tilelang\n  version: \"0.1.14\"\n  cuda_enabled: ${{ cuda_compiler_version != \"None\" }}\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name }}-${{ version }}.tar.gz\n  sha256: 7ae0fba6c63dae80b3c9c5c11a70bb8d7165794994f290f36e2fe87bfb143cfc\n  patches:\n    # Stop shipping the vendored CUTLASS headers (they are only used as a JIT\n    # include path) and resolve them from the prefix instead, where the\n    # conda-forge `cutlass` package installs them.\n    - patches/0001-do-not-vendor-cutlass.patch\n\nbuild:\n  number: 0\n  # The only compiled Python extension is a Cython module built against the\n  # stable ABI (`wheel.py-api = \"cp39\"`), so build once per platform/CUDA variant.\n  # Windows is not supported yet.\n  skip:\n    - win\n    - not (match(python, python_min ~ \".*\") and is_abi3)\n  python:\n    version_independent: true\n  script:\n    env:\n      CMAKE_GENERATOR: Ninja\n      # Otherwise the version gets a local label, e.g. `0.1.14+cu130.gitabcdef`.\n      NO_VERSION_LABEL: \"1\"\n      USE_CUDA: ${{ \"ON\" if cuda_enabled else \"OFF\" }}\n      USE_ROCM: \"OFF\"\n    content:\n      # These are not needed for the build: CUTLASS comes from the `cutlass`\n      # package (see the patch above) and the HIP headers are only used by the\n      # ROCm backend, which is not enabled here. Removing them makes sure\n      # neither gets picked up or packaged by accident.\n      - rm -rf 3rdparty/cutlass 3rdparty/hip-headers\n      # Upstream's FindZ3 only looks inside the PyPI `z3-solver` wheel layout\n      # (NO_DEFAULT_PATH); point it at `libz3` from the prefix instead.\n      - export CMAKE_ARGS=\"${CMAKE_ARGS} -DPython3_EXECUTABLE=${PYTHON} -DZ3_INCLUDE_DIR=${PREFIX}/include -DZ3_LIBRARY=${PREFIX}/lib/libz3${SHLIB_EXT}\"\n      - export CMAKE_BUILD_PARALLEL_LEVEL=${CPU_COUNT}\n      - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - if: build_platform != host_platform\n      then:\n        - python\n        - cross-python_${{ host_platform }}\n        - cython >=3.1.0\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - if: cuda_enabled\n      then:\n        - ${{ compiler('cuda') }}\n    - cmake >=3.26.1\n    - ninja\n    # tvm-ffi builds its bundled libbacktrace with autotools\n    - make\n    - if: linux\n      then:\n        - patchelf >=0.17.2\n  host:\n    - python ${{ python_min }}.*\n    - python-abi3 ${{ python_min }}.*\n    - pip\n    - cython >=3.1.0\n    - scikit-build-core\n    # FindZ3.cmake imports `z3` at configure time; the library itself comes from libz3.\n    - z3-solver >=4.13.0,<4.15.5\n    - libz3\n    - if: cuda_enabled\n      then:\n        # Headers for the dlopen-based CUDA driver/runtime/NVRTC stubs; nothing\n        # links against the real CUDA libraries, so the package still imports on\n        # machines without a GPU.\n        # The stubs assert that the CUDA headers match nvcc's version.\n        - cuda-version ${{ cuda_compiler_version }}.*\n        - cuda-cudart-dev\n        - cuda-driver-dev\n        - cuda-nvrtc-dev\n  run:\n    - python >=${{ python_min }}\n    - apache-tvm-ffi >=0.1.11,<0.1.13\n    - torch-c-dlpack-ext\n    - cloudpickle\n    - ml_dtypes\n    - numpy >=1.23.5\n    - psutil\n    - pytorch >=2.4\n    - tqdm >=4.62.3\n    - typing_extensions >=4.10.0\n    - z3-solver >=4.13.0,<4.15.5\n    - if: osx\n      then:\n        # Upstream: \"jit-compiling a torch extension needs setuptools\"\n        - setuptools\n    - if: cuda_enabled\n      then:\n        # Loaded at runtime by the stub libraries.\n        - cuda-cudart\n        - cuda-nvrtc\n        # Header-only, and only consumed by the CUDA JIT at runtime (passed to\n        # nvcc/NVRTC as an -I flag), so it is not needed at build time. The\n        # upstream sdist vendors CUTLASS 4.1.0.\n        - cutlass >=4.1.0,<5\n\ntests:\n  - python:\n      imports:\n        - tilelang\n        - tilelang.cpu\n        - tilelang.engine\n        - tilelang.jit\n        - tilelang.language\n        - tilelang.utils\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - files:\n      recipe:\n        - test_package.py\n    requirements:\n      run:\n        - python ${{ python_min }}.*\n        - if: unix\n          then:\n            - abi3audit\n    script:\n      - python test_package.py ${{ version }} ${{ \"cuda\" if cuda_enabled else \"cpu\" }}\n      - if: unix\n        then:\n          - abi3audit \"$(python -c 'import importlib.util, os; print(os.path.dirname(importlib.util.find_spec(\"tilelang\").origin))')/lib/tilelang_cython_wrapper.abi3.so\" -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  homepage: https://github.com/tile-ai/tilelang\n  repository: https://github.com/tile-ai/tilelang\n  documentation: https://tilelang.com/\n  summary: A tile level programming language to generate high performance code.\n  description: |\n    Tile Language (tile-lang) is a concise domain-specific language designed to\n    streamline the development of high-performance GPU/CPU kernels (e.g., GEMM,\n    Dequant GEMM, FlashAttention, LinearAttention). It is built on top of TVM,\n    a vendored fork of which is included in this package.\n\n    Just-in-time compilation of CUDA kernels requires `nvcc`; install\n    `cuda-nvcc` alongside this package if you need it.\n  # tilelang itself is MIT. The vendored TVM (compiled into libtvm_*.so and\n  # shipped as headers/sources for the JIT) and tvm-ffi headers are Apache-2.0,\n  # and bring in the third-party code listed in 3rdparty/tvm/licenses.\n  license: MIT AND Apache-2.0 AND Apache-2.0 WITH LLVM-exception AND BSD-2-Clause AND BSD-3-Clause AND Unlicense\n  license_file:\n    - LICENSE\n    - THIRDPARTYNOTICES.txt\n    - 3rdparty/tvm/LICENSE\n    - 3rdparty/tvm/NOTICE\n    - 3rdparty/tvm/licenses/\n    - 3rdparty/tvm/3rdparty/tvm-ffi/LICENSE\n    - 3rdparty/tvm/3rdparty/tvm-ffi/NOTICE\n    - 3rdparty/tvm/3rdparty/tvm-ffi/licenses/LICENSE.dlpack.txt\n\nextra:\n  recipe-maintainers:\n    - iamthebot\n",
