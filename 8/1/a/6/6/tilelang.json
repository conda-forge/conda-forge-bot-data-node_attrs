  "linux_64_meta_yaml": {
    "about": {
      "description": "Tile Language (tile-lang) is a concise domain-specific language designed to\nstreamline the development of high-performance GPU/CPU kernels (e.g., GEMM,\nDequant GEMM, FlashAttention, LinearAttention). It is built on top of TVM,\na vendored fork of which is included in this package.\n\nJust-in-time compilation of CUDA kernels requires `nvcc`; install\n`cuda-nvcc` alongside this package if you need it.",
      "dev_url": "https://github.com/tile-ai/tilelang",
      "doc_url": "https://tilelang.com/",
      "home": "https://github.com/tile-ai/tilelang",
      "license": "MIT AND Apache-2.0 AND Apache-2.0 WITH LLVM-exception AND BSD-2-Clause AND BSD-3-Clause AND Unlicense",
      "license_family": "MIT AND Apache-2.0 AND Apache-2.0 WITH LLVM-exception AND BSD-2-Clause AND BSD-3-Clause AND Unlicense",
      "license_file": "LICENSE",
      "summary": "A tile level programming language to generate high performance code."
    },
    "build": {
      "number": "0",
      "python": {
        "version_independent": true
      },
      "script": {
        "content": [
          "rm -rf 3rdparty/cutlass 3rdparty/hip-headers",
          "export CMAKE_ARGS=\"${CMAKE_ARGS} -DPython3_EXECUTABLE=${PYTHON} -DZ3_INCLUDE_DIR=${PREFIX}/include -DZ3_LIBRARY=${PREFIX}/lib/libz3${SHLIB_EXT}\"",
          "export CMAKE_BUILD_PARALLEL_LEVEL=${CPU_COUNT}",
          "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
        ],
        "env": {
          "CMAKE_GENERATOR": "Ninja",
          "NO_VERSION_LABEL": "1",
          "USE_CUDA": "ON",
          "USE_ROCM": "OFF"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "iamthebot"
      ]
    },
    "outputs": [
