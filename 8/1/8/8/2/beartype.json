  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.23.1\"\n  # A concrete \"latest\" python for the solve/import/`pip check` test rather than `*`,\n  # which only entails \"some\" python. Update after annual migration moves out of `python_rc`.\n  python_check_max: \"3.15\"\n\npackage:\n  name: beartype\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/b/beartype/beartype-${{ version }}.tar.gz\n  sha256: 8b805f246b32931c74f2b321ea0939fe5bb2ff43c12a3eff19cc4c854b832e1d\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check --check-build-dependencies\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - hatchling >=1.14.0\n    - pip\n  run:\n    - python >=${{ python_min }}\n\ntests:\n  - package_contents:\n      strict: true\n      files:\n        - etc/conda/test-files/beartype/**\n      site_packages:\n        - beartype/**\n        - beartype-${{ version }}.dist-info/**\n  - python:\n      imports: beartype\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - ${{ python_check_max }}.*\n  - files:\n      source:\n        - beartype_test/**\n        - conftest.py\n        - pytest.ini\n        - README.rst\n    requirements:\n      run:\n        - python ${{ python_min }}.*\n        # required\n        - pytest >=6.2.0\n        # simple optionals without services/network/install from [test-tox]\n        - click\n        - coverage\n        - numba\n        - numpy\n        - pandas\n        - pandera\n        - polars\n        - pygments\n        - rich-click\n        - sphinx\n        - sqlalchemy-with-asyncio\n        - typer\n        - typing_extensions\n        - xarray\n    script:\n      # see: https://github.com/beartype/beartype/issues/744\n      # tes