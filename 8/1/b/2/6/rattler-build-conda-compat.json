  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.4.19\"\n\npackage:\n  name: rattler-build-conda-compat\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/prefix-dev/rattler-build-conda-compat/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: bc69a8523d32e932fd979ac45d5381859105857d68928eae8bf72bb33d49b7b3\n\nbuild:\n  number: 1\n  noarch: python\n  script:\n    # Need to use SETUPTOOLS_SCM_PRETEND_VERSION as GitHub release tarballs don't contain a .git directory\n    env:\n      SETUPTOOLS_SCM_PRETEND_VERSION: ${{ version }}\n    content: ${{ PYTHON }} -m pip install . -vv\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - hatchling >=1.24.0\n    - hatch-vcs\n  run:\n    - python >=${{ python_min }}\n    - rattler-build\n    - conda-build\n    - typing-extensions >=4.12.2,<5\n    - tomli\n    - ruamel.yaml >=0.18.6,<0.19\n    - jinja2 >=3.0.2,<4\n    - pygithub\n\ntests:\n  - python:\n      imports:\n        - rattler_build_conda_compat.loader\n        - rattler_build_conda_compat.render\n        - rattler_build_conda_compat.conditional_list\n        - rattler_build_conda_compat.recipe_sources\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - downstream: conda-smithy >=3.61.1\n  - files:\n      source:\n        - tests/\n    requirements:\n      run:\n        - python ${{ python_min }}.*\n        - pytest\n        # Upstream's snapshots are written with syrupy 4, and syrupy 6 serializes\n        # dataclasses differently, failing the tests/test_recipe_sources.py\n        # snapshots. Match the pin in upstream's pixi.toml and update it when\n        # upstream regenerates the snapshots with a newer syrupy.\n        - syrupy >=4.6.1,<5\n    script:\n      - pytest ./tests\n\nabout:\n  summary: rattler-build module which offer compatibility with conda-smithy\n  description: |\n    rattler-build module which offer compatibility with conda-smithy\n  license: BSD-3-Clause\n  license_file: LICENSE.txt\n  homepage: https://github.com/prefix-dev/rattler-build-conda-compat\n  repository: https://github.com/prefix-dev/rattler-build-conda-compat\n\nextra:\n  recipe-maintainers:\n    - Hofer-Julian\n    - baszalmstra\n    - minrk\n    - nichmor\n    - tdejager\n",
