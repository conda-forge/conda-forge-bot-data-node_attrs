  "raw_meta_yaml": "context:\n  version: \"1.4.2\"\n\npackage:\n  name: bun\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/oven-sh/bun/archive/refs/tags/bun-v${{ version }}.tar.gz\n    sha256: e14670b117d69012d828514d657f0a3133d1c25d13d69461184d05b6a8e9a876\n    patches:\n      - 0001-Disable-Werror.patch\n      - 0002-Don-t-statically-link-libstdc-and-libgcc.patch\n      - 0003-Disable-ld_new.patch\n      - 0004-Use-prebuilt-Rust-std-for-release-builds.patch\n      - 0005-Support-cross-compiling-with-conda-forge-s-compilers.patch\n      - 0006-Use-the-macOS-SDK-from-the-conda-build-environment.patch\n      - 0007-Allow-linking-selected-dependencies-from-the-system.patch\n      - 0008-Set-the-build-revision-to-a-placeholder.patch\n  - if: build_platform == \"osx-64\"\n    then:\n      url: https://github.com/oven-sh/bun/releases/download/bun-v${{ version }}/bun-darwin-x64.zip\n      sha256: 80520d7e17526308c9185d261679ac6d27798d3803a0e9f7ff9121ab8affb012\n      target_directory: bun.native\n  - if: build_platform == \"osx-arm64\"\n    then:\n      url: https://github.com/oven-sh/bun/releases/download/bun-v${{ version }}/bun-darwin-aarch64.zip\n      sha256: 90987a3a16d7db556d886ac3d551e7b6d3edf0a1cf43acaed622e8676be1d12f\n      target_directory: bun.native\n  - if: build_platform == \"linux-aarch64\"\n    then:\n      url: https://github.com/oven-sh/bun/releases/download/bun-v${{ version }}/bun-linux-aarch64.zip\n      sha256: 54328bbc2d9c8e0c9f892c544d66c57a83b84139e34909e5ee81758f1ac8fda7\n      target_directory: bun.native\n  - if: build_platform == \"linux-64\"\n    then:\n      url: https://github.com/oven-sh/bun/releases/download/bun-v${{ version }}/bun-linux-x64-baseline.zip\n      sha256: c678040f14fe0440eb839d37cbd0ce4c051a32da72806ac97de6a6aab6bf728f\n      target_directory: bun.native\n  - if: build_platform == \"win-64\"\n    then:\n      url: https://github.com/oven-sh/bun/releases/download/bun-v${{ version }}/bun-windows-x64.zip\n      sha256: ce4c17497b2f29712a99d3d53f028de28cd42e3bacb8589599e7f000e49b6405\n      target_directory: bun.native\n  # simdutf is statically linked via the prebuilt WebKit, which doesn't ship its license\n  - url: https://raw.githubusercontent.com/simdutf/simdutf/refs/heads/master/LICENSE-MIT\n    sha256: fc8dbc04e03ad4efc08a647ffe7f995b811a95bc04c0e85a56d5277c6593fa5f\n    file_name: simdutf-LICENSE-MIT\n  - url: https://raw.githubusercontent.com/simdutf/simdutf/refs/heads/master/LICENSE-APACHE\n    sha256: 3d34610fc6b5e1b0bfe4e2f36171c2d62c28ef05cb8d704f5a0073be41a43b3d\n    file_name: simdutf-LICENSE-APACHE\n\nbuild:\n  number: 1\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    # nightly rust from conda-forge/label/rust_dev (see conda_build_config.yaml)\n    - ${{ compiler('rust') }}\n    - ${{ stdlib('c') }}\n    - if: linux\n      then:\n        # ensure libstdcxx-devel version matches libgcc-devel so that\n        # clang can find the C++ standard library headers\n        - libstdcxx-devel_linux-64 >=15\n    - cargo-bundle-licenses\n    - cmake\n    - git\n    - if: unix\n      then:\n        - lld ${{ c_compiler_version }}.*\n        - llvm-tools ${{ c_compiler_version }}.*\n        - sed\n    - if: win\n      then:\n        # clang-cl, lld-link, llvm-lib and llvm-rc; the MSVC headers and\n        # libraries come from the vs2022 compiler activation\n        - clang 21.*\n        - lld 21.*\n        - llvm-tools 21.*\n        # BoringSSL's and libjpeg-turbo's x64 assembly\n        - nasm\n        # the Windows .bin/ shim is built with -Zbuild-std\n        - rust-src\n    - ninja\n    - perl\n    - pkg-config\n  host:\n    # unpatched upstream dependencies, used instead of the vendored copies\n    # (see BUN_SYSTEM_DEPS in build.sh and build.bat)\n    # headers of libbrotli{common,dec,enc}\n    - brotli\n    - hdrhistogram-c\n    - libdeflate\n    - libhwy\n    - libjpeg-turbo\n    - libwebp-base\n    - if: unix\n      then:\n        # not available on Windows, vendored there\n        - ls-hpack\n    - zlib\n    - zstd\n    - if: not osx\n      then:\n        # on macOS, bun loads the system's libsqlite3 at runtime\n        - libsqlite\n\ntests:\n  - package_contents:\n      bin:\n        - bun\n        - bunx\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/bun\n            - share/zsh/site-functions/_bun\n            - share/fish/vendor_completions.d/bun.fish\n      strict: true\n  - script:\n      - bun --version\n      - bun --help\n      - bunx --version\n      # simple smoke test\n      - bunx cowsay hello\n\nabout:\n  homepage: https://bun.sh\n  repository: https://github.com/oven-sh/bun\n  license: MIT\n  license_file:\n    - LICENSE.md\n    - picohttp-LICENSE-MIT\n    - packages/bun-usockets/LICENSE\n    - packages/bun-uws/LICENSE\n    - src/clap/LICENSE\n    - simdutf-LICENSE-MIT\n    - simdutf-LICENSE-APACHE\n    # Rust crate licenses, generated by cargo-bundle-licenses in build.sh\n    - THIRDPARTY.yml\n    # licenses of the statically linked vendored C/C++ dependencies,\n    # collected from vendor/ in build.sh\n    - vendored-licenses/\n  summary: Bun is a fast all-in-one JavaScript runtime\n\nextra:\n  recipe-maintainers:\n    - xhochy\n    - pavelzw\n    - I-Al-Istannen\n",
