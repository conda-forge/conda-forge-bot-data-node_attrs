  "raw_meta_yaml": "context:\n  version: \"0.4.0\"\n\npackage:\n  name: fsspec-browser\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/f/fsspec-browser/fsspec_browser-${{ version }}.tar.gz\n  sha256: 479440beedfa9c6025b7a1316712c8529fd60fb3a1da188ec44bfb9d0f700229\n\nbuild:\n  number: 0\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n  script:\n    - if: unix\n      then:\n        - export PYO3_PYTHON=\"$PYTHON\"\n        - export RUSTFLAGS=\"\"\n      else:\n        - set \"PYO3_PYTHON=%PYTHON%\"\n        - set \"RUSTFLAGS=\"\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - crossenv\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - if: linux\n      then:\n        - pkg-config\n  host:\n    - python\n    - pip\n    - hatchling\n    - hatch-js >=0.1.4\n    - hatch-rs >=0.6.0\n    - fsspec-rs >=0.2.1,<0.3\n    - pnpm\n    - if: is_abi3\n      then:\n        - python-abi3\n  run:\n    - python\n    - fsspec\n    - fsspec-data >=0.6.0\n    - fsspec-rs >=0.2.1,<0.3\n\ntests:\n  - python:\n      imports:\n        - fsspec_browser\n      pip_check: true\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/fsspec_browser/fsspec_browser.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%/fsspec_browser/fsspec_browser.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  summary: terminal and web browser for fsspec backends\n  homepage: https://github.com/1kbgz/fsspec-browser\n  repository: https://github.com/1kbgz/fsspec-browser\n\nextra:\n  recipe-maintainers:\n    - timkpaine\n",
