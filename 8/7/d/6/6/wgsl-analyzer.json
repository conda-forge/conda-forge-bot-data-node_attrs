  "raw_meta_yaml": "context:\n  version: \"2026.09.30\"\n  # Upstream tags releases by date, e.g. YYYY-MM-DD\n  tag: ${{ version | replace(\".\", \"-\") }}\n\nrecipe:\n  name: wgsl-analyzer\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/wgsl-analyzer/wgsl-analyzer/archive/refs/tags/${{ tag }}.tar.gz\n  sha256: 656ca21fc1e37bc8c1bab25c434b315ba910d4f6702ee6905e20e9860e8f482c\n\nbuild:\n  number: 1\n\noutputs:\n  - staging:\n      name: wgsl-analyzer-build\n    requirements:\n      build:\n        - ${{ compiler('rust') }}\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - cargo-auditable\n        - cargo-bundle-licenses\n    build:\n      script:\n        env:\n          CARGO_PROFILE_RELEASE_STRIP: symbols\n          CARGO_PROFILE_RELEASE_LTO: fat\n        content:\n          - cd crates/wgsl-analyzer && cargo-bundle-licenses --format yaml --output ../../THIRDPARTY-wgsl-analyzer.yml && cd ../..\n          - cd crates/wgslfmt && cargo-bundle-licenses --format yaml --output ../../THIRDPARTY-wgslfmt.yml && cd ../..\n          - if: unix\n            then:\n              - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path crates/wgsl-analyzer\n              - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path crates/wgslfmt\n            else:\n              - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path crates/wgsl-analyzer\n              - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path crates/wgslfmt\n\n  - package:\n      name: wgsl-analyzer\n    inherit: wgsl-analyzer-build\n    build:\n      files:\n        - if: unix\n          then: bin/wgsl-analyzer\n          else: Library/bin/wgsl-analyzer.exe\n    tests:\n      - script:\n          - wgsl-analyzer --version\n          - wgsl-analyzer --help\n      - package_contents:\n          strict: true\n          bin:\n            - wgsl-analyzer\n    about:\n      summary: A language server implementation for WGSL and WESL\n      description: |\n        wgsl-analyzer is a language server for WGSL (WebGPU Shading Language) and\n        WESL, providing completions, diagnostics, go-to-definition, hover and more\n        to any LSP-compatible editor.\n      license_file:\n        - LICENSE-MIT\n        - LICENSE-APACHE\n        - THIRDPARTY-wgsl-analyzer.yml\n\n  - package:\n      name: wgslfmt\n    inherit: wgsl-analyzer-build\n    build:\n      files:\n        - if: unix\n          then: bin/wgslfmt\n          else: Library/bin/wgslfmt.exe\n    tests:\n      - script:\n          - wgslfmt --version\n          - wgslfmt --help\n      - package_contents:\n          strict: true\n          bin:\n            - wgslfmt\n    about:\n      summary: Tool to find and fix WGSL/WESL formatting issues\n      description: |\n        wgslfmt formats WGSL (WebGPU Shading Language) and WESL source files and\n        can check them for formatting issues, e.g. in CI.\n      license_file:\n        - LICENSE-MIT\n        - LICENSE-APACHE\n        - THIRDPARTY-wgslfmt.yml\n\nabout:\n  homepage: https://wgsl-analyzer.github.io\n  summary: Language server and formatter for WGSL and WESL\n  license: MIT OR Apache-2.0\n  # each output overrides this with its own bundled third-party licenses\n  license_file:\n    - LICENSE-MIT\n    - LICENSE-APACHE\n  repository: https://github.com/wgsl-analyzer/wgsl-analyzer\n  documentation: https://wgsl-analyzer.github.io\n\nextra:\n  recipe-maintainers:\n    - VasanthakumarV\n",
