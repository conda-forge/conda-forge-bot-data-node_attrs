  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.70.0\"\n\nrecipe:\n  name: nghttp2\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/nghttp2/nghttp2/releases/download/v${{ version }}/nghttp2-${{ version }}.tar.gz\n  sha256: aa317e2cf9dca6afa0aed68f8fad6ff303ec6982e25a78c75c0b65e2b9b3ded5\n\nbuild:\n  number: 0\n\noutputs:\n  - staging:\n      name: nghttp2-build\n    build:\n      script:\n        file: ${{ \"build.bat\" if win else \"build.sh\" }}\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - if: win\n          then:\n            - cmake\n            - ninja\n          else:\n            - libtool\n            - make\n            - pkg-config\n      host:\n        - if: unix\n          then:\n            - zlib\n            - openssl\n            # Unconstrained entries let migrators apply global pins.\n            - libev\n            - libev >=4.11\n            - c-ares\n            - c-ares >=1.7.5\n\n  - package:\n      name: libnghttp2\n    inherit: nghttp2-build\n    build:\n      script:\n        file: ${{ \"install.bat\" if win else \"install.sh\" }}\n      files:\n        - if: unix\n          then:\n            - include/nghttp2/nghttp2*\n            - lib/libnghttp2*\n            - lib/nghttp2*\n            - lib/pkgconfig/libnghttp2*\n            - bin/nghttp*\n          else:\n            - Library/**\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - if: win\n          then:\n            - cmake\n            - ninja\n          else:\n            - make\n            - pkg-config\n      host:\n        - if: unix\n          then:\n            - zlib\n            - openssl\n            - libev\n            - libev >=4.11\n            - c-ares\n            - c-ares >=1.7.5\n      run:\n        - if: unix\n          then: ${{ pin_compatible('libev') }}\n      run_exports:\n        - ${{ pin_subpackage('libnghttp2') }}\n    tests:\n      - script:\n          - if: unix\n            then:\n              - nghttp -nv https://nghttp2.org\n              - test ! -f ${PREFIX}/lib/libnghttp2.a\n          - if: linux\n            then: test -f ${PREFIX}/lib/libnghttp2.so\n          - if: osx\n            then: test -f ${PREFIX}/lib/libnghttp2.dylib\n          - if: win\n            then:\n              - if not exist %PREFIX%\\Library\\bin\\nghttp2.dll exit 1\n              - if not exist %PREFIX%\\Library\\lib\\nghttp2.lib exit 1\n\n  - package:\n      name: libnghttp2-static\n    inherit: nghttp2-build\n    build:\n      skip: win\n      script: install.sh\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - make\n      host:\n        - ${{ pin_subpackage('libnghttp2', exact=True) }}\n        - openssl\n        - zlib\n      run:\n        - ${{ pin_subpackage('libnghttp2', exact=True) }}\n        - libev-static\n        - c-ares-static\n    tests:\n      - script: test -f ${PREFIX}/lib/libnghttp2.a\n\nabout:\n  homepage: https://github.com/nghttp2/nghttp2\n  license: MIT\n  license_file: COPYING\n  summary: This is an implementation of Hypertext Transfer Protocol version 2.\n  description: |\n    This is an implementation of the Hypertext Transfer Protocol version 2 in C.\n\n    The framing layer of HTTP/2 is implemented as a reusable C library. On top\n    of that, we have implemented an HTTP/2 client, server and proxy. We have\n    also developed load test and benchmarking tools for HTTP/2.\n  documentation: https://nghttp2.org/documentation/\n  repository: https://github.com/nghttp2/nghttp2\n\nextra:\n  recipe-maintainers:\n    - cpaulik\n    - mariusvniekerk\n    - wolfv\n",
