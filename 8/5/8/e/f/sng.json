  "linux_64_meta_yaml": {
    "about": {
      "description": "SNG (Scriptable Network Graphics) is a minilanguage designed specifically to\nrepresent the entire contents of a PNG (Portable Network Graphics) file in an\neditable form. Thus, SNGs representing elaborate graphics images and ancillary\nchunk data can be readily generated or modified using only text tools.\n\nSNG is implemented by a compiler/decompiler called sng that losslessly\ntranslates between SNG and PNG.",
      "dev_url": "https://git.code.sf.net/p/sng/code",
      "home": "https://sng.sourceforge.net/",
      "license": "Zlib",
      "license_family": "Zlib",
      "license_file": "COPYING",
      "summary": "Enable lossless editing of PNGs via a textual representation."
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "export CFLAGS=\"${CFLAGS} -Wno-array-bounds -Wno-stringop-truncation -Wno-stringop-overflow\"",
          "make sng VERSION=\"${{ version }}\" PREFIX=\"${{ PREFIX }}\" RGBTXT=\"${{ PREFIX }}/share/netpbm/rgb.txt\"",
          "make install-bin",
          "mv ${PREFIX}/bin/bin/sng ${PREFIX}/bin/sng"
        ]
      }
    },
    "extra": {
      "recipe-maintainers": [
        "bollwyvl"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "sng",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "c_stdlib_stub",
            "make"
          ],
          "host": [
            "libpng",
            "netpbm"
          ],
          "run": []
        },
        "tests": [
          {
            "package_contents": {
              "bin": [
                "sng"
              ],
              "strict": true
            }
          },
          {
            "script": [
              "sng -V",
              "sng -V | grep -iE \"sng version ${{ version | replace(\".\", \"\\\\.\") }} \""
            ]
          }
        ],
        "version": "1.1.2"
      }
    ],
