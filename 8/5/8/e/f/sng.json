  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"1.1.2\"\n\npackage:\n  name: sng\n  version: ${{ version }}\n\nsource:\n  - url: http://sourceforge.net/projects/sng/files/sng-${{ version }}.tar.gz\n    sha256: e6938a66ce3b6fafb0c6e6b809f8ddf662c6a962279278c4a627924761336f93\n  - url: https://sourceforge.net/p/sng/code/ci/${{ version }}/tree/COPYING?format=raw\n    sha256: 7dbbdc18f4336dffe72f10a3fd6341727012c87960c4827fab12d12674c927cc\n    file_name: COPYING\n\nbuild:\n  number: 0\n  skip: win\n  script:\n    content:\n      - if: linux\n        then:\n          - export CFLAGS=\"${CFLAGS} -Wno-array-bounds -Wno-stringop-truncation -Wno-stringop-overflow\"\n        else:\n          # error: unknown warning option '-Wno-stringop-truncation'; did you mean '-Wno-format-truncation'? [-Werror,-Wunknown-warning-option]\n          # error: unknown warning option '-Wno-stringop-overflow'; did you mean '-Wno-shift-overflow'? [-Werror,-Wunknown-warning-option]\n          - export CFLAGS=\"${CFLAGS} -Wno-array-bounds -Wno-format-truncation -Wno-shift-overflow\"\n      - make sng VERSION=\"${{ version }}\" PREFIX=\"${{ PREFIX }}\" RGBTXT=\"${{ PREFIX }}/share/netpbm/rgb.txt\"\n      - make install-bin\n      - mv ${PREFIX}/bin/bin/sng ${PREFIX}/bin/sng\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - make\n  host:\n    - libpng\n    - netpbm\n\ntests:\n  - package_contents:\n      strict: true\n      bin:\n        - sng\n  - script:\n      - sng -V\n      - sng -V | grep -iE \"sng version ${{ version | replace(\".\", \"\\\\.\") }} \"\n\nabout:\n  summary: Enable lossless editing of PNGs via a textual representation.\n  description: |\n    SNG (Scriptable Network Graphics) is a minilanguage designed specifically to\n    represent the entire contents of a PNG (Portable Network Graphics) file in an\n    editable form. Thus, SNGs representing elaborate graphics images and ancillary\n    chunk data can be readily generated or modified using only text tools.\n\n    SNG is implemented by a compiler/decompiler called sng that losslessly\n    translates between SNG and PNG.\n  license: Zlib\n  license_file: COPYING\n  homepage: https://sng.sourceforge.net\n  repository: https://git.code.sf.net/p/sng/code\n\nextra:\n  recipe-maintainers:\n    - bollwyvl\n",
