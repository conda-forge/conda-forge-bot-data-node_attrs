  "raw_meta_yaml": "context:\n  version: \"0.3.28\"\n\npackage:\n  name: phraze\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/sts10/phraze/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 4f5565867777a225651d774f5ba3143fcd4833019cc7ecb5a16cb146f18d64db\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build main app and generate license data\n      - cargo auditable install --path=. --root=($prefix) --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml\n      # copy shell completion files and man page\n      - mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions ($prefix)/share/man/man1\n      - cp target/completions/phraze.bash ($prefix)/share/bash-completion/completions/phraze\n      - cp target/completions/phraze.fish ($prefix)/share/fish/vendor_completions.d/phraze.fish\n      - cp target/completions/_phraze     ($prefix)/share/zsh/site-functions/_phraze\n      - cp target/man/phraze.1            ($prefix)/share/man/man1/phraze.1\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - nushell\n\ntests:\n  - script:\n      - phraze --help\n      - phraze --version\n  - package_contents:\n      bin:\n        - phraze\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/phraze\n            - share/fish/vendor_completions.d/phraze.fish\n            - share/zsh/site-functions/_phraze\n            - share/man/man1/phraze.1\n        - if: win\n          then:\n            - Library/share/bash-completion/completions/phraze\n            - Library/share/fish/vendor_completions.d/phraze.fish\n            - Library/share/zsh/site-functions/_phraze\n            - Library/share/man/man1/phraze.1\n      strict: true\n\nabout:\n  summary: Random passphrase generator\n  description: |\n    Phraze is a random passphrase generator that generates passphrases with\n    user-configurable entropy, word counts, and built-in word lists. It is\n    fast, supports a variety of separator options, and can include numbers,\n    symbols, and capital letters.\n  license: MPL-2.0\n  license_file:\n    - LICENSE.txt\n    - THIRDPARTY.yml\n  homepage: https://github.com/sts10/phraze\n  repository: https://github.com/sts10/phraze\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
