  "raw_meta_yaml": "context:\n  version: \"0.4.0\"\n\npackage:\n  name: edgehop\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ytausch/edgehop/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 8580c46d98b158b514e8ec9460737b68c7ea4496ee563895f7fe1487817f4c86\n\nbuild:\n  number: 0\n  # edgehop only supports macOS and Windows\n  skip: linux\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - if: unix\n        then:\n          - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .\n        else:\n          - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path .\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n\ntests:\n  - script: edgehop --help\n  - package_contents:\n      bin:\n        - edgehop\n      strict: true\n\nabout:\n  homepage: https://github.com/ytausch/edgehop\n  summary: Switch Logitech Easy-Switch devices when the cursor hits a screen edge\n  description: |\n    Push the mouse cursor against an outer edge of the screen, and your Logitech\n    Easy-Switch keyboard and mouse switch to another computer.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  repository: https://github.com/ytausch/edgehop\n\nextra:\n  recipe-maintainers:\n    - ytausch\n",
