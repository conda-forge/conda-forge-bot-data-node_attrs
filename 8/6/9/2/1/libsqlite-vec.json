  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.1.9\"\n\nrecipe:\n  name: sqlite-vec\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/asg017/sqlite-vec/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 9823e737d9934dcbe85dff75d3fca81018a9beee803d70fa77b16faab5d61dc9\n  patches:\n    - 0001-respect-build-flags.patch\n    - 0002-avoid-using-uv-in-tests.patch\n\nbuild:\n  number: 1\n\noutputs:\n  - package:\n      name: libsqlite-vec\n    build:\n      script:\n        - if: unix\n          then: build.sh\n          else: build.bat\n    requirements:\n      build:\n        - ${{ stdlib(\"c\") }}\n        - ${{ compiler('c') }}\n        - gettext  # envsubst for sqlite-vec.h generation\n        - if: unix\n          then: make\n        - if: win\n          then:\n            - m2-bash\n            - m2-coreutils\n            - m2-sed\n            - m2-make\n      host:\n        - libsqlite\n      run:\n        - libsqlite\n      # sqlite-vec use sqlite's table interface API, not a linked libsqlite.\n      ignore_run_exports:\n        by_name:\n          - libsqlite\n    tests:\n      - script: bash test_libsqlite-vec.sh\n        files:\n          source:\n            - tests/\n            - Makefile\n          recipe:\n            - test_libsqlite-vec.sh\n        requirements:\n          run:\n            - python >=${{ python_min }}\n            - pytest\n            - numpy\n            - syrupy\n            - if: unix\n              then: make\n            - if: win\n              then:\n                - m2-bash\n                - m2-coreutils\n                - m2-sed\n                - m2-make\n  - package:\n      name: sqlite-vec-python\n    build:\n      noarch: python\n      script:\n        content:\n          - python -m pip install \"${{ RECIPE_DIR }}/sqlite-vec-python\" -vv --no-build-isolation --no-deps\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - setuptools\n        - pip\n      run:\n        - python >=${{ python_min }}\n        - libsqlite-vec ==${{ version }}\n        - numpy\n    tests:\n      - python:\n          imports:\n            - sqlite_vec\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n      - script:\n          - >-\n              python -c \"import sqlite3, sqlite_vec;\n              db = sqlite3.connect(':memory:');\n              db.enable_load_extension(True);\n              sqlite_vec.load(db);\"\n          - >-\n              python -c \"import sqlite_vec, importlib.metadata;\n              assert '${{ version }}' == importlib.metadata.version('sqlite-vec'), 'Version mismatch, please update recipe/sqlite-vec/pyproject.toml';\n              assert '${{ version }}' == sqlite_vec.__version__, 'Version mismatch, please update recipe/sqlite-vec/sqlite_vec/__init__.py';\"\n\nabout:\n  homepage: https://github.com/asg017/sqlite-vec\n  summary: SQLite loadable extension for vector search\n  description: |\n    sqlite-vec is a SQLite loadable extension providing vector search\n    functionality through the vec0 virtual table and vec_* SQL functions.\n  license: MIT OR Apache-2.0\n  license_file:\n    - LICENSE-MIT\n    - LICENSE-APACHE\n  repository: https://github.com/asg017/sqlite-vec\n  documentation: https://alexgarcia.xyz/sqlite-vec/\n\nextra:\n  feedstock-name: libsqlite-vec\n  recipe-maintainers:\n    - jsmolic\n",
