  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"6.0\"\n  # test_imessagecatalog and locales test_xmlfactory only hold abstract base\n  # cases that zope.testrunner builds via test_suite(), so they are left out\n  test_modules:\n    - zope.i18n.locales.tests.test_docstrings\n    - zope.i18n.locales.tests.test_fallbackcollator\n    - zope.i18n.locales.tests.test_locales\n    - zope.i18n.tests.test\n    - zope.i18n.tests.test_formats\n    - zope.i18n.tests.test_gettextmessagecatalog\n    - zope.i18n.tests.test_itranslationdomain\n    - zope.i18n.tests.test_negotiator\n    - zope.i18n.tests.test_plurals\n    - zope.i18n.tests.test_simpletranslationdomain\n    - zope.i18n.tests.test_testmessagecatalog\n    - zope.i18n.tests.test_translationdomain\n    - zope.i18n.tests.test_zcml\n    - zope.i18n.tests.testi18nawareobject\n\npackage:\n  name: zope.i18n\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/z/zope.i18n/zope_i18n-${{ version }}.tar.gz\n  sha256: 93bd26a20c931cd5ac14c5f36fc3f62e4a98b37bb7ac7cc5e646cba34dac7dc8\n  patches:\n    # compile .po files with msgfmt from gettext-tools instead of the\n    # unmaintained python-gettext, as Debian does\n    # https://github.com/zopefoundation/zope.i18n/issues/16\n    - use-msgfmt.patch\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n  run:\n    - python >=${{ python_min }}\n    - setuptools\n    - gettext-tools\n    - pytz\n    - zope.deprecation\n    - zope.schema\n    - zope.i18nmessageid >=4.3\n    - zope.component\n\ntests:\n  - python:\n      imports:\n        - zope.i18n\n        - zope.i18n.compile\n        - zope.i18n.translationdomain\n        - zope.i18n.locales\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      # on win, test_po_exists_cannot_write_mo passes but its cleanup can't\n      # remove the read-only .mo it creates, so only the other compile tests run\n      - if: win\n        then: python -m unittest -v ${{ test_modules | join(\" \") }} zope.i18n.tests.test_compile.TestCompile.test_non_existant_path zope.i18n.tests.test_compile.TestCompile.test_po_exists_but_invalid\n        else: python -m unittest -v ${{ test_modules | join(\" \") }} zope.i18n.tests.test_compile\n    requirements:\n      run:\n        - zope.configuration\n        - zope.testing\n\nabout:\n  homepage: https://github.com/zopefoundation/zope.i18n\n  repository: https://github.com/zopefoundation/zope.i18n\n  documentation: https://zopei18n.readthedocs.io\n  summary: Zope Internationalization Support\n  license: ZPL-2.1\n  license_file:\n    - LICENSE.txt\n    - COPYRIGHT.txt\n\nextra:\n  recipe-maintainers:\n    - killua156\n",
