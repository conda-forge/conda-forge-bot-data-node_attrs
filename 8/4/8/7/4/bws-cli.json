  "raw_meta_yaml": "context:\n  version: \"2.1.0\"\n\npackage:\n  name: bws-cli\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/bitwarden/sdk-sm/archive/refs/tags/bws-v${{ version }}.tar.gz\n  sha256: 3ea669ae57b1d3090f98ff2c09894b4da0bf2c700a4f8d79f70a0f96615cd9ed\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - if: unix\n        then:\n          - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path crates/bws\n        else:\n          - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path crates/bws\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n      - if: unix\n        then:\n          - mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d\n          - $PREFIX/bin/bws completions zsh > $PREFIX/share/zsh/site-functions/_bws\n          - $PREFIX/bin/bws completions bash > $PREFIX/share/bash-completion/completions/bws\n          - $PREFIX/bin/bws completions fish > $PREFIX/share/fish/vendor_completions.d/bws.fish\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n\ntests:\n  - script: bws --help\n  - package_contents:\n      bin:\n        - bws\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/bws\n            - share/fish/vendor_completions.d/bws.fish\n            - share/zsh/site-functions/_bws\n      strict: true\n\nabout:\n  homepage: https://github.com/bitwarden/sdk-sm\n  summary: Bitwarden Secrets Manager CLI\n  description: |\n    bws is the official CLI for Bitwarden Secrets Manager.\n    It allows developers and CI/CD pipelines to retrieve, create, and manage secrets\n    without embedding credentials in code or configuration files.\n  license: LicenseRef-Bitwarden-SDK\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  documentation: https://docs.rs/bws\n  repository: https://github.com/bitwarden/sdk-sm\n\nextra:\n  recipe-maintainers:\n    - phreed\n",
