  "linux_64_meta_yaml": {
    "about": {
      "description": "bws is the official CLI for Bitwarden Secrets Manager.\nIt allows developers and CI/CD pipelines to retrieve, create, and manage secrets\nwithout embedding credentials in code or configuration files.",
      "dev_url": "https://github.com/bitwarden/sdk-sm",
      "doc_url": "https://docs.rs/bws",
      "home": "https://github.com/bitwarden/sdk-sm",
      "license": "LicenseRef-Bitwarden-SDK",
      "license_family": "LicenseRef-Bitwarden-SDK",
      "license_file": "LICENSE",
      "summary": "Bitwarden Secrets Manager CLI"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path crates/bws",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml",
          "mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d",
          "$PREFIX/bin/bws completions zsh > $PREFIX/share/zsh/site-functions/_bws",
          "$PREFIX/bin/bws completions bash > $PREFIX/share/bash-completion/completions/bws",
          "$PREFIX/bin/bws completions fish > $PREFIX/share/fish/vendor_completions.d/bws.fish"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "phreed"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "bws-cli",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-bundle-licenses",
            "cargo-auditable"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": "bws --help"
          },
          {
            "package_contents": {
