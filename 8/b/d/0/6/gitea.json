  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: gitea\n  version: \"28.3.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/go-gitea/${{ name }}/archive/v${{ version }}.tar.gz\n  sha256: c2060e8ccf89c07764f834d2e96a3fdbd3d2f203cd49b99415ab1fd827192e56\n\nbuild:\n  # Can't currently build on Windows, but config is kept so we can try again in future\n  number: 0\n  skip: win\n\nrequirements:\n  build:\n    - ${{ compiler('cgo') }} 1.27.*\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n    - if: not win\n      then: file\n    - go-licenses\n    - make\n    - nodejs >=20\n    - pnpm\n    # Makefile uses some unix bash commands\n    - if: win\n      then: m2-filesystem\n    - if: win\n      then: m2-bash\n    - if: win\n      then: m2-base\n    - if: win\n      then: m2-grep\n    - if: win\n      then: m2-sed\n  run:\n    - git\n\ntests:\n  - script:\n      - gitea --version\n      - gitea --help\n\nabout:\n  license: MIT\n  license_file:\n    - LICENSE\n    - license-files/\n  summary: Git with a cup of tea\n  description: |\n    The goal of this project is to make the easiest, fastest, and most\n    painless way of setting up a self-hosted Git service.\n  homepage: https://about.gitea.com\n  repository: https://github.com/go-gitea/gitea\n  documentation: https://docs.gitea.com\n\nextra:\n  recipe-maintainers:\n    - manics\n    - nehaljwani\n    - techknowlogick\n",
