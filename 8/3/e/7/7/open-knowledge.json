  "raw_meta_yaml": "context:\n  version: \"0.89.11\"\n\npackage:\n  name: open-knowledge\n  version: ${{ version }}\n\nsource:\n  - url: https://registry.npmjs.org/@inkeep/open-knowledge/-/open-knowledge-${{ version }}.tgz\n    sha256: f994bbcaee9192a55a947c3b4bc485500853d225c93af410ffce1f320824b490\n  # The npm tarball ships prebuilt native bindings only, build them from here.\n  - url: https://github.com/inkeep/open-knowledge/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 8c0183a2ad5c91013350e5fc07ab411db3228b603f57fab1a9de60a8e0cc0610\n    target_directory: repo\n    patches:\n      # Use conda-forge's Rust compiler instead of requiring upstream's exact patch release.\n      - conda-rust-toolchain.patch\n\nbuild:\n  number: 0\n  dynamic_linking:\n    binary_relocation: false\n  script:\n    - if: win\n      then:\n        - call npm pack --ignore-scripts\n        - call npm install --global --ignore-scripts --omit=optional --prefix \"%PREFIX%\\lib\" inkeep-open-knowledge-${{ version }}.tgz\n        - cd repo\\packages\\native-config\n        - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n        - cargo build --release --locked\n        - node \"%RECIPE_DIR%\\build.js\"\n      else:\n        - npm pack --ignore-scripts\n        - npm install --global --ignore-scripts --omit=optional inkeep-open-knowledge-${{ version }}.tgz\n        - cd repo/packages/native-config\n        - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n        - cargo build --release --locked\n        - node \"$RECIPE_DIR/build.js\"\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n  host:\n    - nodejs >=24\n  run:\n    - git\n    - nodejs >=24\n    - napi-rs-keyring ==2.1.2\n    - parcel-watcher >=2.5.6,<3\n\ntests:\n  - files:\n      recipe:\n        - test.cjs\n    script:\n      - node test.cjs\n      - ok --version\n      - ok --help\n      - ok config validate\n      - open-knowledge --version\n\nabout:\n  homepage: https://openknowledge.ai/\n  summary: Beautiful, AI-native markdown editor and LLM wiki\n  description: |\n    OpenKnowledge is a local-first markdown editor for knowledge bases,\n    LLM wikis, specifications, and notes. It includes a web UI, CLI, MCP\n    server, agent skills, semantic search, and Git-based sharing.\n  license: GPL-3.0-or-later\n  license_file:\n    - dist/LICENSE\n    - dist/THIRD_PARTY_NOTICES.md\n    - repo/packages/native-config/THIRDPARTY.yml\n  documentation: https://openknowledge.ai/docs\n  repository: https://github.com/inkeep/open-knowledge\n\nextra:\n  recipe-maintainers:\n    - timkpaine\n",
