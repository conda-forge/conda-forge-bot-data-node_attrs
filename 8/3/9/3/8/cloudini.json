  "linux_64_meta_yaml": {
    "about": {
      "description": "Cloudini is a high-performance pointcloud compression library focused on\nspeed while still achieving very good compression ratios. It uses a\ntwo-stage approach: custom per-field encoding followed by general-purpose\ncompression (LZ4/ZSTD). Typical use cases are shrinking rosbag/MCAP datasets\nthat contain pointclouds and reducing bandwidth when streaming pointclouds\nover a network. This package ships the C++ library (with a CMake package\nconfig, `find_package(cloudini_lib)` + `cloudini::cloudini_lib`) and the\n`cloudini_rosbag_converter` command-line tool for compressing/decompressing\nMCAP rosbags.",
      "dev_url": "https://github.com/facontidavide/cloudini",
      "doc_url": "https://github.com/facontidavide/cloudini#readme",
      "home": "https://github.com/facontidavide/cloudini",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "High-performance pointcloud compression library and CLI"
    },
    "build": {
      "number": "1",
      "run_exports": {
        "weak": [
          "cloudini"
        ]
      },
      "script": [
        "MCAP_INCLUDE_DIR=\"$(find \"$PWD/mcap-src\" -type d -path '*/cpp/mcap/include' | head -1)\"",
        "cmake ${CMAKE_ARGS} -GNinja -B build -S cloudini_lib -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON -DCLOUDINI_FORCE_VENDORED_DEPS=OFF -DCLOUDINI_BUILD_BENCHMARKS=OFF -DBUILD_TESTING=OFF -DMCAP_INCLUDE_DIR=\"${MCAP_INCLUDE_DIR}\" -DCMAKE_INSTALL_PREFIX=$PREFIX",
        "cmake --build build --parallel ${CPU_COUNT}",
        "cmake --install build"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "facontidavide"
      ]
    },
    "outputs": [
      {
        "build": {
          "run_exports": {
            "weak": [
              "cloudini"
            ]
          }
        },
        "name": "cloudini",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "cxx_compiler_stub",
            "c_stdlib_stub",
            "cmake",
            "ninja"
          ],
          "host": [
            "zstd",
            "lz4-c",
            "cxxopts"
          ],
          "run": []
        },
        "tests": [
          {
            "package_contents": {
              "bin": [
                "cloudini_rosbag_converter"
              ],
              "files": [
                "lib/cmake/cloudini_lib/cloudini_libConfig.cmake",
                "lib/cmake/cloudini_lib/cloudini_libTargets.cmake"
              ],
              "include": [
                "cloudini_lib/cloudini.hpp"
              ],
              "lib": [
                "cloudini_lib"
              ]
            }
          },
          {
            "script": "cloudini_rosbag_converter --help"
          }
        ],
        "version": "1.4.1"
      }
    ],
