  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: natten\n  version: \"0.21.7\"\n\nrecipe:\n  name: natten-split\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/n/natten/natten-${{ version }}.tar.gz\n  sha256: 8417236b74db079b2d23899ec8f77514fb2dc73d4bbd6b346a45b6967fc05ffb\n  patches:\n    # https://github.com/SHI-Labs/NATTEN/pull/348\n    - 0001-Fix-int32-offset-overflow-in-compute-delta-reduction.patch\n    # https://github.com/SHI-Labs/NATTEN/pull/346\n    - 0002-Fix-torch.compile-self-attention-fallback-logging.patch\n    # Blackwell MMA helpers still use the pre-CUTLASS-4.5 spelling; we build\n    # against conda-forge's cutlass (4.7), not the vendored 4.3.5\n    - 0003-Port-Blackwell-MMA-helpers-to-CUTLASS-4.5.patch\n\nbuild:\n  number: 2\n  # libnatten is CUDA-only; without CUDA upstream builds a pure-python package\n  skip:\n    - cuda_compiler_version == \"None\" or (not linux)\n\noutputs:\n  # The CUDA kernels only use libtorch's C++ API, not Python, so they build into\n  # a shared library of their own instead of being compiled into every Python\n  # variant's extension module.\n  - package:\n      name: libnatten\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ compiler('cuda') }}\n        - ${{ stdlib('c') }}\n        - cmake\n        - make\n        # Only runs the stdlib-only kernel autogen scripts; constrained so that\n        # it does not become a per-Python variant\n        - python >=3.10\n      host:\n        - cuda-version ${{ cuda_compiler_version }}.*\n        - cuda-cudart-dev\n        # Pulled in by ATen/cuda/CUDAContext.h and curand_kernel.h\n        - libcublas-dev\n        - libcurand-dev\n        - libcusolver-dev\n        - libcusparse-dev\n        - cutlass\n        - libtorch\n        - libtorch * cuda*\n      # The kernels and the pybind11 module are two halves of one translation\n      # unit set; there is no soname-level ABI contract between them.\n      run_exports:\n        - ${{ pin_subpackage('libnatten', exact=True) }}\n    build:\n      script:\n        env:\n          # recipe/cuda_archs.sh turns this into NATTEN_CUDA_ARCHS and the\n          # NATTEN_WITH_*_FNA flags; the datacenter parts are CUDA 13 only\n          cuda_compiler_version: ${{ cuda_compiler_version }}\n        file: build_kernels.sh\n    tests:\n      - package_contents:\n          lib:\n            - natten_kernels\n\n  - package:\n      name: natten\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ compiler('cuda') }}\n        - ${{ stdlib('c') }}\n        - cmake\n        - make\n        - if: build_platform != host_platform\n          then:\n            - python\n            - cross-python_${{ host_platform }}\n            - pytorch\n            - pytorch * cuda*\n      host:\n        - cuda-version ${{ cuda_compiler_version }}.*\n        - cuda-cudart-dev\n        - ${{ pin_subpackage('libnatten', exact=True) }}\n        - pip\n        - python\n        - pytorch\n        - pytorch * cuda*\n        - setuptools >=64\n      run:\n        - python\n        - pytorch * cuda*\n    build:\n      script:\n        env:\n          # Same resolution as the kernels, via recipe/cuda_archs.sh\n          cuda_compiler_version: ${{ cuda_compiler_version }}\n        file: build_python.sh\n    tests:\n      - python:\n          imports:\n            - natten\n            # natten silently falls back to stubs if libnatten fails to import\n            - natten.libnatten\n          pip_check: true\n      - script:\n          - python -c \"import natten; assert natten.HAS_LIBNATTEN\"\n\nabout:\n  homepage: https://natten.org\n  summary: Neighborhood Attention Extension\n  description: |\n    NATTEN is an open-source project dedicated to providing infrastructure for\n    Neighborhood Attention (NA), a sliding window self-attention mechanism, and\n    its extensions. It provides fused CUDA kernels for 1D, 2D and 3D\n    neighborhood attention built on CUTLASS, with PyTorch bindings.\n  license: MIT AND BSD-3-Clause\n  license_file:\n    - LICENSE\n    - NOTICE\n    - third_party/cutlass/LICENSE.txt\n  documentation: https://natten.org\n  repository: https://github.com/SHI-Labs/NATTEN\n\nextra:\n  feedstock-name: natten\n  recipe-maintainers:\n    - hmaarrfk\n",
