  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"5.1.1\"\n  name: ${{ \"qt5-advanced-docking-system\" if qt == \"5\" else \"qt6-advanced-docking-system\" }}\n  libname: ${{ \"qtadvanceddocking-qt5\" if qt == \"5\" else \"qtadvanceddocking-qt6\" }}\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/githubuser0xFFFF/Qt-Advanced-Docking-System/archive/v${{ version }}.tar.gz\n  sha256: 9ce947acbb1984946f9145c976e42e6984f99b98fb414dd7354a290af6d4ff04\n  patches:\n    # Keep inactive tabs parented to their dock area, so render-to-texture\n    # widgets (QRhiWidget, QOpenGLWidget) keep their graphics resources across\n    # tab switches. Needed by PlotJuggler 4. From the PlotJuggler fork:\n    # https://github.com/PlotJuggler/Qt-Advanced-Docking-System/commit/d713b1f97ecec009fa07b83f6594adec2f131d41\n    - 0001-keep-inactive-tabs-parented-to-their-dock-area.patch\n\nbuild:\n  number: 3\n  dynamic_linking:\n    missing_dso_allowlist:\n      # Follow: https://github.com/conda-forge/deno-feedstock/blob/49611827965b148b4e724b23d4077de17cf4f90b/recipe/meta.yaml#L13-L23\n      - if: osx\n        then: /System/Library/Frameworks/Metal.framework/Versions/A/Metal\n\nrequirements:\n  build:\n    - cmake\n    - ${{ compiler(\"cxx\") }}\n    - ${{ stdlib(\"c\") }}\n    - if: win\n      then: ninja\n      else: make\n  host:\n    - if: qt == \"5\"\n      then: qt-main\n      else: qt6-main\n    - if: linux\n      then:\n        - libxcb\n        - libgl-devel\n  run_exports:\n    - ${{ pin_subpackage(name, upper_bound=\"x.x\") }}\n\ntests:\n  - package_contents:\n      lib:\n        - ${{ libname }}\n      include:\n        - ${{ libname }}/ads_globals.h\n      files:\n        - ${{ \"Library/\" if win }}lib/cmake/${{ libname }}/${{ libname }}Config.cmake\n\nabout:\n  homepage: https://github.com/githubuser0xFFFF/Qt-Advanced-Docking-System\n  license: LGPL-2.1-only\n  license_file: gnu-lgpl-v2.1.md\n  summary: Advanced Docking System for Qt\n\nextra:\n  feedstock-name: qt6-advanced-docking-system\n  recipe-maintainers:\n    - n-elie\n",
