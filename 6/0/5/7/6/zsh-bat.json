    "about": {
      "description": "Aliases cat to bat, keeps the original cat available as rcat, and routes\nman pages through bat.\n\nActivate it by adding this to your .zshrc:\n\n  source \"${CONDA_PREFIX}/share/zsh/plugins/zsh-bat/zsh-bat.plugin.zsh\"",
      "dev_url": "https://github.com/fdellwing/zsh-bat",
      "home": "https://github.com/fdellwing/zsh-bat",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Zsh plugin that aliases cat to bat"
    },
    "build": {
      "noarch": "generic",
      "number": "0",
      "script": "install -d \"${PREFIX}/${{ plugin_dir }}\"\ninstall -m 644 zsh-bat.plugin.zsh \"${PREFIX}/${{ plugin_dir }}/\"\n"
    },
    "extra": {
      "recipe-maintainers": [
        "ManuelLerchner"
      ]
    },
    "outputs": [
      {
        "build": {
          "noarch": "generic"
        },
        "name": "zsh-bat",
        "requirements": {
          "build": [],
          "host": [],
          "run": [
            "__unix",
            "zsh",
            "bat"
          ]
        },
        "tests": [
          {
            "package_contents": {
              "files": [
                "share/zsh/plugins/zsh-bat/zsh-bat.plugin.zsh"
              ]
            }
          },
          {
            "script": "zsh -f -c 'source \"${PREFIX}/${{ plugin_dir }}/zsh-bat.plugin.zsh\"; [[ \"$(alias cat)\" == *bat* ]]'\n"
          }
        ],
        "version": "0.0.0.dev20241112"
      }
