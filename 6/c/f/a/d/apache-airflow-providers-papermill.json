  "raw_meta_yaml": "context:\n  name: apache-airflow-providers-papermill\n  version: \"3.13.3\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/apache_airflow_providers_papermill-${{ version }}.tar.gz\n  sha256: 0a709fec0e6722864b4506fc4071a1efbd4e5ecd327ae402463297c4d4c2c8f5\n\nbuild:\n  noarch: python\n  script: python -m pip install . -vv --no-deps --no-build-isolation\n  number: 0\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - flit-core ==4.1.0\n  run:\n    - python >=${{ python_min }}\n    - apache-airflow >=2.11.0\n    - apache-airflow-providers-common-compat >=1.8.0\n    - papermill >=2.6.0\n    # start papermill[all]\n    - azure-datalake-store >=0.0.30,<1.0.0a0\n    - azure-storage-blob >=12.1\n    - requests >=2.21\n    - azure-identity >=1.3.1\n    - gcsfs >=0.2\n    - pygithub >=1.55\n    - pyarrow >=2\n    - boto3\n    - black >=19.3b0\n    # end papermill[all]\n    # scrapbook[all] needs nothing extra on conda-forge\n    - scrapbook >=0.5.0\n    - ipykernel >=6.29.4\n    # tightest of upstream's floors (python >=3.14)\n    - pandas >=2.3.3\n    - nbconvert >=7.16.1\n  run_constraints:\n    # temporary: the solver can pick azure-identity 1.17.1 + msal_extensions\n    # 0.3.0, whose conda metadata lacks its portalocker ~=1.0 pin (pip check\n    # fails with portalocker 3.x)\n    - msal_extensions >=1.2\n\ntests:\n  - python:\n      imports:\n        - airflow.providers.papermill\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\nabout:\n  homepage: https://github.com/apache/airflow/\n  summary: Provider package apache-airflow-providers-papermill for Apache Airflow\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - NOTICE\n  documentation: https://airflow.apache.org/docs/apache-airflow-providers-papermill/stable/index.html\n  repository: https://github.com/apache/airflow/\n