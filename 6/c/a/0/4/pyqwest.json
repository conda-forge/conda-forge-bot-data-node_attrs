  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.14.0\"\n\npackage:\n  name: pyqwest\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/pyqwest/pyqwest-${{ version }}.tar.gz\n  sha256: a5a1db2aeb3d63fd45fb055098adc2f7ce5169bf9e0c1fd075eb7b572dfe73fe\n  patches:\n    - cargo-target-rustflags.patch\n\nbuild:\n  number: 0\n  # Upstream publishes cp311-abi3 wheels (maturin --features pyo3/abi3-py311),\n  # so build once at python_min and ship one artifact per platform.\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n  script:\n    env:\n      MATURIN_PEP517_ARGS: --features pyo3/abi3-py311\n    content:\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n      - ${{ PYTHON }} -m pip install . -vv\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin >=1.16.0,<2.0\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n  host:\n    - if: is_abi3\n      then: python-abi3\n    - python\n    - pip\n    - maturin >=1.16.0,<2.0\n  run:\n    - python\n    - opentelemetry-api >=1.39.1\n\ntests:\n  - python:\n      imports:\n        - pyqwest\n        - pyqwest._pyqwest\n      pip_check: true\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - files:\n      source:\n        - tests/\n    requirements:\n      run:\n        - pytest\n        - anyio\n        - trio\n        - sniffio\n    script:\n      # Most of the suite runs against a pyvoy (Envoy) server, and the conftest\n      # imports pyvoy and opentelemetry-test-utils, neither of which is on\n      # conda-forge. Run the files that don't need the server, without the\n      # conftest. The deselected tests need its server or certs fixtures, and\n      # test_response_content_awaitable_ensure_future is asyncio-only (the\n      # conftest normally deselects it on trio).\n      - pytest -v --noconftest --import-mode=importlib tests/test_asgi.py tests/test_common.py tests/test_headers.py tests/test_multipart_encode.py tests/test_protocol_errors.py tests/test_proxy.py tests/test_request.py tests/test_response.py tests/test_timeout.py tests/test_tls_system.py tests/test_trio_bridge.py tests/test_uds.py tests/test_unwinding.py -k \"not test_response_content_awaitable_ensure_future and not ca_cert_and_include_system_certs\"\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/pyqwest/_pyqwest.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%\\pyqwest\\_pyqwest.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  homepage: https://github.com/curioswitch/pyqwest\n  repository: https://github.com/curioswitch/pyqwest\n  summary: A modern, high-performance HTTP client for Python and Rust\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - killua156\n",
