  "raw_meta_yaml": "{% set name = \"halide\" %}\n{% set version = \"22.0.0.post3\" %}\n{% set sha256 = \"de3e1a168de2a326eb9739e59fb2305fab58cb55085c8f11b2764adc0e1463d2\" %}\n{% set build = 0 %}\n{% set llvm_version = 22 %}\n\npackage:\n  name: {{ name }}\n  version: {{ version }}\n\nsource:\n  url: https://github.com/halide/Halide/archive/v{{ version }}.tar.gz\n  sha256: {{ sha256 }}\n\nbuild:\n  number: {{ build }}\n  skip: true  # [win]\n  run_exports:\n    - {{ pin_subpackage(\"halide\") }}\n  ignore_run_exports:\n    # used only at build time (flatc and headers)\n    - flatbuffers\n\nrequirements:\n  build:\n    - {{ compiler('cxx') }}\n    - {{ stdlib('c') }}\n    - cmake\n    - make\n  host:\n    - clangdev   {{ llvm_version }}.*\n    - llvmdev    {{ llvm_version }}.*\n    - llvm       {{ llvm_version }}.*\n    - lld        {{ llvm_version }}.*\n    - flatbuffers\n    - openssl  # libwabt.a links libcrypto\n    - wabt\n\ntest:\n  requires:\n    - {{ compiler('cxx') }}\n    - {{ stdlib('c') }}\n  files:\n    - test.cpp\n\noutputs:\n  - name: halide\n\n  - name: halide-python\n    script: install-python.sh\n    build:\n      # Halide's Python bindings require CPython 3.12+\n      skip: true  # [py<312]\n    requirements:\n      build:\n        - {{ compiler('cxx') }}\n        - {{ stdlib('c') }}\n        - cmake\n        - make\n      host:\n        - python\n        - nanobind >=2.11\n        - {{ pin_subpackage(\"halide\", exact=True) }}\n      run:\n        - {{ pin_subpackage(\"halide\", exact=True) }}\n        - python\n        - imageio\n        - numpy\n    test:\n      requires:\n        - pip\n      imports:\n        - halide\n        - halide.runtime\n      commands:\n        - pip check\n        - python -c \"import halide as hl; f = hl.Func('f'); x = hl.Var('x'); f[x] = x * 2; assert f.realize([4])[3] == 6\"\n    about:\n      summary: 'python bindings for halide programming language'\n\nabout:\n  home: http://halide-lang.org\n  license: MIT\n  license_family: MIT\n  license_file: LICENSE.txt\n  summary: 'a language for image processing and computational photography'\n  description: |\n    Halide is a programming language designed to make it easier to write\n    high-performance data parallel processing code on modern machines.\n    Its current front end is embedded in C++. Compiler targets include\n    x86/SSE, ARM v7/NEON, CUDA, Hexagon DSP, and OpenCL.\n  doc_url: http://halide-lang.org/docs/\n  dev_url: https://github.com/halide/Halide\n\nextra:\n  recipe-maintainers:\n    - jrk\n    - minrk\n    - steven-johnson\n    - isuruf\n    - alexreinking\n",
