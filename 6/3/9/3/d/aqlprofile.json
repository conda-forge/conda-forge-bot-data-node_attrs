  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"7.2.4\"\n\nrecipe:\n  name: aqlprofile-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ROCm/rocm-systems/releases/download/rocm-${{ version }}/aqlprofile.tar.gz\n  sha256: ce96a97e2ae5d66f6a783882749f90ec234e9e1c59e3fd8decfc6826cd626a84\n\nbuild:\n  number: 0\n  skip: not linux\n\noutputs:\n  - staging:\n      name: aqlprofile-build\n    build:\n      script: build.sh\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - cmake\n        - ninja\n      host:\n        - rocm-core ${{ version }}.*\n        - rocr-runtime ${{ version }}.*\n\n  - package:\n      name: libaqlprofile\n    inherit: aqlprofile-build\n    build:\n      files:\n        include:\n          - \"**/*\"\n        exclude:\n          - include/**\n          - lib/*.a\n          - lib/cmake/**\n          - lib/pkgconfig/**\n          - share/pkgconfig/**\n          - share/doc/**\n    tests:\n      - package_contents:\n          lib:\n            - hsa-amd-aqlprofile64\n          files:\n            not_exists:\n              - include/**\n              - lib/*.a\n      - requirements:\n          run:\n            - python\n        script:\n          - python -c \"import ctypes, os; ctypes.CDLL(os.path.join(os.environ['PREFIX'], 'lib/libhsa-amd-aqlprofile64.so.1'))\"\n\n  - package:\n      name: libaqlprofile-devel\n    inherit: aqlprofile-build\n    build:\n      files:\n        - include/**\n        - lib/*.a\n        - lib/cmake/**\n        - lib/pkgconfig/**\n        - share/pkgconfig/**\n        - share/doc/**\n    requirements:\n      run:\n        - ${{ pin_subpackage('libaqlprofile', exact=True) }}\n      run_exports:\n        - ${{ pin_subpackage('libaqlprofile', upper_bound='x.x') }}\n    tests:\n      - package_contents:\n          include:\n            - aqlprofile-sdk/aql_profile_v2.h\n            - aqlprofile-sdk/version.h\n      - requirements:\n          run:\n            - ${{ compiler('cxx') }}\n        script: run_test.sh\n\nabout:\n  homepage: https://rocm.docs.amd.com/projects/aqlprofile/en/latest/\n  repository: https://github.com/ROCm/rocm-systems\n  license: MIT\n  license_file: LICENSE.md\n  summary: AQL packet level profiling support for AMD GPUs\n  description: |\n    AQLPROFILE provides AQL packet level profiling support for AMD GPUs.\n    It is used by profiling tools to collect hardware performance counters.\n\nextra:\n  feedstock-name: aqlprofile\n  recipe-maintainers:\n    - flferretti\n    - conda-forge/rocm-core\n",
