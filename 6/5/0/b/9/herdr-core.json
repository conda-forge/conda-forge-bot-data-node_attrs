    "about": {
      "description": "herdr-core (`hc`) runs programs and coding agents in terminals that stay\nalive after you leave. Agents can start other agents, send them work, and\nhear back; you can attach to any terminal and take over.",
      "dev_url": "https://github.com/herdrdev/herdr-core",
      "doc_url": "https://github.com/herdrdev/herdr-core/tree/master/docs",
      "home": "https://herdr.dev/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Terminals for coding agents that stay alive after you leave"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "export GHOSTTY_VT_LIB_DIR=\"${PREFIX}/lib\"",
          "cargo auditable install --locked --no-track --bin herdr-core --root ${{ PREFIX }} --path crates/herdr-core",
          "ln -s herdr-core ${{ PREFIX }}/bin/hc",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
