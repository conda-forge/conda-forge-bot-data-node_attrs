  "raw_meta_yaml": "context:\n  version: \"0.1.17\"\n\npackage:\n  name: herdr-core\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/herdrdev/herdr-core/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: c872f92437ebb72b9147a430127d9da57a307d0502aada04d08d26d4778bf094\n  patches:\n    # link conda-forge's libghostty-vt instead of building vendor/ghostty with zig\n    - patches/0001-ghostty-vt-link-a-system-libghostty-vt-when-GHOSTTY_.patch\n    # ghostty 1.4.0 replaced vt_write_until_ground with vt_write_until\n    - patches/0002-ghostty-vt-use-ghostty_terminal_vt_write_until.patch\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - if: unix\n        then:\n          - export GHOSTTY_VT_LIB_DIR=\"${PREFIX}/lib\"\n          - cargo auditable install --locked --no-track --bin herdr-core --root ${{ PREFIX }} --path crates/herdr-core\n          - ln -s herdr-core ${{ PREFIX }}/bin/hc\n        else:\n          # upstream links the C runtime statically on windows; use the dynamic one like the rest of conda-forge\n          - if exist .cargo\\config.toml del .cargo\\config.toml\n          - set \"GHOSTTY_VT_LIB_DIR=%LIBRARY_LIB%\"\n          - cargo auditable install --locked --no-track --bin herdr-core --root %LIBRARY_PREFIX% --path crates/herdr-core\n          - if errorlevel 1 exit 1\n          - copy %LIBRARY_BIN%\\herdr-core.exe %LIBRARY_BIN%\\hc.exe\n          - if errorlevel 1 exit 1\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n  host:\n    - libghostty-vt\n\ntests:\n  - script:\n      - herdr-core --version\n      - hc --version\n      - hc --help\n  - package_contents:\n      bin:\n        - herdr-core\n        - hc\n      strict: true\n\nabout:\n  homepage: https://herdr.dev\n  summary: Terminals for coding agents that stay alive after you leave\n  description: |\n    herdr-core (`hc`) runs programs and coding agents in terminals that stay\n    alive after you leave. Agents can start other agents, send them work, and\n    hear back; you can attach to any terminal and take over.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - crates/herdr-core/THIRD-PARTY-NOTICES\n    - THIRDPARTY.yml\n  documentation: https://github.com/herdrdev/herdr-core/tree/master/docs\n  repository: https://github.com/herdrdev/herdr-core\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
