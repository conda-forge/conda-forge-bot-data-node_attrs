  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"1.2.1\"\n\npackage:\n  name: sphinx-rustdocgen\n  version: ${{ version }}\n\nsource:\n  # The crates.io release does not ship the license file, so build from the\n  # sdist, which bundles the crate alongside the Python extension that drives it.\n  url: https://pypi.org/packages/source/s/sphinxcontrib-rust/sphinxcontrib_rust-${{ version }}.tar.gz\n  sha256: 71ddb07f99d074549ccecc12924f844d415b4024bc469e95efff6d5c8ef3727d\n\nbuild:\n  number: 0\n  script:\n    - cd sphinx-rustdocgen\n    - cargo auditable install --locked --no-track --root ${{ PREFIX }} --path .\n    - cargo-bundle-licenses --format=yaml --output ../THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n\ntests:\n  - package_contents:\n      bin:\n        - sphinx-rustdocgen\n      strict: true\n\nabout:\n  homepage: https://gitlab.com/munir0b0t/sphinxcontrib-rust\n  repository: https://gitlab.com/munir0b0t/sphinxcontrib-rust\n  documentation: https://sphinxcontrib-rust.readthedocs.io/en/latest/\n  summary: Executable to extract rustdoc comments for Sphinx\n  description: |\n    sphinx-rustdocgen extracts doc comments from Rust crates and emits the\n    reStructuredText or MyST sources consumed by Sphinx. It is tightly coupled\n    with the sphinxcontrib-rust extension, which invokes it during the Sphinx\n    build.\n  license: GPL-3.0-or-later\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - timkpaine\n",
