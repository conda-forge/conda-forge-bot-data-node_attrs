    "about": {
      "description": "sphinx-rustdocgen extracts doc comments from Rust crates and emits the\nreStructuredText or MyST sources consumed by Sphinx. It is tightly coupled\nwith the sphinxcontrib-rust extension, which invokes it during the Sphinx\nbuild.",
      "dev_url": "https://gitlab.com/munir0b0t/sphinxcontrib-rust",
      "doc_url": "https://sphinxcontrib-rust.readthedocs.io/en/latest/",
      "home": "https://gitlab.com/munir0b0t/sphinxcontrib-rust",
      "license": "GPL-3.0-or-later",
      "license_family": "GPL-3.0-or-later",
      "license_file": "LICENSE",
      "summary": "Executable to extract rustdoc comments for Sphinx"
    },
    "build": {
      "number": "0",
      "script": [
        "cd sphinx-rustdocgen",
        "cargo auditable install --locked --no-track --root ${{ PREFIX }} --path .",
        "cargo-bundle-licenses --format=yaml --output ../THIRDPARTY.yml"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "timkpaine"
      ]
    },
    "outputs": [
      {
        "build": null,
