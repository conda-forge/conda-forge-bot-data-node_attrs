  "raw_meta_yaml": "context:\n  version: \"0.4.1\"\n\npackage:\n  name: wifit3\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/derv82/wifit3/archive/v${{ version }}.tar.gz\n  sha256: 4d1e0da60389044395d1243673e866868c2d216e838fd32f82d4644dd735542d\n  patches:\n    # build for the native arch only; conda's python and libusb_package are thin.\n    - 0001-native-target-arch.patch\n\nbuild:\n  number: 0\n  script:\n    content:\n      - uv run pyinstaller wifit3.spec --noconfirm --clean\n      - if: unix\n        then:\n          - mkdir -p \"$PREFIX/bin\"\n          - install -m0755 dist/wifit3 \"$PREFIX/bin/\"\n        else:\n          - mkdir -p \"%LIBRARY_BIN%\"\n          - install -m0755 dist/wifit3 \"%LIBRARY_BIN%\"\n\nrequirements:\n  build:\n    - uv\n\ntests:\n  - script:\n      - wifit3 --version\n      - wifit3 --help\n  - package_contents:\n      strict: true\n      bin:\n        - wifit3\n\nabout:\n  homepage: https://github.com/derv82/wifit3\n  summary: \"Wifite but USB-only & cross-platform.\"\n  description: |\n    A standalone USB Wi-Fi auditor for Linux, Windows, and macOS.\n  license: GPL-2.0-or-later\n  license_file:\n    - LICENSE\n  repository: https://github.com/derv82/wifit3\n\nextra:\n  recipe-maintainers:\n    - XhstormR\n",
