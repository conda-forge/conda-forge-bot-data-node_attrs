    "about": {
      "description": "Skia is an open source 2D graphics library which provides common APIs that\nwork across a variety of hardware and software platforms. It serves as the\ngraphics engine for Google Chrome and ChromeOS, Android, Flutter and many\nother products.\n\nThis build is deliberately minimal: it provides Skia's geometry and path\nhandling (including pathops) with no GPU backends, image codecs, text shaping\nor system font managers, which is what allows it to be built without Skia's\nthird_party/externals checkout.",
      "dev_url": "https://github.com/google/skia",
      "doc_url": "https://skia.org/docs/",
      "home": "https://skia.org/",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE",
      "summary": "Skia is a complete 2D graphic library for drawing text, geometries and images"
    },
