  "linux_64_meta_yaml": {
    "about": {
      "description": "\"Leiningen!\" he shouted. \"You're insane! They're not creatures you can\nfight-they're an elemental-an 'act of God!' Ten miles long, two miles\nwide-ants, nothing but ants! And every single one of them a fiend from hell...\"\n  from Leiningen Versus the Ants by Carl Stephenson",
      "home": "https://codeberg.org/leiningen/leiningen",
      "license": "EPL-1.0",
      "license_family": "EPL-1.0",
      "license_file": "leiningen-src/COPYING",
      "summary": "Leiningen is for automating Clojure projects without setting your hair on fire."
    },
    "build": {
      "number": "1"
    },
    "extra": {
      "recipe-maintainers": [
        "MementoRC"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "leiningen",
        "requirements": {
          "build": [
            "openjdk",
            "maven",
            "sed",
            "leiningen >=2.13.1"
          ],
          "host": [],
          "run": [
            "openjdk"
          ]
        },
        "tests": [
          {
            "files": {
              "source": [
                "leiningen-src/project.clj",
                "leiningen-src/src/",
                "leiningen-src/test/",
                "leiningen-src/test_projects/",
                "leiningen-src/leiningen-core/project.clj",
                "leiningen-src/leiningen-core/src/",
                "leiningen-src/leiningen-core/test/",
                "leiningen-src/leiningen-core/dev-resources/",
                "leiningen-src/resources/leiningen/bootclasspath-deps.clj"
              ]
            },
            "script": [
              "test -f ${PREFIX}/bin/lein",
              "test -f ${PREFIX}/lib/leiningen/libexec/leiningen-${{ version }}-standalone.jar",
              "lein version",
              "lein version | grep \"Leiningen ${{ version }}\"",
              "test \"$(ls ${PREFIX}/lib/leiningen/libexec)\" = \"leiningen-${{ version }}-standalone.jar\"",
              "grep -q 'LEIN_VERSION=\"${{ version }}\"' ${PREFIX}/bin/lein",
              "cd leiningen-src && lein test leiningen.test.test"
            ]
          }
        ],
        "version": "2.13.1"
      }
    ],
    "package": {
      "name": "leiningen",
