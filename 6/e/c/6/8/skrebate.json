  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.8.4\"\n  python_check_max: \"3.14\"\n\npackage:\n  name: skrebate\n  # the epoch is due to a historic issue with yanked upstream releases of 0.61 and 0.62\n  version: 1!${{ version }}\n\nsource:\n  - target_directory: dist\n    url: https://pypi.org/packages/source/s/skrebate/skrebate-${{ version }}.tar.gz\n    sha256: 4b590dfbc64ab5f6d6b215a07a472a7e8f8990f395f37bde33fe171b852b449b\n  - target_directory: src\n    url:\n      # some upstream tags don't have -beta corresponding to a PyPI release\n      - https://github.com/UrbsLab/scikit-rebate/archive/refs/tags/v${{ version }}.tar.gz\n      - https://github.com/UrbsLab/scikit-rebate/archive/refs/tags/v${{ version }}-beta.tar.gz\n    sha256: 6afba3a821bedf5f5877ba6dccebefd932e543d6d832d3ad6f93d92911111fe2\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    - cd dist\n    - ${{ PYTHON }} -m pip install . --no-deps -vv --no-build-isolation --disable-pip-version-check --check-build-dependencies\n\nrequirements:\n  host:\n    - pip\n    - python ${{ python_min }}.*\n    - setuptools >=61\n    - wheel\n  run:\n    - joblib\n    - numpy\n    - python >=${{ python_min }}\n    - scikit-learn\n    - scipy\n\ntests:\n  - package_contents:\n      strict: true\n      files:\n        - etc/conda/test-files/skrebate/**\n      site_packages:\n        - skrebate/**\n        - skrebate-${{ version }}.dist-info/**\n  - python:\n      imports: skrebate\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - ${{ python_check_max }}.*\n  - files:\n      source:\n        - src/tests/\n        - src/data/\n    requirements:\n      run:\n        - pytest-cov\n        - pandas\n        - python ${{ python_min }}.*\n    script:\n      - cd src\n      - coverage run --source=skrebate --branch -m pytest -vv --tb=long --color=yes\n      - coverage report --show-missing --skip-covered --fail-under=63\n\nabout:\n  license: MIT\n  license_file: dist/LICENSE\n  summary: |\n    Feature selection algorithms based on Relief-based methods\n  homepage: https://pypi.org/project/skrebate\n  repository: https://github.com/UrbsLab/scikit-rebate\n  documentation: https://urbslab.github.io/scikit-rebate\n\nextra:\n  recipe-maintainers:\n    - bollwyvl\n    - lacava\n    - rhiever\n    - weixuanfu\n",
