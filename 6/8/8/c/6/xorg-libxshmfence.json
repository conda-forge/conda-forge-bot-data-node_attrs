  "raw_meta_yaml": "{% set xorg_name = \"libxshmfence\" %}\n{% set xorg_category = \"lib\" %}\n{% set name = \"xorg-\" ~ xorg_name %}\n{% set version = \"1.3.3\" %}\n{% set sha256 = \"6233ccd9fa80198835efc3039cdf8086ab2b218b17e77ebdb0a19913fcee58d3\" %}\n{% set am_version = \"1.16\" %} # keep synchronized with build.sh\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  fn: {{ name }}-{{ version }}.tar.gz\n  url: https://www.x.org/releases/individual/{{ xorg_category }}/{{ xorg_name }}-{{ version }}.tar.gz\n  sha256: {{ sha256 }}\n  patches:\n    - windows.patch  # [win and x86_64]\n    - win-arm64-msvc.patch  # [win and arm64]\n\nbuild:\n  number: 0\n  run_exports:\n    - {{ pin_subpackage(name|lower) }}\n\nrequirements:\n  build:\n    - m2-autoconf                  # [win and x86_64]\n    - m2-automake{{ am_version }}  # [win and x86_64]\n    - m2-libtool                   # [win and x86_64]\n    - autotools_clang_conda >=0.0.14  # [win and arm64]\n    - pkg-config                   # [win and arm64]\n    - pkg-config                   # [unix]\n    - m2-pkg-config                # [win]\n    - gnuconfig                    # [unix]\n    - m2-base                      # [win and x86_64]\n    - make                         # [unix]\n    - m2-make                      # [win and x86_64]\n    - {{ stdlib(\"c\") }}            # [unix]\n    - {{ compiler(\"c\") }}          # [unix]\n    - {{ stdlib(\"c\") }}            # [win and arm64]\n    - {{ compiler(\"c\") }}          # [win and arm64]\n    - {{ stdlib(\"m2w64_c\") }}      # [win and x86_64]\n    - {{ compiler(\"m2w64_c\") }}    # [win and x86_64]\n    - autoconf                     # [unix]\n    - automake                     # [unix]\n    - gettext                      # [unix]\n    - libtool                      # [unix]\n  host:\n    - xorg-xorgproto\n    - xorg-util-macros\n\ntest:\n  requires:\n    - {{ compiler(\"c\") }}  # [win and arm64]\n    - xorg-xorgproto       # [win and arm64]\n  files:\n    - test_xshmfence.c     # [win and arm64]\n  commands:\n    {% set lib_idents = [ \"xshmfence\" ] %}\n    {% for lib_ident in lib_idents %}\n    - test -f $PREFIX/lib/lib{{ lib_ident }}.dylib  # [osx]\n    - test -f $PREFIX/lib/lib{{ lib_ident }}.so  # [linux]\n    - if not exist %PREFIX%/Library/lib/lib{{ lib_ident }}.dll.a exit /b 1  # [win and x86_64]\n    - if not exist %PREFIX%/Library/bin/msys-{{ lib_ident }}-*.dll exit /b 1  # [win and x86_64]\n    {% endfor %}\n    - if not exist %LIBRARY_INC%\\X11\\xshmfence.h exit /b 1  # [win and arm64]\n    - if not exist %LIBRARY_LIB%\\xshmfence.lib exit /b 1  # [win and arm64]\n    - if not exist %LIBRARY_BIN%\\xshmfence-*.dll exit /b 1  # [win and arm64]\n    - if not exist %LIBRARY_LIB%\\pkgconfig\\xshmfence.pc exit /b 1  # [win and arm64]\n    - call %CC% /nologo /MD /W4 /I\"%LIBRARY_INC%\" test_xshmfence.c /link /LIBPATH:\"%LIBRARY_LIB%\" xshmfence.lib /OUT:xshmfence_consumer.exe  # [win and arm64]\n    - if errorlevel 1 exit /b 1  # [win and arm64]\n    - set \"PATH=%LIBRARY_BIN%;%PATH%\"  # [win and arm64]\n    - xshmfence_consumer.exe  # [win and arm64]\n    - if errorlevel 1 exit /b 1  # [win and arm64]\n\nabout:\n  home: https://www.x.org/\n  license: MIT\n  license_family: MIT\n  license_file: COPYING\n  summary: Shared memory 'SyncFence' synchronization primitive\n\nextra:\n  recipe-maintainers:\n    - ehfd\n",
