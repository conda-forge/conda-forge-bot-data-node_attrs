      "description": "GKX is a JAX-native gyrokinetic solver designed for differentiability,\nhigh-performance accelerator execution, and advanced stellarator\noptimization.\nThe code employs a Hermite-Laguerre velocity space, Fourier perpendicular\ncoordinates, and field-aligned flux-tube geometry to simulate linear and\nnonlinear electrostatic and electromagnetic turbulence in magnetized\nplasmas.",
      "dev_url": "https://github.com/uwplasma/GKX",
      "doc_url": "https://gkx.readthedocs.io/",
      "home": "https://gkx.readthedocs.io/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Gyrokinetic Spectral Solver of Plasma Turbulence"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "gkx = gkx.cli:main"
        ]
      },
