  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"4.0.0\"\n\nrecipe:\n  name: smact\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/s/smact/smact-${{ version }}.tar.gz\n  sha256: f2372e9127565a298e3a49a0b0488bd3cf67b6a591b6ebb752f8b9ce25736a68\n\nbuild:\n  number: 2\n  noarch: python\n\noutputs:\n  - package:\n      name: smact\n    build:\n      noarch: python\n      script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - setuptools >=77.0.0\n        - pip\n        - numpy\n      run:\n        - python >=${{ python_min }},<3.14\n        - scipy\n        - numpy <3\n        - spglib >=2.6.0\n        - pymatgen >=2024.2.20\n        - ase\n        - pandas\n        - pathos\n        - pandarallel >=1.6.5\n        - tabulate\n        - tqdm\n        - typing-extensions\n    tests:\n      - python:\n          imports:\n            - smact\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - 3.12.*\n            - 3.13.*\n\n  # The following noarch meta-packages mirror SMACT's public runtime extras.\n  # They deliberately use conda package names (for example, pytorch rather\n  # than the PyPI name torch) and allow users to select only the functionality\n  # they need.\n  - package:\n      name: smact-mp\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"smact\", upper_bound=\"x.x\") }}\n        - mp-api >=0.45.3\n    tests:\n      - python:\n          imports:\n            - mp_api.client\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - 3.12.*\n            - 3.13.*\n\n  - package:\n      name: smact-crystal-space\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"smact-mp\", upper_bound=\"x.x\") }}\n        - elementembeddings >=0.4\n        - umap-learn ==0.5.7\n        - python-kaleido >=0.2.1\n    tests:\n      - python:\n          imports:\n            - elementembeddings\n            - umap\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - 3.12.*\n            - 3.13.*\n\n  - package:\n      name: smact-featurisers\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"smact\", upper_bound=\"x.x\") }}\n        - matminer\n        - elementembeddings\n    tests:\n      - python:\n          imports:\n            - elementembeddings\n            - matminer\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - 3.12.*\n            - 3.13.*\n\n  - package:\n      name: smact-visualisation\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"smact\", upper_bound=\"x.x\") }}\n        - seaborn >=0.13.2\n        - pymatviz >=0.15\n        - dash >=2.18.2\n    tests:\n      - python:\n          imports:\n            - dash\n            - pymatviz\n            - seaborn\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - 3.12.*\n            - 3.13.*\n\n  - package:\n      name: smact-ml\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"smact-featurisers\", upper_bound=\"x.x\") }}\n        - xgboost\n        - shap\n    tests:\n      - python:\n          imports:\n            - shap\n            - xgboost\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - 3.12.*\n            - 3.13.*\n\n  - package:\n      name: smact-property-prediction\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"smact\", upper_bound=\"x.x\") }}\n        # aviary-models must be available from conda-forge before this output\n        # can be built. Do not replace it with a pip installation: that would\n        # make the environment unsafely mutable after conda solves it.\n        - aviary-models >=1.2.1\n        - pytorch >=2.0.0,<2.11\n        - requests\n    tests:\n      - python:\n          imports:\n            - aviary.roost.model\n            - smact.property_prediction\n            - torch\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - 3.12.*\n            - 3.13.*\n\n  - package:\n      name: smact-optional\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"smact-mp\", upper_bound=\"x.x\") }}\n        - ${{ pin_subpackage(\"smact-visualisation\", upper_bound=\"x.x\") }}\n        - ${{ pin_subpackage(\"smact-ml\", upper_bound=\"x.x\") }}\n        - pydantic >=2.9.2\n        - matminer >=0.9.2\n        - python-kaleido >=0.2.1\n        - llvmlite >=0.40\n        # `matplotlib-venn[shapely]` is a PyPI extra. Conda represents the\n        # same request as the package and its optional dependency separately.\n        - matplotlib-venn >=1.1.2\n        - shapely\n    tests:\n      - python:\n          imports:\n            - llvmlite\n            - matplotlib_venn\n            - pydantic\n            - shapely\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - 3.12.*\n            - 3.13.*\n\nabout:\n  homepage: https://github.com/WMD-group/SMACT\n  summary: Python package to aid materials design and informatics\n  description: |\n    Semiconducting Materials by Analogy and Chemical Theory (SMACT)\n    is a collection of rapid screening tools that uses data about chemical elements.\n  license: MIT\n  license_file: LICENSE\n  documentation: https://smact.readthedocs.io/en/latest/\n  repository: https://github.com/WMD-group/SMACT\n\nextra:\n  feedstock-name: smact\n  recipe-maintainers:\n    - AntObi\n    - KingaMas\n    - aronwalsh\n",
