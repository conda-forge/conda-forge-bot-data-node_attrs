  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: flux-pmix\n  version: \"0.9.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/flux-framework/flux-pmix/releases/download/v${{ version }}/flux-pmix-${{ version }}.tar.gz\n  sha256: 7beeab7fb3b1f9d883cfa4dabdfae02474a6eab775dd58c8d3b1f7124c8aa62f\n  patches:\n    # rename `struct wait`, which clashes with glibc 2.17's `union wait`\n    - 0001-rename-struct-wait.patch\n    # skip node-info-array tests: libpmix 5.0.8 lacks hostname alias\n    # support (added in 5.0.9) that the multi-shell-per-host test setup needs\n    - 0002-skip-node-info-array-tests.patch\n\nbuild:\n  number: 0\n  skip: not linux\n\nrequirements:\n  build:\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib(\"c\") }}\n    - make\n    - pkg-config\n  host:\n    - flux-core\n    - ${{ mpi }}\n    - jansson\n    - libpmix\n    - libpmix-devel\n    - libxml2\n    - libxml2-devel\n  run:\n    - flux-core\n    - ${{ mpi }}\n\ntests:\n  - script:\n      - flux --help\n\nabout:\n  summary: flux shell plugin to bootstrap openmpi v5+\n  license: LGPL-3.0-or-later\n  license_file: LICENSE\n  homepage: https://github.com/flux-framework/flux-pmix\n\nextra:\n  recipe-maintainers:\n    - jan-janssen\n",
