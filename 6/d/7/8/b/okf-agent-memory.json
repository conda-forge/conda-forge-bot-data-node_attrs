      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Domain-neutral, git-native persistent project memory for AI agents based on the Open Knowledge Format (OKF) v0.2"
    },
    "build": {
      "number": "0",
      "script": [
        "go-licenses save ./cmd/okf --save_path library_licenses --ignore github.com/okf-memory/okf-agent-memory",
        "go build -v -trimpath -ldflags=\"-s -w -X main.Version=${PKG_VERSION}\" -o \"${PREFIX}/bin/okf\" ./cmd/okf"
      ]
