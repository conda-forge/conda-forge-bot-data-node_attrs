  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.24.2\"\n\npackage:\n  name: lychee\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/lycheeverse/lychee/archive/refs/tags/lychee-v${{ version }}.tar.gz\n  sha256: 62687c0a84ceec76d17e30e494dcf8e65c7099a2e24a6a521a41854b8eb3759d\n\nbuild:\n  number: 1\n  skip: ppc64le\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - cargo auditable install --bins --locked --no-track --profile=release --path=lychee-bin --root=\"${{ '${PREFIX}' if unix else '%LIBRARY_PREFIX%' }}\"\n      - cargo-bundle-licenses --format=yaml --output=THIRDPARTY.yml\n      - if: build_platform == target_platform\n        then:\n          - if: unix\n            then:\n              - mkdir -p \"${PREFIX}/share/bash-completion/completions\" \"${PREFIX}/share/elvish/lib\" \"${PREFIX}/share/fish/vendor_completions.d\" \"${PREFIX}/share/powershell/completions\" \"${PREFIX}/share/zsh/site-functions\"\n              - lychee --generate complete-bash       > \"${PREFIX}/share/bash-completion/completions/lychee\"\n              - lychee --generate complete-elvish     > \"${PREFIX}/share/elvish/lib/lychee.elv\"\n              - lychee --generate complete-fish       > \"${PREFIX}/share/fish/vendor_completions.d/lychee.fish\"\n              - lychee --generate complete-powershell > \"${PREFIX}/share/powershell/completions/lychee.ps1\"\n              - lychee --generate complete-zsh        > \"${PREFIX}/share/zsh/site-functions/_lychee\"\n            else:\n              - md \"%LIBRARY_PREFIX%\\share\\bash-completion\\completions\" \"%LIBRARY_PREFIX%\\share\\elvish\\lib\" \"%LIBRARY_PREFIX%\\share\\fish\\vendor_completions.d\" \"%LIBRARY_PREFIX%\\share\\powershell\\completions\" \"%LIBRARY_PREFIX%\\share\\zsh\\site-functions\"\n              - lychee --generate complete-bash       > \"%LIBRARY_PREFIX%\\share\\bash-completion\\completions\\lychee\"\n              - lychee --generate complete-elvish     > \"%LIBRARY_PREFIX%\\share\\elvish\\lib\\lychee.elv\"\n              - lychee --generate complete-fish       > \"%LIBRARY_PREFIX%\\share\\fish\\vendor_completions.d\\lychee.fish\"\n              - lychee --generate complete-powershell > \"%LIBRARY_PREFIX%\\share\\powershell\\completions\\lychee.ps1\"\n              - lychee --generate complete-zsh        > \"%LIBRARY_PREFIX%\\share\\zsh\\site-functions\\_lychee\"\n\nrequirements:\n  build:\n    - ${{ compiler('rust') }}\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - pkg-config\n\ntests:\n  - package_contents:\n      strict: true\n      bin:\n        - lychee\n      files:\n        - if: build_platform == target_platform\n          then:\n            - ${{ 'Library/' if win }}share/bash-completion/completions/lychee\n            - ${{ 'Library/' if win }}share/elvish/lib/lychee.elv\n            - ${{ 'Library/' if win }}share/fish/vendor_completions.d/lychee.fish\n            - ${{ 'Library/' if win }}share/powershell/completions/lychee.ps1\n            - ${{ 'Library/' if win }}share/zsh/site-functions/_lychee\n  - script:\n      - lychee --help\n      - lychee --version\n      - lychee --version | ${{ 'grep -iE ' if unix else 'findstr /r /c:' }}${{ version | replace('.', '\\\\.') }}\n\n\nabout:\n  license: Apache-2.0 OR MIT\n  license_file:\n    - LICENSE-APACHE\n    - LICENSE-MIT\n    - THIRDPARTY.yml\n  summary: Fast, async, resource-friendly link checker\n  description: |\n    Finds broken URLs and mail addresses inside Markdown, HTML,\n    reStructuredText, websites and more!\n\n  homepage: https://lychee.cli.rs\n  repository: https://github.com/lycheeverse/lychee\n  documentation: https://lychee.cli.rs/introduction\n\nextra:\n  recipe-maintainers:\n    - danielnachun\n    - egpbos\n",
