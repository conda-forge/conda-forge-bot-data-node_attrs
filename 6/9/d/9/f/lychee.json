  "linux_64_meta_yaml": {
    "about": {
      "description": "Finds broken URLs and mail addresses inside Markdown, HTML,\nreStructuredText, websites and more!",
      "dev_url": "https://github.com/lycheeverse/lychee",
      "doc_url": "https://lychee.cli.rs/introduction",
      "home": "https://lychee.cli.rs/",
      "license": "Apache-2.0 OR MIT",
      "license_family": "Apache-2.0 OR MIT",
      "license_file": "LICENSE-APACHE",
      "summary": "Fast, async, resource-friendly link checker"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "cargo auditable install --bins --locked --no-track --profile=release --path=lychee-bin --root=\"${{ '${PREFIX}' if unix else '%LIBRARY_PREFIX%' }}\"",
          "cargo-bundle-licenses --format=yaml --output=THIRDPARTY.yml",
          "mkdir -p \"${PREFIX}/share/bash-completion/completions\" \"${PREFIX}/share/elvish/lib\" \"${PREFIX}/share/fish/vendor_completions.d\" \"${PREFIX}/share/powershell/completions\" \"${PREFIX}/share/zsh/site-functions\"",
          "lychee --generate complete-bash       > \"${PREFIX}/share/bash-completion/completions/lychee\"",
          "lychee --generate complete-elvish     > \"${PREFIX}/share/elvish/lib/lychee.elv\"",
          "lychee --generate complete-fish       > \"${PREFIX}/share/fish/vendor_completions.d/lychee.fish\"",
          "lychee --generate complete-powershell > \"${PREFIX}/share/powershell/completions/lychee.ps1\"",
          "lychee --generate complete-zsh        > \"${PREFIX}/share/zsh/site-functions/_lychee\""
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "danielnachun",
        "egpbos"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "lychee",
        "requirements": {
          "build": [
            "rust_compiler_stub",
            "c_compiler_stub",
            "c_stdlib_stub",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "pkg-config"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "package_contents": {
              "bin": [
                "lychee"
              ],
              "files": [
                "share/bash-completion/completions/lychee",
                "share/elvish/lib/lychee.elv",
                "share/fish/vendor_completions.d/lychee.fish",
                "share/powershell/completions/lychee.ps1",
                "share/zsh/site-functions/_lychee"
              ],
              "strict": true
            }
          },
          {
            "script": [
              "lychee --help",
              "lychee --version",
              "lychee --version | ${{ 'grep -iE ' if unix else 'findstr /r /c:' }}${{ version | replace('.', '\\\\.') }}"
            ]
          }
        ],
        "version": "0.24.2"
      }
    ],
