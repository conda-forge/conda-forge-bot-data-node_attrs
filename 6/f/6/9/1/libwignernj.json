  "raw_meta_yaml": "context:\n  version: \"0.8.0\"\n\npackage:\n  name: libwignernj\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/susilehtola/libwignernj/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 7220cea92652040d6456aba92ff151124d9c69ce8695840490c18dd25a0da80c\n\nbuild:\n  number: 0\n  script:\n    - if: unix\n      then: |\n        cmake -S . -B build -G Ninja ${CMAKE_ARGS} \\\n          -DCMAKE_BUILD_TYPE=Release \\\n          -DBUILD_SHARED_LIBS=ON \\\n          -DWIGNERNJ_BUILD_FORTRAN=ON \\\n          -DWIGNERNJ_BUILD_LTO=OFF \\\n          -DWIGNERNJ_BUILD_EXAMPLES=OFF \\\n          -DWIGNERNJ_BUILD_TESTS=ON\n        cmake --build build --parallel ${CPU_COUNT}\n        if [[ \"${CONDA_BUILD_CROSS_COMPILATION:-}\" != \"1\" || -n \"${CROSSCOMPILING_EMULATOR:-}\" ]]; then\n          ctest --test-dir build --output-on-failure\n        fi\n        cmake --install build\n      else: |\n        cmake -S . -B build -G Ninja %CMAKE_ARGS% -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON -DWIGNERNJ_BUILD_FORTRAN=OFF -DWIGNERNJ_BUILD_LTO=OFF -DWIGNERNJ_BUILD_EXAMPLES=OFF\n        if errorlevel 1 exit 1\n        cmake --build build --parallel %CPU_COUNT%\n        if errorlevel 1 exit 1\n        ctest --test-dir build --output-on-failure\n        if errorlevel 1 exit 1\n        cmake --install build\n        if errorlevel 1 exit 1\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ compiler(\"cxx\") }}\n    - if: unix\n      then: ${{ compiler(\"fortran\") }}\n    - ${{ stdlib(\"c\") }}\n    - cmake\n    - ninja\n  run_exports:\n    - ${{ pin_subpackage(\"libwignernj\", upper_bound=\"x.x\") }}\n\ntests:\n  - package_contents:\n      include:\n        - wignernj.h\n        - wignernj.hpp\n      lib:\n        - wignernj\n      files:\n        - if: unix\n          then: lib/pkgconfig/libwignernj.pc\n\nabout:\n  homepage: https://github.com/susilehtola/libwignernj\n  summary: Exact evaluation of Wigner 3j, 6j, 9j symbols, Clebsch-Gordan, Racah W, Fano X and Gaunt coefficients\n  license: BSD-3-Clause\n  license_file: LICENSE\n  repository: https://github.com/susilehtola/libwignernj\n\nextra:\n  recipe-maintainers:\n    - mkrack\n",
