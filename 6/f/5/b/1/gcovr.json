    "about": {
      "description": "Gcovr provides a utility for managing the use of the GNU gcov utility and\ngenerating summarized code coverage results. This command is inspired by the\nPython coverage.py package, which provides a similar utility for Python.",
      "dev_url": "https://github.com/gcovr/gcovr",
      "doc_url": "http://gcovr.com/guide.html",
      "home": "http://gcovr.com/",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE.txt",
      "summary": "generate GCC code coverage reports"
    },
    "build": {
      "noarch": "python",
      "number": "1",
      "python": {
        "entry_points": [
          "gcovr = gcovr.__main__:main"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "t-b",
        "jdmarques",
        "tovrstra",
        "mjscosta"
      ]
    },
    "outputs": [
      {
        "build": {
          "noarch": "python",
          "python": {
            "entry_points": [
              "gcovr = gcovr.__main__:main"
            ]
          }
        },
        "name": "gcovr",
        "requirements": {
          "build": [],
          "host": [
            "python 3.11.*",
            "hatchling ==1.27.0",
            "hatch-vcs ==0.5.0",
            "hatch-fancy-pypi-readme ==25.1.0",
