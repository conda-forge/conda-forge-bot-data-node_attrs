  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: 6.2.1\n\npackage:\n  name: libcint\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/sunqm/libcint/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 726241d9be6fdaf959707a64b923b54b29e1a50f572ab476cac38396a7c730c9\n  patches:\n    - 0001-Fix-test-location.patch\n\nbuild:\n  number: 1\n\nrequirements:\n  build:\n    - if: win\n      then:\n        - ${{ compiler('m2w64_c') }}\n        - ${{ stdlib('m2w64_c') }}\n      else:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n    - cmake\n    - ninja\n  run_exports:\n    - ${{ pin_subpackage('libcint', lower_bound='x.x', upper_bound='x.x') }}\n\ntests:\n  - files:\n      source:\n        - testsuite/\n    requirements:\n      run:\n        - numpy\n        - python\n    script:\n      # the tests load libcint from sys.prefix/lib, but on Windows it is\n      # installed to Library/bin\n      - if: win\n        then:\n          - if not exist \"%CONDA_PREFIX%\\lib\" mkdir \"%CONDA_PREFIX%\\lib\"\n          - copy /Y \"%CONDA_PREFIX%\\Library\\bin\\libcint.dll\" \"%CONDA_PREFIX%\\lib\\libcint.dll\"\n      - cd testsuite\n      - python test_cint.py --quick\n      - python test_3c2e.py --quick\n  - package_contents:\n      include:\n        - cint.h\n        - cint_funcs.h\n\nabout:\n  summary: general GTO integrals for quantum chemistry\n  license: Apache-2.0\n  license_file: LICENSE\n  homepage: https://github.com/sunqm/libcint\n  repository: https://github.com/sunqm/libcint\n  documentation: http://wiki.sunqm.net/libcint\n\nextra:\n  recipe-maintainers:\n    - BastianZim\n    - chillenb\n",
