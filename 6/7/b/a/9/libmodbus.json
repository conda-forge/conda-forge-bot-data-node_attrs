      "license_file": "COPYING.LESSER",
      "summary": "A Modbus library for sending and receiving data over serial lines or TCP/IP."
    },
    "build": {
      "number": "0",
      "run_exports": {
        "weak": [
          "libmodbus"
        ]
      },
      "script": [
        "./autogen.sh",
        "./configure --prefix=\"${PREFIX}\" --host=\"${CONDA_TOOLCHAIN_HOST}\" --disable-static",
        "make -j\"${CPU_COUNT}\"",
        "make install",
        "cd src\\\\win32",
        "cscript //NoLogo configure.js",
        "if errorlevel 1 exit /b 1",
        "rc /nologo /fo modbus.res modbus.rc",
        "cl /nologo /O2 /MD /W3 /I.. /I. /DHAVE_CONFIG_H /DDLLBUILD /D_CRT_SECURE_NO_DEPRECATE=1 /D_CRT_NONSTDC_NO_DEPRECATE=1 /LD ..\\\\modbus.c ..\\\\modbus-data.c ..\\\\modbus-rtu.c ..\\\\modbus-tcp.c ws2_32.lib /link /DLL /OUT:modbus.dll /IMPLIB:modbus.lib modbus.res",
        "if not exist \"%LIBRARY_BIN%\" mkdir \"%LIBRARY_BIN%\"",
        "if not exist \"%LIBRARY_LIB%\" mkdir \"%LIBRARY_LIB%\"",
        "if not exist \"%LIBRARY_INC%\\\\modbus\" mkdir \"%LIBRARY_INC%\\\\modbus\"",
        "copy /Y \"modbus.dll\" \"%LIBRARY_BIN%\\\\modbus.dll\"",
        "copy /Y \"modbus.lib\" \"%LIBRARY_LIB%\\\\modbus.lib\"",
        "copy /Y \"..\\\\modbus.h\" \"%LIBRARY_INC%\\\\modbus\\\\modbus.h\"",
        "copy /Y \"..\\\\modbus-rtu.h\" \"%LIBRARY_INC%\\\\modbus\\\\modbus-rtu.h\"",
        "copy /Y \"..\\\\modbus-tcp.h\" \"%LIBRARY_INC%\\\\modbus\\\\modbus-tcp.h\"",
        "copy /Y \"..\\\\modbus-version.h\" \"%LIBRARY_INC%\\\\modbus\\\\modbus-version.h\""
      ]
    },
