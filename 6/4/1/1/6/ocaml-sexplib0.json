      "summary": "Library containing the definition of S-expressions and some base converters"
    },
    "build": {
      "number": "2",
      "script": [
        "dune build --profile=release -p sexplib0 @install",
        "dune install --prefix=\"${PREFIX}\" --libdir=\"${PREFIX}/lib/ocaml\" sexplib0"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "ManuelLerchner",
        "MementoRC"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "ocaml-sexplib0",
        "requirements": {
          "build": [
            "ocaml_compiler_stub",
            "c_stdlib_stub",
            "ocaml-dune >=3.11.0"
          ],
          "host": [
            "ocaml 5.4.0.*"
          ],
          "run": []
        },
        "tests": [
          {
            "package_contents": {
              "files": [
                "lib/ocaml/sexplib0/*",
                "doc/sexplib0/*"
              ],
              "strict": true
            }
          },
          {
            "requirements": {
              "build": [
                "file",
                "binutils"
              ]
            },
            "script": {
              "content": "set -eu\nn=0\nfor a in $(find \"${PREFIX}/lib/ocaml/sexplib0\" -name '*.a'); do\n  n=$((n + 1))\n  d=$(mktemp -d)\n  (cd \"$d\" && ar x \"$a\")\n  file -L \"$d\"/*.o | tee \"$d/out\"\n  if ! grep -q \"${ELF_ARCH}\" \"$d/out\" || grep -v \"${ELF_ARCH}\" \"$d/out\"; then\n    echo \"arch mismatch in $a\" >&2\n    exit 1\n  fi\ndone\ntest \"$n\" -gt 0\nfor s in \"${PREFIX}\"/lib/ocaml/stublibs/dll*sexplib0*.so; do\n  [ -e \"$s\" ] || continue\n  out=$(file -L \"$s\")\n  echo \"$out\"\n  echo \"$out\" | grep -q \"${ELF_ARCH}\"\ndone\n",
              "env": {
                "ELF_ARCH": "x86-64"
              }
            }
          }
        ],
        "version": "0.17.0"
      },
