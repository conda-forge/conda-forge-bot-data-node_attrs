  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"13_0\"\n\npackage:\n  name: iverilog\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/steveicarus/iverilog/archive/v${{ version | replace(\".\", \"_\") }}.tar.gz\n  sha256: c897bbfa9848688982c6d5c30529fc29d68df0b9ff22ffa73bad89db73a7ce49\n  patches:\n    - if: osx-64\n      then:\n        - patch_macos_mach-o.patch\n\nbuild:\n  number: 1\n\nrequirements:\n  build:\n    - if: win\n      then:\n        - ${{ compiler('m2w64_c') }}\n        - ${{ compiler('m2w64_cxx') }}\n        - ${{ stdlib('m2w64_c') }}\n        - m2-autoconf\n        - m2-make\n        - m2-bash\n        - m2-coreutils\n        - m2-base\n        - m2-sed\n        - m2-grep\n        - winflexbison\n      else:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - make\n        - autoconf\n  host:\n    - zlib\n    - if: not win\n      then:\n        - gperf >=3\n        - bison\n        - flex\n        - readline\n\ntests:\n  - script:\n      - if: unix\n        then:\n          - test -f \"${PREFIX}/bin/iverilog\"\n          - test -f \"${PREFIX}/bin/iverilog-vpi\"\n          - test -f \"${PREFIX}/bin/vvp\"\n          - test -f \"${PREFIX}/lib/libvpi.a\"\n          - test -f \"${PREFIX}/lib/ivl/ivl\"\n          - test -f \"${PREFIX}/lib/ivl/ivlpp\"\n          - test -f \"${PREFIX}/lib/ivl/vhdlpp\"\n      - if: win\n        then:\n          - if not exist \"%LIBRARY_BIN%\\\\iverilog.exe\" exit 1\n          - if not exist \"%LIBRARY_BIN%\\\\vvp.exe\" exit 1\n          - if not exist \"%LIBRARY_LIB%\\\\ivl\\\\ivl.exe\" exit 1\n          - if not exist \"%LIBRARY_LIB%\\\\ivl\\\\ivlpp.exe\" exit 1\n          - if not exist \"%LIBRARY_LIB%\\\\ivl\\\\vhdlpp.exe\" exit 1\n          - if not exist \"%LIBRARY_LIB%\\\\libvpi.a\" exit 1\n      - iverilog -V\n      - vvp -V\n  - files:\n      recipe:\n        - tests/hello.v\n    script:\n      - iverilog -o hello.vvp tests/hello.v\n      - vvp hello.vvp\n      - if: unix\n        then:\n          - vvp hello.vvp | grep -q \"Hello, iverilog\"\n        else:\n          - vvp hello.vvp | findstr /C:\"Hello, iverilog\"\n\nabout:\n  license: GPL-2.0-only\n  license_file: COPYING\n  summary: Icarus Verilog is intended to compile ALL of the Verilog HDL as described in the IEEE-1364 standard.\n  homepage: http://iverilog.icarus.com/home\n\nextra:\n  recipe-maintainers:\n    - tfors\n    - carlodri\n",
