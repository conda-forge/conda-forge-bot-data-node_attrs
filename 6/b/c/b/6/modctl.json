  "raw_meta_yaml": "context:\n  version: \"0.2.2\"\n\npackage:\n  name: modctl\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/modelpack/modctl/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 339f9db84db5c6e21168489561e4b09f5b57b77a784637afdc2939cae58eef60\n\nbuild:\n  number: 0\n  script:\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build main app and generate license data\n      - let build_time = date now | format date \"%Y-%m-%dT%H:%M:%SZ\"\n      - let short_commit_hash = (http get https://api.github.com/repos/modelpack/modctl/commits/v${{ version }}).sha | str substring 0..6\n      - ^go build\n        -o ($prefix)/bin/\n        -v\n        -ldflags=$'-s -w -X github.com/modelpack/modctl/pkg/version.BuildTime=($build_time) -X github.com/modelpack/modctl/pkg/version.GitCommit=($short_commit_hash) -X github.com/modelpack/modctl/pkg/version.GitVersion=${{ version }}'\n        -trimpath\n        .\n      - ^go-licenses save . --save_path=library_licenses\n      # generate shell completions\n      - if: build_platform == host_platform\n        then:\n          - ^modctl completion bash | save --force ($prefix)/share/bash-completion/completions/modctl\n          - ^modctl completion fish | save --force ($prefix)/share/fish/vendor_completions.d/modctl.fish\n          - ^modctl completion zsh  | save --force ($prefix)/share/zsh/site-functions/_modctl\n  skip:\n    # Windows is currently unsupported, cf. https://github.com/modelpack/modctl/issues/472\n    - win\n\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n    - nushell\n\ntests:\n  - script:\n      - modctl --help\n      - modctl version\n  - package_contents:\n      bin:\n        - modctl\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/modctl\n            - share/fish/vendor_completions.d/modctl.fish\n            - share/zsh/site-functions/_modctl\n        - if: win\n          then:\n            - Library/share/bash-completion/completions/modctl\n            - Library/share/fish/vendor_completions.d/modctl.fish\n            - Library/share/zsh/site-functions/_modctl\n      strict: true\n\nabout:\n  summary: A CLI tool for managing OCI model artifacts bundled based on the ModelPack specification\n  description: |\n    Modctl is a user-friendly CLI tool for managing OCI model artifacts, which are\n    bundled based on the ModelPack Model Specification. It offers commands such as\n    build, pull, push, and more, making it easy to interact with AI/ML model registries.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - library_licenses/\n  homepage: https://modelpack.org/\n  documentation: https://github.com/modelpack/model-spec/tree/main/docs\n  repository: https://github.com/modelpack/modctl\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
  "req": {
    "__set__": true,
