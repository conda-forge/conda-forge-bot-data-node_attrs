  "linux_64_meta_yaml": {
    "about": {
      "description": "Modctl is a user-friendly CLI tool for managing OCI model artifacts, which are\nbundled based on the ModelPack Model Specification. It offers commands such as\nbuild, pull, push, and more, making it easy to interact with AI/ML model registries.",
      "dev_url": "https://github.com/modelpack/modctl",
      "doc_url": "https://github.com/modelpack/model-spec/tree/main/docs",
      "home": "https://modelpack.org/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "A CLI tool for managing OCI model artifacts bundled based on the ModelPack specification"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "let build_time = date now | format date \"%Y-%m-%dT%H:%M:%SZ\"",
          "let short_commit_hash = (http get https://api.github.com/repos/modelpack/modctl/commits/v${{ version }}).sha | str substring 0..6",
          "^go build -o ($prefix)/bin/ -v -ldflags=$'-s -w -X github.com/modelpack/modctl/pkg/version.BuildTime=($build_time) -X github.com/modelpack/modctl/pkg/version.GitCommit=($short_commit_hash) -X github.com/modelpack/modctl/pkg/version.GitVersion=${{ version }}' -trimpath .",
          "^go-licenses save . --save_path=library_licenses",
          "^modctl completion bash | save --force ($prefix)/share/bash-completion/completions/modctl",
          "^modctl completion fish | save --force ($prefix)/share/fish/vendor_completions.d/modctl.fish",
          "^modctl completion zsh  | save --force ($prefix)/share/zsh/site-functions/_modctl"
        ],
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "modctl",
        "requirements": {
          "build": [
            "go-nocgo_compiler_stub",
            "go-licenses",
            "nushell"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "modctl --help",
              "modctl version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "modctl"
              ],
              "files": [
                "share/bash-completion/completions/modctl",
                "share/fish/vendor_completions.d/modctl.fish",
                "share/zsh/site-functions/_modctl"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.2.2"
      }
    ],
