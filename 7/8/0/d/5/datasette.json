    "about": {
      "description": "Datasette is a tool for exploring and publishing data. It helps people take\ndata of any shape or size and publish that as an interactive,\nexplorable website and accompanying API. Datasette is aimed at data\njournalists, museum curators, archivists, local governments and anyone else\nwho has data that they wish to share with the world. It is part of a wider\necosystem of tools and plugins dedicated to making working with structured\ndata as productive as possible.",
      "dev_url": "https://github.com/simonw/datasette",
      "doc_url": "https://docs.datasette.io/en/stable/",
      "home": "https://datasette.io/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "An open source multi-tool for exploring and publishing data"
    },
    "build": {
