  "raw_meta_yaml": "context:\n  version: \"0.24.1\"\n\npackage:\n  name: hyalo\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ractive/hyalo/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 03f80b232ac1fff2e22cfb4f8872e4bd7f368a16e82654573530ec18277510a6\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build main app and generate license data\n      - cd crates/hyalo-cli\n      - cargo auditable install --path=. --root=($prefix) --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml\n      # generate shell completions\n      - if: build_platform == host_platform\n        then:\n          - mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions\n          - let bin = ($prefix)/bin/hyalo\n          - ^$bin completion bash | save ($prefix)/share/bash-completion/completions/hyalo\n          - ^$bin completion fish | save ($prefix)/share/fish/vendor_completions.d/hyalo.fish\n          - ^$bin completion zsh  | save ($prefix)/share/zsh/site-functions/_hyalo\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - nushell\n\ntests:\n  - script:\n      - hyalo --help\n      - hyalo --version\n  - package_contents:\n      bin:\n        - hyalo\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/bash-completion/completions/hyalo\n            - share/fish/vendor_completions.d/hyalo.fish\n            - share/zsh/site-functions/_hyalo\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/bash-completion/completions/hyalo\n            - Library/share/fish/vendor_completions.d/hyalo.fish\n            - Library/share/zsh/site-functions/_hyalo\n      strict: true\n\nabout:\n  summary: Download and install release assets from GitHub\n  description: |\n    Hyalo is a high-performance CLI tool designed to query, manage, and bulk-edit Markdown collections\n    that use YAML frontmatter, such as Obsidian vaults, Zettelkastens, and static documentation sites.\n    Hyalo natively understands Markdown structures to offer advanced filtering, bulk metadata mutations,\n    and smart link refactoring across thousands of files in milliseconds. With native JSON output,\n    built-in AI agent integrations, and robust dry-run safety features, Hyalo provides a fast,\n    scriptable solution for maintaining and automating complex knowledge bases.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/ractive/hyalo\n  repository: https://github.com/ractive/hyalo\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
