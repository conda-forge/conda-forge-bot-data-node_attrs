  "raw_meta_yaml": "context:\n  version: \"6.12.0\"\n\npackage:\n  name: usage\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/jdx/usage/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 7ff9edb65341a36866389fecba7a83852aeed97ca1e98e232c6aaa3b7375db45\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build main app and generate license data\n      - cd cli\n      - ^cargo auditable install --path=. --root=($prefix) --no-track --locked --bins\n      - ^cargo-bundle-licenses --format=yaml --output=../THIRDPARTY.yml\n      # copy manpage\n      - mkdir ($prefix)/share/man/man1\n      - cp assets/*.1 ($prefix)/share/man/man1/\n      # generate shell completions\n      - if: build_platform == host_platform\n        then:\n          - ^usage --completions bash | save --force ($prefix)/share/bash-completion/completions/usage\n          - ^usage --completions fish | save --force ($prefix)/share/fish/vendor_completions.d/usage.fish\n          - ^usage --completions zsh  | save --force ($prefix)/share/zsh/site-functions/_usage\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - nushell\n\ntests:\n  - script:\n      - usage --help\n      - usage --version\n  - package_contents:\n      bin:\n        - usage\n      files:\n        - if: unix\n          then:\n            - share/man/man1/usage.1\n            - if: build_platform == host_platform\n              then:\n                - share/bash-completion/completions/usage\n                - share/fish/vendor_completions.d/usage.fish\n                - share/zsh/site-functions/_usage\n        - if: win\n          then:\n            - Library/share/man/man1/usage.1\n            - if: build_platform == host_platform\n              then:\n                - Library/share/bash-completion/completions/usage\n                - Library/share/fish/vendor_completions.d/usage.fish\n                - Library/share/zsh/site-functions/_usage\n      strict: true\n\nabout:\n  summary: Usage Spec processor CLI\n  description: |\n    Usage is a spec and CLI for defining CLI tools. Arguments, flags, environment\n    variables, and config files can all be defined in a Usage spec. It can be\n    thought of like OpenAPI (swagger) for CLIs. Use it to generate autocompletion\n    scripts, markdown documentation, man pages, and more.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://usage.jdx.dev\n  documentation: https://usage.jdx.dev/cli/reference/\n  repository: https://github.com/jdx/usage\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
