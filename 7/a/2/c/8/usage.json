  "linux_64_meta_yaml": {
    "about": {
      "description": "Usage is a spec and CLI for defining CLI tools. Arguments, flags, environment\nvariables, and config files can all be defined in a Usage spec. It can be\nthought of like OpenAPI (swagger) for CLIs. Use it to generate autocompletion\nscripts, markdown documentation, man pages, and more.",
      "dev_url": "https://github.com/jdx/usage",
      "doc_url": "https://usage.jdx.dev/cli/reference/",
      "home": "https://usage.jdx.dev/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Usage Spec processor CLI"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "cd cli",
          "^cargo auditable install --path=. --root=($prefix) --no-track --locked --bins",
          "^cargo-bundle-licenses --format=yaml --output=../THIRDPARTY.yml",
          "mkdir ($prefix)/share/man/man1",
          "cp assets/*.1 ($prefix)/share/man/man1/",
          "^usage --completions bash | save --force ($prefix)/share/bash-completion/completions/usage",
          "^usage --completions fish | save --force ($prefix)/share/fish/vendor_completions.d/usage.fish",
          "^usage --completions zsh  | save --force ($prefix)/share/zsh/site-functions/_usage"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        },
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "usage",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "nushell"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "usage --help",
              "usage --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "usage"
              ],
              "files": [
                "share/man/man1/usage.1",
                "share/bash-completion/completions/usage",
                "share/fish/vendor_completions.d/usage.fish",
                "share/zsh/site-functions/_usage"
              ],
              "strict": true
            }
          }
        ],
        "version": "6.12.0"
      }
    ],
