  "linux_64_meta_yaml": {
    "about": {
      "description": "QATS is a Python library and GUI for processing and visualising time series from marine and offshore\nsimulations (SIMO, RIFLEX, SIMA and others): file input/output, signal processing, extreme value statistics,\nrainflow counting and fatigue.",
      "dev_url": "https://github.com/dnvgl/qats",
      "doc_url": "https://qats.readthedocs.io/",
      "home": "https://github.com/dnvgl/qats",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Library for efficient processing and visualization of time series"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "qats = qats.cli:main"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "tovop",
        "eneelo"
      ]
    },
    "outputs": [
      {
        "build": {
          "noarch": "python",
          "python": {
            "entry_points": [
              "qats = qats.cli:main"
            ]
          }
        },
        "name": "qats",
        "requirements": {
          "build": [],
          "host": [
            "python 3.11.*",
            "pip",
            "setuptools >=64",
            "setuptools-scm >=8"
          ],
          "run": [
            "python >=3.11",
            "h5py >=3.11.0",
            "matplotlib-base >=3.7.5",
            "nptdms >=1.10.0",
            "numpy >=1.24.4",
            "openpyxl >=3.1.5",
            "pandas >=2.0.3",
            "pymatreader >=0.0.32",
            "pyside6 >=6.10.1",
            "pywin32-on-windows",
            "qtpy >=2.4.2",
            "scipy >=1.10.1"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "qats",
                "qats.fatigue",
                "qats.io",
                "qats.stats"
              ],
              "python_version": [
                "3.11.*",
                "*"
              ]
            }
          },
          {
            "requirements": {
              "run": [
                "python 3.11.*"
              ]
            },
            "script": {
              "content": [
                "qats --help",
                "qats app --help",
                "qats config --help",
                "python -c \"from qtpy.QtWidgets import QApplication; from qats.app.gui import Qats; app = QApplication([]); Qats()\""
              ],
              "env": {
                "QT_API": "pyside6",
                "QT_QPA_PLATFORM": "offscreen"
              }
            }
          }
        ],
        "version": "5.4.1"
      }
    ],
