  "raw_meta_yaml": "context:\n  version: \"5.4.1\"\n\npackage:\n  name: qats\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/q/qats/qats-${{ version }}.tar.gz\n  sha256: 894c47e45b28028a2d724676f01332b696a2ee91aa14c6387403541bc5096df8\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - qats = qats.cli:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools >=64\n    - setuptools-scm >=8\n  run:\n    - python >=${{ python_min }}\n    - h5py >=3.11.0\n    - matplotlib-base >=3.7.5\n    - nptdms >=1.10.0\n    - numpy >=1.24.4\n    - openpyxl >=3.1.5\n    - pandas >=2.0.3\n    - pymatreader >=0.0.32\n    - pyside6 >=6.10.1\n    # pywin32 is only needed (and only installed) on Windows\n    - pywin32-on-windows\n    - qtpy >=2.4.2\n    - scipy >=1.10.1\n\ntests:\n  - python:\n      imports:\n        - qats\n        - qats.fatigue\n        - qats.io\n        - qats.stats\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      env:\n        QT_API: pyside6\n        QT_QPA_PLATFORM: offscreen\n      content:\n        - qats --help\n        - qats app --help\n        - qats config --help\n        # the GUI main window can be created (without a display)\n        - python -c \"from qtpy.QtWidgets import QApplication; from qats.app.gui import Qats; app = QApplication([]); Qats()\"\n\nabout:\n  homepage: https://github.com/dnvgl/qats\n  summary: Library for efficient processing and visualization of time series\n  description: |\n    QATS is a Python library and GUI for processing and visualising time series from marine and offshore\n    simulations (SIMO, RIFLEX, SIMA and others): file input/output, signal processing, extreme value statistics,\n    rainflow counting and fatigue.\n  license: MIT\n  license_file: LICENSE\n  documentation: https://qats.readthedocs.io\n  repository: https://github.com/dnvgl/qats\n\nextra:\n  recipe-maintainers:\n    - tovop\n    - eneelo\n",
