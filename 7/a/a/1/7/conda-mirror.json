  "raw_meta_yaml": "context:\n  name: conda-mirror\n  version: \"0.12.2\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/conda-incubator/${{ name }}/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 4e3eddf197d41829e9a443662ac2679178ab3da4fdd704bcfc284c63e68f0f2c\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n      # aws-lc-sys (pulled in via aws-config/rustls) needs clang-cl to assemble\n      # its ARM64 perlasm `.S` files on Windows; MSVC's cl.exe silently drops\n      # them, which results in a link error. Harmless no-op on other targets.\n      # https://aws.github.io/aws-lc-rs/requirements/windows.html\n      CC_aarch64_pc_windows_msvc: clang-cl\n      AR_aarch64_pc_windows_msvc: llvm-lib\n    content:\n      - if: win\n        then:\n          - cargo auditable install --no-track --locked --root %PREFIX% --path .\n          - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n        else:\n          # rust-lld cannot handle the ppc64le relocations emitted for\n          # libdbus-sys, so link with GNU ld there instead\n          - if: target_platform == \"linux-ppc64le\"\n            then: export CARGO_BUILD_RUSTFLAGS=\"${CARGO_BUILD_RUSTFLAGS:-} -C link-arg=-fuse-ld=bfd\"\n          - export \"OPENSSL_DIR=$PREFIX\"\n          - cargo auditable install --no-track --locked --root $PREFIX --path .\n          - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\nrequirements:\n  build:\n    - pkg-config\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - if: win and arm64\n      then: clang # provides clang-cl, required by aws-lc-sys on win-arm64\n  host:\n    - openssl\n\ntests:\n  - script:\n      - conda-mirror --help\n  - package_contents:\n      bin:\n        - conda-mirror\n      strict: true\n\nabout:\n  homepage: https://github.com/conda-incubator/conda-mirror\n  license: BSD-3-Clause\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  summary: Mirror conda channels\n\nextra:\n  recipe-maintainers:\n    - ericdill\n    - parente\n    - scopatz\n    - xhochy\n    - pavelzw\n    - delsner\n",
