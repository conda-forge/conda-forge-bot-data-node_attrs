  "raw_meta_yaml": "context:\n  name: polars-cloud\n  version: 0.13.0\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\n# Starting with 0.13.0, polars-cloud is a deprecated wrapper around polars-nanook\n# that is only published as a wheel.\nsource:\n  - url: https://pypi.org/packages/py3/p/polars-cloud/polars_cloud-${{ version }}-py3-none-any.whl\n    sha256: 80fcee85ccb3572684bb694b225dd0be4534a1adf9e72d74e86993458ea69d6a\n  # the wheel does not ship a license file\n  - url: https://raw.githubusercontent.com/pola-rs/polars-cloud-client/client-${{ version }}/client/LICENSE\n    sha256: 5cf22724ea53abcfbc2ed22b0c295672904e932427e3b2522b25e76b1baa3798\n    file_name: LICENSE\n\nbuild:\n  number: 0\n  noarch: python\n  python:\n    entry_points:\n      - pc=polars_nanook:cli_main\n  script: python -m pip install polars_cloud-${{ version }}-py3-none-any.whl -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - polars-nanook ==${{ version }}\n\ntests:\n  - python:\n      imports:\n        - polars_cloud\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      env:\n        NANOOK_CONFIG_DIR: nanook_config\n      content:\n        - pc --help\n\nabout:\n  homepage: https://pola.rs/nanook\n  summary: \"Deprecated: renamed to polars-nanook\"\n  description: |\n    Polars Cloud is now Polars Nanook. This package installs polars-nanook plus a deprecated\n    polars_cloud module that re-exports it. Switch to `import polars_nanook as pn`, the\n    `nanook` CLI, and depend on polars-nanook instead.\n  license: MIT\n  license_file: LICENSE\n  documentation: https://docs.nanook.pola.rs/\n  repository: https://github.com/pola-rs/polars-cloud-client\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
