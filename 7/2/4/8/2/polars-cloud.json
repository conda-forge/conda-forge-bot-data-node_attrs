  "raw_meta_yaml": "context:\n  name: polars-cloud\n  version: 0.12.0\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/pola-rs/${{ name }}-client/archive/refs/tags/client-${{ version }}.tar.gz\n  sha256: 66cf28ec9c18147e757e8098e59b8be2f6902daa126c8c4fb17896503da6ac31\n\nbuild:\n  python:\n    version_independent: true\n    entry_points:\n      - pc=polars_cloud.__main__:cli\n  skip:\n    - not (match(python, python_min ~ \".*\") and is_abi3)\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO: cargo-auditable-wrapper${{ '' if unix else '.bat' }}\n    content:\n      - cd client\n      - if: unix\n        then:\n          - cp ${RECIPE_DIR}/cargo-auditable-wrapper.sh ${BUILD_PREFIX}/bin/cargo-auditable-wrapper\n        else:\n          - copy %RECIPE_DIR%\\cargo-auditable-wrapper.bat %BUILD_PREFIX%\\Library\\bin\\cargo-auditable-wrapper.bat\n      - python -m pip install . -vv\n      - cargo-bundle-licenses --format yaml --output ../THIRD_PARTY.yml\n  number: 0\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - ${{ stdlib('c') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - libprotobuf\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin >=1,<2\n  host:\n    - python\n    - pip\n    - maturin >=1,<2\n    - libprotobuf\n  run:\n    - python\n    - polars ==2.0.0\n    - typing_extensions >=4.5\n\ntests:\n  - if: not win\n    then:\n      python:\n        imports:\n          - polars_cloud\n        pip_check: true\n        python_version:\n          - ${{ python_min }}.*\n          - \"*\"\n  # polars_cloud resolves its config directory on import, which fails in the\n  # Windows test environment unless POLARS_CLOUD_CONFIG_DIR is set\n  - if: win\n    then:\n      script:\n        env:\n          POLARS_CLOUD_CONFIG_DIR: polars_cloud_config\n        content:\n          - python -c \"import polars_cloud\"\n          - python -m pip check\n      requirements:\n        run:\n          - python ${{ python_min }}.*\n          - pip\n  - script:\n      content:\n        - if: win\n          then: abi3audit %SP_DIR%\\polars_cloud\\polars_cloud.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit $SP_DIR/polars_cloud/polars_cloud.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n    requirements:\n      run:\n        - abi3audit\n\nabout:\n  homepage: https://cloud.pola.rs\n  summary: Python client for Polars Cloud\n  description: |\n    Built on top of the popular open source project, Polars Cloud enables you to write DataFrame code once and run it anywhere. The distributed engine available with Polars Cloud allows you to scale your Polars queries beyond a single machine.\n  license: MIT\n  license_file:\n    - client/LICENSE\n    - THIRD_PARTY.yml\n  documentation: https://cloud.pola.rs\n  repository: https://github.com/pola-rs/polars-cloud-client\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
