  "raw_meta_yaml": "context:\n  version: \"0.17.0\"\n  build_number: 2\n\n  # ELF machine token `file` prints for the target; checked by the arch test\n  elf_arch: ${{ \"x86-64\" if target_platform == \"linux-64\" else \"aarch64\" if target_platform == \"linux-aarch64\" else \"PowerPC\" if target_platform == \"linux-ppc64le\" else \"RISC-V\" if target_platform == \"linux-riscv64\" else \"S/390\" if target_platform == \"linux-s390x\" else \"\" }}\n  # ocaml_win-64 ships gcc_* and vs2022_* at the same version/build; name the track.\n  c_toolchain: ${{ \"\" if unix else c_compiler ~ \"_*\" }}\n  library: ${{ \"Library/\" if not unix else \"\" }}\n\npackage:\n  name: ocaml-compiler-libs\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/janestreet/ocaml-compiler-libs/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 9b9644d7351db699e57ddba7c767bb4153e6e988ccf45ead2fb238a3bd75cdc7\n\nbuild:\n  number: ${{ build_number }}\n  string: ${{ c_compiler ~ \"_\" if not unix }}h${{ hash }}_${{ build_number }}\n  script:\n    - if: unix\n      then:\n        # cross: ocamlopt's link does not search the host prefix; the build-time\n        # generators link compiler-libs, which pulls -lzstd for the target, and\n        # run under qemu, so they also need the rpath to find libzstd.so\n        - if: build_platform != target_platform and target_platform != \"linux-s390x\"\n          then:\n            - export OCAMLPARAM=\"_,ccopt=-L${PREFIX}/lib -Xlinker -rpath -Xlinker ${PREFIX}/lib\"\n        - dune build --profile=release -p ocaml-compiler-libs @install\n        - dune install --prefix=\"${PREFIX}\" --libdir=\"${PREFIX}/lib/ocaml\" ocaml-compiler-libs\n      else:\n        # Plain cmd.exe, not MSYS2 bash: pure OCaml, no stubs, so no wrapper is\n        # needed and the backslashed install prefix reaches dune intact. The\n        # dune cache trips over mixed path separators on windows.\n        # dune install also opens the shared cache; disable it for every dune call\n        - set DUNE_CACHE=disabled\n        - dune build --cache=disabled --profile=release -p ocaml-compiler-libs @install\n        - if errorlevel 1 exit 1\n        - dune install --prefix=\"%LIBRARY_PREFIX%\" --libdir=\"%LIBRARY_PREFIX%\\lib\\ocaml\" ocaml-compiler-libs\n        - if errorlevel 1 exit 1\n\nrequirements:\n  build:\n    - ${{ compiler(\"ocaml\") }}\n    - if: not unix and c_compiler == \"gcc\"\n      then:\n        - ${{ stdlib(\"m2w64_c\") }}\n      else:\n        - ${{ stdlib(\"c\") }}\n    # ocaml_win-64 >=14 only run-constrains the C compiler; activate it here, once (vs2022, zig)\n    - if: not unix and c_compiler != \"gcc\"\n      then:\n        - ${{ compiler(\"c\") }}\n    # compiler(\"ocaml\") renders no toolchain track; name it on windows\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n    # the cross compiler does not pull the native one; the build runs OCaml on the build machine\n    - if: build_platform != target_platform and unix\n      then:\n        - ocaml_${{ build_platform }} ${{ ocaml_compiler_version }}.*\n        # ocaml >=17: the cross compiler activates itself (shims, OCAMLLIB, host OCAMLPATH) and has natdynlink\n        - ocaml_${{ target_platform }}[version=\"${{ ocaml_compiler_version }}.*\", build_number=\">=17\"]\n    # windows cross: the self-contained gcc track needs no vcvars\n    - if: build_platform != target_platform and not unix\n      then:\n        - ocaml_${{ build_platform }} ${{ ocaml_compiler_version }}.* gcc_*\n    - ocaml-dune >=1.5.1\n  host:\n    # library: ocaml's run_export pins the compiler patch version\n    - ocaml ${{ ocaml_compiler_version }}.*\n    # cross: the build-time generators link compiler-libs, which pulls -lzstd for the target\n    # (not s390x: no zstd package there, and its ocaml is built without zstd)\n    - if: build_platform != target_platform and unix and target_platform != \"linux-s390x\"\n      then:\n        - zstd\n    # the noarch ocaml metapackage does not pin the windows toolchain track\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n  # the ocaml run_export does not encode the windows toolchain track\n  run_constraints:\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n  ignore_run_exports:\n    from_package:\n      - zstd\n\ntests:\n  - package_contents:\n      strict: true\n      files:\n        - ${{ library }}lib/ocaml/ocaml-compiler-libs/*\n        - ${{ library }}doc/ocaml-compiler-libs/*\n  # cross lanes test under qemu binfmt, which would also run a build-machine\n  # binary; check the native objects' ELF headers name the target instead\n  - if: linux\n    then:\n      script:\n        # test scripts are not jinja-rendered; hand the token over by env\n        env:\n          ELF_ARCH: ${{ elf_arch }}\n        content:\n          - |\n            set -eu\n            n=0\n            tmp=$(mktemp -d)\n            for a in $(find \"${PREFIX}/lib/ocaml/ocaml-compiler-libs\" -name '*.a'); do\n              n=$((n + 1))\n              mkdir \"${tmp}/${n}\"\n              (cd \"${tmp}/${n}\" && ar x \"${a}\")\n              find \"${tmp}/${n}\" -name '*.o' -exec file -L {} + | tee \"${tmp}/out\"\n              if grep -v \"${ELF_ARCH}\" \"${tmp}/out\"; then exit 1; fi\n            done\n            if [ \"${n}\" -eq 0 ]; then echo \"no .a found\"; exit 1; fi\n            for s in \"${PREFIX}\"/lib/ocaml/stublibs/dll*ocaml-compiler-libs*.so; do\n              [ -e \"${s}\" ] || continue\n              file -L \"${s}\" | tee \"${tmp}/out\"\n              if grep -v \"${ELF_ARCH}\" \"${tmp}/out\"; then exit 1; fi\n            done\n      requirements:\n        build:\n          - file\n          - binutils\n\nabout:\n  homepage: https://github.com/janestreet/ocaml-compiler-libs\n  repository: https://github.com/janestreet/ocaml-compiler-libs\n  summary: OCaml compiler libraries repackaged with a namespaced interface\n  license: MIT\n  license_file: LICENSE.md\n\nextra:\n  recipe-maintainers:\n    - ManuelLerchner\n    - MementoRC\n",
