    "outputs": [
      {
        "build": null,
        "name": "ocaml-compiler-libs",
        "requirements": {
          "build": [
            "ocaml_compiler_stub",
            "c_stdlib_stub",
            "ocaml-dune >=1.5.1"
          ],
          "host": [
            "ocaml 5.4.0.*"
          ],
          "run": []
        },
        "tests": [
          {
            "package_contents": {
              "files": [
                "lib/ocaml/ocaml-compiler-libs/*",
                "doc/ocaml-compiler-libs/*"
              ],
              "strict": true
            }
          },
          {
            "requirements": {
              "build": [
                "file",
                "binutils"
              ]
            },
            "script": {
              "content": "set -eu\nn=0\ntmp=$(mktemp -d)\nfor a in $(find \"${PREFIX}/lib/ocaml/ocaml-compiler-libs\" -name '*.a'); do\n  n=$((n + 1))\n  mkdir \"${tmp}/${n}\"\n  (cd \"${tmp}/${n}\" && ar x \"${a}\")\n  find \"${tmp}/${n}\" -name '*.o' -exec file -L {} + | tee \"${tmp}/out\"\n  if grep -v \"${ELF_ARCH}\" \"${tmp}/out\"; then exit 1; fi\ndone\nif [ \"${n}\" -eq 0 ]; then echo \"no .a found\"; exit 1; fi\nfor s in \"${PREFIX}\"/lib/ocaml/stublibs/dll*ocaml-compiler-libs*.so; do\n  [ -e \"${s}\" ] || continue\n  file -L \"${s}\" | tee \"${tmp}/out\"\n  if grep -v \"${ELF_ARCH}\" \"${tmp}/out\"; then exit 1; fi\ndone\n",
              "env": {
                "ELF_ARCH": "x86-64"
              }
            }
          }
        ],
        "version": "0.17.0"
      },
