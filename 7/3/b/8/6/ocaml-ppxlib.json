  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: ppxlib\n  version: \"0.38.0\"\n\n  library: ${{ \"Library/\" if not unix else \"\" }}\n  m2: ${{ \"m2-\" if not unix else \"\" }}\n  c_toolchain: ${{ \"\" if unix else \"gcc_*\" }}\n\npackage:\n  name: ocaml-${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ocaml-ppx/ppxlib/releases/download/${{ version }}/ppxlib-${{ version }}.tbz\n  sha256: 89e049b3102f6670a213d34d802ea3ab0fc530a8959d2f1a1e8db830063429a3\n\nbuild:\n  number: 0\n  script: bash ${{ RECIPE_DIR }}/build.sh ppxlib\n\nrequirements:\n  build:\n    - if: unix\n      then:\n        - ${{ compiler(\"c\") }}\n        - ${{ stdlib(\"c\") }}\n      else:\n        - ${{ compiler(\"m2w64_c\") }}\n        - ${{ stdlib(\"m2w64_c\") }}\n    # non-unix: conda-forge ocaml has gcc_ and vs2022_ tracks; these recipes use the gcc (MinGW) track only.\n    - ocaml ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n    - ocaml-dune 3.24.*\n    - ${{ m2 }}make\n    - if: not unix\n      then:\n        - m2-bash\n  host:\n    - ocaml ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n    - ocaml-compiler-libs >=0.11\n    - ocaml-ppx-derivers >=1.0\n    - ocaml-sexplib0 >=0.12\n    - ocaml-stdlib-shims\n  run:\n    - ocaml-compiler-libs >=0.11\n    - ocaml-ppx-derivers >=1.0\n    - ocaml-sexplib0 >=0.12\n    - ocaml-stdlib-shims\n\ntests:\n  - package_contents:\n      files:\n        - ${{ library }}lib/ocaml/${{ name }}/META\n        - ${{ library }}lib/ocaml/${{ name }}/ppxlib.cmxa\n        - ${{ library }}lib/ocaml/${{ name }}/ast/ppxlib_ast.cmxa\n        - ${{ library }}lib/ocaml/${{ name }}/astlib/astlib.cmxa\n  - script: bash testing/test_ppxlib.sh\n    files:\n      recipe:\n        - testing/test_ppxlib.sh\n    requirements:\n      run:\n        - ocaml ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n        - ocaml-dune 3.24.*\n        - if: unix\n          then:\n            - ${{ compiler(\"c\") }}\n        - if: not unix\n          then:\n            - m2-bash\n\nabout:\n  homepage: https://github.com/ocaml-ppx/ppxlib\n  repository: https://github.com/ocaml-ppx/ppxlib\n  documentation: https://ocaml-ppx.github.io/ppxlib/\n  license: MIT\n  license_file: LICENSE.md\n  summary: Standard infrastructure for ppx rewriters\n\nextra:\n  recipe-maintainers:\n    - MementoRC\n    - ManuelLerchner\n",
