  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: nng\n  version: \"2.1.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/nanomsg/nng/archive/v${{ version }}.tar.gz\n  sha256: e2fdcdf126b530e331b4727812b710629cdb5d90d230ce8f080e2eb520299d8d\n  patches:\n    - if: linux\n      then: test.patch\n\nbuild:\n  number: 0\n\nrequirements:\n  run_exports:\n    - ${{ pin_subpackage(name, upper_bound='x') }}\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler('cxx') }}\n    - cmake\n    - make\n    - ninja\n  host:\n    - mbedtls >=4.2\n  run:\n    # ucrt is only packaged for win-64; vc14_runtime covers win-arm64\n    - if: win and x86_64\n      then: ucrt\n    - ${{ pin_compatible('mbedtls', upper_bound='x.x') }}\n\ntests:\n  - script:\n      - if: linux\n        then: test -f $PREFIX/lib/libnng.so\n      - if: osx\n        then: test -f $PREFIX/lib/libnng.dylib\n      - if: unix\n        then: nngcat -V\n      - if: win\n        then: nngcat.exe -V\n  # nng_tls_config_alloc() returns NNG_ENOTSUP if nng was built without TLS\n  - script:\n      - if: win\n        then:\n          - cl /nologo /I%LIBRARY_INC% test_tls.c /link /LIBPATH:%LIBRARY_LIB% nng.lib\n          # nng.dll must use the mbedtls DLLs, not static copies of Mbed TLS\n          - dumpbin /dependents %LIBRARY_BIN%\\nng.dll | findstr /i mbedtls.dll\n          - dumpbin /dependents %LIBRARY_BIN%\\nng.dll | findstr /i mbedx509.dll\n          - dumpbin /dependents %LIBRARY_BIN%\\nng.dll | findstr /i tfpsacrypto.dll\n          - test_tls.exe\n        else:\n          - ${CC} ${CFLAGS} -I${PREFIX}/include test_tls.c -o test_tls ${LDFLAGS} -L${PREFIX}/lib -Wl,-rpath,${PREFIX}/lib -lnng\n          - ./test_tls\n    requirements:\n      build:\n        - ${{ stdlib('c') }}\n        - ${{ compiler('c') }}\n    files:\n      recipe:\n        - test_tls.c\n\nabout:\n  summary: nanomsg-next-generation -- light-weight brokerless messaging\n  description: |\n    nanomsg-next-generation -- light-weight brokerless messaging\n  license: MIT\n  license_file: LICENSE.txt\n  homepage: https://nng.nanomsg.org/\n  repository: https://github.com/nanomsg/nng\n  documentation: https://nng.nanomsg.org/man/\n\nextra:\n  recipe-maintainers:\n    - jan-janssen\n    - carlodri\n",
