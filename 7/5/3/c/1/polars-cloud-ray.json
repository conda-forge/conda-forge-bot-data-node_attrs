  "raw_meta_yaml": "context:\n  version: \"0.1.1\"\n\npackage:\n  name: polars-cloud-ray\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/polars-cloud-ray/polars_cloud_ray-${{ version }}.tar.gz\n  sha256: 2abd844dc4c6a877c931af4e95a4d34af37187171173bd9c3ad5b9a353335d58\n\nbuild:\n  number: 0\n  noarch: python\n  script: python -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - hatchling\n  run:\n    - python >=${{ python_min }}\n    - polars >=1.42.1\n    - polars-cloud >=0.9\n    - psutil >=7.0\n    - pydantic >=2.0\n    - ray-core >=2.0\n    - toml >=0.10\n\ntests:\n  - if: not win\n    then:\n      python:\n        imports:\n          - polars_cloud_ray\n        pip_check: true\n        python_version:\n          - ${{ python_min }}.*\n          - \"*\"\n  # polars_cloud resolves its config directory on import, which fails in the\n  # Windows test environment unless the config directory is set explicitly\n  - if: win\n    then:\n      script:\n        env:\n          POLARS_CLOUD_CONFIG_DIR: polars_cloud_config\n          NANOOK_CONFIG_DIR: nanook_config\n        content:\n          - python -c \"import polars_cloud_ray\"\n          - python -m pip check\n      requirements:\n        run:\n          - python ${{ python_min }}.*\n          - pip\n\nabout:\n  homepage: https://pypi.org/project/polars-cloud-ray/\n  summary: Polars On-Prem over Ray\n  license: MIT\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
