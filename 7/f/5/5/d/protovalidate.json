  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.2.0\"\n\npackage:\n  name: protovalidate\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/protovalidate/protovalidate-${{ version }}.tar.gz\n  sha256: 4cb9a5065f32abc9baf2cf25c5bd09a139f7dffb7b8692f636a8e3e6883bb9a2\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    env:\n      SETUPTOOLS_SCM_PRETEND_VERSION: ${{ version }}\n    content:\n      - ${{ PYTHON }} -m pip install . -vv\n      # protovalidate imports buf.validate.validate_pb2, which the wheel does\n      # not ship. Install upstream's generated copy from gen/ so the package\n      # works on its own.\n      - ${{ PYTHON }} ${{ RECIPE_DIR }}/install_buf_validate.py\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - hatchling\n    - hatch-vcs\n  run:\n    - python >=${{ python_min }}\n    - cel-python >=0.5\n    # Upstream raises these floors with python_version markers (re2 for 3.12+,\n    # protobuf for 3.14). noarch can't carry markers, so use the highest floor.\n    - google-re2 >=1.1.20251105\n    - protobuf >=6.31.0\n\ntests:\n  - python:\n      imports:\n        - protovalidate\n        - buf.validate.validate_pb2\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - files:\n      source:\n        # Test protos. gen/buf is left out so the installed buf.validate is used.\n        - test/\n        - gen/cel/\n        - gen/tests/\n    requirements:\n      run:\n        - pytest\n    script:\n      env:\n        # Same as upstream's Makefile.\n        PYTHONPATH: gen\n      content:\n        - pytest -v test\n\nabout:\n  homepage: https://github.com/bufbuild/protovalidate-python\n  repository: https://github.com/bufbuild/protovalidate-python\n  documentation: https://protovalidate.com\n  summary: Protocol Buffer Validation for Python\n  license: Apache-2.0\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - killua156\n",
