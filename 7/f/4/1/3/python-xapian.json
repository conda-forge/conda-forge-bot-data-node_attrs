  "raw_meta_yaml": "{% set name = \"python-xapian\" %}\n{% set version = \"2.1.0\" %}\n\npackage:\n  name: {{ name }}\n  version: {{ version }}\n\nsource:\n  url: https://oligarchy.co.uk/xapian/{{ version }}/xapian-bindings-{{ version }}.tar.xz\n  sha256: f52ec189f13b4fa66ea625a6eb94bb32dd651b9ec806be6a911dda54cbe3875c\n  patches:\n    - patches/py315-finalization-workaround.patch\n\nbuild:\n  number: 1\n  skip: true  # [win or python_impl == 'pypy']\n\nrequirements:\n  build:\n    - {{ compiler('cxx') }}\n    - {{ stdlib(\"c\") }}\n    - make\n\n  host:\n    - python\n    - pip\n    - setuptools\n    - sphinx\n    - xapian-core {{ version }}\n\n  run:\n    - python\n\ntest:\n  imports:\n    - xapian\n  commands:\n    # Keep an owning SWIG proxy alive until interpreter shutdown, to check if\n    # finalization works correctly in Python 3.15.\n    - python -c \"import xapian; query = xapian.Query('shutdown-finalization-test')\"\n\nabout:\n  home: http://xapian.org\n  license: GPL-2.0-or-later\n  license_family: GPL\n  license_file: COPYING\n  summary: Python bindings for the Xapian Search Engine Library.\n  description: |\n    Xapian is an Open Source search engine library which allows developers\n    to add advanced indexing and search facilities to their own applications.\n    It has built-in support for several families of weighting models and also\n    supports a rich set of boolean query operators.\n  doc_url: https://xapian.org/docs/bindings/\n  dev_url: https://xapian.org/bleeding\n\nextra:\n  recipe-maintainers:\n    - kohr-h\n",
