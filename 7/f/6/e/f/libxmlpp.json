  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"5.4.0\"\n  major_minor: ${{ (version | split(\".\"))[:2] | join(\".\") }}\n  abi_version: \"5.0\"\n\nrecipe:\n  name: libxmlpp-split\n  version: ${{ version }}\n\nsource:\n  url: http://ftp.gnome.org/pub/GNOME/sources/libxml++/${{ major_minor }}/libxml++-${{ version }}.tar.xz\n  sha256: e9a23c436686a94698d2138e6bcbaf849121d63bfa0f50dc34fefbfd79566848\n\nbuild:\n  number: 3\n\noutputs:\n\n  # Performs the actual build - outputs\n  # are inherited by packages below\n  - staging:\n      name: libxmlpp-build\n    build:\n      script: build_libxmlpp\n    requirements:\n      build:\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - xz-tools\n        - meson\n        - ninja\n        - pkg-config\n      host:\n        - zlib\n        - libxml2-devel\n        - if: win\n          then: liblzma-devel\n\n  # ABI-specific runtime package\n  - package:\n      name: libxmlpp-${{ abi_version }}\n    inherit: libxmlpp-build\n    build:\n      files:\n        - if: win\n          then: Library/bin/xml++-vc143-${{ abi_version }}-1.dll\n        - if: linux\n          then: lib/libxml++-${{ abi_version }}.so.*\n        - if: osx\n          then: lib/libxml++-${{ abi_version }}*.dylib\n    requirements:\n      build:\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - xz-tools\n        - meson\n        - ninja\n        - pkg-config\n      host:\n        - zlib\n        - libxml2-devel\n        - if: win\n          then: liblzma-devel\n      run_exports:\n        - ${{ pin_subpackage(\"libxmlpp-\" ~ abi_version, upper_bound=\"x.x\") }}\n    tests:\n      - package_contents:\n          lib:\n            - if: unix\n              then: xml++-${{ abi_version }}\n          files:\n            - if: win\n              then: Library/bin/xml++-vc143-${{ abi_version }}-1.dll\n\n  # ABI-independent metapackage\n  - package:\n      name: libxmlpp\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"libxmlpp-\" ~ abi_version, exact=True) }}\n\n  # Development package\n  - package:\n      name: libxmlpp-devel\n    inherit: libxmlpp-build\n    build:\n      files:\n        - if: win\n          then:\n           - Library/lib/*\n           - Library/include/*\n        - if: unix\n          then:\n            - include/*\n            - lib/libxml++-${{ abi_version }}/*\n            - lib/pkgconfig/*\n        - if: linux\n          then:\n            - lib/libxml++-${{ abi_version }}.so\n    requirements:\n      run:\n        - libxml2-devel\n      run_exports:\n        - ${{ pin_subpackage(\"libxmlpp-\" ~ abi_version, exact=True) }}\n    tests:\n      - requirements:\n          run:\n            - pkg-config\n        script:\n          - env\n          - pkg-config --exact-version=${{ version }} libxml++-${{ abi_version }}\n\nabout:\n  license: LGPL-2.1-or-later\n  license_file: COPYING\n  summary: C++ bindings for libxml2-devel\n  homepage: https://libxmlplusplus.github.io/libxmlplusplus/\n  repository: https://github.com/libxmlplusplus/libxmlplusplus\n  documentation: https://libxmlplusplus.github.io/libxmlplusplus/\n\nextra:\n  # conda-smithy otherwise names the feedstock after the first output\n  feedstock-name: libxmlpp\n  recipe-maintainers:\n    - scopatz\n    - pauldmccarthy\n",
