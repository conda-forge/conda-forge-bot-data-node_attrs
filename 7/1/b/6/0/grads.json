  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.3\"\n\nrecipe:\n  name: grads\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/RogierFloors/GrADS/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: c669ecac608489c1c322189f81ecd25e70f518b8c8ff8612a0035370a88035ed\n    patches:\n      - platform-build-fixes.patch.txt\n\nbuild:\n  number: 0\n\noutputs:\n  - staging:\n      name: grads-build\n    build:\n      script:\n        - if: win\n          then: build.bat\n          else: build.sh\n    requirements:\n      build:\n        - if: unix\n          then:\n            - ${{ compiler('c') }}\n            - ${{ stdlib('c') }}\n            - make\n            - autoconf\n            - automake\n            - libtool\n            - pkg-config\n        - if: win\n          then:\n            - cmake\n            - ninja\n            - m2w64-toolchain\n            - pkg-config\n        - xorg-xproto\n      host:\n        - xorg-xproto\n        - libxcb\n        - xorg-libx11\n        - xorg-libxext\n        - freetype\n        - libnetcdf\n        - hdf5\n        - if: unix\n          then: hdf4\n        - udunits2\n        # Older Windows builds have no exported API or import library.\n        - if: win\n          then: nceplibs-g2c >=2.3\n          else: nceplibs-g2c\n        - geotiff\n        - libtiff\n        - cairo\n        - if: unix\n          then:\n            - readline\n            - ncurses\n        - libpng\n        - zlib\n        - libjpeg-turbo\n        - jasper\n        - libgd\n        - libxml2\n        - curl\n        - shapelib\n\n  - package:\n      name: grads\n    inherit: grads-build\n    build:\n      number: 0\n      files:\n        - if: unix\n          then:\n            - bin/grads\n            - bin/gribmap\n            - bin/stnmap\n            - bin/gribscan\n            - bin/grib2scan\n            - bin/bufrscan\n            - lib/libgxd*\n            - lib/libgxp*\n            - lib/libgradspy*\n            - share/grads\n            - etc/conda/activate.d/grads-env.sh\n            - etc/conda/deactivate.d/grads-env.sh\n        - if: win\n          then:\n            - Library/bin/grads.exe\n            - Library/bin/gribmap.exe\n            - Library/bin/stnmap.exe\n            - Library/bin/gribscan.exe\n            - Library/bin/grib2scan.exe\n            - Library/bin/bufrscan.exe\n            - Library/bin/libgxd*.dll\n            - Library/bin/libgxp*.dll\n            - Library/bin/gradspy.dll\n            - Library/share/grads\n            - etc/conda/activate.d/grads-env.bat\n            - etc/conda/deactivate.d/grads-env.bat\n    requirements:\n      run:\n        - libnetcdf\n        - hdf5\n        - if: unix\n          then: hdf4\n        - libudunits2\n        - nceplibs-g2c\n        - geotiff\n        - libtiff\n        - jasper\n        - cairo\n        - libcurl\n        - if: unix\n          then: readline\n        - libpng\n        - if: unix\n          then: ncurses\n        - libgd\n        - shapelib\n        - xorg-libice\n        - xorg-libsm\n        - xorg-libx11\n        - xorg-libxext\n    tests:\n      - if: unix\n        then:\n          - script:\n              - printf \"q config\\nquit\\n\" | grads -bl -d gxdummy | grep \"grib2.*netcdf.*hdf4-sds.*hdf5.*geotiff.*shapefile\"\n              - test -x \"$PREFIX/bin/gribmap\"\n              - test -f \"$PREFIX/share/grads/udpt\"\n              - test -f \"$PREFIX/share/grads/ne10m\"\n              - test -f \"$PREFIX/share/grads/ne50m\"\n              - test -f \"$PREFIX/share/grads/ne110m\"\n              - test -f \"$PREFIX/share/grads/nebasemap.gs\"\n              - test -f \"$PREFIX/share/grads/natural_earth_masks.json\"\n              - test -f \"$PREFIX/share/grads/ne110m_land.shp\"\n              - test -f \"$PREFIX/share/grads/ne110m_ocean.shp\"\n              - test -f \"$PREFIX/share/grads/ne50m_land.shp\"\n              - test -f \"$PREFIX/share/grads/ne50m_ocean.shp\"\n              - test -f \"$PREFIX/share/grads/ne10m_land.shp\"\n              - test -f \"$PREFIX/share/grads/ne10m_ocean.shp\"\n              - test -f \"$PREFIX/share/grads/ne10m_land.shx\"\n              - test -f \"$PREFIX/share/grads/ne10m_land.dbf\"\n              - test -f \"$PREFIX/share/grads/ne10m_land.prj\"\n              - test -f \"$GAGPY\"\n      - if: win\n        then:\n          - script:\n              - '(echo q config& echo quit) | grads -bl -d gxdummy | findstr /r \"grib2.*netcdf.*geotiff.*shapefile\"'\n              - if not exist \"%LIBRARY_BIN%\\gribmap.exe\" exit /b 1\n              - if not exist \"%LIBRARY_PREFIX%\\share\\grads\\udpt\" exit /b 1\n              - if not exist \"%LIBRARY_PREFIX%\\share\\grads\\natural_earth_masks.json\" exit /b 1\n              - if not exist \"%GAGPY%\" exit /b 1\n\n  - package:\n      name: gradspy\n    build:\n      number: 0\n      noarch: python\n      script:\n        - if: unix\n          then: install -Dm644 src/gradspy.py \"${SP_DIR}/gradspy.py\"\n        - if: win\n          then:\n            - if not exist \"%SP_DIR%\" mkdir \"%SP_DIR%\"\n            - copy src\\gradspy.py \"%SP_DIR%\\gradspy.py\"\n      files:\n        - if: unix\n          then: lib/python*/site-packages/gradspy.py\n        - if: win\n          then: Lib/site-packages/gradspy.py\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n      run:\n        - python >=${{ python_min }}\n        - numpy >=1.23\n        - pandas\n        - xarray\n        - grads ==${{ version }}\n    tests:\n      - python:\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n          imports:\n            - gradspy\n      - script:\n          - python -c \"from gradspy import GrADS; print(GrADS)\"\n          - python -c \"from gradspy import GrADS; ga = GrADS(); print(ga)\"\n\nabout:\n  homepage: https://wetterzentrale.de/grads/docs/index.html\n  documentation: https://wetterzentrale.de/grads/docs/index.html\n  repository: https://github.com/RogierFloors/GrADS\n  license: GPL-2.0-or-later\n  license_file:\n    - COPYRIGHT\n    - data/UDUNITS2-COPYRIGHT\n  summary: Grid Analysis and Display System\n  description: |\n    GrADS is an interactive desktop tool for access, manipulation, and\n    visualization of earth science data.\n\nextra:\n  recipe-maintainers:\n    - RogierFloors\n",
