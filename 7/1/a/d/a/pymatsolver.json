  "raw_meta_yaml": "context:\n  version: \"0.5.0\"\n  build_num: 0\n  # each default_direct variant gets its own build number range so the solver\n  # preference can be picked with a build number (pardiso > mumps > none)\n  direct_offset: ${{ 200 if default_direct == \"pardiso\" else (100 if default_direct == \"mumps\" else 0) }}\n  # the solver interface installed with this variant (none for the \"none\" variant)\n  direct_dep: ${{ \"pydiso >=0.1\" if default_direct == \"pardiso\" else (\"python-mumps >=0.0.2\" if default_direct == \"mumps\" else \"\") }}\n\npackage:\n  name: pymatsolver\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/pymatsolver/pymatsolver-${{ version }}.tar.gz\n  sha256: 4977943e324d850401d703e64100e494bc7a950a344029a32900a84491a2669f\n\nbuild:\n  number: ${{ build_num + direct_offset }}\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . --no-deps -vv\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools >=64\n    - setuptools_scm >=8\n  run:\n    - python >=${{ python_min }}\n    - numpy >=1.26\n    - scipy >=1.11.2\n    - packaging\n    - ${{ direct_dep }}\n  run_constraints:\n    - pydiso >=0.1\n    - python-mumps >=0.0.2\n\ntests:\n  - python:\n      imports:\n        - pymatsolver\n        - pymatsolver.solvers\n        - pymatsolver.iterative\n        - pymatsolver.wrappers\n        - pymatsolver.direct\n        - pymatsolver.direct.pardiso\n        - pymatsolver.direct.mumps\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\nabout:\n  homepage: https://simpeg.xyz\n  license: MIT\n  license_file: LICENSE\n  summary: \"pymatsolver: Matrix Solvers for Python\"\n  repository: https://github.com/simpeg/pymatsolver\n  documentation: https://simpeg.xyz/pymatsolver/\n\nextra:\n  recipe-maintainers:\n    - lheagy\n    - jcapriot\n",
