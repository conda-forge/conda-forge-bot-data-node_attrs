  "linux_64_meta_yaml": {
    "about": {
      "description": "`bw` is the command-line interface to a Bitwarden vault. It logs in and\nunlocks a vault, then creates, reads, edits and deletes items, folders,\nattachments and organization collections, either interactively or as JSON\non stdin and stdout for scripting. It also generates passwords, imports\nand exports vault data, sends and receives Bitwarden Sends, and can serve\na local REST API for other tools to query.",
      "dev_url": "https://github.com/bitwarden/clients/tree/main/apps/cli",
      "doc_url": "https://bitwarden.com/help/cli/",
      "home": "https://bitwarden.com/help/cli/",
      "license": "GPL-3.0-only",
      "license_family": "GPL-3.0-only",
      "license_file": "LICENSE.txt",
      "summary": "A secure and free password manager for all of your devices."
    },
    "build": {
      "number": "0",
      "script": [
        "cp \"$RECIPE_DIR/pnpm-workspace.yaml\" .",
        "pnpm import",
        "pnpm install --frozen-lockfile --ignore-scripts",
        "pnpm --filter @bitwarden/cli run build:oss:prod",
        "pnpm --filter @bitwarden/cli licenses list --prod --json | pnpm-licenses generate-disclaimer --prod --json-input --output-file THIRD_PARTY_LICENSES.txt",
        "pnpm --dir apps/cli pack --out ../../bitwarden-cli-${{ version }}.tgz",
        "npm install --global --prefix ${{ PREFIX }} --omit=dev --ignore-scripts --no-audit --no-fund --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000 ./bitwarden-cli-${{ version }}.tgz"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "phreed"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "bitwarden-cli",
        "requirements": {
          "build": [
            "nodejs >=24.17,<25",
            "pnpm >=10,<13",
            "pnpm-licenses >=2.4,<3"
          ],
          "host": [
            "nodejs >=24.17,<25"
          ],
          "run": [
            "nodejs >=24.17,<25"
          ]
        },
        "tests": [
          {
            "script": [
              "bw --version",
              "bw --help"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "bw"
              ]
            }
          }
        ],
        "version": "2026.9.0"
      }
    ],
