  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  parts_version: \"2610\"\n  mklist_version: \"1.6\"\n\nrecipe:\n  name: ldraw\n  version: ${{ parts_version }}\n\nsource:\n  - url: https://library.ldraw.org/library/updates/complete.zip\n    sha256: 023083918da2d3697c794fb4267975509584f3611b993095874206a803fa610f\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: ldraw-parts\n      version: ${{ parts_version }}\n    build:\n      noarch: generic\n      skip: not (linux and x86_64)\n      script:\n        file: build_parts\n    tests:\n      - script:\n          - test -f $PREFIX/share/ldraw/LDConfig.ldr\n          - test -f $PREFIX/share/ldraw/LDConfig_TLG.ldr\n          - test -f $PREFIX/share/ldraw/LDCfgalt.ldr\n          - test -d $PREFIX/share/ldraw/parts/\n          - test -d $PREFIX/share/ldraw/models/\n          - test -f $PREFIX/share/ldraw/models/car.ldr\n          - test -f $PREFIX/share/ldraw/parts/u9462.dat\n\n  - package:\n      name: ldraw-mklist\n      version: ${{ mklist_version }}\n    build:\n      script:\n        file: build_mklist\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - if: unix\n          then: unzip\n        - if: win\n          then:\n            - m2-unzip\n            - m2-sed\n        - make\n    tests:\n      - script:\n          - if: unix\n            then:\n              - test -f $PREFIX/bin/mklist\n            else:\n              - if exist \"%LIBRARY_PREFIX%\\bin\\mklist.exe\" (exit 0) else (exit 1)\n\nabout:\n  homepage: https://www.ldraw.org/\n  license: CC-BY-2.0 AND CC-BY-4.0\n  license_file:\n    - CAlicense.txt\n    - CAlicense4.txt\n  summary: LDraw parts library\n  description: |\n    Collection of 3D LEGO parts, 3D part primitives and two example LEGO 3D models\n    in LDraw format. This part library is needed by 3D CAD programs such as MLCAD,\n    LeoCAD and Konstruktor which allow one to construct LEGO models from\n    individual LDraw parts. It is also needed by rendering software such as LDView\n    and LdGLite or instruction creation software like LPub4 or Lic.\n\nextra:\n  recipe-maintainers:\n    - SylvainCorlay\n    - wolfv\n",
