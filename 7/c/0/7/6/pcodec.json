  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.0.4\"\n\npackage:\n  name: pcodec\n  version: ${{ version }}\n\nsource:\n  - url: https://pypi.org/packages/source/p/pcodec/pcodec-${{ version }}.tar.gz\n    sha256: f1ba6caae1536a11f9e5c39c8ef231cb7477fe9c860c172443eea76025af9b39\n  # the sdist does not ship the license file\n  - url: https://raw.githubusercontent.com/pcodec/pcodec/refs/tags/Python_v${{ version }}/LICENSE\n    sha256: c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4\n    file_name: LICENSE\n\nbuild:\n  number: 0\n  script:\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin >=1.0,<2.0\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - cargo-bundle-licenses\n  host:\n    - python\n    - pip\n    - maturin >=1.0,<2.0\n  run:\n    - python\n    - numpy\n\ntests:\n  - python:\n      imports:\n        - pcodec\n        - pcodec.wrapped\n      pip_check: true\n  - files:\n      source:\n        - pco_python/test/\n    requirements:\n      run:\n        - pytest\n    script:\n      # these two tests read pco/assets/, which the sdist does not ship\n      - pytest pco_python/test -v -k \"not test_simple_decompress_errors and not test_decompress_without_n_hint\"\n\nabout:\n  homepage: https://github.com/pcodec/pcodec\n  summary: Lossless codec for numerical data\n  description: |\n    Pcodec (or pco) losslessly compresses and decompresses numerical sequences\n    with high compression ratio and moderately fast speed. This package\n    provides the Python bindings.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  documentation: https://pcodec.readthedocs.io/\n  repository: https://github.com/pcodec/pcodec\n\nextra:\n  recipe-maintainers:\n    - Hoeze\n",
