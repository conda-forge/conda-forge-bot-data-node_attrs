  "linux_64_meta_yaml": {
    "about": {
      "dev_url": "https://github.com/rclone/rclone",
      "doc_url": "https://rclone.org/docs/",
      "home": "https://rclone.org/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": [
        "COPYING",
        "library_licenses/"
      ],
      "summary": "Rclone (\"rsync for cloud storage\") is a command line program to\nsync files and directories to and from different cloud storage providers.\n"
    },
    "build": {
      "number": "1",
      "script": [
        "go build -v -trimpath -tags noselfupdate -ldflags \"-s -X github.com/rclone/rclone/fs.Version=v1.76.0\" -o ${PREFIX}/bin/rclone",
        "GOFLAGS=\"$GOFLAGS -tags=noselfupdate\" go-licenses save . --save_path library_licenses --ignore bazil.org/fuse",
        "mkdir -p library_licenses/bazil.org/fuse && cp \"$(go env GOMODCACHE)/$(go list -m bazil.org/fuse | tr ' ' '@')/LICENSE\" library_licenses/bazil.org/fuse/LICENSE",
        "mkdir -p $PREFIX/share/man/man1 $PREFIX/share/bash-completion/completions $PREFIX/share/zsh/site-functions $PREFIX/share/fish/vendor_completions.d",
        "cp rclone.1 $PREFIX/share/man/man1/rclone.1",
        "$PREFIX/bin/rclone completion bash $PREFIX/share/bash-completion/completions/rclone",
        "$PREFIX/bin/rclone completion zsh $PREFIX/share/zsh/site-functions/_rclone",
        "$PREFIX/bin/rclone completion fish $PREFIX/share/fish/vendor_completions.d/rclone.fish"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "luizirber"
      ]
    },
    "package": {
      "name": "rclone",
      "version": "1.76.0"
    },
