  "raw_meta_yaml": "{% set goname = \"github.com/rclone/rclone\" %}\n{% set version = \"1.76.0\" %}\n\n{% set name = goname.split('/')[-1] %}\n{% set pkg_src = ('src/'+goname).replace(\"/\",os.sep) %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://{{ goname }}/archive/v{{ version }}.tar.gz\n  sha256: 8cb7e5d576fe9a3aef8b1a0785e2ffc6c1953f8ed109f42000b0b86718f6628b\n\nbuild:\n  number: 1\n  script:\n    # fs.Version: otherwise `rclone version` reports \"v{{ version }}-DEV\" (upstream's release builds set it the same way)\n    # -s, -trimpath: strip the symbol table and local paths, as upstream's release builds do\n    # noselfupdate: drop `rclone selfupdate`, which would overwrite the binary conda installed\n    - go build -v -trimpath -tags noselfupdate -ldflags \"-s -X {{ goname }}/fs.Version=v{{ version }}\" -o {{ target_gobin }}{{ name }}{{ target_goexe }}  # [not win]\n    # cmount tag: adds `rclone mount` on Windows (WinFsp, loaded at run time; builds without cgo, like upstream's release)\n    - go build -v -trimpath -tags cmount,noselfupdate -ldflags \"-s -X {{ goname }}/fs.Version=v{{ version }}\" -o {{ target_gobin }}{{ name }}{{ target_goexe }}  # [win]\n    # licenses of all Go dependencies; bazil.org/fuse (linux only) is not recognised by go-licenses\n    # (BSD-3-Clause followed by extra notices), so its LICENSE is copied as is\n    - GOFLAGS=\"$GOFLAGS -tags=noselfupdate\" go-licenses save . --save_path library_licenses --ignore bazil.org/fuse  # [unix]\n    - set \"GOFLAGS=%GOFLAGS% -tags=cmount,noselfupdate\"  # [win]\n    - go-licenses save . --save_path library_licenses --ignore bazil.org/fuse  # [win]\n    - mkdir -p library_licenses/bazil.org/fuse && cp \"$(go env GOMODCACHE)/$(go list -m bazil.org/fuse | tr ' ' '@')/LICENSE\" library_licenses/bazil.org/fuse/LICENSE  # [linux]\n    # man page (shipped in the source) and shell completions; emulated builds can run the binary too\n    - mkdir -p $PREFIX/share/man/man1 $PREFIX/share/bash-completion/completions $PREFIX/share/zsh/site-functions $PREFIX/share/fish/vendor_completions.d  # [unix]\n    - cp rclone.1 $PREFIX/share/man/man1/rclone.1  # [unix]\n    - $PREFIX/bin/rclone completion bash $PREFIX/share/bash-completion/completions/rclone  # [unix]\n    - $PREFIX/bin/rclone completion zsh $PREFIX/share/zsh/site-functions/_rclone  # [unix]\n    - $PREFIX/bin/rclone completion fish $PREFIX/share/fish/vendor_completions.d/rclone.fish  # [unix]\n\nrequirements:\n  build:\n    - {{ compiler(\"go\") }} >=1.13\n    - go-licenses\n\ntest:\n  commands:\n    - rclone version\n    - rclone version | grep -x \"rclone v{{ version }}\"  # [not win]\n    - rclone version | findstr /B /C:\"rclone v{{ version }}\"  # [win]\n    - rclone mount --help  # [win]\n    - rclone version | grep \"go/tags:.*noselfupdate\"  # [not win]\n    - rclone version | findstr /C:\"noselfupdate\"  # [win]\n    - test -s $PREFIX/share/man/man1/rclone.1  # [unix]\n    - test -s $PREFIX/share/bash-completion/completions/rclone  # [unix]\n    - test -s $PREFIX/share/zsh/site-functions/_rclone  # [unix]\n    - test -s $PREFIX/share/fish/vendor_completions.d/rclone.fish  # [unix]\n\nabout:\n  home: https://rclone.org/\n  license: MIT\n  license_family: MIT\n  license_file:\n    - COPYING\n    - library_licenses/\n  summary: |\n    Rclone (\"rsync for cloud storage\") is a command line program to\n    sync files and directories to and from different cloud storage providers.\n  doc_url: https://rclone.org/docs/\n  dev_url: https://github.com/rclone/rclone\n\nextra:\n  recipe-maintainers:\n    - luizirber\n",
