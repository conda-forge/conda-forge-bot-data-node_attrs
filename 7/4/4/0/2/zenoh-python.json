  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.10.2\"\n\nrecipe:\n  name: zenoh-python-split\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/e/eclipse-zenoh/eclipse_zenoh-${{ version }}.tar.gz\n  sha256: a338f4d1a0a736cbae4e1f5becdd2e81a6a2e5934ffa8a4b1436cf0fbac7fb2e\n\nbuild:\n  number: 0\n  skip: not is_python_min\n\noutputs:\n  - package:\n      # The output matches the pypi package name\n      name: eclipse-zenoh\n    build:\n      python:\n        version_independent: true\n      script:\n        env:\n          CARGO_PROFILE_RELEASE_LTO: fat\n          CARGO_PROFILE_RELEASE_STRIP: symbols\n        content:\n          - uv pip install . -vv --python python --system --no-deps --no-build-isolation -C \"build-args=--locked --auditwheel skip\"\n          - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - ${{ compiler('rust') }}\n        - cargo-bundle-licenses\n        - git\n        - uv\n        - if: build_platform != target_platform\n          then:\n            - python\n            - cross-python_${{ target_platform }}\n            - maturin >1,<2\n      host:\n        - python ${{ python_min }}.*\n        - python-abi3\n        - maturin >1,<2\n      run:\n        - python >=${{ python_min }}\n        # We want to protect about a possible future zenoh 2 that may\n        # break wire compatibility\n        - zenoh-rust-abi >=1,<2\n\n    tests:\n      - requirements:\n          run:\n            - abi3audit\n        script:\n          - if: win\n            then: abi3audit -s -v --assume-minimum-abi3 ${{ python_min }} \"%SP_DIR%\\zenoh\\zenoh.pyd\"\n            else: abi3audit -s -v --assume-minimum-abi3 ${{ python_min }} \"$SP_DIR/zenoh/zenoh.abi3.so\"\n\n      - python:\n          imports:\n            - zenoh\n            - zenoh.ext\n            - zenoh.shm\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n      - files:\n          recipe:\n            - test_pubsub.py\n        script:\n          - python test_pubsub.py\n      - files:\n          source:\n            - tests/test_serializer.py\n            - tests/test_timestamp_stack.py\n        requirements:\n          run:\n            - pytest\n            - python ${{ python_min }}.*\n        script:\n          # The other upstream session tests use fixed ports and sleep-based synchronization.\n          - >-\n            python -m pytest -q tests/test_serializer.py\n            tests/test_timestamp_stack.py::test_timestamp_instrumentation_builder\n            tests/test_timestamp_stack.py::test_timestamp_instrumentation_builder_empty\n\n    about:\n      license_file:\n        - LICENSE\n        - NOTICE.md\n        - THIRDPARTY.yml\n\n  - package:\n      # The output matches the repository name, as eclipse-zenoh used in PyPI\n      # world is familiar for people coming from PyPI, but it is not clear for\n      # the multi-language context of conda-forge, in which it is not clear the\n      # the difference between other zenoh packages and the package of zenoh Python.\n      name: zenoh-python\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - eclipse-zenoh ==${{ version }}\n    tests:\n      - python:\n          imports:\n            - zenoh\n\nabout:\n  homepage: https://zenoh.io/\n  repository: https://github.com/eclipse-zenoh/zenoh-python\n  documentation: https://zenoh-python.readthedocs.io/\n  license: Apache-2.0 OR EPL-2.0\n  license_file:\n    - LICENSE\n    - NOTICE.md\n  summary: Python bindings for Eclipse Zenoh\n\nextra:\n  # The feedstock name should match the upstream name of the repo\n  feedstock-name: zenoh-python\n  recipe-maintainers:\n    - traversaro\n",
