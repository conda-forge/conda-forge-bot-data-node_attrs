      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "ocaml-ppx-derivers",
        "requirements": {
          "build": [
            "ocaml_compiler_stub",
            "c_stdlib_stub",
            "ocaml-dune >=1.0"
          ],
          "host": [
            "ocaml 5.4.0.*"
          ],
          "run": []
        },
        "tests": [
          {
            "package_contents": {
              "files": [
                "lib/ocaml/ppx_derivers/*",
                "doc/ppx_derivers/*"
              ],
              "strict": true
            }
          },
          {
            "requirements": {
              "build": [
                "file",
                "binutils"
              ]
            },
            "script": {
              "content": [
                "found=0",
                "for a in $(find \"${PREFIX}/lib/ocaml/ppx_derivers\" -name '*.a'); do\n  found=1\n  d=$(mktemp -d)\n  (cd \"$d\" && ar x \"$a\")\n  out=$(file -L \"$d\"/*.o)\n  echo \"$out\"\n  if echo \"$out\" | grep -v \"${ELF_ARCH}\"; then echo \"wrong arch in $a\"; exit 1; fi\ndone\n",
                "for s in $(find \"${PREFIX}/lib/ocaml/stublibs\" -name 'dll*ppx_derivers*.so' 2>/dev/null); do\n  out=$(file -L \"$s\")\n  echo \"$out\"\n  if echo \"$out\" | grep -v \"${ELF_ARCH}\"; then echo \"wrong arch in $s\"; exit 1; fi\ndone\n",
                "test \"$found\" = 1"
              ],
              "env": {
                "ELF_ARCH": "x86-64"
              }
            }
          }
        ],
        "version": "1.2.1"
      },
