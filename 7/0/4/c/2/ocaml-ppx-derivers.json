  "raw_meta_yaml": "context:\n  version: \"1.2.1\"\n  build_number: 4\n\n  # ELF machine token `file` prints for the target; checked by the arch test\n  elf_arch: ${{ \"x86-64\" if target_platform == \"linux-64\" else \"aarch64\" if target_platform == \"linux-aarch64\" else \"PowerPC\" if target_platform == \"linux-ppc64le\" else \"RISC-V\" if target_platform == \"linux-riscv64\" else \"S/390\" if target_platform == \"linux-s390x\" else \"\" }}\n\n  # ocaml_win-64 ships gcc_* and vs2022_* at the same version/build; name the track.\n  c_toolchain: ${{ \"\" if unix else c_compiler ~ \"_*\" }}\n  library: ${{ \"Library/\" if not unix else \"\" }}\n\npackage:\n  name: ocaml-ppx-derivers\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ocaml-ppx/ppx_derivers/archive/${{ version }}.tar.gz\n  sha256: b6595ee187dea792b31fc54a0e1524ab1e48bc6068d3066c45215a138cc73b95\n\nbuild:\n  number: ${{ build_number }}\n  string: ${{ c_compiler ~ \"_\" if not unix }}h${{ hash }}_${{ build_number }}\n  script:\n    - if: unix\n      then:\n        - dune build --profile=release -p ppx_derivers @install\n        - dune install --prefix=\"${PREFIX}\" --libdir=\"${PREFIX}/lib/ocaml\" ppx_derivers\n      else:\n        # Plain cmd.exe, not MSYS2 bash: pure OCaml, no stubs, so no wrapper is\n        # needed and the backslashed install prefix reaches dune intact. The\n        # dune cache trips over mixed path separators on windows.\n        # dune install also opens the shared cache; disable it for every dune call\n        - set DUNE_CACHE=disabled\n        - dune build --cache=disabled --profile=release -p ppx_derivers @install\n        - if errorlevel 1 exit 1\n        - dune install --prefix=\"%LIBRARY_PREFIX%\" --libdir=\"%LIBRARY_PREFIX%\\lib\\ocaml\" ppx_derivers\n        - if errorlevel 1 exit 1\n\nrequirements:\n  build:\n    - ${{ compiler(\"ocaml\") }}\n    - if: not unix and c_compiler == \"gcc\"\n      then:\n        - ${{ stdlib(\"m2w64_c\") }}\n      else:\n        - ${{ stdlib(\"c\") }}\n    # ocaml_win-64 >=14 only run-constrains the C compiler; activate it here, once (vs2022, zig)\n    - if: not unix and c_compiler != \"gcc\"\n      then:\n        - ${{ compiler(\"c\") }}\n    # compiler(\"ocaml\") renders no toolchain track; name it on windows\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n    # the cross compiler does not pull the native one; the build runs OCaml on the build machine\n    - if: build_platform != target_platform and unix\n      then:\n        - ocaml_${{ build_platform }} ${{ ocaml_compiler_version }}.*\n        # ocaml >=17: the cross compiler activates itself (shims, OCAMLLIB, host OCAMLPATH) and has natdynlink\n        - ocaml_${{ target_platform }}[version=\"${{ ocaml_compiler_version }}.*\", build_number=\">=17\"]\n    # windows cross: the self-contained gcc track needs no vcvars\n    - if: build_platform != target_platform and not unix\n      then:\n        - ocaml_${{ build_platform }} ${{ ocaml_compiler_version }}.* gcc_*\n    - ocaml-dune >=1.0\n  host:\n    # library: ocaml's run_export pins the compiler patch version\n    - ocaml ${{ ocaml_compiler_version }}.*\n    # the noarch ocaml metapackage does not pin the windows toolchain track\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n  # the ocaml run_export does not encode the windows toolchain track\n  run_constraints:\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n\ntests:\n  - package_contents:\n      strict: true\n      files:\n        - ${{ library }}lib/ocaml/ppx_derivers/*\n        - ${{ library }}doc/ppx_derivers/*\n  # cross lanes test under qemu binfmt, which would also run a build-machine\n  # binary; check the native objects' ELF headers name the target instead\n  - if: linux\n    then:\n      script:\n        # test scripts are not jinja-rendered; hand the token over by env\n        env:\n          ELF_ARCH: ${{ elf_arch }}\n        content:\n          - found=0\n          - |\n            for a in $(find \"${PREFIX}/lib/ocaml/ppx_derivers\" -name '*.a'); do\n              found=1\n              d=$(mktemp -d)\n              (cd \"$d\" && ar x \"$a\")\n              out=$(file -L \"$d\"/*.o)\n              echo \"$out\"\n              if echo \"$out\" | grep -v \"${ELF_ARCH}\"; then echo \"wrong arch in $a\"; exit 1; fi\n            done\n          - |\n            for s in $(find \"${PREFIX}/lib/ocaml/stublibs\" -name 'dll*ppx_derivers*.so' 2>/dev/null); do\n              out=$(file -L \"$s\")\n              echo \"$out\"\n              if echo \"$out\" | grep -v \"${ELF_ARCH}\"; then echo \"wrong arch in $s\"; exit 1; fi\n            done\n          - test \"$found\" = 1\n      requirements:\n        build:\n          - file\n          - binutils\n\nabout:\n  homepage: https://github.com/ocaml-ppx/ppx_derivers\n  repository: https://github.com/ocaml-ppx/ppx_derivers\n  summary: Shared ppx_deriving and ppx_type_conv registry for ppx derivers\n  license: BSD-3-Clause\n  license_file: LICENSE.md\n\nextra:\n  recipe-maintainers:\n    - ManuelLerchner\n    - MementoRC\n",
