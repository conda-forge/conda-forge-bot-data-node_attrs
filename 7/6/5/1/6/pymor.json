  "raw_meta_yaml": "context:\n  version: \"2026.1.1\"\n  # python_min: \"3.10\"   # 3.10 is older the current conda-forge min\n\nrecipe:\n  name: pymor\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/p/pymor/pymor-${{ version }}.tar.gz\n  sha256: 3c13192c1453b1db1797cc67ef9938042dca48e2bcae6c828c36e925c55b0da7\n\nbuild:\n  number: 4\n\noutputs:\n  - package:\n      name: pymor\n\n    build:\n      noarch: python\n      script: \"${{ PYTHON }} -m pip install . -vv\"\n      python:\n        entry_points:\n          - pymor-config = pymor.scripts.pymor_config:app\n          - pymor-demo = pymor.scripts.pymor_demo:app.meta\n          - pymor-vis = pymor.scripts.pymor_vis:app\n\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - hatchling >=1.27\n\n      run:\n        - python >=${{ python_min }}\n        - cyclopts\n        - diskcache\n        - matplotlib-base >=3.5.0\n        - numpy >=1.21,!=1.25.0\n        - packaging\n        - pillow\n        - pygments\n        - qtpy >=2.3.1\n        - scipy >=1.8,!=1.15.0,!=1.15.1,!=1.15.2\n        - threadpoolctl\n\n    tests:\n      - python:\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n          imports:\n            - pymor\n            - pymordemos\n\n  - package:\n      name: pymor-full\n\n    build:\n      noarch: generic\n\n    requirements:\n      run:\n        - ${{ pin_subpackage('pymor', exact=True) }}\n\n        # slycot\n        - slycot >=0.5.4\n\n        # ann\n        - pytorch >=1.11.0\n\n        # ipyparallel\n        - ipyparallel >=6.2.5\n\n        # gui\n        - pyqt6\n        - pyopengl\n\n        # jupyter\n        - ipympl\n        - ipywidgets >7\n        - jupyterlab\n        - jupyterlab-myst\n        - k3d >=2.15.2,<3\n        - notebook\n\n        # vtk\n        - lxml\n        - meshio >=4.4\n        - pyevtk\n        - xmljson\n\n        # gmsh\n        - python-gmsh\n\n        # scikit-fem\n        - scikit-fem >=6.0.0\n\n    tests:\n      - python:\n          python_version:\n            - ${{ python_min }}.*\n          imports:\n            - pymor\n            - pymordemos\n          # k3d depends on deepcomparer, which is not packaged in conda-forge\n          pip_check: false\n\nabout:\n  homepage: https://pymor.org\n  license: \"BSD-2-Clause AND BSD-3-Clause\"\n  license_file: LICENSE.txt\n  summary: \"Library for building model order reduction applications with Python\"\n  description: >\n    pyMOR is a software library for building model order reduction applications with the Python programming language. All algorithms in pyMOR are formulated in terms of abstract interfaces, allowing generic implementations to work with different backends, from NumPy/SciPy to external partial differential equation solver\n    packages.\n\nextra:\n  recipe-maintainers:\n    - HenKlei\n    - lbalicki\n    - pmli\n    - sdrave\n",
