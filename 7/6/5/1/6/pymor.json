    "about": {
      "description": "pyMOR is a software library for building model order reduction applications with the Python programming language. All algorithms in pyMOR are formulated in terms of abstract interfaces, allowing generic implementations to work with different backends, from NumPy/SciPy to external partial differential equation solver packages.",
      "home": "https://pymor.org/",
      "license": "BSD-2-Clause AND BSD-3-Clause",
      "license_family": "BSD-2-Clause AND BSD-3-Clause",
      "license_file": "LICENSE.txt",
      "summary": "Library for building model order reduction applications with Python"
    },
    "build": {
      "noarch": "python",
      "number": "3",
      "python": {
        "entry_points": [
          "pymor-config = pymor.scripts.pymor_config:app",
          "pymor-demo = pymor.scripts.pymor_demo:app.meta",
          "pymor-vis = pymor.scripts.pymor_vis:app"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv"
    },
