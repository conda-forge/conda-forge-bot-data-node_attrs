  "raw_meta_yaml": "context:\n  version: \"1.0.0\"\n  tag: ${{ version | replace(\"beta\", \"-beta\") }}\n\npackage:\n  name: rustfs\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/rustfs/rustfs/archive/refs/tags/${{ tag }}.tar.gz\n  sha256: e7d4a9580aa4a48d9df509d8c41eb0521b51e72964d763eaf2f44311e325d708\n\nbuild:\n  number: 0\n  # Currently don't ship the web console because `rustfs/static` is empty at build time.\n  script:\n    # `--ignore-rust-version`: upstream sets `rust-version` to whatever the\n    # current stable release is (1.97.1 in 1.0.0-beta.12, 1.98.1 in 1.0.0)\n    # rather than to a tested minimum, and conda-forge's `rust` activation\n    # packages lag a release behind. The sources build fine on 1.97.1.\n    env:\n      # Upstream's release profile asks for `lto = \"thin\"` with\n      # `codegen-units = 1`. Both are too memory-hungry for the 4-core/16 GB\n      # linux-aarch64 runner, where rustc gets OOM-killed (\"rustc was\n      # terminated by a deadly signal\") — with thin LTO while linking the two\n      # ~200 MB binaries (`rustfs` and `rustfs-cli`, the latter new in 1.0.0)\n      # in parallel, and with one codegen unit while compiling large crates\n      # such as `rustfs-ecstore`. Drop LTO and use cargo's stock release\n      # `codegen-units`, which splits codegen into smaller units.\n      CARGO_PROFILE_RELEASE_LTO: \"off\"\n      CARGO_PROFILE_RELEASE_CODEGEN_UNITS: \"16\"\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - if: unix\n        then:\n          - cargo auditable install --locked --no-track --bins --ignore-rust-version --root ${{ PREFIX }} --path ./rustfs\n        else:\n          # The env vars below are only correct on Windows, so they are exported\n          # here instead of in `script.env` (which applies to every platform).\n          #\n          # aws-lc-sys' default build path emits x86_64 objects when\n          # cross-compiling win-64 -> win-arm64:\n          #   fatal error LNK1112: module machine type 'x64' conflicts with\n          #   target machine type 'ARM64'\n          # Its CMake builder honours the target architecture instead.\n          - set \"AWS_LC_SYS_CMAKE_BUILDER=1\"\n          # Link the host zstd rather than zstd-sys' vendored copy, which does\n          # not survive the cross-compile:\n          #   error LNK2019: unresolved external symbol ZSTD_compressStream\n          # `pkg-config` refuses to run for a foreign target unless cross\n          # lookups are opted into. No PKG_CONFIG_SYSROOT_DIR: conda's .pc\n          # files already carry the relocated host prefix, so prepending a\n          # sysroot would break the paths they contain.\n          - set \"ZSTD_SYS_USE_PKG_CONFIG=1\"\n          - set \"PKG_CONFIG_ALLOW_CROSS=1\"\n          - set \"PKG_CONFIG_PATH=%LIBRARY_PREFIX%\\lib\\pkgconfig\"\n          - cargo auditable install --locked --no-track --bins --ignore-rust-version --root %LIBRARY_PREFIX% --path ./rustfs\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - cmake\n    - ninja\n    - make\n    - libprotobuf\n    - if: win\n      then:\n        - pkg-config\n  host:\n    - if: win\n      then:\n        - zstd\n\ntests:\n  - script:\n      - rustfs --help\n      - rustfs-cli --help\n  - package_contents:\n      bin:\n        - rustfs\n        # New in 1.0.0.\n        - rustfs-cli\n      strict: true\n\nabout:\n  homepage: https://rustfs.com\n  summary: High-performance distributed S3-compatible object storage written in Rust\n  description: |\n    RustFS is an open-source, S3-compatible high-performance object storage\n    system built in Rust. It supports erasure coding, identity and access\n    management, policy management, S3 Select, and migration and coexistence\n    with other S3-compatible platforms such as MinIO and Ceph.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  documentation: https://docs.rustfs.com/\n  repository: https://github.com/rustfs/rustfs\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
