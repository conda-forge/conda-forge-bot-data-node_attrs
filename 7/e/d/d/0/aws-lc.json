  "linux_64_meta_yaml": {
    "about": {
      "description": "AWS-LC is a general-purpose cryptographic library maintained by the AWS\nCryptography team for AWS and their customers. It is based on code from\nGoogle's BoringSSL project and the OpenSSL project.\n\nAWS-LC contains portable C implementations of algorithms needed for TLS\nand common applications, with optimized assembly versions for x86 and\nARM on several platforms.\n\nTo avoid conflicting with the `openssl` package, this build installs its\nheaders under `$PREFIX/include/aws-lc/openssl`, names the libraries\n`libcrypto-awslc` and `libssl-awslc`, and prefixes the command line tools\nwith `aws-lc-`. Consumers should use the `aws-lc`, `libcrypto-awslc` or\n`libssl-awslc` pkg-config files, or the CMake packages `crypto` and `ssl`.",
      "dev_url": "https://github.com/aws/aws-lc",
      "doc_url": "https://github.com/aws/aws-lc/tree/main/docs",
      "home": "https://github.com/aws/aws-lc",
      "license": "(Apache-2.0 OR ISC) AND Apache-2.0 AND ISC AND MIT AND MIT-0 AND BSD-3-Clause",
      "license_family": "(Apache-2.0 OR ISC) AND Apache-2.0 AND ISC AND MIT AND MIT-0 AND BSD-3-Clause",
      "license_file": "LICENSE",
      "summary": "AWS-LC is a general-purpose cryptographic library maintained by AWS"
    },
    "build": {
      "number": "0",
      "script": "build.sh"
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw",
        "xhochy"
      ]
    },
    "outputs": [
