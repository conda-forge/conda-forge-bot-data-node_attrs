  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.17.5\"\n\nrecipe:\n  name: ruff-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/astral-sh/ruff/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 3d920afb666d51ebec3c80ec2847ae7ad14cca3badaaf39f1c0a175d100a4506\n  patches:\n    # let `ruff.find_ruff_bin()` find the executable in `%PREFIX%\\Library\\bin`\n    - find-ruff-conda-windows.patch\n\nbuild:\n  number: 1\n\noutputs:\n  - package:\n      name: ruff\n    build:\n      script:\n        env:\n          JEMALLOC_SYS_WITH_LG_PAGE: ${{ '16' if aarch64 else '' }}\n          CARGO_PROFILE_RELEASE_STRIP: symbols\n          CARGO_PROFILE_RELEASE_LTO: fat\n        content:\n          # rust-lld cannot handle some ppc64le relocations emitted by the jemalloc\n          # C sources, so fall back to the bfd linker there\n          - if: target_platform == \"linux-ppc64le\"\n            then: export CARGO_BUILD_RUSTFLAGS=\"${CARGO_BUILD_RUSTFLAGS:-} -C link-arg=-fuse-ld=bfd\"\n          - if: unix\n            then:\n              - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path crates/ruff\n            else:\n              - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path .\\crates\\ruff\n          - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n          - if: unix\n            then:\n              - mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d\n              - $PREFIX/bin/ruff generate-shell-completion zsh > $PREFIX/share/zsh/site-functions/_ruff\n              - $PREFIX/bin/ruff generate-shell-completion bash > $PREFIX/share/bash-completion/completions/ruff\n              - $PREFIX/bin/ruff generate-shell-completion fish > $PREFIX/share/fish/vendor_completions.d/ruff.fish\n\n    requirements:\n      build:\n        - ${{ stdlib('c') }}\n        - ${{ compiler('c') }}\n        - ${{ compiler('rust') }}\n        - cargo-bundle-licenses\n        - cargo-auditable\n        - if: unix\n          then: make\n\n    tests:\n      - package_contents:\n          bin:\n            - ruff\n          files:\n            - if: unix\n              then:\n                - share/bash-completion/completions/ruff\n                - share/fish/vendor_completions.d/ruff.fish\n                - share/zsh/site-functions/_ruff\n          strict: true\n      - script:\n          - ruff --version\n          - ruff --help\n\n  - package:\n      name: python-ruff\n    build:\n      noarch: python\n      # the noarch package only needs to be built (and tested) once per native\n      # platform; skip the cross-compiled configurations\n      skip: build_platform != target_platform\n      script:\n        - if: unix\n          then: cp ${{ RECIPE_DIR }}/python-ruff/pyproject.toml python/pyproject.toml\n          else: copy %RECIPE_DIR%\\python-ruff\\pyproject.toml python\\pyproject.toml\n        - ${{ PYTHON }} -m pip install -vv --no-deps --no-build-isolation ./python\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - hatchling\n      run:\n        - python >=${{ python_min }}\n        # use the ruff executable from the `ruff` output; the version is pinned\n        # without the build string since this package is noarch\n        - ruff ==${{ version }}\n    tests:\n      - python:\n          imports:\n            - ruff\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n      - requirements:\n          run:\n            - python ${{ python_min }}.*\n        script:\n          - python -m ruff --version\n          - python -m ruff --help\n          - python -c \"import ruff, os; p = ruff.find_ruff_bin(); print(p); assert os.path.isfile(p)\"\n    about:\n      license: MIT\n      license_file:\n        - LICENSE\n      summary: Python package to locate and run the ruff executable (`import ruff`, `python -m ruff`).\n\nabout:\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n    - crates/ruff_unicode_names2/LICENSE-MIT\n    - crates/ruff_unicode_names2/data/LICENSE-UNICODE\n  summary: An extremely fast Python linter, written in Rust.\n  description: |\n    An extremely fast Python linter, written in Rust. Ruff can be used to\n    replace Flake8 (plus a variety of plugins), isort, pydocstyle, yesqa, and\n    even a subset of pyupgrade and autoflake all while executing tens or\n    hundreds of times faster than any individual tool.\n  homepage: https://github.com/astral-sh/ruff\n  documentation: https://docs.astral.sh/ruff\n  repository: https://github.com/astral-sh/ruff\n\nextra:\n  feedstock-name: ruff\n  recipe-maintainers:\n    - dhruvmanila\n    - ntBre\n    - zanieb\n    - messense\n    - charliermarsh\n",
