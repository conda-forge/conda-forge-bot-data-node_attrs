  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.17.0\"\n\npackage:\n  name: ruff\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/astral-sh/ruff/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 2df40dc573eb751154b49055d0949668ec4f72f928d9c7fe5d86f451bfb3d7d5\n\nbuild:\n  number: 0\n  script:\n    env:\n      JEMALLOC_SYS_WITH_LG_PAGE: ${{ '16' if aarch64 else '' }}\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      # rust-lld cannot handle some ppc64le relocations emitted by the jemalloc\n      # C sources, so fall back to the bfd linker there\n      - if: target_platform == \"linux-ppc64le\"\n        then: export CARGO_BUILD_RUSTFLAGS=\"${CARGO_BUILD_RUSTFLAGS:-} -C link-arg=-fuse-ld=bfd\"\n      - if: unix\n        then:\n          - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path crates/ruff\n        else:\n          - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path .\\crates\\ruff\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n      - if: unix\n        then:\n          - mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d\n          - $PREFIX/bin/ruff generate-shell-completion zsh > $PREFIX/share/zsh/site-functions/_ruff\n          - $PREFIX/bin/ruff generate-shell-completion bash > $PREFIX/share/bash-completion/completions/ruff\n          - $PREFIX/bin/ruff generate-shell-completion fish > $PREFIX/share/fish/vendor_completions.d/ruff.fish\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - if: unix\n      then: make\n\ntests:\n  - package_contents:\n      bin:\n        - ruff\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/ruff\n            - share/fish/vendor_completions.d/ruff.fish\n            - share/zsh/site-functions/_ruff\n      strict: true\n  - script:\n      - ruff --version\n      - ruff --help\n\nabout:\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n    - crates/ruff_unicode_names2/LICENSE-MIT\n    - crates/ruff_unicode_names2/data/LICENSE-UNICODE\n  summary: An extremely fast Python linter, written in Rust.\n  description: |\n    An extremely fast Python linter, written in Rust. Ruff can be used to\n    replace Flake8 (plus a variety of plugins), isort, pydocstyle, yesqa, and\n    even a subset of pyupgrade and autoflake all while executing tens or\n    hundreds of times faster than any individual tool.\n  homepage: https://github.com/astral-sh/ruff\n  documentation: https://docs.astral.sh/ruff\n  repository: https://github.com/astral-sh/ruff\n\nextra:\n  recipe-maintainers:\n    - dhruvmanila\n    - ntBre\n    - zanieb\n    - messense\n    - charliermarsh\n",
