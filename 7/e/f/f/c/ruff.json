  "linux_64_meta_yaml": {
    "about": {
      "description": "An extremely fast Python linter, written in Rust. Ruff can be used to\nreplace Flake8 (plus a variety of plugins), isort, pydocstyle, yesqa, and\neven a subset of pyupgrade and autoflake all while executing tens or\nhundreds of times faster than any individual tool.",
      "dev_url": "https://github.com/astral-sh/ruff",
      "doc_url": "https://docs.astral.sh/ruff",
      "home": "https://github.com/astral-sh/ruff",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "An extremely fast Python linter, written in Rust."
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path crates/ruff",
          "cargo-bundle-licenses --format yaml --output THIRDPARTY.yml",
          "mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d",
          "$PREFIX/bin/ruff generate-shell-completion zsh > $PREFIX/share/zsh/site-functions/_ruff",
          "$PREFIX/bin/ruff generate-shell-completion bash > $PREFIX/share/bash-completion/completions/ruff",
          "$PREFIX/bin/ruff generate-shell-completion fish > $PREFIX/share/fish/vendor_completions.d/ruff.fish"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "feedstock-name": "ruff",
      "recipe-maintainers": [
        "dhruvmanila",
        "ntBre",
        "zanieb",
        "messense",
        "charliermarsh"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "ruff",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-bundle-licenses",
            "cargo-auditable",
            "make"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
