  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.1.0\"\n\npackage:\n  name: dataproc-spark-connect\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/d/dataproc-spark-connect/dataproc_spark_connect-${{ version }}.tar.gz\n  sha256: c4d7337a422e80fe6c5cab7ca4e642de5948c6f5dcbe2e6d6ae4aafd32aad55e\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n  run:\n    - python >=${{ python_min }}\n    - google-api-core >=2.19\n    - google-cloud-dataproc >=5.18\n    - packaging >=20.0\n    - pyspark >=4.0.0,<4.1.0\n    - tqdm >=4.67\n    - websockets >=14.0\n    # upstream asks for pyspark[connect]; conda-forge has no package for that\n    # extra and its pyspark carries only the pandas/pyarrow/numpy part, so the\n    # grpc half is listed here\n    - grpcio >=1.67.0\n    - grpcio-status >=1.67.0\n    - googleapis-common-protos >=1.65.0\n\ntests:\n  - python:\n      imports:\n        - google.cloud.dataproc_spark_connect\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\nabout:\n  homepage: https://github.com/GoogleCloudDataproc/dataproc-spark-connect-python\n  repository: https://github.com/GoogleCloudDataproc/dataproc-spark-connect-python\n  license: Apache-2.0\n  license_file: LICENSE\n  summary: Dataproc client library for Spark Connect\n  description: |\n    dataproc-spark-connect extends the Spark Connect Python client with\n    support for Google Cloud Dataproc. It creates and manages Dataproc\n    Spark sessions from a local environment or a notebook, so a remote\n    Dataproc cluster can be driven through the ordinary Spark Connect\n    DataFrame API. IPython magics for session management are included.\n\nextra:\n  recipe-maintainers:\n    - killua156\n",
