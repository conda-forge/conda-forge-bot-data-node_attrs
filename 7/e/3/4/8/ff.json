  "linux_64_meta_yaml": {
    "about": {
      "description": "FF is a package to evaluate one-loop integrals written by G. J.\nvan Oldenborgh, NIKHEF-H, Amsterdam. For the the algorithms used see\npreprint NIKHEF-H 89/17, 'New Algorithms for One-loop Integrals', by\nG.J. van Oldenborgh and J.A.M. Vermaseren, published in Zeitschrift\nfuer Physik C46(1990)425.\n[DOI: 10.1007/BF01621031](https://doi.org/10.1007/BF01621031)",
      "dev_url": "https://github.com/hep-packaging-coordination/ff",
      "home": "https://github.com/hep-packaging-coordination/ff",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "FF: a package to evaluate one-loop integrals"
    },
    "build": {
      "number": "0",
      "script": [
        "cd src/ff",
        "make install FC=$FC FFLAGS=\"$FFLAGS -std=legacy -ffixed-line-length-none\" DEST=$PREFIX/lib --jobs=\"${CPU_COUNT}\"",
        "mkdir -p $PREFIX/include/ff",
        "mv *.h $PREFIX/include/ff",
        "mkdir -p $PREFIX/share/ff",
        "mv *.dat $PREFIX/share/ff/"
      ]
    },
    "extra": {
      "feedstock-name": "ff",
      "recipe-maintainers": [
        "matthewfeickert"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "ff-static",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "fortran_compiler_stub",
            "make",
            "libtool"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "package_contents": {
              "files": [
                "share/ff/fferr.dat",
                "share/ff/ffperm5.dat",
                "share/ff/ffwarn.dat"
              ],
              "include": [
                "ff/aa.h",
                "ff/ff.h",
                "ff/ffs.h"
              ],
              "lib": [
                "libff.a"
              ]
            }
          },
          {
            "files": {
              "source": [
                "src/ff/npointes.f"
              ]
            },
            "requirements": {
              "run": [
                "fortran-compiler",
                "grep"
              ]
            },
            "script": [
              "export FC=gfortran",
              "export FFLAGS=\"-O2\"",
              "export LDFLAGS=\"-L$PREFIX/lib -Wl,-rpath,$PREFIX/lib\"",
              "$FC ./src/ff/npointes.f -o npointes $FFLAGS -I$PREFIX/include/ff $LDFLAGS -lff",
              "./npointes > npointes.log",
              "cat npointes.log",
              "if grep -q \"could not open\" npointes.log; then exit 1; fi"
            ]
          }
        ],
        "version": "2.1.0"
      }
    ],
