  "raw_meta_yaml": "context:\n  version: \"23.1.4\"\n  major: ${{ (version | split(\".\") | list)[0] | int }}\n  triple_arch: ${{ \"x86_64\" if x86_64 else \"aarch64\" }}\n  triple_os: ${{ \"pc-windows-msvc\" if win else \"unknown-linux-gnu\" }}\n  target_triple: ${{ triple_arch ~ \"-\" ~ triple_os }}\n\nrecipe:\n  name: flang-rt-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/llvm/llvm-project/archive/refs/tags/llvmorg-${{ version|replace(\".rc\", \"-rc\") }}.tar.gz\n  sha256: 3e1c70b30f623976c2046d94b8eeab6cac536f107914cb4ed7bac572a03131db\n\nbuild:\n  number: 1\n  # intentionally only windows (main target) & linux (debuggability)\n  skip: osx\n\noutputs:\n  - staging:\n      name: flang-rt-stage\n    build:\n      script:\n        file: build\n        # this is a work-around for something rattler-build should be doing,\n        # see https://github.com/prefix-dev/rattler-build/issues/2587\n        env:\n          PKG_VERSION: ${{ version }}\n    requirements:\n      build:\n        - cmake\n        - ninja\n        - python *\n        - ${{ stdlib('c') }}\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - flang               ==${{ version }}\n        # only to avoid pulling in newer rc's which have a different SONAME\n        - libllvm${{ major }} ==${{ version }}\n        # flang looks for libmlir relative to its binary; since we're only\n        # doing native compilation here, accept this inaccuracy\n        - mlir                ==${{ version }}\n        - lit\n      host:\n        - clangdev      ==${{ version }}\n        - compiler-rt   ==${{ version }}\n        - llvmdev       ==${{ version }}\n        - mlir          ==${{ version }}\n        - libxml2-devel\n        - zlib\n        - zstd\n\n  - package:\n      name: libflang-rt\n    inherit: flang-rt-stage\n    build:\n      # not supported on windows yet, see\n      # https://github.com/llvm/llvm-project/issues/134186\n      skip: win\n      files:\n        - lib/libflang_rt.runtime.so\n    requirements:\n      build:\n        # for strong run-exports\n        - ${{ stdlib('c') }}\n      run_constraints:\n        # avoid old flang runtime\n        - libflang <0.0a0\n    tests:\n      - package_contents:\n          files:\n            # shared library; copied from target-specific location\n            - lib/libflang_rt.runtime.so\n\n  - package:\n      name: flang-rt_${{ target_platform }}\n    inherit: flang-rt-stage\n    build:\n      noarch: generic\n      files:\n        include:\n          - if: unix\n            then:\n              - include/flang-rt/runtime/\n              - lib/clang/${{ major }}/finclude/flang/${{ target_triple }}/*.mod\n              - lib/clang/${{ major }}/lib/${{ target_triple }}/libflang_rt.runtime.a\n              - lib/clang/${{ major }}/lib/${{ target_triple }}/libflang_rt.runtime.so\n            else:\n              - Library/include/flang-rt/runtime/\n              - Library/lib/clang/${{ major }}/finclude/flang/${{ target_triple }}/*.mod\n              # corresponding to different flavours of the MSVC runtime, i.e. `/MD`, `/MDd`, `/MT`, `/MTd`\n              - Library/lib/clang/${{ major }}/lib/${{ target_triple }}/flang_rt.runtime.static.lib\n              - Library/lib/clang/${{ major }}/lib/${{ target_triple }}/flang_rt.runtime.dynamic.lib\n              - Library/lib/clang/${{ major }}/lib/${{ target_triple }}/flang_rt.runtime.static_dbg.lib\n              - Library/lib/clang/${{ major }}/lib/${{ target_triple }}/flang_rt.runtime.dynamic_dbg.lib\n        exclude:\n          # only relevant for windows for now\n          - Library/lib/clang/${{ major }}/finclude/flang/${{ target_triple }}/omp*.mod\n    requirements:\n      build:\n        # for strong run-exports\n        - ${{ stdlib('c') }}\n      host:\n        - clangdev      ==${{ version }}\n        - compiler-rt   ==${{ version }}\n        - llvmdev       ==${{ version }}\n        - mlir          ==${{ version }}\n      run:\n        - clangdev      ==${{ version }}\n        - flang         ==${{ version }}\n    tests:\n      - package_contents:\n          include:\n            # sample\n            - flang-rt/runtime/buffer.h\n          files:\n            exists:\n              - if: unix\n                then:\n                  - lib/clang/${{ major }}/finclude/flang/${{ target_triple }}/__fortran_type_info.mod\n                  - lib/clang/${{ major }}/lib/${{ target_triple }}/libflang_rt.runtime.a\n                  - lib/clang/${{ major }}/lib/${{ target_triple }}/libflang_rt.runtime.so\n                else:\n                  # see https://github.com/conda-forge/flang-feedstock/issues/147\n                  - Library/lib/clang/${{ major }}/finclude/flang/${{ target_triple }}/__fortran_type_info.mod\n                  # corresponding to different flavours of the MSVC runtime, i.e. `/MD`, `/MDd`, `/MT`, `/MTd`\n                  - Library/lib/clang/${{ major }}/lib/${{ target_triple }}/flang_rt.runtime.static.lib\n                  - Library/lib/clang/${{ major }}/lib/${{ target_triple }}/flang_rt.runtime.dynamic.lib\n                  - Library/lib/clang/${{ major }}/lib/${{ target_triple }}/flang_rt.runtime.static_dbg.lib\n                  - Library/lib/clang/${{ major }}/lib/${{ target_triple }}/flang_rt.runtime.dynamic_dbg.lib\n            not_exists:\n              # only relevant for windows for now\n              - Library/lib/clang/${{ major }}/finclude/flang/${{ target_triple }}/omp_lib.mod\n              - Library/lib/clang/${{ major }}/finclude/flang/${{ target_triple }}/omp_lib_kinds.mod\n\n  - package:\n      name: llvm-openmp-fortran\n    inherit: flang-rt-stage\n    build:\n      # restricted to Windows for now\n      skip: not win\n      files:\n        - Library/lib/clang/${{ major }}/finclude/flang/${{ target_triple }}/\n    requirements:\n      host:\n        - llvm-openmp ==${{ version }}\n        - ${{ pin_subpackage(\"flang-rt_\" ~ target_platform, exact=True) }}\n      run:\n        - llvm-openmp ==${{ version }}\n        - ${{ pin_subpackage(\"flang-rt_\" ~ target_platform, exact=True) }}\n      run_exports:\n        strong:\n          - llvm-openmp >=${{ version }}\n    tests:\n      - package_contents:\n          files:\n            exists:\n              - Library/lib/clang/${{ major }}/finclude/flang/${{ target_triple }}/omp_lib.mod\n              - Library/lib/clang/${{ major }}/finclude/flang/${{ target_triple }}/omp_lib_kinds.mod\n            not_exists:\n              - Library/lib/clang/${{ major }}/finclude/flang/${{ target_triple }}/__fortran_type_info.mod\n\nabout:\n  homepage: https://flang.llvm.org\n  license: Apache-2.0\n  license_file: flang/LICENSE.TXT\n  summary: Flang is a Fortran compiler targeting LLVM.\n  repository: https://github.com/llvm/llvm-project\n\nextra:\n  recipe-maintainers:\n    - conda-forge/flang\n    - h-vetinari\n  feedstock-name: flang-rt\n",
