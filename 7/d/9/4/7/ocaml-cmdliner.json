    "outputs": [
      {
        "build": null,
        "name": "ocaml-cmdliner",
        "requirements": {
          "build": [
            "ocaml_compiler_stub",
            "c_stdlib_stub",
            "make"
          ],
          "host": [
            "ocaml 5.4.0.*"
          ],
          "run": []
        },
        "tests": [
          {
            "package_contents": {
              "files": [
                "bin/cmdliner",
                "lib/ocaml/cmdliner/*",
                "share/bash-completion/completions/*",
                "share/zsh/site-functions/*",
                "share/powershell/*"
              ],
              "strict": true
            }
          },
          {
            "requirements": {
              "build": [
                "file",
                "binutils"
              ]
            },
            "script": {
              "content": [
                "set -eu",
                "found=0",
                "tmp=\"$(mktemp -d)\"",
                "for a in $(find \"${PREFIX}/lib/ocaml/cmdliner\" -name '*.a'); do\n  found=1\n  d=\"${tmp}/$(basename \"$a\" .a)\"\n  mkdir -p \"$d\"\n  (cd \"$d\" && ar x \"$a\")\n  out=\"$(find \"$d\" -name '*.o' -exec file -L {} +)\"\n  echo \"$out\"\n  if echo \"$out\" | grep -v \"${ELF_ARCH}\" | grep -q .; then echo \"wrong arch in $a\"; exit 1; fi\ndone\n",
                "test \"$found\" = 1",
                "for s in \"${PREFIX}\"/lib/ocaml/stublibs/dll*cmdliner*.so; do\n  [ -e \"$s\" ] || continue\n  file -L \"$s\"\n  file -L \"$s\" | grep -q \"${ELF_ARCH}\"\ndone\n"
              ],
              "env": {
                "ELF_ARCH": "x86-64"
              }
            }
          }
        ],
        "version": "2.1.1"
      },
