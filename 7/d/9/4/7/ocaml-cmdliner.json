  "raw_meta_yaml": "context:\n  version: \"2.1.1\"\n\npackage:\n  name: ocaml-cmdliner\n  version: ${{ version }}\n\nsource:\n  url: https://erratique.ch/software/cmdliner/releases/cmdliner-${{ version }}.tbz\n  sha256: 05b938d1def4f54c478178f1982822834510431ed98f2ac67cb4d90aa120d6b6\n\nbuild:\n  number: 0\n  skip:\n    - win\n  script:\n    # cmdliner bootstraps itself with `ocaml build.ml`; it has no build-system dependency.\n    - make all PREFIX=\"${PREFIX}\"\n    - make install\n        BINDIR=\"${PREFIX}/bin\"\n        LIBDIR=\"${PREFIX}/lib/ocaml/cmdliner\"\n        SHAREDIR=\"${PREFIX}/share\"\n        MANDIR=\"${PREFIX}/share/man\"\n\nrequirements:\n  build:\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"ocaml\") }}\n    - make\n  host:\n    - ocaml >=4.08.0\n\ntests:\n  - package_contents:\n      strict: true\n      bin:\n        - cmdliner\n      files:\n        - lib/ocaml/cmdliner/*\n        - share/bash-completion/completions/*\n        - share/zsh/site-functions/*\n        - share/powershell/*\n\nabout:\n  homepage: https://erratique.ch/software/cmdliner\n  repository: https://github.com/dbuenzli/cmdliner\n  documentation: https://erratique.ch/software/cmdliner/doc\n  summary: Declarative definition of command line interfaces for OCaml\n  license: ISC\n  license_file: LICENSE.md\n\nextra:\n  recipe-maintainers:\n    - ManuelLerchner\n    - MementoRC\n",
