  "raw_meta_yaml": "context:\n  version: \"2.1.1\"\n  build_number: 2\n\n  # ELF machine token `file` prints for the target; checked by the arch test\n  elf_arch: ${{ \"x86-64\" if target_platform == \"linux-64\" else \"aarch64\" if target_platform == \"linux-aarch64\" else \"PowerPC\" if target_platform == \"linux-ppc64le\" else \"RISC-V\" if target_platform == \"linux-riscv64\" else \"S/390\" if target_platform == \"linux-s390x\" else \"\" }}\n  # ocaml_win-64 ships gcc_* and vs2022_* at the same version/build; name the track.\n  c_toolchain: ${{ \"\" if unix else c_compiler ~ \"_*\" }}\n  library: ${{ \"Library/\" if not unix else \"\" }}\n  m2: ${{ \"m2-\" if not unix else \"\" }}\n\npackage:\n  name: ocaml-cmdliner\n  version: ${{ version }}\n\nsource:\n  url: https://erratique.ch/software/cmdliner/releases/cmdliner-${{ version }}.tbz\n  sha256: 05b938d1def4f54c478178f1982822834510431ed98f2ac67cb4d90aa120d6b6\n\nbuild:\n  number: ${{ build_number }}\n  string: ${{ c_compiler ~ \"_\" if not unix }}h${{ hash }}_${{ build_number }}\n  script: build.sh\n\nrequirements:\n  build:\n    - ${{ compiler(\"ocaml\") }}\n    - if: not unix and c_compiler == \"gcc\"\n      then:\n        - ${{ stdlib(\"m2w64_c\") }}\n      else:\n        - ${{ stdlib(\"c\") }}\n    # ocaml_win-64 >=14 only run-constrains the C compiler; activate it here, once (vs2022, zig)\n    - if: not unix and c_compiler != \"gcc\"\n      then:\n        - ${{ compiler(\"c\") }}\n    # compiler(\"ocaml\") renders no toolchain track; name it on windows\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n    # the cross compiler does not pull the native one; the build runs OCaml on the build machine\n    - if: build_platform != target_platform and unix\n      then:\n        - ocaml_${{ build_platform }} ${{ ocaml_compiler_version }}.*\n        # ocaml >=17: the cross compiler activates itself (shims, OCAMLLIB, host OCAMLPATH) and has natdynlink\n        - ocaml_${{ target_platform }}[version=\"${{ ocaml_compiler_version }}.*\", build_number=\">=17\"]\n    # windows cross: the self-contained gcc track needs no vcvars\n    - if: build_platform != target_platform and not unix\n      then:\n        - ocaml_${{ build_platform }} ${{ ocaml_compiler_version }}.* gcc_*\n    - ${{ m2 }}make\n    # build.sh runs under MSYS2 bash; the Makefile calls install(1)\n    - if: not unix\n      then:\n        - ${{ m2 }}bash >=5.2\n        - ${{ m2 }}coreutils\n  host:\n    # library: ocaml's run_export pins the compiler patch version\n    - ocaml ${{ ocaml_compiler_version }}.*\n    # the noarch ocaml metapackage does not pin the windows toolchain track\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n  # the ocaml run_export does not encode the windows toolchain track\n  run_constraints:\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n\ntests:\n  - package_contents:\n      strict: true\n      files:\n        - ${{ library }}bin/cmdliner${{ \".exe\" if not unix }}\n        - ${{ library }}lib/ocaml/cmdliner/*\n        - ${{ library }}share/bash-completion/completions/*\n        - ${{ library }}share/zsh/site-functions/*\n        - ${{ library }}share/powershell/*\n  # cross lanes test under qemu binfmt, which would also run a build-machine\n  # binary; check the native objects' ELF headers name the target instead\n  - if: linux\n    then:\n      script:\n        # test scripts are not jinja-rendered; hand the token over by env\n        env:\n          ELF_ARCH: ${{ elf_arch }}\n        content:\n          - set -eu\n          - found=0\n          - tmp=\"$(mktemp -d)\"\n          - |\n            for a in $(find \"${PREFIX}/lib/ocaml/cmdliner\" -name '*.a'); do\n              found=1\n              d=\"${tmp}/$(basename \"$a\" .a)\"\n              mkdir -p \"$d\"\n              (cd \"$d\" && ar x \"$a\")\n              out=\"$(find \"$d\" -name '*.o' -exec file -L {} +)\"\n              echo \"$out\"\n              if echo \"$out\" | grep -v \"${ELF_ARCH}\" | grep -q .; then echo \"wrong arch in $a\"; exit 1; fi\n            done\n          - test \"$found\" = 1\n          - |\n            for s in \"${PREFIX}\"/lib/ocaml/stublibs/dll*cmdliner*.so; do\n              [ -e \"$s\" ] || continue\n              file -L \"$s\"\n              file -L \"$s\" | grep -q \"${ELF_ARCH}\"\n            done\n      requirements:\n        build:\n          - file\n          - binutils\n\nabout:\n  homepage: https://erratique.ch/software/cmdliner\n  repository: https://github.com/dbuenzli/cmdliner\n  documentation: https://erratique.ch/software/cmdliner/doc\n  summary: Declarative definition of command line interfaces for OCaml\n  license: ISC\n  license_file: LICENSE.md\n\nextra:\n  recipe-maintainers:\n    - ManuelLerchner\n    - MementoRC\n",
