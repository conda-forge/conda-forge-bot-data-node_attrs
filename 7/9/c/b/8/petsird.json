  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.12.2\"\n\nrecipe:\n  name: petsird\n  version: ${{ version }}\n\nbuild:\n  number: 0\n  skip:\n    - win\n    - osx and not arm64\n\noutputs:\n  - package:\n      name: petsird\n    source:\n      - url: https://pypi.org/packages/source/p/petsird/petsird-${{ version }}.tar.gz\n        sha256: 39c48520769928f43589f8e507841d8c96b07bc2e874a9bf3615c9c13eceb12b\n    build:\n      noarch: python\n      skip:\n        - not linux\n      script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - setuptools >=42\n        - setuptools-scm >=3.4\n        - pip\n      run:\n        - python >=${{ python_min }}\n        - numpy >=1.22\n    tests:\n      - python:\n          imports:\n            - petsird\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n  - package:\n      name: libpetsird\n    source:\n      - url: https://github.com/ETSInitiative/PETSIRD/archive/refs/tags/v${{ version }}.tar.gz\n        sha256: c6b6a01fe7629721468b8831eaea13720f7d4421b148ee0fe8a1b44983ff4b55\n    build:\n      script:\n        # can't currently use \"just\" as it doesn't allow setting CMAKE_PREFIX_PATH,\n        # which seems necessary for finding blas\n        - cd $SRC_DIR\n        - env DEST=yardl ./install_yardl.sh\n        - cd model && ../yardl/yardl generate && cd ..\n        - cmake -GNinja -S cpp -B cpp/build -DCMAKE_INSTALL_PREFIX:PATH=\"${PREFIX}\"\n        - ninja -C cpp/build install\n        # Need to have the same name as in PyPI for the `about: license_file` to work\n        - mv LICENSE.txt LICENSE\n    requirements:\n      build:\n        - cmake\n        - ninja\n        - ${{ stdlib('c') }}\n        - ${{ compiler('cxx') }}\n      host:\n        - hdf5>=1.12.1\n        - howardhinnant_date>=3.0.1\n        - nlohmann_json>=3.11.2\n        - xtensor>=0.24.2\n        - xtensor-blas\n      run:\n        - nlohmann_json>=3.11.2\n        - xtensor>=0.24.2\n        - xtensor-blas\n    tests:\n      - package_contents:\n          include:\n            - petsird_helpers.h\n            - petsird/types.h\n            - petsird/protocols.h\n            # self-distributed yardl (i.e. under petsird/) since there is no yardl-headers conda package (yet) to pin to instead\n            - petsird/yardl/yardl.h\n          files:\n            - lib/cmake/PETSIRD-*/PETSIRDConfig.cmake\n            - lib/cmake/PETSIRD-*/PETSIRDConfigVersion.cmake\n            - lib/*petsird.* # libpetsird.a or equivalent should be present\n\nabout:\n  summary: Library and tools for working with Positron Emission Tomography Standardization Initiative Raw Data (PETSIRD)\n  license: Apache-2.0\n  license_file: LICENSE\n  homepage: https://github.com/ETSInitiative/PETSIRD\n\nextra:\n  recipe-maintainers:\n    - gschramm\n    - KrisThielemans\n    - casperdcl\n",
