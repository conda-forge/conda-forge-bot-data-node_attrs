    "about": {
      "description": "plotastro provides matplotlib style sheets and helpers for producing\npublication-ready figures for astronomy, physics and chemistry journals\n(MNRAS, A&A, ApJ, OJA, the Physical Review journals, JCAP, Nature\nAstronomy, and the RSC and ACS journals): journal-accurate figure sizes,\nfonts and colorblind-friendly palettes, plus a tool that generates LaTeX\nauthor/affiliation blocks from a CSV file.",
      "dev_url": "https://github.com/BehnoodBandi/plotastro",
      "doc_url": "https://plotastro.readthedocs.io/",
      "home": "https://github.com/BehnoodBandi/plotastro",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Publication-quality matplotlib styles and helpers for astronomy, physics and chemistry journals"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "plotastro-authors = plotastro._authors:main"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv"
    },
    "extra": {
      "recipe-maintainers": [
        "BehnoodBandi"
      ]
    },
    "outputs": [
      {
        "build": {
          "noarch": "python",
          "python": {
            "entry_points": [
              "plotastro-authors = plotastro._authors:main"
            ]
          }
        },
        "name": "plotastro",
        "requirements": {
          "build": [],
          "host": [
            "python 3.11.*",
            "hatchling",
