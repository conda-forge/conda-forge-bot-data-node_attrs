  "raw_meta_yaml": "context:\n  version: \"5.9.2\"\n  build_number: 0\n\npackage:\n  name: zsh\n  version: ${{ version }}\n\nsource:\n  - url: https://www.zsh.org/pub/zsh-${{ version }}.tar.xz\n    sha256: 36fa734374b44783582cec09bcd67822e2f992c779ec1624ab5596df078d2f81\n  # Prebuilt manuals avoid requiring texinfo, which is unavailable on linux-riscv64.\n  - url: https://www.zsh.org/pub/zsh-${{ version }}-doc.tar.xz\n    sha256: 020ee644be1749507b282e619cdcd95c56ff36144e79b7a3c245458aacd9458f\n\nbuild:\n  number: ${{ build_number }}\n  skip: win\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - make\n    - if: unix\n      then: gnuconfig\n  host:\n    - ncurses\n    - pcre2\n    - if: linux\n      then: libcap\n    # GDBM is not yet packaged for linux-riscv64 on conda-forge.\n    - if: not riscv64\n      then: gdbm\n\ntests:\n  - package_contents:\n      bin:\n        - zsh\n      files:\n        - share/info/zsh.info\n        - share/man/man1/zsh.1\n        - if: not riscv64\n          then: lib/zsh/${{ version }}/zsh/db/gdbm.bundle\n  - script:\n      - zsh --version | grep -F \"zsh ${{ version }} \"\n      # Verify prefix relocation did not overwrite a version string shared with a path.\n      - zsh -fc '[[ $ZSH_VERSION == \"${{ version }}\" ]]'\n      - zsh -c 'echo hi' | grep hi\n      # Check that the installed PCRE2 module loads and matches; configure can silently omit it.\n      - zsh -fc 'zmodload zsh/pcre && [[ abc -pcre-match \"a.c\" ]]'\n      - if: linux\n        then: zsh -fc 'zmodload zsh/cap && cap'\n      - if: not riscv64\n        then: zsh -fc 'zmodload zsh/db/gdbm && ztie -d db/gdbm -f test.gdbm db && db[key]=value && zuntie db && ztie -d db/gdbm -f test.gdbm db && [[ $db[key] == value ]] && zuntie db'\n\nabout:\n  homepage: https://zsh.org/\n  license: MIT\n  license_file: LICENCE\n  summary: Zsh is a shell designed for interactive use, although it is also a powerful scripting language.\n  documentation: ht