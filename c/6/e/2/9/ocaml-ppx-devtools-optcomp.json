  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: ppx_devtools-optcomp\n  version: \"0.1\"\n  build_number: 0\n\n  library: ${{ \"Library/\" if not unix else \"\" }}\n  m2: ${{ \"m2-\" if not unix else \"\" }}\n  # ocaml_<platform> matchspec tail: version, plus the gcc_ (MinGW) track on non-unix\n  ocaml_spec: ${{ ocaml_compiler_version ~ (\".*\" if unix else \".* gcc_*\") }}\n\npackage:\n  name: ocaml-ppx-devtools-optcomp\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ocsigen/ppx_devtools/releases/download/${{ version }}/ppx_devtools-${{ version }}.tbz\n  sha256: 46ad4e62a213e3c0852c02cd1cc182d88ec89afa284a45a4316cfb3ffc0bcb9c\n\nbuild:\n  number: ${{ build_number }}\n  string: ${{ \"gcc_\" if not unix }}h${{ hash }}_${{ build_number }}\n  script: bash ${{ RECIPE_DIR }}/build.sh\n\nrequirements:\n  build:\n    - ${{ compiler(\"ocaml\") }}\n    # compiler(\"ocaml\") renders no toolchain track; name the gcc_ (MinGW) one on non-unix\n    - ocaml_${{ target_platform }} ${{ ocaml_spec }}\n    # no C stubs; ocamlopt still links through the C compiler on non-unix\n    - if: unix\n      then:\n        - ${{ stdlib(\"c\") }}\n      else:\n        - ${{ compiler(\"m2w64_c\") }}\n        - ${{ stdlib(\"m2w64_c\") }}\n    - ocaml-dune >=3.20\n    - ${{ m2 }}make\n    - if: not unix\n      then:\n        - m2-bash\n        - m2-coreutils\n        - m2-sed\n        - m2-grep\n        - m2-findutils\n  host:\n    # library: ocaml's run_export pins the compiler patch version\n    - ocaml ${{ ocaml_spec }}\n    - ocaml-ppxlib >=0.33\n  run:\n    - ocaml-ppxlib >=0.33\n  # the ocaml run_export does not encode the non-unix toolchain track\n  run_constraints:\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_spec }}\n\ntests:\n  - package_contents:\n      files:\n        - ${{ library }}lib/ocaml/${{ name }}/META\n        - ${{ library }}lib/ocaml/${{ name }}/ppx_devtools_optcomp.cma\n        - ${{ library }}lib/ocaml/${{ name }}/ppx_devtools_optcomp.cmxa\n        - ${{ library }}lib/ocaml/${{ name }}/ppx_devtools_optcomp.a\n        - ${{ library }}lib/ocaml/${{ name }}/ppx_devtools_optcomp.cmxs\n  - script:\n      interpreter: bash\n      content:\n        - export DUNE_CACHE=disabled\n        - LIBDIR=$PREFIX/lib/ocaml; SEP=':'\n        - if [[ -d $PREFIX/Library/lib/ocaml ]]; then LIBDIR=$PREFIX/Library/lib/ocaml; SEP=';'; fi\n        - export OCAMLPATH=\"$LIBDIR${OCAMLPATH:+$SEP$OCAMLPATH}\"\n        - echo '(lang dune 3.0)' > dune-project\n        - echo '(executable (name t) (preprocess (pps ppx_devtools-optcomp)))' > dune\n        - printf '%s\\n' 'let x = 1 [@@if ocaml_version >= (4, 0, 0)]' 'let y = this_identifier_does_not_exist [@@if ocaml_version < (4, 0, 0)]' 'let () = ignore x; print_string \"ok\"' > t.ml\n        - dune build --root . ./t.exe\n        - ./_build/default/t.exe | grep -q ok\n    requirements:\n      run:\n        - ocaml ${{ ocaml_spec }}\n        - ocaml-dune >=3.20\n        - if: unix\n          then:\n            - ${{ compiler(\"c\") }}\n        - if: not unix\n          then:\n            - m2-bash\n            - m2-coreutils\n            - m2-grep\n\nabout:\n  homepage: https://github.com/ocsigen/ppx_devtools\n  repository: https://github.com/ocsigen/ppx_devtools\n  license: LGPL-2.1-or-later WITH OCaml-LGPL-linking-exception\n  license_file: LICENSE\n  summary: Lightweight ppx for conditional compilation\n  description: |\n    ppx_devtools-optcomp gates code at compile time with [@if] attributes,\n    depending on the OCaml version, the operating system or the compiler flavour.\n\nextra:\n  recipe-maintainers:\n    - MementoRC\n    - ManuelLerchner\n",
