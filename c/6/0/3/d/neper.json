  "raw_meta_yaml": "{% set name = \"neper\" %}\n{% set version = \"7.0.1\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://github.com/neperfepx/neper/archive/v{{ version }}.tar.gz\n  sha256: af52494ea343df596f99303a8ebf1f2aef8acf63c00b2c7c90afccdcb7e80807\n\nbuild:\n  number: 0\n  skip: true  # [win]\n\nrequirements:\n  build:\n    - {{ compiler('c') }}\n    - {{ compiler('cxx') }}\n    - {{ stdlib('c') }}\n    - cmake\n    - make\n  host:\n    - llvm-openmp  # [osx]\n    - libgomp  # [linux]\n    # Gmsh library (libgmsh and gmshc.h), mandatory since Neper 7.0.0\n    - gmsh >=4.9\n    - gsl\n    - scotch\n  run:\n    # the Gmsh library changes name (soname) at each minor version\n    - {{ pin_compatible('gmsh', max_pin='x.x') }}\n    - gsl\n    - scotch\n    # image generation (neper -V)\n    - povray\n\ntest:\n  commands:\n    - test -f $PREFIX/bin/neper\n    - test -f $PREFIX/bin/orilib\n    - neper --version  # [build_platform == target_platform]\n    - neper -T -n 10 -reg 1 -o n10  # [build_platform == target_platform]\n    - neper -M n10.tess  # [build_platform == target_platform]\n    - test -f n10.msh  # [build_platform == target_platform]\n    - neper -M n10.tess -part 2 -o n10p  # [build_platform == target_platform]\n    - grep -q NodePart n10p.msh  # [build_platform == target_platform]\n    - neper -V n10.tess,n10.msh -print img  # [build_platform == target_platform]\n    - test -f img.png  # [build_platform == target_platform]\n\nabout:\n  home: https://neper.info/\n  license: GPL-3.0-only\n  license_family: GPL\n  license_file:\n    - COPYING\n    - CREDITS\n    - src/contrib/muparser/LICENSE\n  summary: Neper is a software package for polycrystal generation and meshing.\n  doc_url: https://neper.info/doc/\n  dev_url: https://github.com/neperfepx/neper\n\nextra:\n  recipe-maintainers:\n    - npavlovikj\n    - lang-m\n    - rquey\n",
