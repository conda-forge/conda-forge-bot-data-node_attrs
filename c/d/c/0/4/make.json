  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"4.4.1\"\n\npackage:\n  name: make\n  version: ${{ version }}\n\nsource:\n  url: https://ftp.gnu.org/gnu/make/make-${{ version }}.tar.gz\n  sha256: dd16fb1d67bfab79a72f5e8390735c49e3e8e70b4945a15ab1f81ddb78658fb3\n  patches:\n    - patches/msvc-have-stdint.patch\n\nbuild:\n  number: 4\n  prefix_detection:\n    ignore_binary_files: true\n\nrequirements:\n  build:\n    - if: unix\n      then:\n        - bash\n        - libtool\n    - if: unix or (target_platform == \"win-arm64\")\n      then:\n        - ${{ stdlib(\"c\") }}\n        - ${{ compiler(\"c\") }}\n    # MinGW gcc is not available on win-arm64; MSVC is used there instead.\n    - if: win and (target_platform != \"win-arm64\")\n      then:\n        - ${{ stdlib(\"m2w64_c\") }}\n        - ${{ compiler(\"m2w64_c\") }}\n        # build wants to find `gcc` binary\n        - gcc\n    - if: build_platform != target_platform\n      then: make\n\ntests:\n  - script:\n      - if: unix\n        then:\n          - $PREFIX/bin/make --help\n          - test \"$(readlink \"$PREFIX/bin/gmake\")\" = make\n          - $PREFIX/bin/gmake --version\n      - if: win\n        then:\n          - '%LIBRARY_BIN%\\gnumake.exe --help'\n          - '%LIBRARY_BIN%\\make.exe --help'\n          - '%LIBRARY_BIN%\\mingw32-make.exe --help'\n\nabout:\n  homepage: https://www.gnu.org/software/make/\n  license: GPL-3.0-or-later\n  license_file: COPYING\n  summary: >-\n    GNU Make is a tool which controls the generation of executables and other non-source files of a program from the program's source files.\n  documentation: https://www.gnu.org/software/make/manual/\n\nextra:\n  recipe-maintainers:\n    - asmeurer\n    - scopatz\n    - h-vetinari\n",
