      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE.txt",
      "summary": "Compare two sets of PUDL Parquet outputs, and report on what changed."
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "pudl_diff = pudl_diff.cli:main"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv"
