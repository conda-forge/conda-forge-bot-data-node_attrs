  "raw_meta_yaml": "{% set xorg_name = \"libxcb\" %}\n{% set xorg_category = \"lib\" %}\n{% set name = \"libxcb\" %}\n{% set version = \"1.17.0\" %}\n{% set sha256 = \"2c69287424c9e2128cb47ffe92171e10417041ec2963bceafb65cb3fcf8f0b85\" %}\n{% set am_version = \"1.15\" %} # keep synchronized with build.sh\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://xorg.freedesktop.org/archive/individual/{{ xorg_category }}/{{ xorg_name }}-{{ version }}.tar.gz\n  sha256: {{ sha256 }}\n  patches:\n    - windows.patch  # [win and not arm64]\n    - native-clang.patch  # [win and arm64]\n\nbuild:\n  number: 3\n  detect_binary_files_with_prefix: true\n  run_exports:\n    - {{ pin_subpackage('libxcb', max_pin='x') }}\n\nrequirements:\n  build:\n    - python                        # [build_platform != target_platform and not (win and arm64)]\n    - python >=3.14                 # [win and arm64]\n    - xcb-proto {{ version }}       # [build_platform != target_platform or (win and arm64)]\n    # Keep the x64 MinGW toolchain; ARM64 uses native Clang with the MSVC runtime.\n    - {{ stdlib(\"c\") }}\n    - {{ compiler(\"c\") }}\n    - m2-autoconf                   # [win and not arm64]\n    - m2-automake{{ am_version }}   # [win and not arm64]\n    # 2.6 drops MSYS shared-library support; keep the existing x64 DLL ABI.\n    - m2-libtool <2.6               # [win and not arm64]\n    - pkg-config                    # [unix or arm64]\n    - xorg-util-macros               # [win and arm64]\n    - m2-pkg-config                 # [win and not arm64]\n    - gnuconfig                     # [unix or arm64]\n    - m2-base                       # [win]\n    - make                          # [unix]\n    - m2-make                       # [win]\n    - autoconf                      # [unix]\n    - automake                      # [unix]\n    - gettext                       # [unix]\n    - libtool                       # [unix]\n  host:\n    - winpthreads                   # [win and arm64]\n    - pthread-stubs\n    - xorg-libxau\n    - xorg-libxdmcp\n    - xorg-util-macros              # [not (win and arm64)]\n    - xcb-proto {{ version }}       # [not (win and arm64)]\n    - xorg-xorgproto\n  run:\n    - libwinpthread                 # [win and arm64]\n    - winpthreads                   # [win and arm64]\n    - xorg-xorgproto                # [win and arm64]\n    - pthread-stubs\n    - xorg-libxau\n    - xorg-libxdmcp\n\ntest:\n  files:\n    - test-libraries.sh  # [unix]\n    - test-libraries.bat  # [win]\n  commands:\n    - bash test-libraries.sh  # [unix]\n    - call test-libraries.bat mingw  # [win and not arm64]\n    - call test-libraries.bat arm64  # [win and arm64]\n\nabout:\n  home: http://xcb.freedesktop.org/\n  license: MIT\n  license_family: MIT\n  license_file: COPYING\n  summary: \"This is the C-language Binding (XCB) package to the X Window System protocol\"\n\nextra:\n  recipe-maintainers:\n    - ccordoba12\n    - pkgw\n    - ClayWarren\n",
