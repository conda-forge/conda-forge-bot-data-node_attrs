  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: git-pkgs-proxy\n  version: \"0.9.1\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/git-pkgs/proxy/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 7a470a221374a8ee2ea25f38ef6068096fd674fd46221bafc2ae7dbf948f7616\n  target_directory: src\n\nbuild:\n  number: 0\n  script:\n    - cd src\n    # oapi-codegen/nullable is Apache-2.0, but its LICENSE is in an incompatible/unknown format\n    # https://github.com/oapi-codegen/nullable?tab=License-1-ov-file\n    - go-licenses save ./cmd/proxy --save_path ../library_licenses --ignore github.com/oapi-codegen/nullable\n    - if: unix\n      then: go build -v -o $PREFIX/bin/proxy -ldflags=\"-s -w -X main.Version=${{ version }}\" ./cmd/proxy\n      else: go build -v -o %LIBRARY_BIN%\\proxy.exe -ldflags=\"-s -X main.Version=${{ version }}\" ./cmd/proxy\n\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n\ntests:\n  - script:\n      - proxy -version\n      - if: unix\n        then: proxy -version | grep ${{ version }}\n  - package_contents:\n      bin:\n        - proxy\n      strict: true\n\nabout:\n  homepage: https://github.com/git-pkgs/proxy\n  summary: A lightweight caching proxy for package registries\n  description: |\n    A caching proxy for package registries. Speeds up package downloads \n    by caching artifacts locally, reducing bandwidth usage and improving \n    reliability.\n  license: GPL-3.0-or-later\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n  documentation: https://git-pkgs.dev/docs/tools/proxy/\n  repository: https://github.com/git-pkgs/proxy\n\nextra:\n  recipe-maintainers:\n    - soapy1\n",
