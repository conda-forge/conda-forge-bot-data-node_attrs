  "raw_meta_yaml": "context:\n  version: \"3.17.1\"\n\npackage:\n  name: html-to-markdown-cli\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/xberg-io/html-to-markdown/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 820846e0a8de1df6ad3a6a76b99bfa7b4379c0221aa27a2006b2d266164a9138\n\nbuild:\n  number: 0\n  script:\n    env:\n      AWS_LC_SYS_CMAKE_BUILDER: \"1\" # force CMake builder for `aws-lc-sys` native C/C++ code\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build main app and generate license data\n      - cd crates/html-to-markdown-cli\n      - ^cargo auditable install --path=. --root=($prefix) --no-track --locked --bins\n      - ^cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml\n      # generate shell completions\n      - if: build_platform == host_platform\n        then:\n          - mkdir ($prefix)/share/man/man1 ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions\n          - ^html-to-markdown --generate-man             | save ($prefix)/share/man/man1/html-to-markdown.1\n          - ^html-to-markdown --generate-completion bash | save ($prefix)/share/bash-completion/completions/html-to-markdown\n          - ^html-to-markdown --generate-completion fish | save ($prefix)/share/fish/vendor_completions.d/html-to-markdown.fish\n          - ^html-to-markdown --generate-completion zsh  | save ($prefix)/share/zsh/site-functions/_html-to-markdown\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - cmake\n    - nushell\n    - if: unix\n      then: make\n\ntests:\n  - script:\n      - html-to-markdown --help\n      - html-to-markdown --version\n  - package_contents:\n      bin:\n        - html-to-markdown\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/man/man1/html-to-markdown.1\n            - share/bash-completion/completions/html-to-markdown\n            - share/fish/vendor_completions.d/html-to-markdown.fish\n            - share/zsh/site-functions/_html-to-markdown\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/man/man1/html-to-markdown.1\n            - Library/share/bash-completion/completions/html-to-markdown\n            - Library/share/fish/vendor_completions.d/html-to-markdown.fish\n            - Library/share/zsh/site-functions/_html-to-markdown\n      strict: true\n\nabout:\n  summary: A fast, powerful HTML to Markdown converter\n  description: |\n    Command-line interface for html-to-markdown, a high-performance\n    HTML to Markdown converter with comprehensive customization options.\n    Uses the html5ever parser for standards-compliant HTML processing.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://docs.html-to-markdown.xberg.io\n  repository: https://github.com/xberg-io/html-to-markdown\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
