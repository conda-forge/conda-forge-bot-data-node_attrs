  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  stubs_version: 1\n  cherab_version: 1.6.0\n  cherab_cap: 1.7.0\n  raysect_version: 0.9.1\n  raysect_cap: 0.10.0\n\nrecipe:\n  name: cherab-stubs-split\n  version: ${{ cherab_version }}.${{ stubs_version }}\n\nsource:\n  url: https://github.com/munechika-koyo/cherab-stubs/archive/v${{ cherab_version }}.${{ stubs_version }}.tar.gz\n  sha256: a61b8ae89fc07279987aca0a73347280a53514ab213793cbc9bcb5a3301fcf11\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: cherab-stubs\n    build:\n      noarch: python\n      script:\n        content: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n        env:\n          SETUPTOOLS_SCM_PRETEND_VERSION: ${{ cherab_version }}.${{ stubs_version }}\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - hatchling\n        - hatch-vcs\n      run:\n        - python >=${{ python_min }}\n        - raysect-stubs >=${{ raysect_version }},<${{ raysect_cap }}\n        - scipy-stubs\n      run_constraints:\n        - cherab >=${{ cherab_version }},<${{ cherab_cap }}\n    tests:\n      - python:\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n          pip_check: true\n\n  - package:\n      name: cherab-typed\n    build:\n      noarch: python\n      skip: win\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n      run:\n        - python >=${{ python_min }}\n        - cherab ==${{ cherab_version }}\n        - ${{ pin_subpackage('cherab-stubs', exact=True) }}\n        - __unix\n    tests:\n      - python:\n          imports:\n            - cherab\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n          pip_check: true\n      - files:\n          source:\n            - pyproject.toml\n            - .mypyignore\n            - tests/\n        requirements:\n          run:\n            - python ${{ python_min }}.*\n            - pytest\n     