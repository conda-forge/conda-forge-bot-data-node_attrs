  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.0.1\"\n\npackage:\n  name: libghostty-vt\n  version: ${{ version }}\n\nsource:\n  - url: https://release.files.ghostty.org/libghostty-vt/${{ version }}/libghostty-vt-${{ version }}.tar.gz\n    sha256: 333dfce97641ef9b536bb9e08907ad86abaaada50e8f7417b70d9284adef37aa\n    patches:\n      - patches/build-glibc-version.patch\n  - url: https://release.files.ghostty.org/libghostty-vt/${{ version }}/libghostty-vt-${{ version }}-deps.tar.gz\n    sha256: 91a4e10960a52bf5bf4b15aa2a2cddaff8a89d6cd903d3055bda4fd17de3356d\n    target_directory: vt-deps\nbuild:\n  number: 0\n  script:\n    interpreter: python\n    file: build-lib.py\n    env:\n      # Recipe variants are not automatically exported to build scripts.\n      C_STDLIB_VERSION: ${{ c_stdlib_version if linux else \"\" }}\nrequirements:\n  # The stable C ABI is compatible within the same major version.\n  run_exports:\n    - ${{ pin_subpackage('libghostty-vt', upper_bound='x') }}\n  build:\n    - zig 0.17.0.*\n    - python >=3.11\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\ntests:\n  - package_contents:\n      strict: true\n      include:\n        - ghostty/vt.h\n        - ghostty/vt/osc.h\n        - ghostty/vt/**/*.h\n      lib:\n        - ghostty-vt\n        - if: unix\n          then: libghostty-vt.a\n          else: ghostty-vt-static.lib\n      files:\n        - etc/conda/test-files/libghostty-vt/0/test-lib.c\n        - etc/conda/test-files/libghostty-vt/0/test-lib.py\n        - if: win\n          then: Library/bin/ghostty-vt.pdb\n        - if: unix\n          then:\n            - lib/pkgconfig/libghostty-vt.pc\n            - lib/pkgconfig/libghostty-vt-static.pc\n            - lib/cmake/ghostty-vt/ghostty-vt-config.cmake\n            - lib/cmake/ghostty-vt/ghostty-vt-config-version.cmake\n          else:\n            - Library/lib/pkgconfig/libghostty-vt.pc\n            - Library/lib/pkgconfig/libghostty-vt-static.pc\n            - Library/lib/cmake/ghostty-vt/ghostty-vt-config.cmake\n            - Library/lib/cmake/ghostty-vt/ghostty-vt-config-version.cmake\n  - script: python test-lib.py\n    requirements:\n      run:\n        - python >=3.11\n        - ${{ compiler('c') }}\n        - pkgconf\n    files:\n      recipe:\n        - test-lib.py\n        - test-lib.c\n\nabout:\n  homepage: https://ghostty.org\n  summary: Ghostty VT parsing library with a C API\n  description: Standalone terminal sequence parsing library, without the Ghostty GUI.\n  license: MIT\n  license_file: LICENSE\n  repository: https://github.com/ghostty-org/ghostty\n  documentation: https://ghostty.org/docs\n\nextra:\n  recipe-maintainers:\n    - davidbrochart\n",
