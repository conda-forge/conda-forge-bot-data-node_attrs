  "linux_64_meta_yaml": {
    "about": {
      "description": "Herwig provides significantly improved and extended physics capabilities when compared to both its predecessors,\nHERWIG 6 and Herwig++ 2, while keeping the key model motivations such as coherent parton showers (including\nangular-ordered and dipole-based evolution), the cluster hadronization model, an eikonal multiple-interaction model,\nhighly flexible BSM capabilities and improved perturbative input using next-to-leading order QCD.\n\nThe default PDF sets used by Herwig are not distributed with the package and need to be installed with\n`lhapdf install CT14lo CT14nlo`.",
      "dev_url": "https://repo.hepforge.org/source/herwighg/",
      "doc_url": "https://herwig.hepforge.org/doxygen/",
      "home": "https://herwig.hepforge.org/",
      "license": "GPL-3.0-or-later",
      "license_family": "GPL-3.0-or-later",
      "license_file": "COPYING",
      "summary": "Multi-purpose particle physics event generator"
    },
    "build": {
      "number": "1",
      "run_exports": {
        "weak": [
          "herwig"
        ]
      },
      "script": [
        "export LHAPDF_DATA_PATH=\"${SRC_DIR}/pdfsets\"",
        "export LDFLAGS=\"${LDFLAGS} -Wl,-rpath,${PREFIX}/lib/ThePEG\"",
        "export CXXFLAGS=\"${CXXFLAGS} -fno-tree-loop-if-convert\"",
        "rm -rf Looptools/{A,B,C,D,E,util}",
        "autoreconf --force --install",
        "cp $BUILD_PREFIX/share/gnuconfig/config.* ./Config",
        "./configure --help",
        "./configure --prefix=${PREFIX} --with-thepeg=${PREFIX} --with-fastjet=${PREFIX} --with-gsl=${PREFIX} --with-boost=${PREFIX}",
        "make -j${CPU_COUNT}",
        "make install"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "utk4r-sh",
        "GiacomoXT",
        "vvsagar",
        "AlexanderHeidelbach",
        "conda-forge/hepmc3"
      ]
    },
    "outputs": [
      {
        "build": {
          "run_exports": {
            "weak": [
              "herwig"
            ]
          }
        },
        "name": "herwig",
        "requirements": {
          "build": [
            "fortran_compiler_stub",
            "cxx_compiler_stub",
            "c_stdlib_stub",
            "make",
            "pkg-config",
            "gnuconfig",
            "autoconf",
            "automake",
            "libtool"
          ],
          "host": [
            "fastjet-cxx",
            "fastjet-cxx-devel",
            "gsl",
            "libboost-headers",
            "looptools",
            "thepeg 2.3.*"
          ],
          "run": [
            "python"
          ]
        },
        "tests": [
          {
            "package_contents": {
              "bin": [
                "Herwig",
                "herwig-config",
                "herwig-combinedistributions",
                "herwig-combineruns",
                "herwig-makedistributions",
                "herwig-mergegrids",
                "gosam2herwig",
                "mg2herwig",
                "slha2herwig",
                "ufo2herwig"
              ],
              "files": [
                "lib/Herwig/Herwig.so",
                "lib/Herwig/Hw*.so",
                "share/Herwig/HerwigDefaults.rpo",
                "share/Herwig/LHC.in"
              ],
              "include": [
                "Herwig/API/HerwigAPI.h"
              ],
              "lib": [
                "Herwig/libHerwigAPI"
              ]
            }
          },
          {
            "script": [
              "Herwig --version",
              "test -z \"$(herwig-config --help 2>&1 > /dev/null)\"",
              "herwig-config --help",
              "herwig-config --prefix",
              "herwig-config --datadir",
              "herwig-config --libdir",
              "herwig-config --includedir",
              "herwig-config --cppflags",
              "herwig-config --ldflags",
              "herwig-config --ldlibs",
              "lhapdf install CT14lo CT14nlo &> /dev/null",
              "Herwig read \"$(herwig-config --datadir)/LHC-Matchbox.in\"",
              "Herwig run LHC-Matchbox.run -N 100",
              "Herwig run LHC-Matchbox.run -N 100 -d 1",
              "cp \"$(herwig-config --datadir)/CMSSM40.1.1.slha\" .",
              "Herwig read \"$(herwig-config --datadir)/LHC-MSSM.in\""
            ]
          }
        ],
        "version": "7.3.0"
      }
    ],
