  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: 1.0.0\n\npackage:\n  name: perseo_perturbations\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/perseo_perturbations/perseo_perturbations-${{ version }}.tar.gz\n  sha256: a9a2488ebad7df83af8b6cc6828c1a4c7cd6893e51d9ab5e5cd128e15796d4a8\n\nbuild:\n  number: 0\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - if: unix\n      then:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ compiler('fortran') }}\n        - ${{ stdlib('c') }}\n    - if: win\n      then:\n        # On Windows, we use the MinGW-w64 toolchain instead of the default\n        # MSVC/Flang toolchain. The legacy Flang 5 compiler appears to be\n        # incompatible with the -fms-runtime-lib=dll flag passed by Meson.\n        # This configuration match the toolchain used to build the Windows wheels.\n        - ${{ compiler('m2w64_c') }}\n        - ${{ compiler('m2w64_cxx') }}\n        - ${{ compiler('m2w64_fortran') }}\n        - ${{ stdlib('m2w64_c') }}\n\n  host:\n    - python\n    - numpy >2\n    - meson-python\n    - meson >=1.1.0\n    - ninja\n    - pip\n  run:\n    - python\n    - numpy >2\n    - scipy >1.13\n    - pandas >=1.4.0\n    - xarray >=2026.4.0\n    - more-itertools\n    - netcdf4\n    - pymap3d >=3.2\n    - perseo-core >=1.0.0,<2\n\ntests:\n  - python:\n      imports:\n        - perseo_perturbations\n        - perseo_perturbations.geodynamics.solid\n      pip_check: true\n\nabout:\n  homepage: https://github.com/aresys-srl/perseo\n  documentation: https://opensource.aresys.it/perseo\n  summary: \"Python Ecosystem for Remote Sensing & Earth Observation: computing geodynamics displacements and atmospheric delays for SAR products.\"\n  license: MIT\n  license_file: LICENSE.txt\n\nextra:\n  recipe-maintainers:\n    - matteoaletti\n",
