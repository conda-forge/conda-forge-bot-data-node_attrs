        "bollwyvl"
      ]
    },
    "outputs": [
      {
        "build": {
          "python": {
            "version_independent": true
          }
        },
        "name": "aioquic",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "c_stdlib_stub"
          ],
          "host": [
            "pip",
            "python",
            "setuptools >=70.1",
            "python 3.11.*",
            "python-abi3"
          ],
          "run": [
            "certifi",
            "cryptography >=43.0.0",
            "openssl",
            "pylsqpack >=1.0.0,<2.0.0",
            "pyopenssl >=24",
            "python",
            "service-identity >=24.1.0",
            "python >=3.11",
            "python-abi3"
          ]
        },
        "tests": [
          {
            "package_contents": {
              "files": [
                "etc/conda/test-files/aioquic/**"
              ],
              "site_packages": [
                "aioquic/**",
                "aioquic-1.5.0.dist-info/**"
              ],
              "strict": true
            }
          },
          {
            "python": {
              "imports": [
                "aioquic",
                "aioquic._buffer",
                "aioquic._crypto"
              ],
              "python_version": [
                "3.11.*",
                "3.14.*"
              ]
            }
          },
          {
            "files": {
              "source": [
                "tests/**"
              ]
            },
            "requirements": {
              "run": [
                "coverage",
                "pytest",
                "abi3audit",
                "python 3.11.*"
              ]
            },
            "script": [
              "coverage run --source=aioquic --branch -m pytest -vv --tb=long --color=yes -k \"not connect_and_serve_ipv6\"",
              "coverage report --show-missing --skip-covered --fail-under=99",
              "abi3audit -s -v --assume-minimum-abi3 ${{ python_min }} \"${SP_DIR}/aioquic/_buffer.abi3.so\""
            ]
          }
        ],
        "version": "1.5.0"
      }
    ],
