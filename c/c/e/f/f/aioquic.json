    "build": {
      "number": "0",
      "python": {
        "version_independent": true
      },
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check --check-build-dependencies"
    },
    "extra": {
