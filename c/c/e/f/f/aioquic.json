  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"1.5.0\"\n  python_check_max: \"3.14\"\n\npackage:\n  name: aioquic\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/a/aioquic/aioquic-${{ version }}.tar.gz\n  sha256: f765bd3c0792110f94cd945e9cac67255d0250875efb4eb4995305d9c55336af\n\nbuild:\n  skip: is_abi3 and not is_python_min\n  number: 0\n  script:\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check --check-build-dependencies\n  python:\n    version_independent: ${{ is_abi3 }}\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n  host:\n    - pip\n    - python\n    - setuptools >=70.1\n    - if: is_abi3\n      then:\n        - python ${{ python_min }}.*\n        - python-abi3\n  run:\n    - certifi\n    - cryptography >=43.0.0\n    - openssl\n    - pylsqpack >=1.0.0,<2.0.0\n    - pyopenssl >=24\n    - python\n    - service-identity >=24.1.0\n    - if: is_abi3\n      then:\n        - python >=${{ python_min }}\n        - python-abi3\n\ntests:\n  - package_contents:\n      strict: true\n      files:\n        - etc/conda/test-files/aioquic/**\n      site_packages:\n        - aioquic/**\n        - aioquic-${{ version }}.dist-info/**\n  - python:\n      imports:\n        - aioquic\n        - aioquic._buffer\n        - aioquic._crypto\n      pip_check: true\n      python_version:\n        - if: is_abi3\n          then:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n          else:\n            - \"*\"\n  - files:\n      source:\n        - tests/**\n    requirements:\n      run:\n        - coverage\n        - pytest\n        - if: is_abi3\n          then:\n            - abi3audit\n      