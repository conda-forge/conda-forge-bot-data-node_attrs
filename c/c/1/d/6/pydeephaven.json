  "raw_meta_yaml": "context:\n  version: \"42.9\"\n\npackage:\n  name: pydeephaven\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/deephaven/deephaven-core/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 3b7ad3dccd8e4102ebda5a44115293f2f52a109bedbf23cfb88778b8461007fb\n\nbuild:\n  noarch: python\n  number: 0\n  script:\n    content:\n      - cd py/client\n      - python -m pip install . -vv\n    env:\n      # setup.py requires DEEPHAVEN_VERSION to compute the package version.\n      DEEPHAVEN_VERSION: ${{ version }}\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools >=64\n    - wheel\n    # setup.py imports packaging directly; it is not declared in pyproject.toml.\n    - packaging\n  run:\n    - python >=${{ python_min }}\n    - pyarrow\n    # pydeephaven unconditionally imports pyarrow.flight, which the pyarrow\n    # metapackage does not pull in on its own.\n    - libarrow-flight\n    - bitstring\n    # the generated proto stubs assert this minimum at import time.\n    - grpcio >=1.76.0\n    - protobuf\n    - numpy\n    - pandas\n\ntests:\n  - python:\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n      imports:\n        - pydeephaven\n        - deephaven_core\n      pip_check: true\n\nabout:\n  homepage: https://deephaven.io/\n  summary: The Deephaven Python Client\n  description: |\n    pydeephaven is the Deephaven Python Client. It is a client API that\n    allows Python applications to remotely connect to and interact with a\n    Deephaven server over gRPC: running queries, creating and manipulating\n    tables, and streaming data to and from the server.\n  license: LicenseRef-Deephaven-Community-License-1.0\n  license_file: LICENSE.md\n  documentation: https://deephaven.io/core/client-api/python/\n  repository: https://github.com/deephaven/deephaven-core\n\nextra:\n  recipe-maintainers:\n    - pb01ka\n",
