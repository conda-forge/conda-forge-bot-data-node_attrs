  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.226.2\"\n\npackage:\n  name: baml-py\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/BoundaryML/baml/archive/refs/tags/${{ version }}.zip\n    sha256: a00996108ee98ca8900af321b077aa59db2f9f5da7b2f07371bf7b6be25487b1\n\nbuild:\n  number: 0\n  # Upstream builds with pyo3's abi3-py38 feature and every wheel on PyPI is\n  # cp38-abi3, so build once at python_min and ship a single artifact per\n  # platform that works on python_min and every newer Python.\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n    # Declare the console scripts so conda generates the wrappers itself. pip\n    # bakes the build prefix interpreter path into the Windows .exe launchers,\n    # which leaves baml-cli and baml broken once the prefix moves.\n    entry_points:\n      - baml-cli = baml_py:invoke_runtime_cli\n      - baml = baml_py:invoke_runtime_cli\n\nrequirements:\n  build:\n    - ${{ compiler('rust') }}\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin\n    - cargo-bundle-licenses\n    - perl\n    - make\n  host:\n    - if: is_abi3\n      then: python-abi3\n    - python\n    - pip\n    - maturin\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - baml_py\n      pip_check: true\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/baml_py/baml_py.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%\\baml_py\\baml_py.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n  - script:\n      - baml-cli --version\n      - baml --help\n\nabout:\n  homepage: https://github.com/BoundaryML/baml\n  summary: BAML is a language that helps you get structured data from LLMs, with the best DX possible.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - moritzwilksch\n    - killua156\n",
