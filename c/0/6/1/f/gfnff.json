  "raw_meta_yaml": "{% set name = \"gfnff\" %}\n{% set version = \"0.3.0\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://github.com/pprcht/gfnff/archive/refs/tags/v{{ version }}.tar.gz\n  sha256: 8511a2b8910894e75e12abb690b6f566b80e6afdf6f3618e2494ac8d6650eb0a\n\nbuild:\n  number: 0\n  # Force the Ninja generator: conda-build defaults CMAKE_GENERATOR to\n  # \"Unix Makefiles\", which makes scikit-build-core skip Ninja detection and\n  # never set CMAKE_MAKE_PROGRAM (there is no `make` in the build image).\n  script: CMAKE_GENERATOR=Ninja {{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  skip: true  # [win]\n\nrequirements:\n  build:\n    - {{ compiler('c') }}\n    - {{ compiler('cxx') }}\n    - {{ compiler('fortran') }}\n    - {{ stdlib('c') }}\n    - cmake\n    - ninja\n    - libgomp      # [linux]\n    - llvm-openmp  # [osx]\n  host:\n    - python\n    - pip\n    - scikit-build-core >=0.9\n    - numpy\n    - libblas\n    - liblapack\n    # use conda-forge's toml-f: without it CMake would download and vendor\n    # its own copy during the build\n    - toml-f-devel\n  run:\n    - python\n    - numpy\n\ntest:\n  imports:\n    - gfnff\n  requires:\n    - pip\n  commands:\n    - pip check\n    - gfnff --help\n    # the library must have been built with TOML parameter file support\n    - python -c \"from gfnff._lib import toml_available; assert toml_available()\"\n\nabout:\n  home: https://github.com/pprcht/gfnff\n  license: LGPL-3.0-or-later\n  license_file: LICENSE\n  summary: Python bindings for the GFN-FF force-field library\n  dev_url: https://github.com/pprcht/gfnff\n\nextra:\n  recipe-maintainers:\n    - pprcht\n",
