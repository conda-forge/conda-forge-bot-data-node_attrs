  "raw_meta_yaml": "schema_version: 1\n\n# Find new releases by checking tags at: https://open-bitbucket.nrao.edu/projects/CASA/repos/casa6/browse\ncontext:\n  version: \"6.8.0.3\"\n  build: 1\n  mpi: openmpi  # force this ... for now?\n  mpi_prefix: ${{ \"mpi_\" + mpi }}\n\npackage:\n  name: casacpp\n  version: ${{ version }}\n\nsource:\n  url: https://open-bitbucket.nrao.edu/rest/api/latest/projects/CASA/repos/casa6/archive?at=refs%2Ftags%2F${{ version }}&format=tgz\n  sha256: 166f9a797c641dda9ab8322b486f2d02cb4cde4c83228efa49b0b4a1fae58c7b\n  file_name: casa-${{ version }}.tar.gz\n  # Note: there are patches, but because rattler-build refuses to detect the\n  # source file as a tarball, we must apply them manually.\n\nbuild:\n  number: ${{ build }}\n  string: ${{ mpi_prefix }}_h${{ hash }}_${{ build }}\n  skip: win\n\nrequirements:\n  build:\n    - cmake <4\n    - bison\n    - if: linux\n      then: libgomp\n    - if: osx\n      then: llvm-openmp\n    - ninja\n    - libprotobuf\n    - libgrpc\n    - patch\n    - pkgconf\n    - tar\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"cxx\") }}\n    - ${{ compiler(\"fortran\") }}\n  host:\n    - ${{ mpi }}\n    - if: linux\n      then: libgomp\n    - if: osx\n      then: llvm-openmp\n    - casacore >=3.8,<3.8.2 ${{ mpi_prefix }}_*  # 3.8.2 breaks API/ABI, not currently supported by CASA6\n    - fftw\n    - gsl\n    - libboost-devel\n    - libgrpc\n    - libprotobuf\n    - libsakura\n    - libxml2-devel\n    - libxslt\n    - sqlite\n  run:\n    - ${{ mpi }}\n    - casacore >=3.8,<3.8.2 ${{ mpi_prefix }}_*  # our pin must be stricter than the casacore run_export\n    - libabseil\n    - libopenblas\n    - if: osx\n      then: libgcc\n  run_exports:\n    - ${{ pin_subpackage(\"casacpp\", lower_bound=\"x.x.x\", upper_bound=\"x.x.x\", build=mpi_prefix+\"_*\") }}\n\ntests:\n  - script: run_test.sh\n\nabout:\n  license: LGPL-2.1-or-later\n  license_file: LICENSE.txt\n  summary: C++ libraries underlying CASA, the radio astronomical data processing package\n  homepage: https://casa.nrao.edu/\n\nextra:\n  recipe-maintainers:\n    - pkgw\n",
