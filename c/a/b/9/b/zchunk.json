  "raw_meta_yaml": "context:\n  version: \"1.3.2\"\n\nrecipe:\n  name: zchunk-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/zchunk/zchunk/archive/${{ version }}.tar.gz\n  sha256: 4d923d32af7db33f3c0a6655b258e857a2ca564912cf85ddce14e9b1b7d495bf\n  patches:\n    - zstd_arg.patch\n\nbuild:\n  number: 1\n\noutputs:\n  - package:\n      name: zchunk\n    build:\n      script: build_zchunk\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - meson\n        - pkgconf\n        - ninja\n      host:\n        - libcurl\n        # libcurl.pc requires zlib.pc\n        - zlib\n        - zstd\n        - openssl\n        - if: osx or win\n          then: argp-standalone\n      ignore_run_exports:\n        by_name:\n          # only needed for libcurl.pc resolution\n          - libzlib\n      run:\n        - libcurl\n        - zstd\n        - openssl\n        - if: win\n          then: ucrt\n      run_exports:\n        - ${{ pin_subpackage('zchunk', upper_bound='x.x') }}\n    tests:\n      - package_contents:\n          include:\n            - zck.h\n          bin:\n            - zck\n            - zckdl\n          files:\n            exists:\n              - if: unix\n                then:\n                  - lib/pkgconfig/zck.pc\n                else:\n                  - Library/lib/pkgconfig/zck.pc\n                  - Library/bin/zck-1.dll\n                  - Library/lib/zck.lib\n              - if: linux\n                then: lib/libzck.so\n              - if: osx\n                then: lib/libzck.dylib\n            # make sure the bundled argp subproject is not installed\n            not_exists:\n              - if: unix\n                then: include/argp.h\n                else: Library/include/argp.h\n      - script:\n          - zck --help\n\n  - package:\n      name: zchunk-static\n    build:\n      script: build_zchunk\n      files:\n        - if: unix\n          then: lib/libzck.a\n          else: Library/lib/libzck.lib\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - meson\n        - pkgconf\n        - ninja\n      host:\n        - ${{ pin_subpackage('zchunk', exact=True) }}\n        - libcurl\n        # libcurl.pc requires zlib.pc\n        - zlib\n        - zstd\n        - openssl\n        - if: osx or win\n          then: argp-standalone\n      run:\n        - ${{ pin_subpackage('zchunk', exact=True) }}\n    tests:\n      - package_contents:\n          files:\n            - if: unix\n              then: lib/libzck.a\n              else: Library/lib/libzck.lib\n\nabout:\n  homepage: https://github.com/zchunk/zchunk\n  license: BSD-2-Clause\n  license_file: LICENSE\n  summary: A file format designed for highly efficient deltas while maintaining good compression\n  description: |\n    zchunk is a compressed file format that splits the file into independent\n    chunks. This allows you to only download changed chunks when downloading a\n    new version of the file, and also makes zchunk files efficient over rsync.\n\n    zchunk files are protected with strong checksums to verify that the file\n    you downloaded is, in fact, the file you wanted.\n\nextra:\n  feedstock-name: zchunk\n  recipe-maintainers:\n    - wolfv\n    - JohanMabille\n    - SylvainCorlay\n    - davidbrochart\n",
