  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.6.0\"\n  grep: ${{ 'grep -iE ' if unix else 'findstr /r /c:' }}\n\npackage:\n  name: vale-ls\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/errata-ai/vale-ls/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 0645f643ba6d1c5b5d641a100a0d7135661fada60a630f38032812959806f4e5\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      # ensure rust `zstd-sys` links against conda-forge `zstd`\n      ZSTD_SYS_USE_PKG_CONFIG: \"1\"\n    content:\n      - cargo auditable install -v --no-track --locked --root=\"${{ PREFIX }}\" --profile=release --path=.\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n      - if: win\n        then:\n          - md \"%SCRIPTS%\" || echo \"%SCRIPTS% already exists\"\n          - move \"%PREFIX%\\bin\\vale-ls.exe\" \"%SCRIPTS%\"\n\nrequirements:\n  build:\n    - ${{ compiler(\"rust\") }}\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - make\n    - pkg-config\n  host:\n    - zstd\n  run:\n    - vale >=3.0.0\n\ntests:\n  - package_contents:\n      strict: true\n      bin:\n        - vale-ls\n  - script:\n      - vale-ls --version\n      - vale-ls --help\n      - vale-ls --version | ${{ grep }}${{ version | replace(\".\", \"\\.\") }}\n\nabout:\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  summary: An implementation of the Language Server Protocol (LSP) for the Vale command-line tool.\n  homepage: https://vale.sh\n  repository: https://github.com/vale-cli/vale-ls\n  documentation: https://vale.sh/docs/guides/lsp\n\nextra:\n  recipe-maintainers:\n    - bollwyvl\n",
