  "raw_meta_yaml": "{% set name = \"menpofit\" %}\n{% set version = \"0.8.0\" %}\n# conda-forge builds Python 3.11-3.14, and menpo (>=0.12) needs 3.11; the noarch test\n# environment is solved at python_min\n{% set python_min = \"3.11\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/{{ name[0] }}/{{ name }}/{{ name }}-{{ version }}.tar.gz\n  sha256: 45e36bb0f24d0b684ebc91395a48da8452f9135b0bcb515de099fbef727ee55a\n\nbuild:\n  number: 0\n  noarch: python\n  script: {{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python {{ python_min }}.*\n    - pip\n    - setuptools >=77\n    - setuptools-scm >=8\n  run:\n    - python >={{ python_min }}\n    - menpo >=0.12\n    - numpy >=1.23\n    - scipy >=1.6\n    - pandas >=1.5\n    - dlib\n\ntest:\n  imports:\n    - menpofit\n    - menpofit.aam\n    - menpofit.aps\n    - menpofit.atm\n    - menpofit.clm\n    - menpofit.dlib\n    - menpofit.error\n    - menpofit.lk\n    - menpofit.math\n    - menpofit.sdm\n    - menpofit.transform\n    - menpofit.visualize\n  requires:\n    - python {{ python_min }}.*\n    - pip\n  commands:\n    - pip check\n\nabout:\n  home: https://github.com/menpo/menpofit\n  dev_url: https://github.com/menpo/menpofit\n  doc_url: https://menpofit.readthedocs.io/en/stable/\n  license: BSD-3-Clause\n  license_family: BSD\n  license_file: LICENSE.txt\n  summary: A Menpo deformable modelling toolkit\n  description: |\n    The Menpo Project package for state-of-the-art 2D deformable modelling\n    techniques including AAMs, SDMs, CLMs\n\nextra:\n  recipe-maintainers:\n    - patricksnape\n",
