    "about": {
      "description": "FLITS (Fast-Look Interactive Transient Suite) measures fast radio bursts\nin dynamic spectra: SIGPROC filterbank, PSRFITS search and fold data, and\nCHIME/FRB HDF5. It masks interference, localizes the burst, optimizes the\nDM, and measures S/N, flux, fluence, widths, arrival times, drift rate and\nrotation measure, with each uncertainty classified. It offers a browser\ninterface, a command line (`flits measure`) and a Python API, and saves\nanalyses as replayable session snapshots.",
      "dev_url": "https://github.com/DirkKuiper/flits",
      "doc_url": "https://dirkkuiper.github.io/flits/",
      "home": "https://dirkkuiper.github.io/flits/",
      "license": "GPL-3.0-only AND MIT",
      "license_family": "GPL-3.0-only AND MIT",
      "license_file": "LICENSE",
      "summary": "Interactive and scriptable fast radio burst (FRB) analysis"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "flits = flits.cli:main"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "DirkKuiper"
      ]
    },
