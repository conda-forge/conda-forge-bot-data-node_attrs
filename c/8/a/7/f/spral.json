  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2025.09.18\"\n\npackage:\n  name: libspral\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ralna/spral/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 1358168ac95297049e4fc810e54a16e0c765796cfbaa156e09979e2620b7dae7\n  patches:\n    # ldlt_torture_test backward error slightly exceeds 1e-13 on aarch64 and ppc64le\n    - loosen-ldlt-torture-tolerance.patch\n\nbuild:\n  skip: not linux\n  number: 4\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('fortran') }}\n    - pkgconf\n    - meson\n    - ninja\n  host:\n    # See https://conda-forge.org/docs/maintainer/knowledge_base/#openmp\n    - if: linux\n      then: libgomp\n      else: llvm-openmp\n    - blas-devel\n    - libblas\n    - libcblas\n    - liblapack\n    - libhwloc\n    - zlib\n    - metis\n  run_exports:\n    - ${{ pin_subpackage('libspral', upper_bound='x.x.x') }}\n\ntests:\n  - script:\n      - test -f ${PREFIX}/include/spral.h\n      - test -f ${PREFIX}/lib/libspral${SHLIB_EXT}\n\nabout:\n  homepage: https://github.com/ralna/spral\n  license: BSD-3-Clause\n  license_file: LICENCE\n  summary: Sparse Parallel Robust Algorithms Library.\n\nextra:\n  feedstock-name: spral\n  recipe-maintainers:\n    - traversaro\n",
