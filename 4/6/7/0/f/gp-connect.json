  "linux_64_meta_yaml": {
    "about": {
      "description": "A GlobalProtect VPN client built on OpenConnect with support for SSO authentication. It provides command-line tools and the GP Connect desktop application for macOS, Linux, FreeBSD, and OpenBSD.",
      "dev_url": "https://github.com/yuezk/GlobalProtect-openconnect",
      "home": "https://github.com/yuezk/GlobalProtect-openconnect",
      "license": "GPL-3.0-or-later",
      "license_family": "GPL-3.0-or-later",
      "license_file": "LICENSE",
      "summary": "A GlobalProtect VPN client for Linux and macOS, written in Rust, based on OpenConnect and Tauri, supports SSO with MFA, YubiKey, and client certificate authentication, etc."
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml",
          "export CARGO_BUILD_RUSTFLAGS=\"${CARGO_BUILD_RUSTFLAGS} -C link-arg=-liconv\"",
          "make build BUILD_GUI_HELPER=0 BUILD_WEBVIEW_AUTH=0",
          "make install BUILD_GUI_HELPER=0 BUILD_WEBVIEW_AUTH=0 PREFIX=\"${PREFIX}\""
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "XhstormR"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "gp-connect",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-bundle-licenses",
            "cargo-auditable",
            "make",
            "pkg-config",
            "autoconf",
            "automake",
            "libtool"
          ],
          "host": [
            "libxml2-devel",
            "zlib",
            "openssl",
            "gnutls",
            "p11-kit",
            "nettle",
            "gmp",
            "libiconv",
