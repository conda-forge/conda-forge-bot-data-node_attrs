  "raw_meta_yaml": "context:\n  version: \"3.1.0\"\n\npackage:\n  name: gp-connect\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/yuezk/GlobalProtect-openconnect/releases/download/v${{ version }}/globalprotect-openconnect-${{ version }}.tar.gz\n  sha256: 772cc7479054a29da43ec0beaf68ca2b0b3670e8f71cb75194d9e0eea67de72c\n\nbuild:\n  number: 0\n  skip: win\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n      # openconnect resolves iconv to GNU libiconv from $PREFIX, but build.rs only links it on macOS/BSD\n      - if: linux\n        then: export CARGO_BUILD_RUSTFLAGS=\"${CARGO_BUILD_RUSTFLAGS} -C link-arg=-liconv\"\n      - make build BUILD_GUI_HELPER=0 BUILD_WEBVIEW_AUTH=0\n      - make install BUILD_GUI_HELPER=0 BUILD_WEBVIEW_AUTH=0 PREFIX=\"${PREFIX}\"\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - make\n    - pkg-config\n    - autoconf\n    - automake\n    - libtool\n  host:\n    - libxml2-devel\n    - zlib\n    - openssl\n    - gnutls\n    - p11-kit\n    - nettle\n    - gmp\n    - if: linux\n      then:\n        - libiconv\n        - lz4-c\n\ntests:\n  - script:\n      - gpclient --version\n      - gpclient --help\n      - gpauth --version\n      - gpauth --help\n\nabout:\n  homepage: https://github.com/yuezk/GlobalProtect-openconnect\n  summary: \"A GlobalProtect VPN client for Linux and macOS, written in Rust, based on OpenConnect and Tauri, supports SSO with MFA, YubiKey, and client certificate authentication, etc.\"\n  description: |\n    A GlobalProtect VPN client built on OpenConnect with support for SSO authentication. It provides command-line tools and the GP Connect desktop application for macOS, Linux, FreeBSD, and OpenBSD.\n  license: GPL-3.0-or-later\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  repository: https://github.com/yuezk/GlobalProtect-openconnect\n\nextra:\n  recipe-maintainers:\n    - XhstormR\n",
