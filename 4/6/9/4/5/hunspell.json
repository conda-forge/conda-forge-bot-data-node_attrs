  "linux_64_meta_yaml": {
    "about": {
      "description": "Hunspell is the spell checker of LibreOffice, OpenOffice.org, Mozilla Firefox 3 & Thunderbird,\nGoogle Chrome, and it is also used by proprietary software packages, like macOS, InDesign,\nmemoQ, Opera and SDL Trados.",
      "dev_url": "https://github.com/hunspell/hunspell",
      "home": "http://hunspell.github.io/",
      "license": "MPL-1.1 OR GPL-2.0-or-later OR LGPL-2.1-or-later",
      "license_family": "MPL-1.1 OR GPL-2.0-or-later OR LGPL-2.1-or-later",
      "license_file": "COPYING",
      "summary": "The most popular spellchecking library."
    },
    "build": {
      "number": "0",
      "script": [
        "autoreconf -vfi",
        "./configure \"--prefix=${{ PREFIX }}\" --with-readline --with-ui",
        "make \"-j${CPU_COUNT}\"",
        "make check || (cat tests/test-suite.log && exit 1)",
        "make install",
        "mkdir -p \"${{ PREFIX }}/${{ dict_path }}\"",
        "echo \"\" >> \"${{ PREFIX }}/${{ dict_path }}/.empty\"",
        "ln -s \"${{ PREFIX }}/${{ dict_path }}\" \"${{ PREFIX }}/${{ legacy_path }}\"",
        "ls \"${{ PREFIX }}/${{ legacy_path }}/.empty\""
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "scopatz",
        "asmeurer",
        "bollwyvl"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "hunspell",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "cxx_compiler_stub",
            "c_stdlib_stub",
            "autoconf",
            "automake",
            "gettext",
            "libtool",
            "make",
            "pkg-config"
          ],
          "host": [
            "libiconv",
            "ncurses",
            "readline"
          ],
          "run": []
        },
        "tests": [
          {
            "package_contents": {
              "bin": [
                "{affixcompress,analyze,chmorph,hunspell,hunzip,hzip,ispellaff2myspell,makealias,munch,unmunch,wordforms,wordlist2hunspell}"
              ]
            }
          },
          {
            "script": {
              "content": [
                "cd \"${CONDA_PREFIX}/${{ dict_path }}\"",
                "echo \"ok\" > test.words",
                "wordlist2hunspell test.words \"${{ test_lang }}\"",
                "rm test.words",
                "cd \"${SRC_DIR}\"",
                "${{ bin_with_help | split | join(' --help || exit 1; ') }} --help || exit 1;",
                "hunspell --version",
                "hunspell --version | grep -iEo \"\\(but really Hunspell ${{ version | replace(\".\", \"\\\\.\") }}\\)\"",
                "${{ hunspell_d }}",
                "${{ hunspell_d }} 2>&1 | grep -iEo \"^\\.::${CONDA_PREFIX}/${{ dict_path }}:\"",
                "${{ hunspell_d }} 2>&1 | grep -iEo \"${CONDA_PREFIX}/${{ dict_path }}/${{ test_lang }}.dic\"",
                "${{ hunspell_d }} 2>&1 | grep -iEo \"${CONDA_PREFIX}/${{ dict_path }}/${{ test_lang }}.aff\"",
                "ls \"${CONDA_PREFIX}/${{ legacy_path }}/${{ test_lang }}.dic\""
              ]
            }
          }
        ],
        "version": "1.7.3"
      }
    ],
