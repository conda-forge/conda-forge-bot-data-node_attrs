  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"1.7.3\"\n  build_number: 0\n  # well-known upstream path\n  dict_path: share/hunspell\n  # legacy path for hunspell <1.7.3\n  legacy_path: share/hunspell_dictionaries\n  # smoke-testable binaries and scripts that return 0 for --help\n  bin_with_help: hunspell hunzip makealias\n  # binaries/scripts with no --help option, or that don't exit 0\n  bin_no_help: affixcompress analyze chmorph hzip ispellaff2myspell munch unmunch wordforms wordlist2hunspell\n  all_bin: ${{ bin_with_help }} ${{ bin_no_help }}\n  # explicit test language to avoid locale detection for en_US (or whatever)\n  test_lang: en_CF\n  hunspell_d: hunspell -D -d ${{ test_lang }}\n\npackage:\n  name: hunspell\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/hunspell/hunspell/archive/v${{ version }}.tar.gz\n  sha256: 933be3dac6fd55f6e752331a170efb7e33800e40fae1156d8434cc8c85379a1b\n\nbuild:\n  number: ${{ build_number }}\n  skip: win\n  script:\n    # delete, and skip discovery of, broken osx tests\n    - if: osx\n      then:\n        - cd tests\n        # some libtool issue\n        - rm gh646.*\n        - grep -v 'gh646' Makefile.am > Makefile.am-osx\n        - mv Makefile.am-osx Makefile.am\n        - cat Makefile.am\n        - cd ..\n    - autoreconf -vfi\n    - ./configure \"--prefix=${{ PREFIX }}\" --with-readline --with-ui\n    - make \"-j${CPU_COUNT}\"\n    - if: host_platform == target_platform\n      then:\n        - make check || (cat tests/test-suite.log && exit 1)\n    - make install\n    - mkdir -p \"${{ PREFIX }}/${{ dict_path }}\"\n    # rattler-build doesn't ship empty directories: https://github.com/prefix-dev/rattler-build/issues/371\n    - echo \"\" >> \"${{ PREFIX }}/${{ dict_path }}/.empty\"\n    # legacy path symlink\n    - ln -s \"${{ PREFIX }}/${{ dict_path }}\" \"${{ PREFIX }}/${{ legacy_path }}\"\n    - ls \"${{ PREFIX }}/${{ legacy_path }}/.empty\"\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ compiler(\"cxx\") }}\n    - ${{ stdlib(\"c\") }}\n    - autoconf\n    - automake\n    - gettext\n    - libtool\n    - make\n    - pkg-config\n  host:\n    - libiconv\n    - ncurses\n    - readline\n\ntests:\n  - package_contents:\n      bin:\n        - ${{ \"{\" ~ (all_bin | split | sort | join(',')) ~ \"}\" }}\n  - script:\n      content:\n        # build a test dictionary\n        - cd \"${CONDA_PREFIX}/${{ dict_path }}\"\n        - echo \"ok\" > test.words\n        - wordlist2hunspell test.words \"${{ test_lang }}\"\n        - rm test.words\n        - cd \"${SRC_DIR}\"\n        # check basic commands that exit with 0\n        - ${{ bin_with_help | split | join(' --help || exit 1; ') }} --help || exit 1;\n        # check versions\n        - hunspell --version\n        - hunspell --version | grep -iEo \"\\(but really Hunspell ${{ version | replace(\".\", \"\\\\.\") }}\\)\"\n        # check discovery\n        - ${{ hunspell_d }}\n        - ${{ hunspell_d }} 2>&1 | grep -iEo \"^\\.::${CONDA_PREFIX}/${{ dict_path }}:\"\n        - ${{ hunspell_d }} 2>&1 | grep -iEo \"${CONDA_PREFIX}/${{ dict_path }}/${{ test_lang }}.dic\"\n        - ${{ hunspell_d }} 2>&1 | grep -iEo \"${CONDA_PREFIX}/${{ dict_path }}/${{ test_lang }}.aff\"\n        # check symlink\n        - ls \"${CONDA_PREFIX}/${{ legacy_path }}/${{ test_lang }}.dic\"\n\nabout:\n  license: MPL-1.1 OR GPL-2.0-or-later OR LGPL-2.1-or-later\n  license_file:\n    - COPYING\n    - COPYING.LESSER\n    - COPYING.MPL\n  summary: The most popular spellchecking library.\n  description: |\n    Hunspell is the spell checker of LibreOffice, OpenOffice.org, Mozilla Firefox 3 & Thunderbird,\n    Google Chrome, and it is also used by proprietary software packages, like macOS, InDesign,\n    memoQ, Opera and SDL Trados.\n  homepage: http://hunspell.github.io\n  repository: https://github.com/hunspell/hunspell\n\nextra:\n  recipe-maintainers:\n    - scopatz\n    - asmeurer\n    - bollwyvl\n",
