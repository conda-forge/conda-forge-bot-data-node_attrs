    "about": {
      "description": "pykmclib repackages KMCLib, the general framework for lattice kinetic Monte\nCarlo simulations, as a modern Python distribution built with\nscikit-build-core and pybind11. The computationally heavy backend is the\noriginal KMCLib C++ code; the Python API follows upstream KMCLib.",
      "dev_url": "https://github.com/LiuGaoyong/pykmclib",
      "doc_url": "https://github.com/LiuGaoyong/pykmclib",
      "home": "https://github.com/LiuGaoyong/pykmclib",
      "license": "GPL-3.0-or-later",
      "license_family": "GPL-3.0-or-later",
      "license_file": "LICENSE",
      "summary": "Lattice kinetic Monte Carlo simulations (Python front end, C++ backend)"
    },
    "build": {
      "number": "0",
      "script": [
        "export CMAKE_GENERATOR=Ninja",
        "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "LiuGaoyong"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "pykmclib",
        "requirements": {
          "build": [
            "c_compiler_stub",
