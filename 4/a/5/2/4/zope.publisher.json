  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"8.1\"\n  test_modules:\n    - zope.publisher.tests.test_baserequest\n    - zope.publisher.tests.test_baseresponse\n    - zope.publisher.tests.test_browserlanguages\n    - zope.publisher.tests.test_browserrequest\n    - zope.publisher.tests.test_browserresponse\n    - zope.publisher.tests.test_ftp\n    - zope.publisher.tests.test_http\n    - zope.publisher.tests.test_httpcharsets\n    - zope.publisher.tests.test_ipublication\n    - zope.publisher.tests.test_mapply\n    - zope.publisher.tests.test_principallogging\n    - zope.publisher.tests.test_publisher\n    - zope.publisher.tests.test_requestdataproperty\n    - zope.publisher.tests.test_testing\n    - zope.publisher.tests.test_xmlrpc\n    - zope.publisher.tests.test_xmlrpcrequest\n    - zope.publisher.tests.test_zcml\n\npackage:\n  name: zope.publisher\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/z/zope.publisher/zope_publisher-${{ version }}.tar.gz\n  sha256: 87a354a029afa3f8fcde802e6323ed9e53b6b96b6e17e94323e945a19194d192\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n  run:\n    - python >=${{ python_min }}\n    - multipart >=1.1.0\n    - zope.browser\n    - zope.component\n    - zope.configuration\n    - zope.contenttype >=4.0.0\n    - zope.event\n    - zope.exceptions\n    - zope.i18n >=4.0.0\n    - zope.interface >=4.0.1\n    - zope.location\n    - zope.proxy\n    - zope.security >=4.0.0\n\ntests:\n  - python:\n      imports:\n        - zope.publisher\n        - zope.publisher.browser\n        - zope.publisher.http\n        - zope.publisher.publish\n        - zope.publisher.xmlrpc\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      # dotted names: discover puts zope/publisher on sys.path, so its http.py\n      # and xmlrpc.py shadow the stdlib modules\n      - python -m unittest -v ${{ test_modules | join(\" \") }}\n    requirements:\n      run:\n        - zope.testing\n\nabout:\n  homepage: https://github.com/zopefoundation/zope.publisher\n  repository: https://github.com/zopefoundation/zope.publisher\n  documentation: https://zopepublisher.readthedocs.io\n  summary: The Zope publisher publishes Python objects on the web\n  license: ZPL-2.1\n  license_file:\n    - LICENSE.txt\n    - COPYRIGHT.txt\n\nextra:\n  recipe-maintainers:\n    - killua156\n",
