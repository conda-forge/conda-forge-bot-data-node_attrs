  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: ocplib-endian\n  version: \"1.2\"\n\n  library: ${{ \"Library/\" if not unix else \"\" }}\n  m2: ${{ \"m2-\" if not unix else \"\" }}\n  c_toolchain: ${{ \"\" if unix else \"gcc_*\" }}\n\npackage:\n  name: ocaml-${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/OCamlPro/ocplib-endian/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 97ae74e8aeead46a0475df14af637ce78e2372c07258619ad8967506f2d4b320\n  patches:\n    - patches/0001-drop-bytes-compat-library.patch\n\nbuild:\n  number: 0\n  script: bash ${{ RECIPE_DIR }}/build.sh ocplib-endian\n\nrequirements:\n  build:\n    - if: unix\n      then:\n        - ${{ compiler(\"c\") }}\n        - ${{ stdlib(\"c\") }}\n      else:\n        - ${{ compiler(\"m2w64_c\") }}\n        - ${{ stdlib(\"m2w64_c\") }}\n    # non-unix: conda-forge ocaml has gcc_ and vs2022_ tracks; these recipes use the gcc (MinGW) track only.\n    - ocaml ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n    - ocaml-dune 3.24.*\n    - ocaml-cppo >=1.1\n    - ${{ m2 }}make\n    - if: not unix\n      then:\n        - m2-bash\n  host:\n    - ocaml ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n  run:\n    - ocaml ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n\ntests:\n  - package_contents:\n      files:\n        - ${{ library }}lib/ocaml/${{ name }}/META\n        - ${{ library }}lib/ocaml/${{ name }}/bigstring/ocplib_endian_bigstring.cmxa\n  - script: bash testing/test_ocaml_lib.sh\n    files:\n      recipe:\n        - testing/test_ocaml_lib.sh\n    requirements:\n      run:\n        - ocaml ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n        - if: not unix\n          then:\n            - m2-bash\n\nabout:\n  homepage: https://github.com/OCamlPro/ocplib-endian\n  repository: https://github.com/OCamlPro/ocplib-endian\n  license: LGPL-2.1-only WITH OCaml-LGPL-linking-exception\n  license_file: COPYING.txt\n  summary: Optimised functions to read and write int16/32/64 from strings and bigarrays\n\nextra:\n  recipe-maintainers:\n    - MementoRC\n    - ManuelLerchner\n",
