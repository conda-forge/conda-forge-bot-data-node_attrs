  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: ocplib-endian\n  version: \"1.2\"\n  build_number: 2\n\n  # ocaml_win-64 ships gcc_* and vs2022_* at the same version/build; name the track.\n  c_toolchain: ${{ \"\" if unix else c_compiler ~ \"_*\" }}\n  library: ${{ \"Library/\" if not unix else \"\" }}\n  m2: ${{ \"m2-\" if not unix else \"\" }}\n  # static archive paired with the .cmxa: msvc ships .lib, gcc and unix ship .a\n  native_lib_ext: ${{ \".lib\" if c_compiler == \"vs2022\" else \".a\" }}\n\npackage:\n  name: ocaml-${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/OCamlPro/ocplib-endian/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 97ae74e8aeead46a0475df14af637ce78e2372c07258619ad8967506f2d4b320\n  patches:\n    - patches/0001-drop-bytes-compat-library.patch\n\nbuild:\n  number: ${{ build_number }}\n  string: ${{ c_compiler ~ \"_\" if not unix }}h${{ hash }}_${{ build_number }}\n  script: bash ${{ RECIPE_DIR }}/build.sh ocplib-endian\n\nrequirements:\n  build:\n    - ${{ compiler(\"ocaml\") }}\n    - if: not unix and c_compiler == \"gcc\"\n      then:\n        - ${{ stdlib(\"m2w64_c\") }}\n      else:\n        - ${{ stdlib(\"c\") }}\n    # ocaml_win-64 >=14 only run-constrains the C compiler; activate it here, once (vs2022, zig)\n    - if: not unix and c_compiler != \"gcc\"\n      then:\n        - ${{ compiler(\"c\") }}\n    # compiler(\"ocaml\") renders no toolchain track; name it on windows\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n    # the cross compiler does not pull the native one; the build runs OCaml on the build machine\n    - if: build_platform != target_platform and unix\n      then:\n        - ocaml_${{ build_platform }} ${{ ocaml_compiler_version }}.*\n        # the cross compiler activates itself (shims, OCAMLLIB, host OCAMLPATH)\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.*\n    # windows cross: the self-contained gcc track needs no vcvars\n    - if: build_platform != target_platform and not unix\n      then:\n        - ocaml_${{ build_platform }} ${{ ocaml_compiler_version }}.* gcc_*\n    - ocaml-dune >=3.4\n    - ocaml-cppo >=1.1\n    - ${{ m2 }}make\n    - if: not unix\n      then:\n        - m2-bash\n        - m2-coreutils\n  host:\n    # library: ocaml's run_export pins the compiler patch version\n    - ocaml ${{ ocaml_compiler_version }}.*\n    # the noarch ocaml metapackage does not pin the windows toolchain track\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n  # the ocaml run_export does not encode the windows toolchain track\n  run_constraints:\n    - if: not unix\n      then:\n        - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n\ntests:\n  - package_contents:\n      files:\n        - ${{ library }}lib/ocaml/${{ name }}/META\n        - ${{ library }}share/doc/ocplib-endian/COPYING.txt\n        # win-arm64 is bytecode-only upstream: OCaml 5.4 has no arm64 Windows backend\n        - if: target_platform != \"win-arm64\"\n          then:\n            - ${{ library }}lib/ocaml/${{ name }}/ocplib_endian.cmxa\n            - ${{ library }}lib/ocaml/${{ name }}/ocplib_endian${{ native_lib_ext }}\n            - ${{ library }}lib/ocaml/${{ name }}/bigstring/ocplib_endian_bigstring.cmxa\n  # the script links native executables, so it cannot run on the bytecode-only lane\n  - if: target_platform != \"win-arm64\"\n    then:\n      script: bash testing/test_ocaml_lib.sh\n      files:\n        recipe:\n          - testing/test_ocaml_lib.sh\n      requirements:\n        run:\n          - ocaml ${{ ocaml_compiler_version }}.*\n          - if: not unix\n            then:\n              - ocaml_${{ target_platform }} ${{ ocaml_compiler_version }}.* ${{ c_toolchain }}\n          - if: not unix and c_compiler != \"gcc\"\n            then:\n              - ${{ compiler(\"c\") }}\n          - if: not unix\n            then:\n              - m2-bash\n              - m2-coreutils\n\nabout:\n  homepage: https://github.com/OCamlPro/ocplib-endian\n  repository: https://github.com/OCamlPro/ocplib-endian\n  license: LGPL-2.1-only WITH OCaml-LGPL-linking-exception\n  license_file: COPYING.txt\n  summary: Optimised functions to read and write int16/32/64 from strings and bigarrays\n\nextra:\n  recipe-maintainers:\n    - MementoRC\n    - ManuelLerchner\n",
