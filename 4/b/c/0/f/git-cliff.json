  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.14.2\"\n\npackage:\n  name: git-cliff\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/orhun/git-cliff/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: fbbb1f8ade8e9affeaacd632bedc94ac898fb726516f2f5a86d1bfba947635f4\n\nbuild:\n  number: 1\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n      LIBGIT2_NO_VENDOR: \"1\"\n    content:\n      - if: unix\n        then:\n          - export PKG_CONFIG=\"$BUILD_PREFIX/bin/pkg-config\"\n          - if: build_platform != target_platform\n            then:\n              # cc-rs also applies the generic CFLAGS to host (build script) compilations,\n              # which breaks with target-only flags like `-mabi=lp64d` on riscv64.\n              # Restrict them to the target triple instead.\n              - export CFLAGS_${CARGO_BUILD_TARGET//-/_}=\"$CFLAGS\"\n              - export CXXFLAGS_${CARGO_BUILD_TARGET//-/_}=\"$CXXFLAGS\"\n              - unset CFLAGS CXXFLAGS\n          - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path git-cliff\n        else:\n          # NOTE: somehow the linker is looking for ssh2.lib and not libssh2.lib.\n          # Using RUSTFLAGS with `-l libssh2` does not work so the only solution found\n          # so far is to copy libssh2.lib to ssh2.lib.\n          # See:\n          # - https://github.com/conda-forge/git-cliff-feedstock/pull/23#issuecomment-2695470356\n          # - https://github.com/conda-forge/git-cliff-feedstock/pull/26\n          # - https://github.com/conda-forge/libssh2-feedstock/issues/55\n          - copy %LIBRARY_LIB%\\libssh2.lib %LIBRARY_LIB%\\ssh2.lib || exit 1\n          - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path git-cliff || exit 1\n          - del %LIBRARY_LIB%\\ssh2.lib || exit 1\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ compiler('rust') }}\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - pkg-config\n    - cargo-bundle-licenses\n    - cargo-auditable\n  host:\n    - libgit2\n    - libssh2\n    # to build against libgit2 we also need the pkgconfig files for zlib\n    - zlib\n\ntests:\n  - script:\n      - git-cliff --help\n      - git-cliff --version\n  - package_contents:\n      bin:\n        - git-cliff\n        - git-cliff-completions\n        - git-cliff-mangen\n      strict: true\n\nabout:\n  summary: A highly customizable changelog generator\n  description: A highly customizable Changelog Generator that follows Conventional Commit specifications ⛰️\n  license: MIT OR Apache-2.0\n  license_file:\n    - LICENSE-MIT\n    - LICENSE-APACHE\n    - THIRDPARTY.yml\n  homepage: https://git-cliff.org\n  repository: https://github.com/orhun/git-cliff\n  documentation: https://git-cliff.org/docs/\n\nextra:\n  recipe-maintainers:\n    - orhun\n    - pavelzw\n",
