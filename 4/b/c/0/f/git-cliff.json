    "about": {
      "description": "A highly customizable Changelog Generator that follows Conventional Commit specifications ⛰️",
      "dev_url": "https://github.com/orhun/git-cliff",
      "doc_url": "https://git-cliff.org/docs/",
      "home": "https://git-cliff.org/",
      "license": "MIT OR Apache-2.0",
      "license_family": "MIT OR Apache-2.0",
      "license_file": "LICENSE-MIT",
      "summary": "A highly customizable changelog generator"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "copy %LIBRARY_LIB%\\libssh2.lib %LIBRARY_LIB%\\ssh2.lib || exit 1",
          "cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path git-cliff || exit 1",
          "del %LIBRARY_LIB%\\ssh2.lib || exit 1",
          "cargo-bundle-licenses --format yaml --output THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols",
          "LIBGIT2_NO_VENDOR": "1"
        }
      }
    },
