  "raw_meta_yaml": "context:\n  version: \"5.6.0\"\n  # Data Dictionary version used to generate the IDS types and routines\n  dd_version: \"4.1.1\"\n\npackage:\n  name: imas-fortran\n  version: ${{ version }}\n\nsource:\n  # Fortran High Level Interface of the IMAS Access Layer\n  - url: https://github.com/iterorganization/IMAS-Fortran/archive/refs/tags/${{ version }}.tar.gz\n    sha256: 9c7c7cb70add077c425f06609488be79f6a50418c58d086f4d516b4ada55596b\n  # IMAS Data Dictionary sources: IDSDef.xml is generated from these at build\n  # time (see build.sh) and defines the IDS types of the interface\n  - url: https://github.com/iterorganization/IMAS-Data-Dictionary/archive/refs/tags/${{ dd_version }}.tar.gz\n    sha256: a8aa78bacbd83801be13dfcca4e2347aa2173d6fd8de3537d724db7254d4c5f0\n    target_directory: data-dictionary\n\nbuild:\n  number: 0\n  string: dd${{ dd_version | version_to_buildstring }}h${{ hash }}_${{ build_number }}\n  # python is only a build-time tool: keep it out of the build variants\n  variant:\n    ignore_keys:\n      - python\n  # No Windows build for now: upstream builds Windows with vcpkg and the\n  # build system needs more work to support conda on Windows\n  skip: win\n  script:\n    file: build.sh\n    env:\n      DD_VERSION: ${{ dd_version }}\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('fortran') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - ninja\n    - pkg-config\n    # Saxon-HE (Java) performs the XSLT 2.0 transformations that generate the\n    # IDS types and routines from the Data Dictionary (replaces the PyPI-only\n    # saxonche)\n    - openjdk\n    - saxon-he\n    # Used to pre-create the venv expected by the build system (see build.sh)\n    - python\n  host:\n    - libimas-core\n  run_exports:\n    # The generated API depends on both the AL and the DD version, and the\n    # installed .mod files are specific to the Fortran compiler used\n    - ${{ pin_subpackage('imas-fortran', upper_bound='x.x.x') }}\n\ntests:\n  - package_contents:\n      lib:\n        - al-fortran-${{ dd_version }}\n        - al-identifiers-fortran\n      include:\n        - fortran/ids_schemas.mod\n      files:\n        - lib/pkgconfig/al-fortran.pc\n        - lib/pkgconfig/al-fortran-${{ dd_version }}.pc\n        - lib/pkgconfig/al-identifiers-fortran.pc\n        # backwards-compatibility symlinks\n        - lib/pkgconfig/imas-fortran.pc\n  - script:\n      - pkg-config --exists --print-errors al-fortran\n      - pkg-config --exists --print-errors \"al-fortran-${{ dd_version }}\"\n      - pkg-config --exists --print-errors al-identifiers-fortran\n    requirements:\n      run:\n        - pkg-config\n\nabout:\n  homepage: https://imas.iter.org/\n  license: LGPL-3.0-only\n  # Include the Data Dictionary licenses, as the generated IDS interfaces are\n  # derived from the Data Dictionary sources\n  license_file:\n    - LICENSE.txt\n    - data-dictionary/LICENSE-LGPL\n    - data-dictionary/LICENSE-CC-BY-ND\n  summary: Fortran High Level Interface of the IMAS Access Layer\n  description: |\n    IMAS-Fortran is part of the Integrated Modelling and Analysis Suite at\n    ITER. It provides the Fortran High Level Interface (HLI) of the IMAS\n    Access Layer, giving Fortran programs strongly-typed access to Interface\n    Data Structures (IDSs) defined by the IMAS Data Dictionary, on top of the\n    IMAS-Core low-level library.\n  repository: https://github.com/iterorganization/IMAS-Fortran\n  documentation: https://imas-fortran.readthedocs.io/en/stable/\n\nextra:\n  recipe-maintainers:\n    - SimonPinches\n    - munechika-koyo\n",
