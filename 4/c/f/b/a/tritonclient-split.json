  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: tritonclient\n  version: \"2.71.0\"\n  client_rev: 67fc23833a2d67edd2840db9f828ca6b75a0336c\n  common_rev: ecb874c3126f9f07810f4900d4e7b088fee5eb8c\n\nrecipe:\n  name: ${{ name|lower }}-split\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/triton-inference-server/client/archive/${{ client_rev }}.tar.gz\n    sha256: c48e31f08959e2c0f264fded27b1395b0ba335939118a747223b1852c8f179ea\n    target_directory: client\n    patches:\n      # Fix shared-library linkage and CMake exports; make static archive installation optional.\n      - client-cmake.patch\n      # Allow the conda-forge gRPC/protobuf runtimes used to regenerate Python stubs.\n      - client-support-conda-grpc.patch\n  - url: https://github.com/triton-inference-server/common/archive/${{ common_rev }}.tar.gz\n    sha256: 81e5f9aef14cc70b9c0570e2a465c69d2fdac55ee9c8bc8f729879244cb7a26e\n    target_directory: common\n    patches:\n      # Control common-library installation/tests and locate the native gRPC code generator.\n      - common-cmake.patch\n\nbuild:\n  number: 1\n  skip:\n    - win\n\noutputs:\n  - package:\n      name: ${{ name }}\n    build:\n      # CMake's protobuf object files are build-only; the installed wheel is pure Python.\n      noarch: python\n      skip:\n        - not linux\n      script: build_python.sh\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - cmake >=3.31.8\n        # Keep native code-generation tools on the same release line as host libgrpc.\n        - libgrpc ${{ libgrpc }}.*\n        - ninja\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - setuptools\n        - wheel\n        - grpcio-tools ${{ libgrpc }}.*\n        - grpcio ${{ libgrpc }}.*\n        - libgrpc\n        - libprotobuf\n        - rapidjson\n      run:\n        - python >=${{ python_min }}\n        - ml_dtypes <=0.5.4\n        - numpy >=1.19.1\n        - python-rapidjson >=0.9.1\n        - urllib3 >=2.0.7\n      run_constraints:\n        # grpcio-tools requires matching grpcio; generated stubs enforce this full version.\n        - ${{ pin_compatible('grpcio', lower_bound='x.x.x', upper_bound=None) }}\n    tests:\n      - python:\n          imports:\n            - tritonclient\n            - tritonclient.utils\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n\n  - package:\n      name: ${{ name }}-http\n    build:\n      noarch: generic\n      skip:\n        - not linux\n    requirements:\n      run:\n        - ${{ pin_subpackage('tritonclient', exact=True) }}\n        - aiohttp >=3.8.1,<4.0.0\n        - geventhttpclient >=2.3.3\n        - greenlet <3.4.0\n    tests:\n      - python:\n          imports:\n            - tritonclient.http\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n\n  - package:\n      name: ${{ name }}-grpc\n    build:\n      noarch: generic\n      skip:\n        - not linux\n    requirements:\n      run:\n        - ${{ pin_subpackage('tritonclient', exact=True) }}\n        # tritonclient constrains this further to the generator's resolved patch version.\n        - grpcio >=${{ libgrpc }}\n        - packaging >=14.1\n        - protobuf >=${{ libprotobuf }},<8.0\n    tests:\n      - python:\n          imports:\n            - tritonclient.grpc\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n\n  - package:\n      name: libtritonclient\n    build:\n      skip:\n        - win\n      script: build_cpp.sh\n    requirements:\n      build:\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - cmake >=3.31.8\n        # grpc_cpp_plugin runs on the build platform and must match host libgrpc.\n        - libgrpc ${{ libgrpc }}.*\n        - ninja\n      host:\n        - libabseil\n        - libcurl\n        - libgrpc\n        - libprotobuf\n        - rapidjson\n        - zlib\n      run:\n        # The installed json_utils.h exposes RapidJSON types to downstream consumers.\n        - rapidjson\n      run_exports:\n        - ${{ pin_subpackage('libtritonclient', upper_bound='x.x') }}\n    tests:\n      - package_contents:\n          include:\n            - common.h\n            - grpc_client.h\n            - http_client.h\n          lib:\n            - grpcclient\n            - httpclient\n          files:\n            - lib/cmake/TritonClient/TritonClientConfig.cmake\n      - script:\n          - cmake -S test -B test-build -GNinja\n          - cmake --build test-build\n          - test-build/tritonclient-test\n          - test ! -e \"$PREFIX/lib/libgrpcclient_static.a\"\n          - test ! -e \"$PREFIX/lib/libhttpclient_static.a\"\n        files:\n          recipe:\n            - test/\n        requirements:\n          build:\n            - ${{ compiler('cxx') }}\n            - ${{ stdlib('c') }}\n          run:\n            - cmake\n            - libabseil\n            - libcurl\n            - libgrpc\n            - libprotobuf\n            - ninja\n            - zlib\n\nabout:\n  license: BSD-3-Clause\n  license_file:\n    - client/LICENSE\n    - common/LICENSE\n  summary: C++ and Python clients for communicating with Triton Inference Server\n  homepage: https://developer.nvidia.com/nvidia-triton-inference-server\n  repository: https://github.com/triton-inference-server/client\n\nextra:\n  feedstock-name: tritonclient-split\n  recipe-maintainers:\n    - janjagusch\n    - ivergara\n    - nick-harmening\n    - timkpaine\n",
