    "about": {
      "description": "Robot Framework is a generic open source automation framework for acceptance testing, acceptance test driven development (ATDD), and robotic process automation (RPA). It has simple plain text syntax and it can be extended easily with libraries implemented using Python or Java.",
      "dev_url": "https://github.com/robotframework/robotframework",
      "doc_url": "https://robotframework.org/robotframework",
      "home": "https://pypi.org/project/robotframework",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "dist/LICENSE.txt",
      "summary": "Generic automation framework for acceptance testing and robotic process automation (RPA)"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "robot = robot.run:run_cli",
          "rebot = robot.rebot:rebot_cli",
          "libdoc = robot.libdoc:libdoc_cli"
        ]
      },
      "script": [
        "cd dist",
        "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check --check-build-dependencies"
      ]
    },
    "extra": {
      "feedstock-name": "robotframework",
      "recipe-maintainers": [
        "abloemert",
        "bollwyvl"
      ]
    },
    "outputs": [
      {
        "build": {
          "noarch": "python",
          "python": {
            "entry_points": [
              "robot = robot.run:run_cli",
              "rebot = robot.rebot:rebot_cli",
              "libdoc = robot.libdoc:libdoc_cli"
            ]
          }
        },
        "name": "robotframework",
        "requirements": {
          "build": [],
          "host": [
            "pip",
            "python 3.11.*",
            "setuptools"
          ],
          "run": [
            "python >=3.11"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "robot"
              ],
              "python_version": [
                "3.11.*",
                "3.15.*"
              ]
            }
          },
          {
            "package_contents": {
              "site_packages": [
                "robot/**",
                "robotframework-7.5.1.dist-info/**"
              ],
              "strict": true
            }
          },
          {
            "requirements": {
              "run": [
                "python 3.11.*"
              ]
            },
            "script": [
              "echo \"*** Test Cases ***\"                   >> test-${{ version }}.robot",
              "echo \"Hello World\"                          >> test-${{ version }}.robot",
              "echo \"    Log   %{PKG_NAME} %{PKG_VERSION}\" >> test-${{ version }}.robot",
              "robot test-${{ version }}.robot",
              "rebot output.xml",
              "libdoc test-${{ version }}.robot test.html",
              "robot --version --nostatusrc",
              "robot --version --nostatusrc | ${{ \"grep -iE\" if unix else \"findstr /c\" }} \" ${{ version | replace('.', '\\\\.') }} \""
            ]
          }
        ],
        "version": "7.5.1"
      },
      {
        "build": {
          "noarch": "generic"
        },
        "name": "_robotframework_tests",
        "requirements": {
          "build": [],
          "host": [],
          "run": [
            "robotframework",
            "python 3.11.*"
          ]
        },
        "tests": [
          {
            "files": {
              "source": [
                "src/utest/",
                "src/atest/",
                "src/doc/schema/",
                "src/README.rst"
              ]
            },
            "requirements": {
              "run": [
                "coverage",
                "docutils",
                "jsonschema",
                "lxml",
                "markdown",
                "pillow",
                "pygments",
                "pyyaml"
              ]
            },
            "script": [
              "cd src/utest",
              "coverage run --source=robot --branch run.py",
              "coverage report --show-missing --skip-covered --fail-under=71"
            ]
          }
        ],
        "version": "7.5.1"
      }
    ],
