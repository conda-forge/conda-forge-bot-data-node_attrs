    "about": {
      "description": "f2py-cmake provides the UseF2Py CMake module, which makes it easy to\nbuild NumPy F2PY extension modules from CMake-based projects (for\nexample together with scikit-build-core).",
      "dev_url": "https://github.com/scikit-build/f2py-cmake",
      "home": "https://github.com/scikit-build/f2py-cmake",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "CMake helpers for building F2Py modules"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "f2py-cmake = f2py_cmake.__main__:main"
        ]
      },
      "script": "${{ PYTHON }} -m pip install . -vv"
    },
    "extra": {
      "recipe-maintainers": [
        "henryiii",
        "LiuGaoyong"
      ]
    },
    "outputs": [
      {
        "build": {
          "noarch": "python",
          "python": {
            "entry_points": [
              "f2py-cmake = f2py_cmake.__main__:main"
            ]
          }
        },
        "name": "f2py-cmake",
        "requirements": {
          "build": [],
          "host": [
            "python 3.11.*",
            "pip",
            "hatchling",
            "hatch-vcs"
          ],
          "run": [
            "python >=3.11",
            "numpy"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "f2py_cmake"
              ],
              "python_version": [
                "3.11.*",
                "*"
              ]
            }
          },
          {
            "requirements": {
              "run": [
                "python 3.11.*"
              ]
            },
            "script": [
              "f2py-cmake --version",
              "mkdir vendored",
              "f2py-cmake vendor vendored",
              "test -f vendored/UseF2Py.cmake"
            ]
          }
        ],
        "version": "0.3.1"
      }
    ],
