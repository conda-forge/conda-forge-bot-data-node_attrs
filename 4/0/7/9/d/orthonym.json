    "about": {
      "description": "A SMILES string goes in. A verified IUPAC name comes out, or a clear \"no\".\nNever a guess. Orthonym needs a Java runtime (installed with this package)\nand the pinned OPSIN and centres jars, which it downloads with a SHA-256\ncheck the first time it needs them (or run `orthonym --fetch-jars`).",
      "dev_url": "https://github.com/Steinbeck-Lab/Orthonym",
      "doc_url": "https://steinbeck-lab.github.io/Orthonym/",
      "home": "https://github.com/Steinbeck-Lab/Orthonym",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Rule-based IUPAC names from molecular structures (SMILES)"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "python": {
        "entry_points": [
          "orthonym = orthonym.cli:main"
        ]
      },
      "script": {
        "content": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation",
        "env": {
          "ORTHONYM_SKIP_JAR_PREFETCH": "1"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "Kohulan"
      ]
    },
    "outputs": [
      {
        "build": {
          "noarch": "python",
          "python": {
            "entry_points": [
              "orthonym = orthonym.cli:main"
            ]
          }
        },
        "name": "orthonym",
        "requirements": {
