  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.7.2\"\n  mpl_min: \"3.9\"\n  mpl_max: \"3.12\"\n\npackage:\n  name: ultraplot\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ultraplot/ultraplot/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 921fa85beca65a8e0d7232620c7e3cd3ee79c1feb4d50920742df028dfd4c8e5\n  patches:\n    - package-data.patch\n\nbuild:\n  number: 1\n  noarch: python\n  script:\n    content: pip install . -vv\n    env:\n      SETUPTOOLS_SCM_PRETEND_VERSION: ${{ version }}\n  python:\n    entry_points:\n      - ultraplot-mcp = ultraplot.mcp:main\n  files:\n    exclude:\n      - var/cache/fontconfig/*\n      - \"**/site-packages/ultraplot/tests/**\"\n      - \"**/site-packages/tools/**\"\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n    - setuptools-scm\n    - numpy >=1.26.0\n    - matplotlib-base >=${{ mpl_min }},<${{ mpl_max }}\n  run:\n    - python >=${{ python_min }}\n    - numpy >=1.26.0\n    - matplotlib-base >=${{ mpl_min }},<${{ mpl_max }}\n    - typing-extensions\n\ntests:\n  - python:\n      imports:\n        - ultraplot\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\n  - script:\n      interpreter: python\n      content: |\n        import ultraplot as uplt\n\n        assert uplt.__version__ == '${{ version }}'\n\n        fig, ax = uplt.subplots()\n        ax.plot([0, 1], [0, 1])\n\n  - script:\n      content:\n        - ultraplot-mcp --help\n    requirements:\n      run:\n        - python ${{ python_min }}.*\n        - matplotlib-base ${{ mpl_min }}.*\n        - mcp >=2.1,<3\n\n  - package_contents:\n      files:\n        - \"**/site-packages/ultraplot/fonts/**.ttf\"\n        - \"**/site-packages/ultraplot/cmaps/**.rgb\"\n        - \"**/site-packages/ultraplot/cycles/**.hex\"\n\nabout:\n  homepage: https://ultraplot.readthedocs.io/\n  license: MIT\n  license_file: LICENSE.txt\n  summary: Elegant and flexible high-level plotting with matplotlib\n  description: |\n    Ultraplot is a Python library that provides a high-level interface for creating\n    publication-quality plots using matplotlib. It focuses on making common plotting\n    tasks simple while maintaining full flexibility for customization.\n  repository: https://github.com/ultraplot/ultraplot\n  documentation: https://ultraplot.readthedocs.io/\n\nextra:\n  recipe-maintainers:\n    - cvanelteren\n    - beckermr\n    - munechika-koyo\n",
