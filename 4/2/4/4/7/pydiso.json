  "raw_meta_yaml": "context:\n  version: \"0.3.0\"\n  # ensure is_freethreading gets detected as a used variable\n  touch_is_freethreading: ${{ is_freethreading }}\n\npackage:\n  name: pydiso\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/pydiso/pydiso-${{ version }}.tar.gz\n  sha256: 0b6d0f3f4cb473a5d74179c72a6774181233ea80029f18c3147c3461aa824ac7\n  patches:\n    # the PyPI `mkl` wheel dependency has no python metadata on conda-forge (fails pip check);\n    # the conda `mkl` runtime comes from mkl-devel's run_exports instead\n    - 0001-drop-pypi-mkl-runtime-dependency.patch\n\nbuild:\n  number: 0\n  skip:\n    - match(python, \"<\" ~ python_min)\n    # the abi3 build is made once on python_min and covers every later (non-freethreading) python\n    - is_abi3 and not match(python, python_min ~ \".*\")\n  python:\n    version_independent: ${{ is_abi3 }}\n  script:\n    - if: is_abi3\n      then: ${{ PYTHON }} -m pip install . --no-deps -vv --no-build-isolation\n      # Cython can't target the free-threaded stable ABI (abi3t) yet, so those builds opt out of the limited API\n      else: ${{ PYTHON }} -m pip install . --no-deps -vv --no-build-isolation -Csetup-args=-Dpython.allow_limited_api=false\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n  host:\n    - if: is_abi3\n      then: python-abi3\n    - python\n    - pip\n    - meson-python >=0.21.0\n    - ninja\n    - pkg-config\n    - cython >=3.1.0\n    - numpy\n    - setuptools_scm >=6.2\n    - mkl-devel\n  run:\n    - python >=${{ python_min }}\n    - numpy >=2.2.0\n    - scipy >=1.15.0\n  run_constraints:\n    # Block openmp from being installed in the same environment (conflicts with numpy and MKL)\n    # done by giving an unsatisfiable openmp version.\n    # Note: llvm-openmp is safe though.\n    - openmp ==99999999999999\n\ntests:\n  - python:\n      imports:\n        - pydiso\n        - pydiso.mkl_solver\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/pydiso/_mkl_solver.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%\\pydiso\\_mkl_solver.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  homepage: https://www.simpeg.xyz\n  license: MIT\n  license_file: LICENSE\n  summary: 'A simple cython based interface to the pardiso solver'\n  repository: https://github.com/simpeg/pydiso\n\nextra:\n  recipe-maintainers:\n    - jcapriot\n    - lheagy\n",
