  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2026.09.01\"\n  aoomed: aoo-mozilla-en-dict\n  stem: vale-spelling-${{ aoomed }}\n  pkg_au: ${{ stem }}-au\n  pkg_ca: ${{ stem }}-ca\n  pkg_gb: ${{ stem }}-gb\n  pkg_gb_ox: ${{ stem }}-gb-oxendict\n  pkg_us: ${{ stem }}-us\n  pkg_za: ${{ stem }}-za\n  share_vale: share/vale/styles/${{ aoomed }}\n  share_hunspell: share/hunspell\n  rules: Spelling.yml\n  meta: meta.json\n  vale_files: \"{${{ meta }},${{ rules }},LICENSE}\"\n  summary: Vale-compatible English Dictionaries Project (AOO+Mozilla+others)\n\nrecipe:\n  name: ${{ stem }}-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/marcoagpinto/aoo-mozilla-en-dict/archive/${{ version }}.tar.gz\n  sha256: 68349bfc36a17bddb16f8fde63fa10f5cf82f1e6c7b21393d3389e303cf2d97d\n\nbuild:\n  number: 0\n  noarch: generic\n\noutputs:\n  - staging:\n      name: staging\n    build:\n      script:\n        env:\n          PKG_VERSION: ${{ version }}\n          PKG_LOCALES: en_AU en_CA en_GB en_GB-oxendict en_US en_ZA\n        file: write_rule.py\n    requirements: { host: [\"python >=3.14\"] }\n\n  - package: { name: \"${{ pkg_au }}\" }\n    inherit: staging\n    build: { files: [\"${{ share_vale }}-au/**\"] }\n    requirements: { run: [\"${{ aoomed }}-au ${{ version }}.*\"] }\n    tests:\n      - package_contents:\n          strict: true\n          files: [\"${{ share_vale }}-au/${{ vale_files }}\"]\n      - requirements: { run: [pytest, python >=3.14, vale] }\n        script: { file: test_spelling.py }\n    about: { summary: \"${{ summary }} (en_AU)\" }\n\n  - package: { name: \"${{ pkg_ca }}\" }\n    inherit: staging\n    build: { files: [\"${{ share_vale }}-ca/**\"] }\n    requirements: { run: [\"${{ aoomed }}-ca ${{ version }}.*\"] }\n    tests:\n      - package_contents:\n          strict: true\n          files: [\"${{ share_vale }}-ca/${{ vale_files }}\"]\n      - requirements: { run: [pytest, python >=3.14, vale] }\n        script: { file: test_spelling.py }\n    about: { summary: \"${{ summary }} (en_CA)\" }\n\n  - package: { name: \"${{ pkg_gb }}\" }\n    inherit: staging\n    build: { files: [\"${{ share_vale }}-gb/**\"] }\n    requirements: { run: [\"${{ aoomed }}-gb ${{ version }}.*\"] }\n    tests:\n      - package_contents:\n          strict: true\n          files: [\"${{ share_vale }}-gb/${{ vale_files }}\"]\n      - requirements: { run: [pytest, python >=3.14, vale] }\n        script: { file: test_spelling.py }\n    about: { summary: \"${{ summary }} (en_GB)\" }\n\n  - package: { name: \"${{ pkg_gb_ox }}\" }\n    inherit: staging\n    build: { files: [\"${{ share_vale }}-gb-oxendict/**\"] }\n    requirements: { run: [\"${{ aoomed }}-gb-oxendict ${{ version }}.*\"] }\n    tests:\n      - package_contents:\n          strict: true\n          files: [\"${{ share_vale }}-gb-oxendict/${{ vale_files }}\"]\n      - requirements: { run: [pytest, python >=3.14, vale] }\n        script: { file: test_spelling.py }\n    about: { summary: \"${{ summary }} (en_GB-oxendict)\" }\n\n  - package: { name: \"${{ pkg_us }}\" }\n    inherit: staging\n    build: { files: [\"${{ share_vale }}-us/**\"] }\n    requirements: { run: [\"${{ aoomed }}-us ${{ version }}.*\"] }\n    tests:\n      - package_contents:\n          strict: true\n          files: [\"${{ share_vale }}-us/${{ vale_files }}\"]\n      - requirements: { run: [pytest, python >=3.14, vale] }\n        script: { file: test_spelling.py }\n    about: { summary: \"${{ summary }} (en_US)\" }\n\n  - package: { name: \"${{ pkg_za }}\" }\n    inherit: staging\n    build: { files: [\"${{ share_vale }}-za/**\"] }\n    requirements: { run: [\"${{ aoomed }}-za ${{ version }}.*\"] }\n    tests:\n      - package_contents:\n          strict: true\n          files: [\"${{ share_vale }}-za/${{ vale_files }}\"]\n      - requirements: { run: [pytest, python >=3.14, vale] }\n        script: { file: test_spelling.py }\n    about: { summary: \"${{ summary }} (en_ZA)\" }\n\n  - package: { name: \"${{ stem }}\" }\n    requirements:\n      run:\n        - ${{ pin_subpackage(pkg_au, exact=True) }}\n        - ${{ pin_subpackage(pkg_ca, exact=True) }}\n        - ${{ pin_subpackage(pkg_gb, exact=True) }}\n        - ${{ pin_subpackage(pkg_gb_ox, exact=True) }}\n        - ${{ pin_subpackage(pkg_us, exact=True) }}\n        - ${{ pin_subpackage(pkg_za, exact=True) }}\n        - vale\n    tests:\n      - requirements: { run: [pytest, python >=3.14] }\n        script: { file: test_spelling.py }\n\nabout:\n  homepage: https://github.com/marcoagpinto/aoo-mozilla-en-dict\n  summary: ${{ summary }}\n  license: LGPL-3.0-or-later\n  license_file: README.md\n\nextra:\n  feedstock-name: vale-spelling-aoo-mozilla-en-dict\n  recipe-maintainers:\n    - bollwyvl\n",
